# Copy to .env. In production set NODE_ENV=production; GOOGLE_CLIENT_ID is then required and audio must be rendered.
PORT=3000
# HOST=127.0.0.1
# DATABASE_PATH=data/app.db
# CONTENT_DIR=content
# AUDIO_DIR=content/audio
GOOGLE_CLIENT_ID=
# Comma-separated; unset allows any verified Google account.
ALLOWED_EMAILS=
# Comma-separated; these accounts see the problem-report triage page (account menu > Reports).
ADMIN_EMAILS=
# Server-side only. Unset disables the "Why?" explainer (503) and conversation mode.
OPENROUTER_API_KEY=
# Quiz audio (gpt-4o-mini-tts, which OpenRouter lacks); unset makes the quiz Play buttons fail.
OPENAI_API_KEY=
# Local/E2E only: enables POST /api/auth/dev. Refused when NODE_ENV=production.
DEV_LOGIN=1
