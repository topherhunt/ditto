# Copy to .env. In production set NODE_ENV=production; GOOGLE_CLIENT_ID is then required and audio must be rendered.
PORT=3000
# HOST=127.0.0.1
# DATABASE_PATH=data/app.db
# CONTENT_DIR=content
# AUDIO_DIR=content/audio
GOOGLE_CLIENT_ID=
# Comma-separated; these accounts get the /admin pages (users with their emails, metrics, spend, problem and people reports, language requests, pronunciation POC) and can play any learner's conversation partner audio.
ADMIN_EMAILS=
# Server-side only; every paid AI call uses it. Unset disables the "Why?" explainer (503) and conversation mode, and makes the quiz Play buttons fail.
OPENAI_API_KEY=
# Local/E2E only: enables POST /api/auth/dev. Refused when NODE_ENV=production.
DEV_LOGIN=1
