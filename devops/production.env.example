# Copy to devops/production.env (gitignored), fill in, then run devops/push-env.sh.
# NODE_ENV, HOST, PORT and DATABASE_PATH are set by the systemd unit, not here.
GOOGLE_CLIENT_ID=
# Comma-separated; unset lets any verified Google account sign in.
ALLOWED_EMAILS=
# Comma-separated; these accounts see the problem-report triage page (account menu > Reports).
ADMIN_EMAILS=
# Every paid AI call but quiz audio goes through OpenRouter: the "Why?" explainer and conversation mode (its OpenAI models and Kokoro voice); unset disables both. Every paid call counts toward DAILY_SPEND_CAP (USD per user per UTC day, default 1), which blocks the exercises once reached.
OPENROUTER_API_KEY=
# Quiz audio is gpt-4o-mini-tts on OpenAI directly (OpenRouter lacks it), cached on disk and counted toward DAILY_SPEND_CAP.
OPENAI_API_KEY=
