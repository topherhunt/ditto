        { "id": "it-a1-giornata-4-u13", "rev": 1, "stage": "sentence", "text": "Mio marito finisce tardi e torna alle otto.", "translation": "My husband finishes late and gets home at eight.", "distractors": ["My husband finishes early and gets home at eight.", "My husband finishes late and gets home at nine."], "variants": ["Mio marito finisce tardi e torna alle 8."], "commas": [3] },
