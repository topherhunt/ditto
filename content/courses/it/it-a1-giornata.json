        { "id": "it-a1-giornata-6-u15", "rev": 1, "stage": "sentence", "text": "Mangiamo dai nonni una volta alla settimana.", "translation": "We eat at our grandparents' once a week.", "distractors": ["We eat at our grandparents' twice a week.", "We eat at our cousins' once a week."], "commas": [2] },
        { "id": "it-a1-giornata-6-u16", "rev": 1, "stage": "sentence", "text": "Non esci mai la sera?", "translation": "Don't you ever go out in the evening?", "distractors": ["Do you always go out in the evening?", "Doesn't he ever go out in the evening?"] }
