        { "id": "it-a1-giornata-6-u09", "rev": 1, "stage": "sentence", "text": "Di solito dormo sette ore.", "translation": "I usually sleep seven hours.", "distractors": ["I usually sleep eight hours.", "I always sleep seven hours."], "variants": ["Di solito dormo 7 ore."], "commas": [1] },
        { "id": "it-a1-giornata-6-u10", "rev": 1, "stage": "phrase", "text": "qualche volta", "translation": "sometimes", "distractors": ["always", "every time"] },
