        { "id": "it-a1-giornata-5-u11", "rev": 1, "stage": "sentence", "text": "Vado a letto verso le undici.", "translation": "I go to bed around eleven.", "distractors": ["I go to bed around ten.", "I get up around eleven."], "variants": ["Vado a letto verso le 11."] },
