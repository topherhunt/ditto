        { "id": "it-a1-giornata-5-u05", "rev": 1, "stage": "chunk", "text": "esci questa sera", "translation": "are you going out this evening", "distractors": ["are you coming home this evening", "are you going out tomorrow evening"] },
        { "id": "it-a1-giornata-5-u06", "rev": 1, "stage": "sentence", "text": "Esci questa sera?", "translation": "Are you going out this evening?", "distractors": ["Are you staying in this evening?", "Is she going out this evening?"] },
