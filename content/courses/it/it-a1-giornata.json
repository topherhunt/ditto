        { "id": "it-a1-giornata-3-u07", "rev": 1, "stage": "word", "text": "occupato", "translation": "busy", "distractors": ["free", "tired"] },
        { "id": "it-a1-giornata-3-u08", "rev": 1, "stage": "sentence", "text": "Oggi sono molto occupata, mangio in ufficio.", "translation": "I'm very busy today, I'm eating at the office.", "distractors": ["I'm not very busy today, I'm eating at the office.", "I'm very busy today, I'm eating at home."] },
        { "id": "it-a1-giornata-3-u09", "rev": 1, "stage": "word", "text": "cominciare", "translation": "to start", "distractors": ["to finish", "to eat"] },
