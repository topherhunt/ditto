        { "id": "it-a1-giornata-4-u07", "rev": 1, "stage": "sentence", "text": "Sono stanca, mi riposo un po'.", "translation": "I'm tired, I'm going to rest a bit.", "distractors": ["I'm not tired, I'm going to rest a bit.", "I'm tired, I'm going to sleep a lot."] },
