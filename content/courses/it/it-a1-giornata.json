        { "id": "it-a1-giornata-3-u03", "rev": 1, "stage": "phrase", "text": "verso l'una", "translation": "around one o'clock", "distractors": ["at exactly one o'clock", "around two o'clock"] },
        { "id": "it-a1-giornata-3-u04", "rev": 1, "stage": "sentence", "text": "Mangio verso l'una.", "translation": "I eat around one o'clock.", "distractors": ["I eat at exactly one o'clock.", "I eat around two o'clock."] },
        { "id": "it-a1-giornata-3-u05", "rev": 1, "stage": "phrase", "text": "a pranzo", "translation": "at lunch", "distractors": ["at dinner", "at breakfast"] },
