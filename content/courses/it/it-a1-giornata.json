  "lessons": [
    {
      "id": "it-a1-giornata-1",
      "title": "La mattina",
      "grammarFocus": ["fare colazione, fare la doccia", "-ere verbs: prendo, legge", "uscire: esco, esce"],
      "units": [
        { "id": "it-a1-giornata-1-u01", "rev": 1, "stage": "word", "text": "colazione", "translation": "breakfast", "distractors": ["lunch", "dinner"] },
        { "id": "it-a1-giornata-1-u02", "rev": 1, "stage": "chunk", "text": "faccio colazione", "translation": "I have breakfast", "distractors": ["I have lunch", "I make coffee"] },
        { "id": "it-a1-giornata-1-u03", "rev": 1, "stage": "sentence", "text": "Faccio colazione alle sette.", "translation": "I have breakfast at seven.", "distractors": ["I have breakfast at eight.", "I have lunch at seven."], "variants": ["Faccio colazione alle 7."] },
        { "id": "it-a1-giornata-1-u04", "rev": 1, "stage": "phrase", "text": "un caffè e un cornetto", "translation": "a coffee and a croissant", "distractors": ["a tea and a croissant", "a coffee and a sandwich"] },
        { "id": "it-a1-giornata-1-u05", "rev": 1, "stage": "sentence", "text": "La mattina prendo un caffè e un cornetto.", "translation": "In the morning I have a coffee and a croissant.", "distractors": ["In the evening I have a coffee and a croissant.", "In the morning I have a tea and a croissant."], "commas": [1] },
        { "id": "it-a1-giornata-1-u06", "rev": 1, "stage": "word", "text": "doccia", "translation": "shower", "distractors": ["bath", "breakfast"] },
        { "id": "it-a1-giornata-1-u07", "rev": 1, "stage": "chunk", "text": "faccio la doccia", "translation": "I take a shower", "distractors": ["I take a bath", "I have breakfast"] },
        { "id": "it-a1-giornata-1-u08", "rev": 1, "stage": "sentence", "text": "Prima faccio la doccia, poi faccio colazione.", "translation": "First I take a shower, then I have breakfast.", "distractors": ["First I have breakfast, then I take a shower.", "First I take a shower, then I go to work."], "commas": [0] },
        { "id": "it-a1-giornata-1-u09", "rev": 1, "stage": "word", "text": "giornale", "translation": "newspaper", "distractors": ["book", "magazine"] },
        { "id": "it-a1-giornata-1-u10", "rev": 1, "stage": "word", "text": "leggere", "translation": "to read", "distractors": ["to write", "to watch"] },
        { "id": "it-a1-giornata-1-u11", "rev": 1, "stage": "sentence", "text": "Mio padre legge il giornale a colazione.", "translation": "My father reads the newspaper at breakfast.", "distractors": ["My father reads a book at breakfast.", "My mother reads the newspaper at breakfast."] },
        { "id": "it-a1-giornata-1-u12", "rev": 1, "stage": "chunk", "text": "esco di casa", "translation": "I leave the house", "distractors": ["I get home", "I stay at home"] },
        { "id": "it-a1-giornata-1-u13", "rev": 1, "stage": "sentence", "text": "Esco di casa alle otto e un quarto.", "translation": "I leave the house at a quarter past eight.", "distractors": ["I leave the house at a quarter to eight.", "I get home at a quarter past eight."], "variants": ["Esco di casa alle 8 e un quarto."] },
        { "id": "it-a1-giornata-1-u14", "rev": 1, "stage": "word", "text": "subito", "translation": "right away", "distractors": ["later", "never"] },
        { "id": "it-a1-giornata-1-u15", "rev": 1, "stage": "sentence", "text": "Mia moglie esce subito dopo colazione.", "translation": "My wife goes out right after breakfast.", "distractors": ["My wife goes out right before breakfast.", "My wife goes back to bed after breakfast."] },
        { "id": "it-a1-giornata-1-u16", "rev": 1, "stage": "sentence", "text": "E tu, prendi il cappuccino la mattina?", "translation": "And you, do you have a cappuccino in the morning?", "distractors": ["And you, do you have a cappuccino in the evening?", "And you, do you have tea in the morning?"], "commas": [4] }
      ]
    },
    {
      "id": "it-a1-giornata-2",
      "title": "Mi sveglio presto",
      "grammarFocus": ["reflexive verbs with mi, ti, si", "reflexive pronoun before the verb"],
      "units": [
        { "id": "it-a1-giornata-2-u01", "rev": 1, "stage": "phrase", "text": "mi sveglio", "translation": "I wake up", "distractors": ["I get up", "I fall asleep"] },
        { "id": "it-a1-giornata-2-u02", "rev": 1, "stage": "sentence", "text": "Mi sveglio alle sei e mezza.", "translation": "I wake up at half past six.", "distractors": ["I wake up at half past seven.", "I get up at half past six."], "variants": ["Mi sveglio alle 6 e mezza."] },
        { "id": "it-a1-giornata-2-u03", "rev": 1, "stage": "word", "text": "presto", "translation": "early", "distractors": ["late", "soon"] },
        { "id": "it-a1-giornata-2-u04", "rev": 1, "stage": "phrase", "text": "mi alzo presto", "translation": "I get up early", "distractors": ["I get up late", "I wake up early"] },
        { "id": "it-a1-giornata-2-u05", "rev": 1, "stage": "sentence", "text": "Il sabato non mi alzo presto.", "translation": "On Saturdays I don't get up early.", "distractors": ["On Sundays I don't get up early.", "On Saturdays I get up early."], "commas": [1] },
        { "id": "it-a1-giornata-2-u06", "rev": 1, "stage": "chunk", "text": "a che ora ti svegli", "translation": "what time do you wake up", "distractors": ["what time do you get up", "what time does he wake up"] },
        { "id": "it-a1-giornata-2-u07", "rev": 1, "stage": "sentence", "text": "A che ora ti svegli la mattina?", "translation": "What time do you wake up in the morning?", "distractors": ["What time do you go to bed at night?", "What time does he wake up in the morning?"] },
        { "id": "it-a1-giornata-2-u08", "rev": 1, "stage": "phrase", "text": "mi lavo e mi vesto", "translation": "I wash and get dressed", "distractors": ["I wash and have breakfast", "I shower and go out"] },
        { "id": "it-a1-giornata-2-u09", "rev": 1, "stage": "sentence", "text": "Mi lavo, mi vesto ed esco.", "translation": "I wash, get dressed and go out.", "distractors": ["I wash, get dressed and have breakfast.", "I wash, get dressed and go back to bed."] },
        { "id": "it-a1-giornata-2-u10", "rev": 1, "stage": "phrase", "text": "in dieci minuti", "translation": "in ten minutes", "distractors": ["in twenty minutes", "ten minutes ago"], "variants": ["in 10 minuti"] },
        { "id": "it-a1-giornata-2-u11", "rev": 1, "stage": "sentence", "text": "Mia sorella si prepara in dieci minuti.", "translation": "My sister gets ready in ten minutes.", "distractors": ["My sister gets ready in twenty minutes.", "My brother gets ready in ten minutes."], "variants": ["Mia sorella si prepara in 10 minuti."] },
        { "id": "it-a1-giornata-2-u12", "rev": 1, "stage": "word", "text": "tardi", "translation": "late", "distractors": ["early", "often"] },
        { "id": "it-a1-giornata-2-u13", "rev": 1, "stage": "sentence", "text": "I ragazzi si alzano sempre tardi.", "translation": "The kids always get up late.", "distractors": ["The kids never get up late.", "The kids always get up early."] },
        { "id": "it-a1-giornata-2-u14", "rev": 1, "stage": "word", "text": "vestirsi", "translation": "to get dressed", "distractors": ["to get up", "to wash"] },
        { "id": "it-a1-giornata-2-u15", "rev": 1, "stage": "sentence", "text": "Ti vesti subito o fai colazione prima?", "translation": "Do you get dressed right away or have breakfast first?", "distractors": ["Do you get dressed right away or take a shower first?", "Do you wake up right away or have breakfast first?"] }
      ]
