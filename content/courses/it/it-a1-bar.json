  "lessons": [
    {
      "id": "it-a1-bar-1",
      "title": "Un caffè, per favore",
      "grammarFocus": ["indefinite articles un / un'", "vorrei + noun"],
      "units": [
        { "id": "it-a1-bar-1-u01", "rev": 1, "stage": "word", "text": "caffè", "translation": "coffee" },
        { "id": "it-a1-bar-1-u02", "rev": 1, "stage": "word", "text": "vorrei", "translation": "I would like" },
        { "id": "it-a1-bar-1-u03", "rev": 1, "stage": "phrase", "text": "un caffè", "translation": "a coffee" },
        { "id": "it-a1-bar-1-u04", "rev": 1, "stage": "phrase", "text": "per favore", "translation": "please" },
        { "id": "it-a1-bar-1-u05", "rev": 1, "stage": "chunk", "text": "vorrei un caffè", "translation": "I'd like a coffee" },
        { "id": "it-a1-bar-1-u06", "rev": 1, "stage": "sentence", "text": "Vorrei un caffè, per favore.", "translation": "I'd like a coffee, please." },
        { "id": "it-a1-bar-1-u07", "rev": 1, "stage": "phrase", "text": "un cornetto", "translation": "a croissant" },
        { "id": "it-a1-bar-1-u08", "rev": 1, "stage": "sentence", "text": "Vorrei un caffè e un cornetto.", "translation": "I'd like a coffee and a croissant." },
        { "id": "it-a1-bar-1-u09", "rev": 1, "stage": "phrase", "text": "un'acqua frizzante", "translation": "a sparkling water" },
        { "id": "it-a1-bar-1-u10", "rev": 1, "stage": "sentence", "text": "Per me, un'acqua frizzante, grazie.", "translation": "For me, a sparkling water, thanks." }
      ]
    },
    {
      "id": "it-a1-bar-2",
      "title": "Quanto costa?",
      "grammarFocus": ["definite articles il / la", "posso + infinitive", "object pronoun lo"],
      "units": [
        { "id": "it-a1-bar-2-u01", "rev": 1, "stage": "word", "text": "quanto", "translation": "how much" },
        { "id": "it-a1-bar-2-u02", "rev": 1, "stage": "sentence", "text": "Quanto costa?", "translation": "How much is it?" },
        { "id": "it-a1-bar-2-u03", "rev": 1, "stage": "phrase", "text": "due euro", "translation": "two euros", "variants": ["2 euro"] },
        { "id": "it-a1-bar-2-u04", "rev": 1, "stage": "sentence", "text": "Costa due euro.", "translation": "It costs two euros.", "variants": ["Costa 2 euro."] },
        { "id": "it-a1-bar-2-u05", "rev": 1, "stage": "phrase", "text": "il conto", "translation": "the bill" },
        { "id": "it-a1-bar-2-u06", "rev": 1, "stage": "sentence", "text": "Il conto, per favore.", "translation": "The bill, please." },
        { "id": "it-a1-bar-2-u07", "rev": 1, "stage": "chunk", "text": "posso pagare", "translation": "can I pay" },
        { "id": "it-a1-bar-2-u08", "rev": 1, "stage": "sentence", "text": "Posso pagare con la carta?", "translation": "Can I pay by card?" },
        { "id": "it-a1-bar-2-u09", "rev": 1, "stage": "sentence", "text": "Lo prendo, grazie.", "translation": "I'll take it, thanks.", "senses": { "0": "pron" } }
      ]
