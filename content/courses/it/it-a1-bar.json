  "lessons": [
    {
      "id": "it-a1-bar-1",
      "title": "Un caffè, per favore",
      "grammarFocus": ["un + masculine noun", "vorrei + noun"],
      "units": [
        { "id": "it-a1-bar-1-u01", "rev": 1, "stage": "word", "text": "caffè", "translation": "coffee", "distractors": ["tea", "milk"] },
        { "id": "it-a1-bar-1-u02", "rev": 1, "stage": "word", "text": "buongiorno", "translation": "good morning", "distractors": ["good evening", "goodbye"] },
        { "id": "it-a1-bar-1-u03", "rev": 1, "stage": "phrase", "text": "un caffè", "translation": "a coffee", "distractors": ["two coffees", "a tea"] },
        { "id": "it-a1-bar-1-u04", "rev": 1, "stage": "phrase", "text": "per favore", "translation": "please", "distractors": ["thank you", "excuse me"] },
        { "id": "it-a1-bar-1-u05", "rev": 1, "stage": "sentence", "text": "Un caffè, per favore.", "translation": "A coffee, please.", "distractors": ["Two coffees, please.", "A coffee, thank you."] },
        { "id": "it-a1-bar-1-u06", "rev": 1, "stage": "word", "text": "vorrei", "translation": "I would like", "distractors": ["I would pay", "I can have"] },
        { "id": "it-a1-bar-1-u07", "rev": 1, "stage": "chunk", "text": "vorrei un caffè", "translation": "I would like a coffee", "distractors": ["I would pay for a coffee", "I would like a tea"] },
        { "id": "it-a1-bar-1-u08", "rev": 1, "stage": "sentence", "text": "Buongiorno, vorrei un caffè.", "translation": "Good morning, I'd like a coffee.", "distractors": ["Good morning, I'd like two coffees.", "Goodbye, I'd like a coffee."] },
        { "id": "it-a1-bar-1-u09", "rev": 1, "stage": "word", "text": "cappuccino", "translation": "cappuccino", "distractors": ["espresso", "hot chocolate"] },
        { "id": "it-a1-bar-1-u10", "rev": 1, "stage": "word", "text": "grazie", "translation": "thank you", "distractors": ["please", "you're welcome"] },
        { "id": "it-a1-bar-1-u11", "rev": 1, "stage": "sentence", "text": "Un cappuccino, grazie.", "translation": "A cappuccino, thanks.", "distractors": ["A cappuccino, please.", "Two cappuccinos, thanks."] },
        { "id": "it-a1-bar-1-u12", "rev": 1, "stage": "word", "text": "ciao", "translation": "hi", "distractors": ["thanks", "please"] },
        { "id": "it-a1-bar-1-u13", "rev": 1, "stage": "sentence", "text": "Ciao, vorrei un cappuccino.", "translation": "Hi, I'd like a cappuccino.", "distractors": ["Hi, I'd like a coffee.", "Thanks, I'd like a cappuccino."] },
        { "id": "it-a1-bar-1-u14", "rev": 1, "stage": "phrase", "text": "anche per me", "translation": "for me too", "distractors": ["only for me", "not for me"] },
        { "id": "it-a1-bar-1-u15", "rev": 1, "stage": "sentence", "text": "Un caffè anche per me.", "translation": "A coffee for me too.", "distractors": ["A cappuccino for me too.", "Just a coffee for me."], "commas": [1] },
        { "id": "it-a1-bar-1-u16", "rev": 1, "stage": "sentence", "text": "Buongiorno, un cappuccino e un caffè, per favore.", "translation": "Good morning, a cappuccino and a coffee, please.", "distractors": ["Good morning, a cappuccino or a coffee, please.", "Good morning, two cappuccinos and a coffee, please."] }
      ]
    },
    {
      "id": "it-a1-bar-2",
      "title": "Un cornetto",
      "grammarFocus": ["prendo + noun", "o in questions", "object lo before the verb"],
      "units": [
        { "id": "it-a1-bar-2-u01", "rev": 1, "stage": "word", "text": "cornetto", "translation": "croissant", "distractors": ["sandwich", "cake"] },
        { "id": "it-a1-bar-2-u02", "rev": 1, "stage": "word", "text": "prendo", "translation": "I'll have", "distractors": ["I'll pay", "I'd like"] },
        { "id": "it-a1-bar-2-u03", "rev": 1, "stage": "chunk", "text": "prendo un cornetto", "translation": "I'll have a croissant", "distractors": ["I'll have two croissants", "I'll pay for a croissant"] },
        { "id": "it-a1-bar-2-u04", "rev": 1, "stage": "sentence", "text": "Prendo un caffè e un cornetto.", "translation": "I'll have a coffee and a croissant.", "distractors": ["I'll have a tea and a croissant.", "I'll have a coffee or a croissant."] },
        { "id": "it-a1-bar-2-u05", "rev": 1, "stage": "word", "text": "panino", "translation": "sandwich", "distractors": ["croissant", "pizza"] },
        { "id": "it-a1-bar-2-u06", "rev": 1, "stage": "word", "text": "anche", "translation": "also", "distractors": ["only", "or"] },
        { "id": "it-a1-bar-2-u07", "rev": 1, "stage": "sentence", "text": "Prendo anche un panino.", "translation": "I'll also have a sandwich.", "distractors": ["I'll only have a sandwich.", "I'll also have a croissant."] },
        { "id": "it-a1-bar-2-u08", "rev": 1, "stage": "phrase", "text": "caffè o cappuccino", "translation": "coffee or cappuccino", "distractors": ["coffee and cappuccino", "tea or cappuccino"] },
        { "id": "it-a1-bar-2-u09", "rev": 1, "stage": "sentence", "text": "Un caffè o un cappuccino?", "translation": "A coffee or a cappuccino?", "distractors": ["A coffee and a cappuccino?", "A tea or a cappuccino?"] },
        { "id": "it-a1-bar-2-u10", "rev": 1, "stage": "word", "text": "sì", "translation": "yes", "distractors": ["no", "please"] },
        { "id": "it-a1-bar-2-u11", "rev": 1, "stage": "sentence", "text": "Sì, un cornetto, grazie.", "translation": "Yes, a croissant, thanks.", "distractors": ["No, a croissant, thanks.", "Yes, a sandwich, thanks."] },
        { "id": "it-a1-bar-2-u12", "rev": 1, "stage": "phrase", "text": "il panino", "translation": "the sandwich", "distractors": ["a sandwich", "the croissant"] },
        { "id": "it-a1-bar-2-u13", "rev": 1, "stage": "chunk", "text": "lo prendo", "translation": "I'll take it", "distractors": ["I'll pay for it", "I'll leave it"], "senses": {"0": "pron"} },
        { "id": "it-a1-bar-2-u14", "rev": 1, "stage": "sentence", "text": "Sì, lo prendo, grazie.", "translation": "Yes, I'll take it, thanks.", "distractors": ["No, I won't take it, thanks.", "Yes, I'll pay for it, thanks."], "senses": {"1": "pron"} },
        { "id": "it-a1-bar-2-u15", "rev": 1, "stage": "word", "text": "no", "translation": "no", "distractors": ["yes", "thanks"] },
        { "id": "it-a1-bar-2-u16", "rev": 1, "stage": "sentence", "text": "No, grazie, il panino no.", "translation": "No thanks, not the sandwich.", "distractors": ["Yes please, the sandwich.", "No thanks, not the croissant."] }
      ]
    },
    {
      "id": "it-a1-bar-3",
      "title": "Da bere",
      "grammarFocus": ["una and un' before feminine nouns", "adjectives after the noun", "di: un bicchiere di vino"],
      "units": [
        { "id": "it-a1-bar-3-u01", "rev": 1, "stage": "word", "text": "acqua", "translation": "water", "distractors": ["milk", "wine"] },
        { "id": "it-a1-bar-3-u02", "rev": 1, "stage": "word", "text": "frizzante", "translation": "sparkling", "distractors": ["still", "cold"] },
        { "id": "it-a1-bar-3-u03", "rev": 1, "stage": "word", "text": "naturale", "translation": "still", "distractors": ["sparkling", "hot"] },
        { "id": "it-a1-bar-3-u04", "rev": 1, "stage": "sentence", "text": "Acqua frizzante o naturale?", "translation": "Sparkling or still water?", "distractors": ["Sparkling or cold water?", "Sparkling and still water?"] },
        { "id": "it-a1-bar-3-u05", "rev": 1, "stage": "phrase", "text": "un'acqua naturale", "translation": "a still water", "distractors": ["a sparkling water", "a bottle of water"] },
        { "id": "it-a1-bar-3-u06", "rev": 1, "stage": "sentence", "text": "Per me un'acqua naturale.", "translation": "For me, a still water.", "distractors": ["For me, a sparkling water.", "For me too, a still water."], "commas": [1] },
        { "id": "it-a1-bar-3-u07", "rev": 1, "stage": "word", "text": "vino", "translation": "wine", "distractors": ["beer", "water"] },
        { "id": "it-a1-bar-3-u08", "rev": 1, "stage": "phrase", "text": "vino rosso", "translation": "red wine", "distractors": ["white wine", "red beer"] },
        { "id": "it-a1-bar-3-u09", "rev": 1, "stage": "phrase", "text": "un bicchiere di vino", "translation": "a glass of wine", "distractors": ["a bottle of wine", "a glass of water"] },
        { "id": "it-a1-bar-3-u10", "rev": 1, "stage": "sentence", "text": "Vorrei un bicchiere di vino bianco.", "translation": "I'd like a glass of white wine.", "distractors": ["I'd like a glass of red wine.", "I'd like a bottle of white wine."] },
        { "id": "it-a1-bar-3-u11", "rev": 1, "stage": "word", "text": "birra", "translation": "beer", "distractors": ["wine", "juice"] },
        { "id": "it-a1-bar-3-u12", "rev": 1, "stage": "phrase", "text": "una bottiglia d'acqua", "translation": "a bottle of water", "distractors": ["a glass of water", "a bottle of wine"] },
        { "id": "it-a1-bar-3-u13", "rev": 1, "stage": "sentence", "text": "Una birra e una bottiglia d'acqua, per favore.", "translation": "A beer and a bottle of water, please.", "distractors": ["A beer and a glass of water, please.", "A wine and a bottle of water, please."] },
        { "id": "it-a1-bar-3-u14", "rev": 1, "stage": "word", "text": "succo", "translation": "juice", "distractors": ["milk", "tea"] },
        { "id": "it-a1-bar-3-u15", "rev": 1, "stage": "phrase", "text": "un succo d'arancia", "translation": "an orange juice", "distractors": ["an orange", "an apple juice"] },
        { "id": "it-a1-bar-3-u16", "rev": 1, "stage": "sentence", "text": "Un succo d'arancia per me, grazie.", "translation": "An orange juice for me, thanks.", "distractors": ["An orange juice for me too, thanks.", "A glass of water for me, thanks."], "commas": [2] }
      ]
    },
    {
      "id": "it-a1-bar-4",
      "title": "Caldo o freddo?",
      "grammarFocus": ["con: un tè con latte", "ecco + noun"],
      "units": [
        { "id": "it-a1-bar-4-u01", "rev": 1, "stage": "word", "text": "tè", "translation": "tea", "distractors": ["coffee", "juice"] },
        { "id": "it-a1-bar-4-u02", "rev": 1, "stage": "word", "text": "caldo", "translation": "hot", "distractors": ["cold", "sweet"] },
        { "id": "it-a1-bar-4-u03", "rev": 1, "stage": "word", "text": "freddo", "translation": "cold", "distractors": ["hot", "still"] },
        { "id": "it-a1-bar-4-u04", "rev": 1, "stage": "phrase", "text": "un tè freddo", "translation": "an iced tea", "distractors": ["a hot tea", "an iced coffee"] },
        { "id": "it-a1-bar-4-u05", "rev": 1, "stage": "sentence", "text": "Un tè caldo o freddo?", "translation": "A hot tea or an iced tea?", "distractors": ["A hot tea or a hot coffee?", "A hot tea and an iced tea?"] },
        { "id": "it-a1-bar-4-u06", "rev": 1, "stage": "word", "text": "latte", "translation": "milk", "distractors": ["coffee", "water"] },
        { "id": "it-a1-bar-4-u07", "rev": 1, "stage": "phrase", "text": "con latte", "translation": "with milk", "distractors": ["without milk", "with water"] },
        { "id": "it-a1-bar-4-u08", "rev": 1, "stage": "sentence", "text": "Vorrei un tè con latte, per favore.", "translation": "I'd like a tea with milk, please.", "distractors": ["I'd like a coffee with milk, please.", "I'd like a tea without milk, please."] },
        { "id": "it-a1-bar-4-u09", "rev": 1, "stage": "sentence", "text": "Il latte caldo o freddo?", "translation": "Hot or cold milk?", "distractors": ["Hot or cold water?", "Hot milk and cold milk?"] },
        { "id": "it-a1-bar-4-u10", "rev": 1, "stage": "sentence", "text": "Un bicchiere di latte freddo, per favore.", "translation": "A glass of cold milk, please.", "distractors": ["A glass of hot milk, please.", "A bottle of cold milk, please."] },
        { "id": "it-a1-bar-4-u11", "rev": 1, "stage": "word", "text": "ecco", "translation": "here is", "distractors": ["where is", "that is"] },
        { "id": "it-a1-bar-4-u12", "rev": 1, "stage": "phrase", "text": "ecco il tè", "translation": "here's the tea", "distractors": ["where's the tea", "here's the coffee"] },
        { "id": "it-a1-bar-4-u13", "rev": 1, "stage": "word", "text": "prego", "translation": "here you go", "distractors": ["thank you", "excuse me"] },
        { "id": "it-a1-bar-4-u14", "rev": 1, "stage": "sentence", "text": "Prego, ecco il cappuccino.", "translation": "Here you go, here's the cappuccino.", "distractors": ["Thank you, here's the cappuccino.", "Here you go, here's the coffee."] },
        { "id": "it-a1-bar-4-u15", "rev": 1, "stage": "sentence", "text": "Ecco un tè caldo con latte.", "translation": "Here's a hot tea with milk.", "distractors": ["Here's an iced tea with milk.", "Here's a hot coffee with milk."] }
      ]
    },
    {
      "id": "it-a1-bar-5",
      "title": "Quant'è?",
      "grammarFocus": ["quanto costa / quanto costano", "numbers 1-5 with euro", "sono + price"],
      "units": [
        { "id": "it-a1-bar-5-u01", "rev": 1, "stage": "word", "text": "quanto", "translation": "how much", "distractors": ["how many", "where"] },
        { "id": "it-a1-bar-5-u02", "rev": 1, "stage": "chunk", "text": "quanto costa", "translation": "how much does it cost", "distractors": ["how many are there", "how much is left"] },
        { "id": "it-a1-bar-5-u03", "rev": 1, "stage": "sentence", "text": "Quanto costa un cornetto?", "translation": "How much is a croissant?", "distractors": ["How much is a sandwich?", "How much are two croissants?"] },
        { "id": "it-a1-bar-5-u04", "rev": 1, "stage": "phrase", "text": "un euro", "translation": "one euro", "distractors": ["two euros", "one dollar"], "variants": ["1 euro"] },
