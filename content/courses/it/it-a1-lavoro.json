        { "id": "it-a1-lavoro-4-u02", "rev": 1, "stage": "chunk", "text": "che lingue parli", "translation": "what languages do you speak", "distractors": ["what languages do you teach", "what languages does he speak"] },
        { "id": "it-a1-lavoro-4-u03", "rev": 1, "stage": "sentence", "text": "Che lingue parli?", "translation": "What languages do you speak?", "distractors": ["What languages do you teach?", "What languages does he speak?"] },
        { "id": "it-a1-lavoro-4-u04", "rev": 1, "stage": "phrase", "text": "un po' di inglese", "translation": "a little English", "distractors": ["a lot of English", "a little Spanish"] },
        { "id": "it-a1-lavoro-4-u05", "rev": 1, "stage": "sentence", "text": "Parlo italiano e un po' di inglese.", "translation": "I speak Italian and a little English.", "distractors": ["I speak Italian and a lot of English.", "I speak Italian and a little Spanish."] },
        { "id": "it-a1-lavoro-4-u06", "rev": 1, "stage": "word", "text": "cinese", "translation": "Chinese", "distractors": ["Japanese", "Russian"] },
