    {
      "id": "it-a1-lavoro-5",
      "title": "Un lavoro nuovo",
      "grammarFocus": ["adjective after the noun: un lavoro nuovo", "da + time: lavoro qui da un anno", "non... più"],
      "units": [
        { "id": "it-a1-lavoro-5-u01", "rev": 1, "stage": "word", "text": "nuovo", "translation": "new", "distractors": ["old", "good"] },
        { "id": "it-a1-lavoro-5-u02", "rev": 1, "stage": "phrase", "text": "un lavoro nuovo", "translation": "a new job", "distractors": ["an old job", "a new house"] },
        { "id": "it-a1-lavoro-5-u03", "rev": 1, "stage": "sentence", "text": "Ho un lavoro nuovo!", "translation": "I have a new job!", "distractors": ["I have a new house!", "I don't have a new job!"] },
        { "id": "it-a1-lavoro-5-u04", "rev": 1, "stage": "sentence", "text": "Sei contenta del lavoro nuovo?", "translation": "Are you happy with the new job?", "distractors": ["Are you happy with the new house?", "Is she happy with the new job?"] },
        { "id": "it-a1-lavoro-5-u05", "rev": 1, "stage": "word", "text": "interessante", "translation": "interesting", "distractors": ["boring", "difficult"] },
        { "id": "it-a1-lavoro-5-u06", "rev": 1, "stage": "sentence", "text": "Sì, è molto interessante.", "translation": "Yes, it's very interesting.", "distractors": ["No, it's not very interesting.", "Yes, it's very boring."] },
        { "id": "it-a1-lavoro-5-u07", "rev": 1, "stage": "word", "text": "architetto", "translation": "architect", "distractors": ["engineer", "lawyer"] },
        { "id": "it-a1-lavoro-5-u08", "rev": 1, "stage": "chunk", "text": "lavoro qui da un anno", "translation": "I've been working here for a year", "distractors": ["I worked here a year ago", "I've been living here for a year"], "variants": ["lavoro qui da 1 anno"], "senses": {"0": "verb"} },
        { "id": "it-a1-lavoro-5-u09", "rev": 1, "stage": "sentence", "text": "Faccio l'architetto e lavoro qui da un anno.", "translation": "I'm an architect and I've been working here for a year.", "distractors": ["I'm an engineer and I've been working here for a year.", "I'm an architect and I've been working here for two years."], "variants": ["Faccio l'architetto e lavoro qui da 1 anno."], "commas": [1], "senses": {"3": "verb"} },
        { "id": "it-a1-lavoro-5-u10", "rev": 1, "stage": "word", "text": "cameriere", "translation": "waiter", "distractors": ["cook", "shop assistant"] },
        { "id": "it-a1-lavoro-5-u11", "rev": 1, "stage": "chunk", "text": "da quanti anni", "translation": "for how many years", "distractors": ["for how many days", "how many years ago"] },
        { "id": "it-a1-lavoro-5-u12", "rev": 1, "stage": "sentence", "text": "Da quanti anni lavori come cameriere?", "translation": "How many years have you worked as a waiter?", "distractors": ["How many days have you worked as a waiter?", "How many years have you worked as a cook?"] },
        { "id": "it-a1-lavoro-5-u13", "rev": 1, "stage": "sentence", "text": "Il mio lavoro al bar è un po' noioso.", "translation": "My job at the bar is a bit boring.", "distractors": ["My job at the bar is very boring.", "My job at the shop is a bit boring."] },
        { "id": "it-a1-lavoro-5-u14", "rev": 1, "stage": "phrase", "text": "in pensione", "translation": "retired", "distractors": ["at work", "on holiday"] },
        { "id": "it-a1-lavoro-5-u15", "rev": 1, "stage": "sentence", "text": "Mio nonno non lavora più, è in pensione.", "translation": "My grandfather doesn't work anymore, he's retired.", "distractors": ["My grandfather still works, he isn't retired.", "My grandmother doesn't work anymore, she's retired."] }
      ]
    },
    {
      "id": "it-a1-lavoro-6",
      "title": "Colleghi",
      "grammarFocus": ["plural nouns in -ghi: colleghi", "lavorare with noi and voi", "days with the article: il sabato"],
      "units": [
        { "id": "it-a1-lavoro-6-u01", "rev": 1, "stage": "word", "text": "collega", "translation": "colleague", "distractors": ["friend", "neighbor"] },
        { "id": "it-a1-lavoro-6-u02", "rev": 1, "stage": "phrase", "text": "i miei colleghi", "translation": "my colleagues", "distractors": ["your colleagues", "my friends"] },
        { "id": "it-a1-lavoro-6-u03", "rev": 1, "stage": "sentence", "text": "I miei colleghi sono molto simpatici.", "translation": "My colleagues are very nice.", "distractors": ["My colleagues aren't very nice.", "My friends are very nice."] },
        { "id": "it-a1-lavoro-6-u04", "rev": 1, "stage": "phrase", "text": "una collega nuova", "translation": "a new colleague", "distractors": ["an old colleague", "a new friend"] },
        { "id": "it-a1-lavoro-6-u05", "rev": 1, "stage": "sentence", "text": "Questa è Giulia, una collega nuova.", "translation": "This is Giulia, a new colleague.", "distractors": ["This is Giulia, an old friend.", "This is Giulia, a new student."] },
        { "id": "it-a1-lavoro-6-u06", "rev": 1, "stage": "word", "text": "cuoco", "translation": "cook", "distractors": ["waiter", "worker"] },
        { "id": "it-a1-lavoro-6-u07", "rev": 1, "stage": "sentence", "text": "Luca fa il cuoco e Paolo il cameriere.", "translation": "Luca is a cook and Paolo is a waiter.", "distractors": ["Luca is a waiter and Paolo is a cook.", "Luca is a cook and Paolo is a doctor."], "commas": [3] },
        { "id": "it-a1-lavoro-6-u08", "rev": 1, "stage": "chunk", "text": "lavoriamo il sabato", "translation": "we work on Saturdays", "distractors": ["we work on Sundays", "we don't work on Saturdays"] },
        { "id": "it-a1-lavoro-6-u09", "rev": 1, "stage": "sentence", "text": "Lavorate anche la domenica?", "translation": "Do you all work on Sundays too?", "distractors": ["Do they work on Sundays too?", "Do you all work on Saturdays too?"] },
        { "id": "it-a1-lavoro-6-u10", "rev": 1, "stage": "sentence", "text": "No, lavoriamo dal lunedì al venerdì.", "translation": "No, we work Monday to Friday.", "distractors": ["No, we work Monday to Thursday.", "Yes, we work Monday to Friday."] },
        { "id": "it-a1-lavoro-6-u11", "rev": 1, "stage": "word", "text": "bravo", "translation": "good", "distractors": ["nice", "new"] },
        { "id": "it-a1-lavoro-6-u12", "rev": 1, "stage": "sentence", "text": "La mia collega è molto brava nel suo lavoro.", "translation": "My colleague is very good at her job.", "distractors": ["My colleague isn't very good at her job.", "My sister is very good at her job."] },
        { "id": "it-a1-lavoro-6-u13", "rev": 1, "stage": "word", "text": "operaio", "translation": "factory worker", "distractors": ["office worker", "engineer"] },
        { "id": "it-a1-lavoro-6-u14", "rev": 1, "stage": "sentence", "text": "In fabbrica gli operai lavorano anche di notte.", "translation": "In the factory the workers also work at night.", "distractors": ["In the factory the workers only work at night.", "In the office the workers also work at night."], "commas": [1] }
      ]
    }
  ]
