        { "id": "it-a1-lavoro-4-u08", "rev": 1, "stage": "sentence", "text": "Il cinese è una lingua difficile.", "translation": "Chinese is a difficult language.", "distractors": ["Chinese is an easy language.", "Russian is a difficult language."] },
        { "id": "it-a1-lavoro-4-u09", "rev": 1, "stage": "word", "text": "imparare", "translation": "to learn", "distractors": ["to teach", "to speak"] },
        { "id": "it-a1-lavoro-4-u10", "rev": 1, "stage": "sentence", "text": "Mio marito impara il russo.", "translation": "My husband is learning Russian.", "distractors": ["My husband is teaching Russian.", "My brother is learning Russian."] },
        { "id": "it-a1-lavoro-4-u11", "rev": 1, "stage": "word", "text": "insegnare", "translation": "to teach", "distractors": ["to learn", "to study"] },
        { "id": "it-a1-lavoro-4-u12", "rev": 1, "stage": "sentence", "text": "Mia madre insegna inglese a scuola.", "translation": "My mother teaches English at school.", "distractors": ["My mother studies English at school.", "My father teaches English at school."] },
        { "id": "it-a1-lavoro-4-u13", "rev": 1, "stage": "word", "text": "facile", "translation": "easy", "distractors": ["difficult", "boring"] },
        { "id": "it-a1-lavoro-4-u14", "rev": 1, "stage": "sentence", "text": "Parlate spagnolo?", "translation": "Do you all speak Spanish?", "distractors": ["Do they speak Spanish?", "Do you all speak French?"] },
        { "id": "it-a1-lavoro-4-u15", "rev": 1, "stage": "sentence", "text": "Sì, ma per noi il tedesco non è facile.", "translation": "Yes, but for us German isn't easy.", "distractors": ["Yes, and for us German is easy.", "Yes, but for them German isn't easy."], "commas": [3] }
      ]
