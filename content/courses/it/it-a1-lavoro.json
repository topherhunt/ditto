    {
      "id": "it-a1-lavoro-1",
      "title": "Che lavoro fai?",
      "grammarFocus": ["fare: faccio, fai, fa", "fare + article + job", "essere + job, no article"],
      "units": [
        { "id": "it-a1-lavoro-1-u01", "rev": 1, "stage": "word", "text": "lavoro", "translation": "job", "distractors": ["house", "school"] },
        { "id": "it-a1-lavoro-1-u02", "rev": 1, "stage": "chunk", "text": "che lavoro fai", "translation": "what do you do for a living", "distractors": ["where do you work", "what do you study"] },
        { "id": "it-a1-lavoro-1-u03", "rev": 1, "stage": "sentence", "text": "Che lavoro fai?", "translation": "What do you do for a living?", "distractors": ["Where do you work?", "What are you studying?"] },
        { "id": "it-a1-lavoro-1-u04", "rev": 1, "stage": "word", "text": "insegnante", "translation": "teacher", "distractors": ["student", "doctor"] },
        { "id": "it-a1-lavoro-1-u05", "rev": 1, "stage": "chunk", "text": "faccio l'insegnante", "translation": "I'm a teacher", "distractors": ["I'm a student", "you're a teacher"] },
        { "id": "it-a1-lavoro-1-u06", "rev": 1, "stage": "sentence", "text": "Faccio l'insegnante a Milano.", "translation": "I'm a teacher in Milan.", "distractors": ["I'm a student in Milan.", "I'm a teacher in Rome."] },
        { "id": "it-a1-lavoro-1-u07", "rev": 1, "stage": "word", "text": "medico", "translation": "doctor", "distractors": ["nurse", "lawyer"] },
        { "id": "it-a1-lavoro-1-u08", "rev": 1, "stage": "sentence", "text": "Mia madre è medico.", "translation": "My mother is a doctor.", "distractors": ["My father is a doctor.", "My mother is a nurse."] },
        { "id": "it-a1-lavoro-1-u09", "rev": 1, "stage": "word", "text": "avvocato", "translation": "lawyer", "distractors": ["engineer", "architect"] },
        { "id": "it-a1-lavoro-1-u10", "rev": 1, "stage": "word", "text": "ingegnere", "translation": "engineer", "distractors": ["lawyer", "worker"] },
        { "id": "it-a1-lavoro-1-u11", "rev": 1, "stage": "sentence", "text": "Lui fa l'avvocato e lei fa l'ingegnere.", "translation": "He's a lawyer and she's an engineer.", "distractors": ["He's an engineer and she's a lawyer.", "He's a lawyer and she's a teacher."], "commas": [2] },
        { "id": "it-a1-lavoro-1-u12", "rev": 1, "stage": "word", "text": "professione", "translation": "profession", "distractors": ["address", "nationality"] },
        { "id": "it-a1-lavoro-1-u13", "rev": 1, "stage": "sentence", "text": "Qual è la sua professione, signora?", "translation": "What's your profession, madam?", "distractors": ["What's your name, madam?", "What's your profession, sir?"] },
        { "id": "it-a1-lavoro-1-u14", "rev": 1, "stage": "phrase", "text": "uno studente", "translation": "a student", "distractors": ["two students", "a teacher"] },
        { "id": "it-a1-lavoro-1-u15", "rev": 1, "stage": "chunk", "text": "non lavoro", "translation": "I don't work", "distractors": ["I don't study", "I work a lot"], "senses": {"1": "verb"} },
        { "id": "it-a1-lavoro-1-u16", "rev": 1, "stage": "sentence", "text": "Sono studente e non lavoro.", "translation": "I'm a student and I don't work.", "distractors": ["I'm a teacher and I don't work.", "I'm a student and I work too."], "commas": [1], "senses": {"4": "verb"} }
      ]
    },
    {
      "id": "it-a1-lavoro-2",
      "title": "Dove lavori?",
      "grammarFocus": ["lavorare in the present", "in ufficio, in ospedale, in fabbrica", "dalle... alle..."],
      "units": [
        { "id": "it-a1-lavoro-2-u01", "rev": 1, "stage": "word", "text": "ospedale", "translation": "hospital", "distractors": ["school", "office"] },
        { "id": "it-a1-lavoro-2-u02", "rev": 1, "stage": "word", "text": "infermiere", "translation": "nurse", "distractors": ["doctor", "waiter"] },
        { "id": "it-a1-lavoro-2-u03", "rev": 1, "stage": "sentence", "text": "Mia sorella fa l'infermiera in ospedale.", "translation": "My sister is a nurse at the hospital.", "distractors": ["My brother is a nurse at the hospital.", "My sister is a doctor at the hospital."] },
        { "id": "it-a1-lavoro-2-u04", "rev": 1, "stage": "chunk", "text": "dove lavori", "translation": "where do you work", "distractors": ["where do you live", "where do you study"] },
        { "id": "it-a1-lavoro-2-u05", "rev": 1, "stage": "sentence", "text": "Dove lavori, Marco?", "translation": "Where do you work, Marco?", "distractors": ["Where do you live, Marco?", "Where does Marco work?"] },
        { "id": "it-a1-lavoro-2-u06", "rev": 1, "stage": "word", "text": "ufficio", "translation": "office", "distractors": ["shop", "factory"] },
        { "id": "it-a1-lavoro-2-u07", "rev": 1, "stage": "phrase", "text": "dalle nove alle cinque", "translation": "from nine to five", "distractors": ["from nine to six", "at nine and at five"], "variants": ["dalle 9 alle 5"] },
        { "id": "it-a1-lavoro-2-u08", "rev": 1, "stage": "sentence", "text": "Lavoro in ufficio dalle nove alle cinque.", "translation": "I work in an office from nine to five.", "distractors": ["I work in an office from nine to six.", "I work at home from nine to five."], "variants": ["Lavoro in ufficio dalle 9 alle 5."], "senses": {"0": "verb"} },
        { "id": "it-a1-lavoro-2-u09", "rev": 1, "stage": "word", "text": "impiegato", "translation": "office worker", "distractors": ["factory worker", "shop assistant"] },
        { "id": "it-a1-lavoro-2-u10", "rev": 1, "stage": "sentence", "text": "Mio padre fa l'impiegato in una grande azienda.", "translation": "My father is an office worker at a big company.", "distractors": ["My father is an office worker at a small company.", "My father is a factory worker at a big company."] },
        { "id": "it-a1-lavoro-2-u11", "rev": 1, "stage": "word", "text": "fabbrica", "translation": "factory", "distractors": ["office", "farm"] },
        { "id": "it-a1-lavoro-2-u12", "rev": 1, "stage": "sentence", "text": "I miei fratelli lavorano in fabbrica.", "translation": "My brothers work in a factory.", "distractors": ["My brothers work in an office.", "My brothers don't work in a factory."] },
        { "id": "it-a1-lavoro-2-u13", "rev": 1, "stage": "word", "text": "commesso", "translation": "shop assistant", "distractors": ["waiter", "cook"] },
        { "id": "it-a1-lavoro-2-u14", "rev": 1, "stage": "phrase", "text": "nel negozio di mio zio", "translation": "in my uncle's shop", "distractors": ["in my aunt's shop", "in my uncle's office"] },
        { "id": "it-a1-lavoro-2-u15", "rev": 1, "stage": "sentence", "text": "Faccio la commessa nel negozio di mio zio.", "translation": "I work as a shop assistant in my uncle's shop.", "distractors": ["I work as a waitress in my uncle's shop.", "I work as a shop assistant in my cousin's shop."] }
      ]
    },
    {
      "id": "it-a1-lavoro-3",
      "title": "Studio l'italiano",
      "grammarFocus": ["studiare in the present", "all'università", "da + time: studio da due anni"],
      "units": [
        { "id": "it-a1-lavoro-3-u01", "rev": 1, "stage": "word", "text": "studiare", "translation": "to study", "distractors": ["to work", "to teach"] },
        { "id": "it-a1-lavoro-3-u02", "rev": 1, "stage": "phrase", "text": "l'italiano", "translation": "Italian", "distractors": ["English", "Spanish"] },
        { "id": "it-a1-lavoro-3-u03", "rev": 1, "stage": "sentence", "text": "Studio l'italiano da due anni.", "translation": "I've been studying Italian for two years.", "distractors": ["I studied Italian two years ago.", "I've been studying Italian for three years."], "variants": ["Studio l'italiano da 2 anni."] },
        { "id": "it-a1-lavoro-3-u04", "rev": 1, "stage": "word", "text": "università", "translation": "university", "distractors": ["school", "library"] },
        { "id": "it-a1-lavoro-3-u05", "rev": 1, "stage": "phrase", "text": "all'università", "translation": "at the university", "distractors": ["at school", "at the office"] },
        { "id": "it-a1-lavoro-3-u06", "rev": 1, "stage": "sentence", "text": "Mia cugina studia all'università di Bologna.", "translation": "My cousin studies at the University of Bologna.", "distractors": ["My cousin teaches at the University of Bologna.", "My cousin studies at the University of Padua."] },
        { "id": "it-a1-lavoro-3-u07", "rev": 1, "stage": "word", "text": "corso", "translation": "course", "distractors": ["lesson", "exam"] },
        { "id": "it-a1-lavoro-3-u08", "rev": 1, "stage": "phrase", "text": "un corso di italiano", "translation": "an Italian course", "distractors": ["a Spanish course", "an Italian lesson"] },
        { "id": "it-a1-lavoro-3-u09", "rev": 1, "stage": "sentence", "text": "Faccio un corso di italiano la sera.", "translation": "I'm taking an Italian course in the evenings.", "distractors": ["I'm taking an Italian course in the mornings.", "I'm teaching an Italian course in the evenings."], "commas": [4] },
        { "id": "it-a1-lavoro-3-u10", "rev": 1, "stage": "word", "text": "lezione", "translation": "lesson", "distractors": ["course", "exam"] },
        { "id": "it-a1-lavoro-3-u11", "rev": 1, "stage": "sentence", "text": "La lezione è alle sei e mezza.", "translation": "The lesson is at half past six.", "distractors": ["The lesson is at half past seven.", "The exam is at half past six."], "variants": ["La lezione è alle 6 e mezza."], "senses": {"4": "num"} },
        { "id": "it-a1-lavoro-3-u12", "rev": 1, "stage": "word", "text": "professore", "translation": "teacher", "distractors": ["student", "doctor"] },
        { "id": "it-a1-lavoro-3-u13", "rev": 1, "stage": "sentence", "text": "Il professore è molto bravo.", "translation": "The teacher is very good.", "distractors": ["The teacher is very nice.", "The student is very good."] },
        { "id": "it-a1-lavoro-3-u14", "rev": 1, "stage": "word", "text": "esame", "translation": "exam", "distractors": ["lesson", "course"] },
        { "id": "it-a1-lavoro-3-u15", "rev": 1, "stage": "chunk", "text": "ho un esame", "translation": "I have an exam", "distractors": ["I have a lesson", "I had an exam"] },
        { "id": "it-a1-lavoro-3-u16", "rev": 1, "stage": "sentence", "text": "Domani ho un esame, studio tutta la sera.", "translation": "I have an exam tomorrow, I'm studying all evening.", "distractors": ["I have an exam today, I'm studying all evening.", "I have a lesson tomorrow, I'm studying all evening."], "commas": [0] }
      ]
    },
