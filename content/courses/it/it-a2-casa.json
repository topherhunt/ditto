        { "id": "it-a2-casa-3-u07", "rev": 1, "stage": "sentence", "text": "Il proprietario affitta l'appartamento a due studenti.", "translation": "The landlord rents the apartment to two students.", "distractors": ["The landlord sells the apartment to two students.", "The landlord rents the apartment to three students."], "variants": ["Il proprietario affitta l'appartamento a 2 studenti."] },
        { "id": "it-a2-casa-3-u08", "rev": 1, "stage": "chunk", "text": "lo pago", "translation": "I pay it", "distractors": ["I pay them", "you pay it"], "senses": { "0": "pron"} },
        { "id": "it-a2-casa-3-u09", "rev": 1, "stage": "sentence", "text": "L'affitto lo pago sempre il primo del mese.", "translation": "I always pay the rent on the first of the month.", "distractors": ["I always pay the rent on the last day of the month.", "I always pay the bills on the first of the month."], "commas": [0], "senses": { "1": "pron"} },
        { "id": "it-a2-casa-3-u10", "rev": 1, "stage": "word", "text": "bolletta", "translation": "bill", "distractors": ["rent", "receipt"] },
