  "lessons": [
    {
      "id": "it-a2-casa-1",
      "title": "Cerco un appartamento",
      "grammarFocus": ["cercare + noun", "l'ho visto / l'ho vista: the participle agrees with lo, la"],
      "units": [
        { "id": "it-a2-casa-1-u01", "rev": 1, "stage": "word", "text": "appartamento", "translation": "apartment", "distractors": ["house", "room"] },
        { "id": "it-a2-casa-1-u02", "rev": 1, "stage": "chunk", "text": "cerco un appartamento", "translation": "I'm looking for an apartment", "distractors": ["I'm renting an apartment", "I'm looking for a room"] },
        { "id": "it-a2-casa-1-u03", "rev": 1, "stage": "sentence", "text": "Cerco un appartamento in centro.", "translation": "I'm looking for an apartment in the center.", "distractors": ["I'm looking for a room in the center.", "I'm renting an apartment in the center."] },
        { "id": "it-a2-casa-1-u04", "rev": 1, "stage": "word", "text": "quartiere", "translation": "neighborhood", "distractors": ["square", "street"] },
        { "id": "it-a2-casa-1-u05", "rev": 1, "stage": "phrase", "text": "una zona tranquilla", "translation": "a quiet area", "distractors": ["a noisy area", "a quiet street"] },
        { "id": "it-a2-casa-1-u06", "rev": 1, "stage": "sentence", "text": "Il quartiere è tranquillo e vicino al centro.", "translation": "The neighborhood is quiet and close to the center.", "distractors": ["The neighborhood is noisy and close to the center.", "The neighborhood is quiet and far from the center."] },
        { "id": "it-a2-casa-1-u07", "rev": 1, "stage": "word", "text": "luminoso", "translation": "bright", "distractors": ["dark", "noisy"] },
        { "id": "it-a2-casa-1-u08", "rev": 1, "stage": "phrase", "text": "un appartamento arredato", "translation": "a furnished apartment", "distractors": ["an empty apartment", "a furnished room"] },
        { "id": "it-a2-casa-1-u09", "rev": 1, "stage": "sentence", "text": "L'appartamento è luminoso e arredato?", "translation": "Is the apartment bright and furnished?", "distractors": ["Is the apartment dark and furnished?", "Is the room bright and furnished?"] },
        { "id": "it-a2-casa-1-u10", "rev": 1, "stage": "chunk", "text": "l'ho visto ieri", "translation": "I saw it yesterday", "distractors": ["I saw it today", "I rented it yesterday"] },
        { "id": "it-a2-casa-1-u11", "rev": 1, "stage": "sentence", "text": "Ho trovato un appartamento, ma non l'ho ancora visto.", "translation": "I found an apartment, but I haven't seen it yet.", "distractors": ["I found an apartment, and I've already seen it.", "I found a room, but I haven't seen it yet."] },
        { "id": "it-a2-casa-1-u12", "rev": 1, "stage": "chunk", "text": "l'ho vista", "translation": "I've seen it", "distractors": ["I haven't seen it", "I've rented it"] },
        { "id": "it-a2-casa-1-u13", "rev": 1, "stage": "sentence", "text": "La casa di via Roma l'ho vista ieri.", "translation": "I saw the house on Via Roma yesterday.", "distractors": ["I saw the house on Via Roma today.", "I rented the house on Via Roma yesterday."], "commas": [4] },
        { "id": "it-a2-casa-1-u14", "rev": 1, "stage": "word", "text": "rumoroso", "translation": "noisy", "distractors": ["quiet", "bright"] },
        { "id": "it-a2-casa-1-u15", "rev": 1, "stage": "sentence", "text": "La zona è bella, ma un po' rumorosa.", "translation": "The area is nice, but a bit noisy.", "distractors": ["The area is nice and very quiet.", "The street is nice, but a bit noisy."] },
        { "id": "it-a2-casa-1-u16", "rev": 1, "stage": "sentence", "text": "Cerchiamo un appartamento con due camere in una zona tranquilla.", "translation": "We're looking for an apartment with two bedrooms in a quiet area.", "distractors": ["We're looking for an apartment with three bedrooms in a quiet area.", "We're looking for a house with two bedrooms in a noisy area."], "variants": ["Cerchiamo un appartamento con 2 camere in una zona tranquilla."] }
      ]
    },
