        { "id": "it-a2-casa-3-u03", "rev": 1, "stage": "phrase", "text": "mille euro al mese", "translation": "a thousand euros a month", "distractors": ["a hundred euros a month", "a thousand euros a week"], "variants": ["1000 euro al mese"] },
        { "id": "it-a2-casa-3-u04", "rev": 1, "stage": "sentence", "text": "L'affitto è di mille euro al mese.", "translation": "The rent is a thousand euros a month.", "distractors": ["The rent is a hundred euros a month.", "The rent is a thousand euros a year."], "variants": ["L'affitto è di 1000 euro al mese."] },
