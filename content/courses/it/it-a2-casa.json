        { "id": "it-a2-casa-2-u12", "rev": 1, "stage": "sentence", "text": "Il soggiorno è luminoso e ha un balcone.", "translation": "The living room is bright and has a balcony.", "distractors": ["The living room is dark and has a balcony.", "The bedroom is bright and has a balcony."] },
        { "id": "it-a2-casa-2-u13", "rev": 1, "stage": "word", "text": "finestra", "translation": "window", "distractors": ["door", "wall"] },
        { "id": "it-a2-casa-2-u14", "rev": 1, "stage": "chunk", "text": "ce ne sono tre", "translation": "there are three", "distractors": ["there are two", "there were three"], "variants": ["ce ne sono 3"] },
        { "id": "it-a2-casa-2-u15", "rev": 1, "stage": "sentence", "text": "Quante finestre ci sono in soggiorno? Ce ne sono tre.", "translation": "How many windows are there in the living room? There are three.", "distractors": ["How many doors are there in the living room? There are three.", "How many windows are there in the bedroom? There are two."], "variants": ["Quante finestre ci sono in soggiorno? Ce ne sono 3."] },
        { "id": "it-a2-casa-2-u16", "rev": 1, "stage": "sentence", "text": "La casa è piccola, ma ha tre stanze e un bel balcone.", "translation": "The house is small, but it has three rooms and a lovely balcony.", "distractors": ["The house is small, but it has two rooms and a lovely balcony.", "The house is small, but it has three rooms and a lovely garden."], "variants": ["La casa è piccola, ma ha 3 stanze e un bel balcone."] }
