        { "id": "it-a2-casa-3-u16", "rev": 1, "stage": "sentence", "text": "Le chiavi? Ne ho due, una è per Lei.", "translation": "The keys? I have two, one is for you.", "distractors": ["The keys? I have three, one is for you.", "The keys? I have two, neither is for you."], "variants": ["Le chiavi? Ne ho 2, una è per Lei."], "senses": { "5": "pron"} }
