        { "id": "it-a2-casa-2-u03", "rev": 1, "stage": "sentence", "text": "Quante stanze ha l'appartamento?", "translation": "How many rooms does the apartment have?", "distractors": ["How many bathrooms does the apartment have?", "How many rooms does the house have?"] },
        { "id": "it-a2-casa-2-u04", "rev": 1, "stage": "word", "text": "soggiorno", "translation": "living room", "distractors": ["bedroom", "balcony"] },
        { "id": "it-a2-casa-2-u05", "rev": 1, "stage": "chunk", "text": "ne ha tre", "translation": "it has three", "distractors": ["it has two", "it had three"], "variants": ["ne ha 3"] },
        { "id": "it-a2-casa-2-u06", "rev": 1, "stage": "sentence", "text": "Ne ha quattro: due camere, la cucina e il soggiorno.", "translation": "It has four: two bedrooms, the kitchen and the living room.", "distractors": ["It has four: two bedrooms, the kitchen and the bathroom.", "It has five: three bedrooms, the kitchen and the living room."], "variants": ["Ne ha 4: 2 camere, la cucina e il soggiorno.", "Ne ha 4: due camere, la cucina e il soggiorno.", "Ne ha quattro: 2 camere, la cucina e il soggiorno."] },
        { "id": "it-a2-casa-2-u07", "rev": 1, "stage": "phrase", "text": "un solo bagno", "translation": "only one bathroom", "distractors": ["only one bedroom", "two bathrooms"] },
        { "id": "it-a2-casa-2-u08", "rev": 1, "stage": "sentence", "text": "C'è un solo bagno?", "translation": "Is there only one bathroom?", "distractors": ["Are there two bathrooms?", "Is there only one bedroom?"] },
        { "id": "it-a2-casa-2-u09", "rev": 1, "stage": "phrase", "text": "due bagni", "translation": "two bathrooms", "distractors": ["two bedrooms", "one bathroom"], "variants": ["2 bagni"] },
        { "id": "it-a2-casa-2-u10", "rev": 1, "stage": "sentence", "text": "No, ci sono due bagni, uno grande e uno piccolo.", "translation": "No, there are two bathrooms, a big one and a small one.", "distractors": ["No, there are two bedrooms, a big one and a small one.", "No, there are three bathrooms, a big one and two small ones."], "variants": ["No, ci sono 2 bagni, uno grande e uno piccolo."] },
