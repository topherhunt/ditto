  "lessons": [
    {
      "id": "it-a1-piacere-1",
      "title": "Ciao!",
      "grammarFocus": ["greetings by time of day", "stare: come stai? / sto bene"],
      "units": [
        { "id": "it-a1-piacere-1-u01", "rev": 1, "stage": "word", "text": "buonasera", "translation": "good evening", "distractors": ["good morning", "good night"] },
        { "id": "it-a1-piacere-1-u02", "rev": 1, "stage": "sentence", "text": "Buonasera, Marco!", "translation": "Good evening, Marco!", "distractors": ["Good morning, Marco!", "Good night, Marco!"] },
        { "id": "it-a1-piacere-1-u03", "rev": 1, "stage": "chunk", "text": "come stai", "translation": "how are you", "distractors": ["where are you", "who are you"] },
        { "id": "it-a1-piacere-1-u04", "rev": 1, "stage": "sentence", "text": "Ciao Anna, come stai?", "translation": "Hi Anna, how are you?", "distractors": ["Hi Anna, where are you?", "Hi Anna, who are you?"], "commas": [0] },
        { "id": "it-a1-piacere-1-u05", "rev": 1, "stage": "chunk", "text": "sto bene", "translation": "I'm fine", "distractors": ["I'm not well", "I'm here"] },
        { "id": "it-a1-piacere-1-u06", "rev": 1, "stage": "phrase", "text": "molto bene", "translation": "very well", "distractors": ["not bad", "very badly"] },
        { "id": "it-a1-piacere-1-u07", "rev": 1, "stage": "sentence", "text": "Sto molto bene, grazie.", "translation": "I'm very well, thanks.", "distractors": ["I'm not very well, thanks.", "I'm quite well, thanks."] },
        { "id": "it-a1-piacere-1-u08", "rev": 1, "stage": "phrase", "text": "e tu", "translation": "and you", "distractors": ["or you", "and me"] },
        { "id": "it-a1-piacere-1-u09", "rev": 1, "stage": "sentence", "text": "Bene, grazie, e tu?", "translation": "Fine, thanks, and you?", "distractors": ["Fine, thanks, and him?", "Not well, thanks, and you?"] },
        { "id": "it-a1-piacere-1-u10", "rev": 1, "stage": "word", "text": "male", "translation": "badly", "distractors": ["well", "slowly"] },
        { "id": "it-a1-piacere-1-u11", "rev": 1, "stage": "phrase", "text": "non male", "translation": "not bad", "distractors": ["not good", "very bad"] },
        { "id": "it-a1-piacere-1-u12", "rev": 1, "stage": "sentence", "text": "Non male, grazie.", "translation": "Not bad, thanks.", "distractors": ["Not well, thanks.", "Very well, thanks."] },
        { "id": "it-a1-piacere-1-u13", "rev": 1, "stage": "phrase", "text": "così così", "translation": "so-so", "distractors": ["very well", "not at all"] },
        { "id": "it-a1-piacere-1-u14", "rev": 1, "stage": "sentence", "text": "Così così, e tu come stai?", "translation": "So-so, and how are you?", "distractors": ["Very well, and how are you?", "So-so, and where are you?"], "commas": [3] },
        { "id": "it-a1-piacere-1-u15", "rev": 1, "stage": "word", "text": "arrivederci", "translation": "goodbye", "distractors": ["good evening", "welcome"] },
        { "id": "it-a1-piacere-1-u16", "rev": 1, "stage": "sentence", "text": "Arrivederci e buonanotte!", "translation": "Goodbye and good night!", "distractors": ["Goodbye and good morning!", "Hello and good evening!"] }
      ]
    },
    {
      "id": "it-a1-piacere-2",
      "title": "Come ti chiami?",
      "grammarFocus": ["chiamarsi: mi chiamo, ti chiami, si chiama", "io, tu, lui, lei"],
      "units": [
        { "id": "it-a1-piacere-2-u01", "rev": 1, "stage": "word", "text": "nome", "translation": "name", "distractors": ["surname", "city"] },
        { "id": "it-a1-piacere-2-u02", "rev": 1, "stage": "chunk", "text": "mi chiamo", "translation": "my name is", "distractors": ["your name is", "his name is"] },
        { "id": "it-a1-piacere-2-u03", "rev": 1, "stage": "sentence", "text": "Ciao, mi chiamo Luca.", "translation": "Hi, my name is Luca.", "distractors": ["Hi, his name is Luca.", "Thanks, my name is Luca."] },
        { "id": "it-a1-piacere-2-u04", "rev": 1, "stage": "chunk", "text": "come ti chiami", "translation": "what's your name", "distractors": ["where do you live", "how are you"] },
        { "id": "it-a1-piacere-2-u05", "rev": 1, "stage": "sentence", "text": "E tu come ti chiami?", "translation": "And what's your name?", "distractors": ["And where do you live?", "And how are you?"], "commas": [1] },
        { "id": "it-a1-piacere-2-u06", "rev": 1, "stage": "word", "text": "piacere", "translation": "nice to meet you", "distractors": ["thank you", "you're welcome"] },
        { "id": "it-a1-piacere-2-u07", "rev": 1, "stage": "sentence", "text": "Piacere, Giulia.", "translation": "Nice to meet you, I'm Giulia.", "distractors": ["Goodbye, I'm Giulia.", "Thank you, I'm Giulia."] },
        { "id": "it-a1-piacere-2-u08", "rev": 1, "stage": "phrase", "text": "molto piacere", "translation": "very nice to meet you", "distractors": ["thank you very much", "very kind of you"] },
        { "id": "it-a1-piacere-2-u09", "rev": 1, "stage": "word", "text": "io", "translation": "I", "distractors": ["you", "he"] },
        { "id": "it-a1-piacere-2-u10", "rev": 1, "stage": "sentence", "text": "Buongiorno, io mi chiamo Sara, e tu?", "translation": "Good morning, my name is Sara, and yours?", "distractors": ["Good morning, her name is Sara, and yours?", "Good morning, my name is Sara, and his?"] },
        { "id": "it-a1-piacere-2-u11", "rev": 1, "stage": "word", "text": "cognome", "translation": "surname", "distractors": ["first name", "nickname"] },
        { "id": "it-a1-piacere-2-u12", "rev": 1, "stage": "phrase", "text": "il cognome", "translation": "the surname", "distractors": ["the first name", "the address"] },
        { "id": "it-a1-piacere-2-u13", "rev": 1, "stage": "sentence", "text": "Il nome è Paolo, il cognome è Rossi.", "translation": "The first name is Paolo, the surname is Rossi.", "distractors": ["The first name is Rossi, the surname is Paolo.", "The first name is Paolo, the surname is Russo."] },
        { "id": "it-a1-piacere-2-u14", "rev": 1, "stage": "chunk", "text": "si chiama", "translation": "his name is", "distractors": ["my name is", "your name is"] },
        { "id": "it-a1-piacere-2-u15", "rev": 1, "stage": "sentence", "text": "Lui si chiama Marco.", "translation": "His name is Marco.", "distractors": ["My name is Marco.", "Your name is Marco."] },
        { "id": "it-a1-piacere-2-u16", "rev": 1, "stage": "sentence", "text": "Lei si chiama Anna, e lui?", "translation": "Her name is Anna, and his?", "distractors": ["My name is Anna, and his?", "Her name is Anna, and yours?"] }
      ]
    },
    {
      "id": "it-a1-piacere-3",
      "title": "Di dove sei?",
      "grammarFocus": ["essere: sono, sei, è", "di + city, a + city", "nationality agreement: italiano, italiana"],
      "units": [
        { "id": "it-a1-piacere-3-u01", "rev": 1, "stage": "word", "text": "dove", "translation": "where", "distractors": ["when", "who"] },
        { "id": "it-a1-piacere-3-u02", "rev": 1, "stage": "chunk", "text": "di dove sei", "translation": "where are you from", "distractors": ["where do you live", "who are you"] },
        { "id": "it-a1-piacere-3-u03", "rev": 1, "stage": "sentence", "text": "Ciao Marta, di dove sei?", "translation": "Hi Marta, where are you from?", "distractors": ["Hi Marta, where do you live?", "Hi Marta, how are you?"], "commas": [0] },
        { "id": "it-a1-piacere-3-u04", "rev": 1, "stage": "phrase", "text": "di Roma", "translation": "from Rome", "distractors": ["in Rome", "to Rome"] },
        { "id": "it-a1-piacere-3-u05", "rev": 1, "stage": "sentence", "text": "Sono di Roma.", "translation": "I'm from Rome.", "distractors": ["I'm in Rome.", "He's from Rome."] },
        { "id": "it-a1-piacere-3-u06", "rev": 1, "stage": "word", "text": "italiano", "translation": "Italian", "distractors": ["English", "Spanish"] },
        { "id": "it-a1-piacere-3-u07", "rev": 1, "stage": "phrase", "text": "sono italiana", "translation": "I'm Italian", "distractors": ["I'm not Italian", "you're Italian"] },
        { "id": "it-a1-piacere-3-u08", "rev": 1, "stage": "sentence", "text": "Sei italiano?", "translation": "Are you Italian?", "distractors": ["Are you English?", "Is he Italian?"] },
        { "id": "it-a1-piacere-3-u09", "rev": 1, "stage": "sentence", "text": "No, sono inglese, di Londra.", "translation": "No, I'm English, from London.", "distractors": ["Yes, I'm English, from London.", "No, I'm American, from London."] },
        { "id": "it-a1-piacere-3-u10", "rev": 1, "stage": "word", "text": "abitare", "translation": "to live", "distractors": ["to speak", "to be"] },
        { "id": "it-a1-piacere-3-u11", "rev": 1, "stage": "chunk", "text": "dove abiti", "translation": "where do you live", "distractors": ["where are you from", "where are you going"] },
        { "id": "it-a1-piacere-3-u12", "rev": 1, "stage": "sentence", "text": "Abito a Milano, ma sono di Napoli.", "translation": "I live in Milan, but I'm from Naples.", "distractors": ["I live in Naples, but I'm from Milan.", "I work in Milan, but I'm from Naples."] },
        { "id": "it-a1-piacere-3-u13", "rev": 1, "stage": "word", "text": "città", "translation": "city", "distractors": ["country", "street"] },
        { "id": "it-a1-piacere-3-u14", "rev": 1, "stage": "phrase", "text": "in città", "translation": "in town", "distractors": ["in the country", "near the city"] },
        { "id": "it-a1-piacere-3-u15", "rev": 1, "stage": "sentence", "text": "Non abito in città, abito in un paese.", "translation": "I don't live in the city, I live in a village.", "distractors": ["I don't live in a village, I live in the city.", "I don't work in the city, I work in a village."] },
        { "id": "it-a1-piacere-3-u16", "rev": 1, "stage": "sentence", "text": "Lui è tedesco e lei è francese.", "translation": "He's German and she's French.", "distractors": ["He's French and she's German.", "He's German and she's Spanish."], "commas": [2] }
      ]
    },
    {
      "id": "it-a1-piacere-4",
      "title": "Lei o tu?",
      "grammarFocus": ["formal Lei: come sta?, di dov'è?", "signore, signora"],
      "units": [
        { "id": "it-a1-piacere-4-u01", "rev": 1, "stage": "word", "text": "signora", "translation": "madam", "distractors": ["sir", "miss"] },
        { "id": "it-a1-piacere-4-u02", "rev": 1, "stage": "phrase", "text": "signor Rossi", "translation": "Mr Rossi", "distractors": ["Mrs Rossi", "the Rossi family"] },
        { "id": "it-a1-piacere-4-u03", "rev": 1, "stage": "chunk", "text": "come sta", "translation": "how are you", "distractors": ["where are you", "who are you"] },
        { "id": "it-a1-piacere-4-u04", "rev": 1, "stage": "sentence", "text": "Buongiorno, signor Rossi, come sta?", "translation": "Good morning, Mr Rossi, how are you?", "distractors": ["Good morning, Mr Rossi, where are you?", "Good evening, Mrs Rossi, how are you?"] },
