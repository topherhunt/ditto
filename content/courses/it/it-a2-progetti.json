  "lessons": [
    {
      "id": "it-a2-progetti-1",
      "title": "L'anno prossimo",
      "grammarFocus": ["futuro semplice of regular verbs", "l'anno prossimo, in futuro"],
      "units": [
        { "id": "it-a2-progetti-1-u01", "rev": 1, "stage": "phrase", "text": "l'anno prossimo", "translation": "next year", "distractors": ["last year", "next week"] },
        { "id": "it-a2-progetti-1-u02", "rev": 1, "stage": "word", "text": "studierò", "translation": "I will study", "distractors": ["I studied", "I study"] },
        { "id": "it-a2-progetti-1-u03", "rev": 1, "stage": "sentence", "text": "L'anno prossimo studierò l'italiano a Firenze.", "translation": "Next year I'll study Italian in Florence.", "distractors": ["Last year I studied Italian in Florence.", "Next year I'll teach Italian in Florence."], "commas": [1] },
        { "id": "it-a2-progetti-1-u04", "rev": 1, "stage": "chunk", "text": "dove lavorerai", "translation": "where will you work", "distractors": ["where do you work", "when will you work"] },
        { "id": "it-a2-progetti-1-u05", "rev": 1, "stage": "sentence", "text": "E tu dove lavorerai l'anno prossimo?", "translation": "And where will you work next year?", "distractors": ["And where did you work last year?", "And when will you work next year?"], "commas": [1] },
        { "id": "it-a2-progetti-1-u06", "rev": 1, "stage": "word", "text": "futuro", "translation": "future", "distractors": ["past", "present"] },
        { "id": "it-a2-progetti-1-u07", "rev": 1, "stage": "phrase", "text": "in futuro", "translation": "in the future", "distractors": ["in the past", "in a few years"] },
        { "id": "it-a2-progetti-1-u08", "rev": 1, "stage": "sentence", "text": "In futuro vivremo in campagna.", "translation": "In the future we'll live in the countryside.", "distractors": ["In the past we lived in the countryside.", "In the future we'll live in the city."], "commas": [1] },
        { "id": "it-a2-progetti-1-u09", "rev": 1, "stage": "chunk", "text": "partiremo a giugno", "translation": "we'll leave in June", "distractors": ["we left in June", "we'll arrive in June"] },
        { "id": "it-a2-progetti-1-u10", "rev": 1, "stage": "sentence", "text": "Partiremo a giugno e torneremo a settembre.", "translation": "We'll leave in June and come back in September.", "distractors": ["We'll leave in July and come back in September.", "We left in June and came back in September."] },
        { "id": "it-a2-progetti-1-u11", "rev": 1, "stage": "word", "text": "progetto", "translation": "plan", "distractors": ["dream", "trip"] },
        { "id": "it-a2-progetti-1-u12", "rev": 1, "stage": "chunk", "text": "i tuoi progetti", "translation": "your plans", "distractors": ["our plans", "your dreams"] },
        { "id": "it-a2-progetti-1-u13", "rev": 1, "stage": "sentence", "text": "Quali sono i tuoi progetti per l'anno prossimo?", "translation": "What are your plans for next year?", "distractors": ["What are your plans for next week?", "What are our plans for next year?"] },
        { "id": "it-a2-progetti-1-u14", "rev": 1, "stage": "chunk", "text": "il corso finirà", "translation": "the course will end", "distractors": ["the course ended", "the course will start"] },
        { "id": "it-a2-progetti-1-u15", "rev": 1, "stage": "sentence", "text": "Il mio corso finirà a maggio.", "translation": "My course will end in May.", "distractors": ["My course will start in May.", "My course ended in May."] },
        { "id": "it-a2-progetti-1-u16", "rev": 1, "stage": "sentence", "text": "Dopo cercherò un lavoro a Milano.", "translation": "Afterwards I'll look for a job in Milan.", "distractors": ["Afterwards I'll look for an apartment in Milan.", "Before that, I'll look for a job in Milan."], "commas": [0] }
      ]
    },
    {
      "id": "it-a2-progetti-2",
      "title": "Tra due settimane",
      "grammarFocus": ["irregular futuro: sarò, avrò, andrò, verrò, potrò, dovrò, farò", "tra and fra + time"],
      "units": [
        { "id": "it-a2-progetti-2-u01", "rev": 1, "stage": "phrase", "text": "tra due settimane", "translation": "in two weeks", "distractors": ["two weeks ago", "for two weeks"], "variants": ["tra 2 settimane"] },
        { "id": "it-a2-progetti-2-u02", "rev": 1, "stage": "word", "text": "andrò", "translation": "I'll go", "distractors": ["I went", "I'll come"] },
        { "id": "it-a2-progetti-2-u03", "rev": 1, "stage": "sentence", "text": "Tra due settimane andrò al mare con i miei amici.", "translation": "In two weeks I'll go to the seaside with my friends.", "distractors": ["Two weeks ago I went to the seaside with my friends.", "In two weeks I'll go to the mountains with my friends."], "variants": ["Tra 2 settimane andrò al mare con i miei amici."], "commas": [2] },
        { "id": "it-a2-progetti-2-u04", "rev": 1, "stage": "phrase", "text": "fra un mese", "translation": "in a month", "distractors": ["a month ago", "in a week"] },
        { "id": "it-a2-progetti-2-u05", "rev": 1, "stage": "word", "text": "sarò", "translation": "I'll be", "distractors": ["I was", "I'll have"] },
        { "id": "it-a2-progetti-2-u06", "rev": 1, "stage": "sentence", "text": "Fra un mese sarò a Roma per lavoro.", "translation": "In a month I'll be in Rome for work.", "distractors": ["A month ago I was in Rome for work.", "In a month I'll be in Rome on vacation."], "commas": [2] },
        { "id": "it-a2-progetti-2-u07", "rev": 1, "stage": "chunk", "text": "avrò tempo", "translation": "I'll have time", "distractors": ["I had time", "I won't have time"] },
        { "id": "it-a2-progetti-2-u08", "rev": 1, "stage": "sentence", "text": "Domani non avrò tempo, ma verrò sabato.", "translation": "Tomorrow I won't have time, but I'll come on Saturday.", "distractors": ["Tomorrow I'll have time, and I'll come on Saturday.", "Tomorrow I won't have time, but I'll come on Sunday."], "commas": [0] },
        { "id": "it-a2-progetti-2-u09", "rev": 1, "stage": "chunk", "text": "potrai venire", "translation": "you'll be able to come", "distractors": ["you were able to come", "you'll have to come"] },
        { "id": "it-a2-progetti-2-u10", "rev": 1, "stage": "sentence", "text": "Potrai venire alla festa?", "translation": "Will you be able to come to the party?", "distractors": ["Were you able to come to the party?", "Will you be able to come to the dinner?"] },
        { "id": "it-a2-progetti-2-u11", "rev": 1, "stage": "word", "text": "dovrò", "translation": "I'll have to", "distractors": ["I had to", "I'll want to"] },
        { "id": "it-a2-progetti-2-u12", "rev": 1, "stage": "sentence", "text": "Purtroppo dovrò lavorare fino a tardi.", "translation": "Unfortunately I'll have to work until late.", "distractors": ["Unfortunately I had to work until late.", "Unfortunately I'll have to study until late."], "commas": [0] },
        { "id": "it-a2-progetti-2-u13", "rev": 1, "stage": "chunk", "text": "che cosa farete", "translation": "what will you do", "distractors": ["what did you do", "what will they do"] },
        { "id": "it-a2-progetti-2-u14", "rev": 1, "stage": "sentence", "text": "Che cosa farete quest'estate?", "translation": "What will you do this summer?", "distractors": ["What did you do this summer?", "What will you do this winter?"] },
        { "id": "it-a2-progetti-2-u15", "rev": 1, "stage": "sentence", "text": "Faremo un viaggio in Sicilia e vedremo molte città.", "translation": "We'll take a trip to Sicily and see many cities.", "distractors": ["We took a trip to Sicily and saw many cities.", "We'll take a trip to Sardinia and see many cities."] }
      ]
    },
    {
      "id": "it-a2-progetti-3",
      "title": "Se ho tempo...",
      "grammarFocus": ["se + present", "se + futuro"],
      "units": [
        { "id": "it-a2-progetti-3-u01", "rev": 1, "stage": "word", "text": "se", "translation": "if", "distractors": ["when", "because"] },
        { "id": "it-a2-progetti-3-u02", "rev": 1, "stage": "chunk", "text": "se ho tempo", "translation": "if I have time", "distractors": ["when I have time", "if I had time"] },
        { "id": "it-a2-progetti-3-u03", "rev": 1, "stage": "sentence", "text": "Se ho tempo, ti chiamo stasera.", "translation": "If I have time, I'll call you tonight.", "distractors": ["When I have time, I'll call you tonight.", "If I have time, I'll call you tomorrow."] },
        { "id": "it-a2-progetti-3-u04", "rev": 1, "stage": "chunk", "text": "se piove", "translation": "if it rains", "distractors": ["if it snows", "when it rains"] },
        { "id": "it-a2-progetti-3-u05", "rev": 1, "stage": "sentence", "text": "Se domani piove, restiamo a casa.", "translation": "If it rains tomorrow, we'll stay home.", "distractors": ["If it snows tomorrow, we'll stay home.", "If it rains tomorrow, we'll go out."] },
        { "id": "it-a2-progetti-3-u06", "rev": 1, "stage": "chunk", "text": "se vuoi", "translation": "if you want", "distractors": ["if you can", "if he wants"] },
        { "id": "it-a2-progetti-3-u07", "rev": 1, "stage": "sentence", "text": "Se vuoi, domani ti aiuto con il trasloco.", "translation": "If you want, I'll help you with the move tomorrow.", "distractors": ["If you want, I'll help you with the move today.", "If you want, you'll help me with the move tomorrow."] },
        { "id": "it-a2-progetti-3-u08", "rev": 1, "stage": "word", "text": "possibile", "translation": "possible", "distractors": ["necessary", "impossible"] },
        { "id": "it-a2-progetti-3-u09", "rev": 1, "stage": "phrase", "text": "se è possibile", "translation": "if possible", "distractors": ["if necessary", "if it's impossible"] },
        { "id": "it-a2-progetti-3-u10", "rev": 1, "stage": "sentence", "text": "Se è possibile, vorrei partire presto.", "translation": "If possible, I'd like to leave early.", "distractors": ["If necessary, I'd like to leave early.", "If possible, I'd like to leave late."] },
        { "id": "it-a2-progetti-3-u11", "rev": 1, "stage": "chunk", "text": "se troverò lavoro", "translation": "if I find work", "distractors": ["if I lose my job", "if I find a house"] },
        { "id": "it-a2-progetti-3-u12", "rev": 1, "stage": "sentence", "text": "Se troverò lavoro, resterò in Italia.", "translation": "If I find a job, I'll stay in Italy.", "distractors": ["If I don't find a job, I'll stay in Italy.", "If I find a house, I'll stay in Italy."] },
        { "id": "it-a2-progetti-3-u13", "rev": 1, "stage": "word", "text": "risparmiare", "translation": "to save", "distractors": ["to spend", "to earn"] },
        { "id": "it-a2-progetti-3-u14", "rev": 1, "stage": "sentence", "text": "Se risparmiamo un po', l'anno prossimo compreremo una macchina.", "translation": "If we save a bit, next year we'll buy a car.", "distractors": ["If we spend a bit, next year we'll buy a car.", "If we save a bit, next year we'll buy a house."], "commas": [5] },
        { "id": "it-a2-progetti-3-u15", "rev": 1, "stage": "sentence", "text": "Se farà bel tempo, andremo al mare.", "translation": "If the weather is nice, we'll go to the seaside.", "distractors": ["If the weather is bad, we'll go to the seaside.", "If the weather is nice, we'll go to the mountains."] }
      ]
    },
    {
      "id": "it-a2-progetti-4",
      "title": "Penso di cambiare lavoro",
      "grammarFocus": ["pensare di, sperare di + infinitive", "avere intenzione di"],
      "units": [
        { "id": "it-a2-progetti-4-u01", "rev": 1, "stage": "word", "text": "pensare", "translation": "to think", "distractors": ["to hope", "to decide"] },
        { "id": "it-a2-progetti-4-u02", "rev": 1, "stage": "chunk", "text": "penso di cambiare lavoro", "translation": "I'm thinking of changing jobs", "distractors": ["I've decided to change jobs", "I'm thinking of moving house"] },
        { "id": "it-a2-progetti-4-u03", "rev": 1, "stage": "sentence", "text": "Penso di cambiare lavoro entro la fine dell'anno.", "translation": "I'm thinking of changing jobs by the end of the year.", "distractors": ["I'm thinking of changing jobs at the start of the year.", "I've decided to change jobs by the end of the year."] },
        { "id": "it-a2-progetti-4-u04", "rev": 1, "stage": "word", "text": "sperare", "translation": "to hope", "distractors": ["to think", "to try"] },
        { "id": "it-a2-progetti-4-u05", "rev": 1, "stage": "chunk", "text": "spero di trovare", "translation": "I hope to find", "distractors": ["I'm trying to find", "I hope you find"] },
        { "id": "it-a2-progetti-4-u06", "rev": 1, "stage": "sentence", "text": "Spero di trovare un lavoro più interessante.", "translation": "I hope to find a more interesting job.", "distractors": ["I hope to find a better-paid job.", "I hope to find a more interesting course."] },
        { "id": "it-a2-progetti-4-u07", "rev": 1, "stage": "word", "text": "intenzione", "translation": "intention", "distractors": ["decision", "wish"] },
        { "id": "it-a2-progetti-4-u08", "rev": 1, "stage": "chunk", "text": "ha intenzione di", "translation": "she intends to", "distractors": ["she refuses to", "you intend to"] },
        { "id": "it-a2-progetti-4-u09", "rev": 1, "stage": "sentence", "text": "Marta ha intenzione di trasferirsi all'estero.", "translation": "Marta intends to move abroad.", "distractors": ["Marta intends to travel abroad.", "Marta refuses to move abroad."] },
        { "id": "it-a2-progetti-4-u10", "rev": 1, "stage": "chunk", "text": "pensi di restare", "translation": "are you thinking of staying", "distractors": ["are you thinking of leaving", "is he thinking of staying"] },
        { "id": "it-a2-progetti-4-u11", "rev": 1, "stage": "sentence", "text": "Pensi di restare in Italia o di tornare a casa?", "translation": "Are you thinking of staying in Italy or going back home?", "distractors": ["Are you thinking of staying in Spain or going back home?", "Are you thinking of staying in Italy or moving to Rome?"], "commas": [4] },
        { "id": "it-a2-progetti-4-u12", "rev": 1, "stage": "phrase", "text": "un corso di cucina", "translation": "a cooking course", "distractors": ["a dance course", "a cooking school"] },
        { "id": "it-a2-progetti-4-u13", "rev": 1, "stage": "sentence", "text": "A settembre inizierò un corso di cucina.", "translation": "In September I'll start a cooking course.", "distractors": ["In September I'll finish a cooking course.", "In October I'll start a cooking course."], "commas": [1] },
        { "id": "it-a2-progetti-4-u14", "rev": 1, "stage": "word", "text": "organizzare", "translation": "to organize", "distractors": ["to cancel", "to postpone"] },
        { "id": "it-a2-progetti-4-u15", "rev": 1, "stage": "sentence", "text": "Mia sorella pensa di organizzare una festa per i nostri genitori.", "translation": "My sister is thinking of organizing a party for our parents.", "distractors": ["My sister has decided to organize a party for our parents.", "My brother is thinking of organizing a party for our parents."] }
      ]
    },
    {
      "id": "it-a2-progetti-5",
      "title": "Forse",
      "grammarFocus": ["forse, probabilmente + futuro", "sarà difficile, sarà possibile"],
      "units": [
        { "id": "it-a2-progetti-5-u01", "rev": 1, "stage": "word", "text": "forse", "translation": "maybe", "distractors": ["never", "certainly"] },
        { "id": "it-a2-progetti-5-u02", "rev": 1, "stage": "sentence", "text": "Forse domani pioverà.", "translation": "Maybe it will rain tomorrow.", "distractors": ["Maybe it will snow tomorrow.", "Surely it will rain tomorrow."] },
        { "id": "it-a2-progetti-5-u03", "rev": 1, "stage": "word", "text": "probabilmente", "translation": "probably", "distractors": ["certainly", "rarely"] },
        { "id": "it-a2-progetti-5-u04", "rev": 1, "stage": "sentence", "text": "Probabilmente arriveremo tardi.", "translation": "We'll probably arrive late.", "distractors": ["We'll probably arrive early.", "They'll probably arrive late."] },
        { "id": "it-a2-progetti-5-u05", "rev": 1, "stage": "word", "text": "sicuro", "translation": "sure", "distractors": ["happy", "ready"] },
        { "id": "it-a2-progetti-5-u06", "rev": 1, "stage": "chunk", "text": "sei sicura", "translation": "are you sure", "distractors": ["are you ready", "is she sure"] },
        { "id": "it-a2-progetti-5-u07", "rev": 1, "stage": "sentence", "text": "Sei sicura? Non è troppo tardi?", "translation": "Are you sure? Isn't it too late?", "distractors": ["Are you ready? Isn't it too late?", "Are you sure? Isn't it too early?"] },
        { "id": "it-a2-progetti-5-u08", "rev": 1, "stage": "chunk", "text": "non lo so ancora", "translation": "I don't know yet", "distractors": ["I already know", "we don't know yet"], "senses": { "1": "pron"} },
        { "id": "it-a2-progetti-5-u09", "rev": 1, "stage": "sentence", "text": "Non lo so ancora, forse andrò in vacanza in Grecia.", "translation": "I don't know yet, maybe I'll go on vacation to Greece.", "distractors": ["I already know, I'll go on vacation to Greece.", "I don't know yet, maybe I'll go on vacation to Spain."], "senses": { "1": "pron"} },
        { "id": "it-a2-progetti-5-u10", "rev": 1, "stage": "phrase", "text": "sarà possibile", "translation": "it will be possible", "distractors": ["it was possible", "it will be impossible"] },
        { "id": "it-a2-progetti-5-u11", "rev": 1, "stage": "sentence", "text": "Domani sarà possibile visitare il museo?", "translation": "Will it be possible to visit the museum tomorrow?", "distractors": ["Was it possible to visit the museum yesterday?", "Will it be possible to visit the church tomorrow?"] },
        { "id": "it-a2-progetti-5-u12", "rev": 1, "stage": "word", "text": "importante", "translation": "important", "distractors": ["difficult", "expensive"] },
        { "id": "it-a2-progetti-5-u13", "rev": 1, "stage": "sentence", "text": "Per me è importante finire gli studi.", "translation": "For me it's important to finish my studies.", "distractors": ["For me it's difficult to finish my studies.", "For me it's important to start my studies."], "commas": [1] },
        { "id": "it-a2-progetti-5-u14", "rev": 1, "stage": "chunk", "text": "sarà difficile", "translation": "it will be difficult", "distractors": ["it was difficult", "it will be easy"] },
        { "id": "it-a2-progetti-5-u15", "rev": 1, "stage": "sentence", "text": "Sarà difficile, ma forse ce la farò.", "translation": "It will be difficult, but maybe I'll make it.", "distractors": ["It was difficult, but maybe I made it.", "It will be difficult, but maybe we'll make it."], "senses": { "5": "pron"} }
      ]
    },
    {
      "id": "it-a2-progetti-6",
      "title": "Un grande progetto",
      "grammarFocus": ["futuro in plans: prepareremo, organizzeremo", "entro + time"],
      "units": [
        { "id": "it-a2-progetti-6-u01", "rev": 1, "stage": "word", "text": "mondo", "translation": "world", "distractors": ["country", "sea"] },
        { "id": "it-a2-progetti-6-u02", "rev": 1, "stage": "phrase", "text": "il giro del mondo", "translation": "a trip around the world", "distractors": ["a trip around Europe", "a trip around the city"] },
        { "id": "it-a2-progetti-6-u03", "rev": 1, "stage": "sentence", "text": "Il nostro grande progetto è fare il giro del mondo.", "translation": "Our big plan is to travel around the world.", "distractors": ["Our big plan is to travel around Europe.", "Their big plan is to travel around the world."] },
        { "id": "it-a2-progetti-6-u04", "rev": 1, "stage": "word", "text": "obiettivo", "translation": "goal", "distractors": ["dream", "problem"] },
        { "id": "it-a2-progetti-6-u05", "rev": 1, "stage": "phrase", "text": "entro due anni", "translation": "within two years", "distractors": ["for two years", "two years ago"], "variants": ["entro 2 anni"] },
        { "id": "it-a2-progetti-6-u06", "rev": 1, "stage": "sentence", "text": "Il nostro obiettivo è partire entro due anni.", "translation": "Our goal is to leave within two years.", "distractors": ["Our goal is to leave within three years.", "Our goal is to arrive within two years."], "variants": ["Il nostro obiettivo è partire entro 2 anni."] },
        { "id": "it-a2-progetti-6-u07", "rev": 1, "stage": "chunk", "text": "dobbiamo risparmiare", "translation": "we need to save", "distractors": ["we need to spend", "we wanted to save"] },
        { "id": "it-a2-progetti-6-u08", "rev": 1, "stage": "sentence", "text": "Per questo adesso dobbiamo risparmiare molto.", "translation": "That's why we have to save a lot now.", "distractors": ["That's why we have to spend a lot now.", "That's why we had to save a lot before."], "commas": [1] },
        { "id": "it-a2-progetti-6-u09", "rev": 1, "stage": "word", "text": "preparare", "translation": "to prepare", "distractors": ["to buy", "to postpone"] },
        { "id": "it-a2-progetti-6-u10", "rev": 1, "stage": "chunk", "text": "prepareremo tutto", "translation": "we'll prepare everything", "distractors": ["we prepared everything", "they'll prepare everything"] },
        { "id": "it-a2-progetti-6-u11", "rev": 1, "stage": "sentence", "text": "Prima prepareremo tutto: biglietti, valigie e passaporti.", "translation": "First we'll prepare everything: tickets, suitcases and passports.", "distractors": ["First we'll buy everything: tickets, suitcases and passports.", "Later we'll prepare everything: tickets, suitcases and passports."], "commas": [0] },
        { "id": "it-a2-progetti-6-u12", "rev": 1, "stage": "chunk", "text": "organizzeremo il viaggio", "translation": "we'll organize the trip", "distractors": ["we organized the trip", "we'll cancel the trip"] },
        { "id": "it-a2-progetti-6-u13", "rev": 1, "stage": "sentence", "text": "Organizzeremo il viaggio insieme, paese per paese.", "translation": "We'll organize the trip together, country by country.", "distractors": ["We'll organize the trip alone, country by country.", "We'll organize the trip together, city by city."] },
        { "id": "it-a2-progetti-6-u14", "rev": 1, "stage": "chunk", "text": "speriamo di conoscere", "translation": "we hope to meet", "distractors": ["we decided to meet", "you hope to meet"] },
        { "id": "it-a2-progetti-6-u15", "rev": 1, "stage": "sentence", "text": "Speriamo di conoscere tante persone nuove.", "translation": "We hope to meet lots of new people.", "distractors": ["They hope to meet lots of new people.", "We hope to see lots of new places."] },
        { "id": "it-a2-progetti-6-u16", "rev": 1, "stage": "sentence", "text": "Quando torneremo, racconteremo tutto ai nostri amici.", "translation": "When we come back, we'll tell our friends everything.", "distractors": ["Before we leave, we'll tell our friends everything.", "When we come back, we'll tell our parents everything."] }
      ]
    }
  ]
}
