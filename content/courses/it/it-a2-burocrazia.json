  "lessons": [
    {
      "id": "it-a2-burocrazia-1",
      "title": "All'ufficio postale",
      "grammarFocus": ["spedire + noun", "formal imperative: scriva"],
      "units": [
        { "id": "it-a2-burocrazia-1-u01", "rev": 1, "stage": "word", "text": "posta", "translation": "post office", "distractors": ["bank", "station"] },
        { "id": "it-a2-burocrazia-1-u02", "rev": 1, "stage": "phrase", "text": "l'ufficio postale", "translation": "the post office", "distractors": ["the tax office", "the police station"] },
        { "id": "it-a2-burocrazia-1-u03", "rev": 1, "stage": "sentence", "text": "Scusi, dov'è l'ufficio postale più vicino?", "translation": "Excuse me, where's the nearest post office?", "distractors": ["Excuse me, where's the nearest bank?", "Excuse me, where's the main post office?"] },
        { "id": "it-a2-burocrazia-1-u04", "rev": 1, "stage": "word", "text": "pacco", "translation": "parcel", "distractors": ["letter", "envelope"] },
        { "id": "it-a2-burocrazia-1-u05", "rev": 1, "stage": "chunk", "text": "spedire un pacco", "translation": "send a parcel", "distractors": ["collect a parcel", "send a letter"] },
        { "id": "it-a2-burocrazia-1-u06", "rev": 1, "stage": "sentence", "text": "Vorrei spedire questo pacco in Francia.", "translation": "I'd like to send this parcel to France.", "distractors": ["I'd like to send this letter to France.", "I'd like to send this parcel to Spain."] },
        { "id": "it-a2-burocrazia-1-u07", "rev": 1, "stage": "word", "text": "francobollo", "translation": "stamp", "distractors": ["envelope", "postcard"] },
        { "id": "it-a2-burocrazia-1-u08", "rev": 1, "stage": "sentence", "text": "Mi servono due francobolli per l'estero.", "translation": "I need two stamps for abroad.", "distractors": ["I need three stamps for abroad.", "I need two envelopes for abroad."] },
        { "id": "it-a2-burocrazia-1-u09", "rev": 1, "stage": "phrase", "text": "una raccomandata", "translation": "a registered letter", "distractors": ["a parcel", "an ordinary letter"] },
        { "id": "it-a2-burocrazia-1-u10", "rev": 1, "stage": "sentence", "text": "Devo mandare una raccomandata.", "translation": "I have to send a registered letter.", "distractors": ["I have to collect a registered letter.", "I have to send a parcel."] },
        { "id": "it-a2-burocrazia-1-u11", "rev": 1, "stage": "chunk", "text": "scriva l'indirizzo", "translation": "write the address", "distractors": ["read the address", "write the name"] },
        { "id": "it-a2-burocrazia-1-u12", "rev": 1, "stage": "sentence", "text": "Scriva l'indirizzo sulla busta, per favore.", "translation": "Please write the address on the envelope.", "distractors": ["Please write the name on the envelope.", "Please write the address on the parcel."] },
        { "id": "it-a2-burocrazia-1-u13", "rev": 1, "stage": "word", "text": "sportello", "translation": "counter", "distractors": ["queue", "office"] },
        { "id": "it-a2-burocrazia-1-u14", "rev": 1, "stage": "sentence", "text": "C'è molta fila allo sportello.", "translation": "There's a long queue at the counter.", "distractors": ["There's no queue at the counter.", "There's a long queue at the bank."] },
        { "id": "it-a2-burocrazia-1-u15", "rev": 1, "stage": "sentence", "text": "Ecco la ricevuta della raccomandata.", "translation": "Here's the receipt for the registered letter.", "distractors": ["Here's the receipt for the parcel.", "Here's the address for the registered letter."] }
      ]
    },
    {
      "id": "it-a2-burocrazia-2",
      "title": "In banca",
      "grammarFocus": ["aprire un conto, fare un bonifico", "servire: che documenti servono?"],
      "units": [
        { "id": "it-a2-burocrazia-2-u01", "rev": 1, "stage": "phrase", "text": "un conto corrente", "translation": "a current account", "distractors": ["a savings account", "a credit card"] },
        { "id": "it-a2-burocrazia-2-u02", "rev": 1, "stage": "sentence", "text": "Vorrei aprire un conto corrente.", "translation": "I'd like to open a current account.", "distractors": ["I'd like to close a current account.", "I'd like to open a savings account."] },
        { "id": "it-a2-burocrazia-2-u03", "rev": 1, "stage": "chunk", "text": "che documenti servono", "translation": "what documents are needed", "distractors": ["what documents are missing", "what forms are needed"] },
        { "id": "it-a2-burocrazia-2-u04", "rev": 1, "stage": "sentence", "text": "Che documenti servono per aprire un conto?", "translation": "What documents do I need to open an account?", "distractors": ["What documents do I need to close an account?", "What forms do I need to open an account?"] },
        { "id": "it-a2-burocrazia-2-u05", "rev": 1, "stage": "phrase", "text": "un documento d'identità", "translation": "an ID document", "distractors": ["a driving licence", "a tax document"] },
        { "id": "it-a2-burocrazia-2-u06", "rev": 1, "stage": "sentence", "text": "Per aprire un conto serve un documento d'identità.", "translation": "To open an account you need an ID document.", "distractors": ["To close an account you need an ID document.", "To open an account you need a tax code."], "commas": [3] },
        { "id": "it-a2-burocrazia-2-u07", "rev": 1, "stage": "word", "text": "bonifico", "translation": "bank transfer", "distractors": ["cash withdrawal", "cheque"] },
        { "id": "it-a2-burocrazia-2-u08", "rev": 1, "stage": "chunk", "text": "fare un bonifico", "translation": "make a transfer", "distractors": ["receive a transfer", "make a withdrawal"] },
        { "id": "it-a2-burocrazia-2-u09", "rev": 1, "stage": "sentence", "text": "Devo fare un bonifico all'estero.", "translation": "I need to make a transfer abroad.", "distractors": ["I need to receive a transfer from abroad.", "I need to make a payment abroad."] },
        { "id": "it-a2-burocrazia-2-u10", "rev": 1, "stage": "word", "text": "prelevare", "translation": "to withdraw (money)", "distractors": ["to deposit", "to spend"] },
        { "id": "it-a2-burocrazia-2-u11", "rev": 1, "stage": "word", "text": "bancomat", "translation": "cash machine", "distractors": ["credit card", "bank"] },
        { "id": "it-a2-burocrazia-2-u12", "rev": 1, "stage": "sentence", "text": "Posso prelevare al bancomat qui vicino?", "translation": "Can I withdraw money at the cash machine nearby?", "distractors": ["Can I pay at the cash machine nearby?", "Can I withdraw money at the bank nearby?"] },
        { "id": "it-a2-burocrazia-2-u13", "rev": 1, "stage": "sentence", "text": "Il bancomat non funziona, devo andare allo sportello.", "translation": "The cash machine isn't working, I have to go to the counter.", "distractors": ["The cash machine is working, I don't have to go to the counter.", "The card machine isn't working, I have to go to the bank."] },
        { "id": "it-a2-burocrazia-2-u14", "rev": 1, "stage": "word", "text": "ritirare", "translation": "to collect, to pick up", "distractors": ["to send", "to lose"] },
        { "id": "it-a2-burocrazia-2-u15", "rev": 1, "stage": "sentence", "text": "La nuova carta è pronta, può ritirarla domani.", "translation": "The new card is ready, you can collect it tomorrow.", "distractors": ["The new card is ready, you can collect it today.", "The new card isn't ready, you can collect it tomorrow."] }
      ]
    },
    {
      "id": "it-a2-burocrazia-3",
      "title": "Il modulo",
      "grammarFocus": ["compilare, firmare", "formal imperative: compili, firmi, torni"],
      "units": [
        { "id": "it-a2-burocrazia-3-u01", "rev": 1, "stage": "word", "text": "modulo", "translation": "form", "distractors": ["receipt", "stamp"] },
        { "id": "it-a2-burocrazia-3-u02", "rev": 1, "stage": "chunk", "text": "compilare il modulo", "translation": "fill in the form", "distractors": ["sign the form", "read the form"] },
        { "id": "it-a2-burocrazia-3-u03", "rev": 1, "stage": "sentence", "text": "Compili il modulo e poi torni qui.", "translation": "Fill in the form and then come back here.", "distractors": ["Fill in the form and then wait here.", "Sign the form and then come back here."] },
        { "id": "it-a2-burocrazia-3-u04", "rev": 1, "stage": "word", "text": "firma", "translation": "signature", "distractors": ["name", "date"] },
        { "id": "it-a2-burocrazia-3-u05", "rev": 1, "stage": "chunk", "text": "firmi qui", "translation": "sign here", "distractors": ["write here", "sign there"] },
        { "id": "it-a2-burocrazia-3-u06", "rev": 1, "stage": "phrase", "text": "in basso", "translation": "at the bottom", "distractors": ["at the top", "on the back"] },
        { "id": "it-a2-burocrazia-3-u07", "rev": 1, "stage": "sentence", "text": "Firmi qui in basso, per favore.", "translation": "Please sign here at the bottom.", "distractors": ["Please sign here at the top.", "Please write here at the bottom."] },
        { "id": "it-a2-burocrazia-3-u08", "rev": 1, "stage": "sentence", "text": "Manca ancora la firma.", "translation": "The signature is still missing.", "distractors": ["The date is still missing.", "The signature is no longer missing."] },
        { "id": "it-a2-burocrazia-3-u09", "rev": 1, "stage": "phrase", "text": "i suoi dati", "translation": "your details", "distractors": ["your documents", "his forms"] },
        { "id": "it-a2-burocrazia-3-u10", "rev": 1, "stage": "sentence", "text": "Scriva qui i suoi dati.", "translation": "Write your details here.", "distractors": ["Write your address here.", "Read your details here."] },
        { "id": "it-a2-burocrazia-3-u11", "rev": 1, "stage": "phrase", "text": "data di nascita", "translation": "date of birth", "distractors": ["place of birth", "date of arrival"] },
        { "id": "it-a2-burocrazia-3-u12", "rev": 1, "stage": "sentence", "text": "Scriva nome, cognome e data di nascita.", "translation": "Write your first name, surname and date of birth.", "distractors": ["Write your first name, surname and place of birth.", "Write your first name, surname and address."] },
        { "id": "it-a2-burocrazia-3-u13", "rev": 1, "stage": "word", "text": "fotocopia", "translation": "photocopy", "distractors": ["photo", "form"] },
        { "id": "it-a2-burocrazia-3-u14", "rev": 1, "stage": "sentence", "text": "Serve anche una fotocopia del passaporto.", "translation": "A photocopy of your passport is also needed.", "distractors": ["A photo of your passport is also needed.", "A photocopy of your ID card is also needed."] },
        { "id": "it-a2-burocrazia-3-u15", "rev": 1, "stage": "sentence", "text": "Mi scusi, ho sbagliato, posso avere un altro modulo?", "translation": "Sorry, I made a mistake, can I have another form?", "distractors": ["Sorry, I made a mistake, can I have another pen?", "Sorry, you made a mistake, can I have another form?"] }
      ]
    },
    {
      "id": "it-a2-burocrazia-4",
      "title": "Il permesso di soggiorno",
      "grammarFocus": ["scadere, rinnovare", "entro + time"],
      "units": [
        { "id": "it-a2-burocrazia-4-u01", "rev": 1, "stage": "phrase", "text": "il permesso di soggiorno", "translation": "the residence permit", "distractors": ["the work permit", "the driving licence"] },
        { "id": "it-a2-burocrazia-4-u02", "rev": 1, "stage": "sentence", "text": "Il mio permesso di soggiorno scade a maggio.", "translation": "My residence permit expires in May.", "distractors": ["My residence permit expires in March.", "My passport expires in May."] },
        { "id": "it-a2-burocrazia-4-u03", "rev": 1, "stage": "word", "text": "scadere", "translation": "to expire", "distractors": ["to renew", "to arrive"] },
        { "id": "it-a2-burocrazia-4-u04", "rev": 1, "stage": "word", "text": "rinnovare", "translation": "to renew", "distractors": ["to cancel", "to collect"] },
        { "id": "it-a2-burocrazia-4-u05", "rev": 1, "stage": "chunk", "text": "rinnovare il permesso", "translation": "renew the permit", "distractors": ["request the permit", "lose the permit"] },
        { "id": "it-a2-burocrazia-4-u06", "rev": 1, "stage": "sentence", "text": "Devo rinnovare il permesso entro la fine del mese.", "translation": "I have to renew the permit by the end of the month.", "distractors": ["I have to renew the permit by the end of the year.", "I have to collect the permit by the end of the month."] },
        { "id": "it-a2-burocrazia-4-u07", "rev": 1, "stage": "word", "text": "questura", "translation": "police headquarters", "distractors": ["town hall", "post office"] },
        { "id": "it-a2-burocrazia-4-u08", "rev": 1, "stage": "sentence", "text": "Per il permesso bisogna andare in questura.", "translation": "For the permit you have to go to the police headquarters.", "distractors": ["For the permit you have to go to the town hall.", "For the passport you have to go to the post office."], "commas": [2] },
        { "id": "it-a2-burocrazia-4-u09", "rev": 1, "stage": "word", "text": "richiesta", "translation": "application", "distractors": ["answer", "receipt"] },
        { "id": "it-a2-burocrazia-4-u10", "rev": 1, "stage": "chunk", "text": "fare la richiesta", "translation": "apply", "distractors": ["withdraw the application", "wait for the answer"] },
        { "id": "it-a2-burocrazia-4-u11", "rev": 1, "stage": "sentence", "text": "Ho fatto la richiesta un mese fa.", "translation": "I applied a month ago.", "distractors": ["I applied a year ago.", "I'll apply in a month."] },
        { "id": "it-a2-burocrazia-4-u12", "rev": 1, "stage": "phrase", "text": "un passaporto valido", "translation": "a valid passport", "distractors": ["an expired passport", "a valid permit"] },
        { "id": "it-a2-burocrazia-4-u13", "rev": 1, "stage": "sentence", "text": "Il passaporto deve essere valido.", "translation": "The passport must be valid.", "distractors": ["The passport must be new.", "The permit must be valid."] },
        { "id": "it-a2-burocrazia-4-u14", "rev": 1, "stage": "chunk", "text": "è scaduto", "translation": "it has expired", "distractors": ["it's still valid", "it will expire"] },
        { "id": "it-a2-burocrazia-4-u15", "rev": 1, "stage": "sentence", "text": "Il mio permesso è scaduto, devo rinnovarlo.", "translation": "My permit has expired, I need to renew it.", "distractors": ["My permit has expired, I need to find it.", "My passport has expired, I need to renew it."] },
        { "id": "it-a2-burocrazia-4-u16", "rev": 1, "stage": "sentence", "text": "Quando posso ritirare il nuovo permesso?", "translation": "When can I collect the new permit?", "distractors": ["Where can I collect the new permit?", "When can I renew the old permit?"] }
      ]
    },
    {
      "id": "it-a2-burocrazia-5",
      "title": "Il codice fiscale",
      "grammarFocus": ["il codice fiscale, la tessera sanitaria", "mancare: mi manca"],
      "units": [
        { "id": "it-a2-burocrazia-5-u01", "rev": 1, "stage": "phrase", "text": "il codice fiscale", "translation": "the tax code", "distractors": ["the post code", "the bank code"] },
        { "id": "it-a2-burocrazia-5-u02", "rev": 1, "stage": "sentence", "text": "In Italia serve il codice fiscale per quasi tutto.", "translation": "In Italy you need a tax code for almost everything.", "distractors": ["In Italy you need a tax code for almost nothing.", "In Italy you need a passport for almost everything."], "commas": [1] },
        { "id": "it-a2-burocrazia-5-u03", "rev": 1, "stage": "word", "text": "codice", "translation": "code", "distractors": ["number", "card"] },
        { "id": "it-a2-burocrazia-5-u04", "rev": 1, "stage": "word", "text": "fiscale", "translation": "tax (adjective)", "distractors": ["postal", "legal"] },
        { "id": "it-a2-burocrazia-5-u05", "rev": 1, "stage": "chunk", "text": "chiedere il codice fiscale", "translation": "apply for a tax code", "distractors": ["lose the tax code", "check the tax code"] },
        { "id": "it-a2-burocrazia-5-u06", "rev": 1, "stage": "sentence", "text": "Dove posso chiedere il codice fiscale?", "translation": "Where can I apply for a tax code?", "distractors": ["When can I apply for a tax code?", "Where can I check my tax code?"] },
        { "id": "it-a2-burocrazia-5-u07", "rev": 1, "stage": "word", "text": "tessera", "translation": "card", "distractors": ["receipt", "stamp"] },
        { "id": "it-a2-burocrazia-5-u08", "rev": 1, "stage": "phrase", "text": "la tessera sanitaria", "translation": "the health insurance card", "distractors": ["the ID card", "the bank card"] },
        { "id": "it-a2-burocrazia-5-u09", "rev": 1, "stage": "sentence", "text": "Con la tessera sanitaria può scegliere un medico.", "translation": "With the health insurance card you can choose a doctor.", "distractors": ["With the ID card you can choose a doctor.", "With the health insurance card you can see a dentist."] },
        { "id": "it-a2-burocrazia-5-u10", "rev": 1, "stage": "word", "text": "lettera", "translation": "letter", "distractors": ["parcel", "form"] },
        { "id": "it-a2-burocrazia-5-u11", "rev": 1, "stage": "sentence", "text": "Mi è arrivata una lettera, ma non la capisco.", "translation": "A letter has come for me, but I don't understand it.", "distractors": ["A parcel has come for me, but I don't understand it.", "A letter has come for me, and I understand it."], "senses": {"7": "pron"} },
        { "id": "it-a2-burocrazia-5-u12", "rev": 1, "stage": "chunk", "text": "mi manca un documento", "translation": "I'm missing a document", "distractors": ["I've got one document", "I'm missing a form"] },
        { "id": "it-a2-burocrazia-5-u13", "rev": 1, "stage": "sentence", "text": "Mi manca ancora un documento.", "translation": "I'm still missing a document.", "distractors": ["I'm still missing a photo.", "I'm no longer missing a document."] },
        { "id": "it-a2-burocrazia-5-u14", "rev": 1, "stage": "sentence", "text": "Per il codice fiscale basta il passaporto.", "translation": "For the tax code the passport is enough.", "distractors": ["For the tax code the passport isn't enough.", "For the health card the passport is enough."], "commas": [3] }
      ]
    },
    {
      "id": "it-a2-burocrazia-6",
      "title": "Il comune",
      "grammarFocus": ["certificato, residenza, anagrafe", "review: formal requests"],
      "units": [
        { "id": "it-a2-burocrazia-6-u01", "rev": 1, "stage": "word", "text": "comune", "translation": "town hall", "distractors": ["police station", "post office"] },
        { "id": "it-a2-burocrazia-6-u02", "rev": 1, "stage": "sentence", "text": "Domani devo andare in comune.", "translation": "Tomorrow I have to go to the town hall.", "distractors": ["Today I have to go to the town hall.", "Tomorrow I have to go to the post office."] },
        { "id": "it-a2-burocrazia-6-u03", "rev": 1, "stage": "word", "text": "residenza", "translation": "residence", "distractors": ["citizenship", "nationality"] },
        { "id": "it-a2-burocrazia-6-u04", "rev": 1, "stage": "chunk", "text": "chiedere la residenza", "translation": "apply for residence", "distractors": ["renew my residence", "lose my residence"] },
        { "id": "it-a2-burocrazia-6-u05", "rev": 1, "stage": "sentence", "text": "Mi sono trasferito qui e vorrei chiedere la residenza.", "translation": "I've moved here and I'd like to apply for residence.", "distractors": ["I've moved here and I'd like to renew my residence.", "I've moved away and I'd like to apply for residence."] },
        { "id": "it-a2-burocrazia-6-u06", "rev": 1, "stage": "word", "text": "anagrafe", "translation": "registry office", "distractors": ["tax office", "police station"] },
        { "id": "it-a2-burocrazia-6-u07", "rev": 1, "stage": "sentence", "text": "L'ufficio anagrafe è al primo piano.", "translation": "The registry office is on the first floor.", "distractors": ["The registry office is on the second floor.", "The post office is on the first floor."] },
        { "id": "it-a2-burocrazia-6-u08", "rev": 1, "stage": "word", "text": "certificato", "translation": "certificate", "distractors": ["form", "receipt"] },
        { "id": "it-a2-burocrazia-6-u09", "rev": 1, "stage": "phrase", "text": "un certificato di nascita", "translation": "a birth certificate", "distractors": ["a marriage certificate", "a date of birth"] },
        { "id": "it-a2-burocrazia-6-u10", "rev": 1, "stage": "sentence", "text": "Mi serve un certificato di residenza.", "translation": "I need a residence certificate.", "distractors": ["I need a birth certificate.", "You need a residence certificate."] },
        { "id": "it-a2-burocrazia-6-u11", "rev": 1, "stage": "sentence", "text": "Il certificato di nascita sarà pronto tra tre giorni.", "translation": "The birth certificate will be ready in three days.", "distractors": ["The birth certificate will be ready in two days.", "The residence certificate will be ready in three days."], "variants": ["Il certificato di nascita sarà pronto tra 3 giorni."] },
        { "id": "it-a2-burocrazia-6-u12", "rev": 1, "stage": "chunk", "text": "è chiuso", "translation": "it's closed", "distractors": ["it's open", "it's full"] },
        { "id": "it-a2-burocrazia-6-u13", "rev": 1, "stage": "sentence", "text": "Il comune è chiuso il sabato pomeriggio.", "translation": "The town hall is closed on Saturday afternoons.", "distractors": ["The town hall is closed on Sunday afternoons.", "The town hall is open on Saturday afternoons."] },
        { "id": "it-a2-burocrazia-6-u14", "rev": 1, "stage": "sentence", "text": "Finalmente ho tutti i documenti!", "translation": "Finally I have all the documents!", "distractors": ["Finally I have all the forms!", "I still don't have all the documents!"] }
      ]
    }
  ]
