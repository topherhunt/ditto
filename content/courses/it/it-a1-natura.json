  "lessons": [
    {
      "id": "it-a1-natura-1",
      "title": "In montagna",
      "grammarFocus": ["salire, scendere: saliamo, scendiamo", "fa fresco"],
      "units": [
        { "id": "it-a1-natura-1-u01", "rev": 1, "stage": "word", "text": "sentiero", "translation": "path", "distractors": ["river", "hill"] },
        { "id": "it-a1-natura-1-u02", "rev": 1, "stage": "phrase", "text": "un sentiero stretto", "translation": "a narrow path", "distractors": ["a wide path", "a narrow river"] },
        { "id": "it-a1-natura-1-u03", "rev": 1, "stage": "sentence", "text": "Questo sentiero va fino al lago.", "translation": "This path goes all the way to the lake.", "distractors": ["This path goes all the way to the river.", "This road goes all the way to the lake."] },
        { "id": "it-a1-natura-1-u04", "rev": 1, "stage": "word", "text": "salire", "translation": "to go up", "distractors": ["to go down", "to walk"] },
        { "id": "it-a1-natura-1-u05", "rev": 1, "stage": "phrase", "text": "in cima alla montagna", "translation": "to the top of the mountain", "distractors": ["to the top of the hill", "to the foot of the mountain"] },
        { "id": "it-a1-natura-1-u06", "rev": 1, "stage": "sentence", "text": "Saliamo in cima alla montagna.", "translation": "We're climbing to the top of the mountain.", "distractors": ["We're climbing to the top of the hill.", "We're climbing to the foot of the mountain."] },
        { "id": "it-a1-natura-1-u07", "rev": 1, "stage": "word", "text": "scendere", "translation": "to go down", "distractors": ["to go up", "to stop"] },
        { "id": "it-a1-natura-1-u08", "rev": 1, "stage": "word", "text": "tramonto", "translation": "sunset", "distractors": ["sunrise", "evening"] },
        { "id": "it-a1-natura-1-u09", "rev": 1, "stage": "sentence", "text": "Scendiamo prima del tramonto.", "translation": "We'll go down before sunset.", "distractors": ["We'll go down after sunset.", "We'll go up before sunset."] },
        { "id": "it-a1-natura-1-u10", "rev": 1, "stage": "chunk", "text": "fa fresco", "translation": "it's cool", "distractors": ["it's hot", "it's windy"] },
        { "id": "it-a1-natura-1-u11", "rev": 1, "stage": "sentence", "text": "In montagna fa fresco anche d'estate.", "translation": "In the mountains it's cool even in summer.", "distractors": ["In the mountains it's hot even in summer.", "By the sea it's cool even in summer."], "commas": [1] },
        { "id": "it-a1-natura-1-u12", "rev": 1, "stage": "word", "text": "collina", "translation": "hill", "distractors": ["mountain", "valley"] },
        { "id": "it-a1-natura-1-u13", "rev": 1, "stage": "phrase", "text": "le colline verdi", "translation": "the green hills", "distractors": ["the green mountains", "the brown hills"] },
        { "id": "it-a1-natura-1-u14", "rev": 1, "stage": "sentence", "text": "Dalla cima vediamo le colline e il mare.", "translation": "From the top we can see the hills and the sea.", "distractors": ["From the top we can see the hills and the lake.", "From the top we can see the mountains and the sea."], "commas": [2] },
        { "id": "it-a1-natura-1-u15", "rev": 1, "stage": "sentence", "text": "Che bello qui in montagna!", "translation": "It's so lovely here in the mountains!", "distractors": ["It's so cold here in the mountains!", "It's so lovely here by the lake!"], "commas": [1] }
      ]
    },
    {
      "id": "it-a1-natura-2",
      "title": "Al lago",
      "grammarFocus": ["c'è / ci sono", "si può + infinitive as a chunk"],
      "units": [
        { "id": "it-a1-natura-2-u01", "rev": 1, "stage": "word", "text": "barca", "translation": "boat", "distractors": ["bridge", "beach"] },
        { "id": "it-a1-natura-2-u02", "rev": 1, "stage": "phrase", "text": "in barca", "translation": "by boat", "distractors": ["on foot", "by car"] },
        { "id": "it-a1-natura-2-u03", "rev": 1, "stage": "sentence", "text": "Andiamo in barca sul lago?", "translation": "Shall we take a boat out on the lake?", "distractors": ["Shall we take a boat out on the sea?", "Shall we go for a swim in the lake?"] },
        { "id": "it-a1-natura-2-u04", "rev": 1, "stage": "word", "text": "fiume", "translation": "river", "distractors": ["lake", "sea"] },
        { "id": "it-a1-natura-2-u05", "rev": 1, "stage": "phrase", "text": "lungo il fiume", "translation": "along the river", "distractors": ["across the river", "along the lake"] },
        { "id": "it-a1-natura-2-u06", "rev": 1, "stage": "sentence", "text": "Camminiamo lungo il fiume fino al lago.", "translation": "We walk along the river to the lake.", "distractors": ["We walk along the river to the sea.", "We run along the river to the lake."] },
        { "id": "it-a1-natura-2-u07", "rev": 1, "stage": "chunk", "text": "si può nuotare", "translation": "can you swim", "distractors": ["can you fish", "do you like swimming"] },
        { "id": "it-a1-natura-2-u08", "rev": 1, "stage": "sentence", "text": "Si può nuotare nel lago?", "translation": "Can you swim in the lake?", "distractors": ["Can you fish in the lake?", "Can you swim in the river?"] },
        { "id": "it-a1-natura-2-u09", "rev": 1, "stage": "sentence", "text": "Sì, ma l'acqua è molto fredda.", "translation": "Yes, but the water is very cold.", "distractors": ["Yes, and the water is very warm.", "No, the water is very cold."] },
        { "id": "it-a1-natura-2-u10", "rev": 1, "stage": "phrase", "text": "sulla riva del lago", "translation": "on the shore of the lake", "distractors": ["on the bank of the river", "in the middle of the lake"] },
        { "id": "it-a1-natura-2-u11", "rev": 1, "stage": "sentence", "text": "Mangiamo sulla riva del lago.", "translation": "We're eating on the shore of the lake.", "distractors": ["We're eating on the bank of the river.", "We're sleeping on the shore of the lake."] },
        { "id": "it-a1-natura-2-u12", "rev": 1, "stage": "word", "text": "uccello", "translation": "bird", "distractors": ["fish", "duck"] },
        { "id": "it-a1-natura-2-u13", "rev": 1, "stage": "phrase", "text": "molti uccelli", "translation": "many birds", "distractors": ["many fish", "a few birds"] },
        { "id": "it-a1-natura-2-u14", "rev": 1, "stage": "sentence", "text": "Vicino al lago ci sono molti uccelli.", "translation": "There are many birds near the lake.", "distractors": ["There are many fish near the lake.", "There are many birds near the river."], "commas": [2] },
        { "id": "it-a1-natura-2-u15", "rev": 1, "stage": "word", "text": "silenzio", "translation": "silence", "distractors": ["noise", "wind"] },
        { "id": "it-a1-natura-2-u16", "rev": 1, "stage": "sentence", "text": "Al lago c'è un grande silenzio.", "translation": "It's very quiet at the lake.", "distractors": ["It's very noisy at the lake.", "It's very quiet by the sea."], "commas": [1] }
      ]
    },
    {
      "id": "it-a1-natura-3",
      "title": "Gli animali",
      "grammarFocus": ["plurals: le mucche, le pecore, i lupi", "ci sono + plural"],
      "units": [
        { "id": "it-a1-natura-3-u01", "rev": 1, "stage": "word", "text": "animale", "translation": "animal", "distractors": ["plant", "bird"] },
        { "id": "it-a1-natura-3-u02", "rev": 1, "stage": "phrase", "text": "animali selvatici", "translation": "wild animals", "distractors": ["farm animals", "wild birds"] },
        { "id": "it-a1-natura-3-u03", "rev": 1, "stage": "sentence", "text": "In questo parco ci sono molti animali selvatici.", "translation": "There are many wild animals in this park.", "distractors": ["There are few wild animals in this park.", "There are many wild animals in this forest."], "commas": [2] },
        { "id": "it-a1-natura-3-u04", "rev": 1, "stage": "word", "text": "mucca", "translation": "cow", "distractors": ["sheep", "horse"] },
        { "id": "it-a1-natura-3-u05", "rev": 1, "stage": "word", "text": "pecora", "translation": "sheep", "distractors": ["cow", "goat"] },
        { "id": "it-a1-natura-3-u06", "rev": 1, "stage": "phrase", "text": "mucche e pecore", "translation": "cows and sheep", "distractors": ["cows and horses", "goats and sheep"] },
        { "id": "it-a1-natura-3-u07", "rev": 1, "stage": "sentence", "text": "Nei prati ci sono mucche e pecore.", "translation": "There are cows and sheep in the meadows.", "distractors": ["There are cows and horses in the meadows.", "There are cows and sheep in the woods."], "commas": [1] },
        { "id": "it-a1-natura-3-u08", "rev": 1, "stage": "sentence", "text": "Le mucche mangiano l'erba nel prato.", "translation": "The cows are eating grass in the meadow.", "distractors": ["The sheep are eating grass in the meadow.", "The cows are eating grass in the barn."] },
        { "id": "it-a1-natura-3-u09", "rev": 1, "stage": "word", "text": "cavallo", "translation": "horse", "distractors": ["cow", "dog"] },
        { "id": "it-a1-natura-3-u10", "rev": 1, "stage": "chunk", "text": "andare a cavallo", "translation": "to ride a horse", "distractors": ["to feed a horse", "to go by car"] },
        { "id": "it-a1-natura-3-u11", "rev": 1, "stage": "sentence", "text": "Mia figlia va a cavallo ogni sabato.", "translation": "My daughter goes horseback riding every Saturday.", "distractors": ["My son goes horseback riding every Saturday.", "My daughter goes horseback riding every Sunday."] },
        { "id": "it-a1-natura-3-u12", "rev": 1, "stage": "phrase", "text": "lupi e orsi", "translation": "wolves and bears", "distractors": ["wolves and foxes", "dogs and bears"] },
        { "id": "it-a1-natura-3-u13", "rev": 1, "stage": "sentence", "text": "In questi boschi vivono lupi e orsi.", "translation": "Wolves and bears live in these woods.", "distractors": ["Wolves and foxes live in these woods.", "Wolves and bears live in these mountains."] },
        { "id": "it-a1-natura-3-u14", "rev": 1, "stage": "sentence", "text": "Hai paura dei lupi?", "translation": "Are you afraid of wolves?", "distractors": ["Are you afraid of bears?", "Do you like wolves?"] },
        { "id": "it-a1-natura-3-u15", "rev": 1, "stage": "sentence", "text": "C'è un uccello sull'albero.", "translation": "There's a bird in the tree.", "distractors": ["There's a cat in the tree.", "There's a bird on the roof."] }
      ]
    },
    {
      "id": "it-a1-natura-4",
      "title": "Il bosco",
      "grammarFocus": ["color agreement: le foglie gialle", "seasons: in autunno, in primavera"],
      "units": [
        { "id": "it-a1-natura-4-u01", "rev": 1, "stage": "word", "text": "bosco", "translation": "woods", "distractors": ["meadow", "park"] },
        { "id": "it-a1-natura-4-u02", "rev": 1, "stage": "phrase", "text": "nel bosco", "translation": "in the woods", "distractors": ["in the meadow", "near the woods"] },
        { "id": "it-a1-natura-4-u03", "rev": 1, "stage": "sentence", "text": "Facciamo una passeggiata nel bosco?", "translation": "Shall we go for a walk in the woods?", "distractors": ["Shall we go for a walk in the park?", "Shall we go for a run in the woods?"] },
        { "id": "it-a1-natura-4-u04", "rev": 1, "stage": "word", "text": "albero", "translation": "tree", "distractors": ["bush", "leaf"] },
        { "id": "it-a1-natura-4-u05", "rev": 1, "stage": "phrase", "text": "alberi alti", "translation": "tall trees", "distractors": ["short trees", "tall houses"] },
        { "id": "it-a1-natura-4-u06", "rev": 1, "stage": "sentence", "text": "Nel bosco ci sono alberi molto alti.", "translation": "There are very tall trees in the woods.", "distractors": ["There are very old trees in the woods.", "There are very tall trees in the park."], "commas": [1] },
        { "id": "it-a1-natura-4-u07", "rev": 1, "stage": "word", "text": "foglia", "translation": "leaf", "distractors": ["tree", "flower"] },
        { "id": "it-a1-natura-4-u08", "rev": 1, "stage": "phrase", "text": "le foglie gialle", "translation": "the yellow leaves", "distractors": ["the green leaves", "the yellow flowers"] },
        { "id": "it-a1-natura-4-u09", "rev": 1, "stage": "sentence", "text": "In autunno le foglie diventano gialle e rosse.", "translation": "In autumn the leaves turn yellow and red.", "distractors": ["In spring the leaves turn yellow and red.", "In autumn the leaves turn yellow and brown."], "commas": [1] },
        { "id": "it-a1-natura-4-u10", "rev": 1, "stage": "word", "text": "fiore", "translation": "flower", "distractors": ["leaf", "tree"] },
        { "id": "it-a1-natura-4-u11", "rev": 1, "stage": "phrase", "text": "fiori di tutti i colori", "translation": "flowers of every color", "distractors": ["leaves of every color", "flowers of one color"] },
        { "id": "it-a1-natura-4-u12", "rev": 1, "stage": "sentence", "text": "In primavera il prato è pieno di fiori.", "translation": "In spring the meadow is full of flowers.", "distractors": ["In summer the meadow is full of flowers.", "In spring the garden is full of flowers."], "commas": [1] },
        { "id": "it-a1-natura-4-u13", "rev": 1, "stage": "word", "text": "fungo", "translation": "mushroom", "distractors": ["berry", "flower"] },
        { "id": "it-a1-natura-4-u14", "rev": 1, "stage": "chunk", "text": "cercare funghi", "translation": "to look for mushrooms", "distractors": ["to pick flowers", "to eat mushrooms"] },
        { "id": "it-a1-natura-4-u15", "rev": 1, "stage": "sentence", "text": "In ottobre mio nonno cerca funghi nel bosco.", "translation": "In October my grandfather looks for mushrooms in the woods.", "distractors": ["In November my grandfather looks for mushrooms in the woods.", "In October my father looks for mushrooms in the woods."], "commas": [1] },
        { "id": "it-a1-natura-4-u16", "rev": 1, "stage": "sentence", "text": "Nel bosco l'aria è fresca e pulita.", "translation": "In the woods the air is cool and clean.", "distractors": ["In the city the air is cool and clean.", "In the woods the air is cold and damp."], "commas": [1] }
      ]
    },
    {
      "id": "it-a1-natura-5",
      "title": "Una gita",
      "grammarFocus": ["dobbiamo + infinitive", "partire, arrivare with times"],
      "units": [
        { "id": "it-a1-natura-5-u01", "rev": 1, "stage": "word", "text": "gita", "translation": "day trip", "distractors": ["holiday", "walk"] },
        { "id": "it-a1-natura-5-u02", "rev": 1, "stage": "phrase", "text": "una gita in campagna", "translation": "a trip to the countryside", "distractors": ["a trip to the mountains", "a walk in the countryside"] },
        { "id": "it-a1-natura-5-u03", "rev": 1, "stage": "sentence", "text": "Domenica facciamo una gita in campagna.", "translation": "On Sunday we're taking a trip to the countryside.", "distractors": ["On Saturday we're taking a trip to the countryside.", "On Sunday we're taking a trip to the seaside."], "commas": [0] },
        { "id": "it-a1-natura-5-u04", "rev": 1, "stage": "word", "text": "zaino", "translation": "backpack", "distractors": ["suitcase", "tent"] },
        { "id": "it-a1-natura-5-u05", "rev": 1, "stage": "chunk", "text": "dobbiamo portare", "translation": "we have to bring", "distractors": ["we want to bring", "we have to buy"] },
        { "id": "it-a1-natura-5-u06", "rev": 1, "stage": "sentence", "text": "Nello zaino dobbiamo portare acqua e panini.", "translation": "We have to bring water and sandwiches in the backpack.", "distractors": ["We have to bring wine and sandwiches in the backpack.", "We don't have to bring water and sandwiches in the backpack."], "commas": [1] },
        { "id": "it-a1-natura-5-u07", "rev": 1, "stage": "word", "text": "escursione", "translation": "hike", "distractors": ["trip", "climb"] },
        { "id": "it-a1-natura-5-u08", "rev": 1, "stage": "phrase", "text": "un'escursione di tre ore", "translation": "a three-hour hike", "distractors": ["a two-hour hike", "a three-hour drive"], "variants": ["un'escursione di 3 ore"] },
        { "id": "it-a1-natura-5-u09", "rev": 1, "stage": "sentence", "text": "Partiamo alle otto per un'escursione di tre ore.", "translation": "We're leaving at eight for a three-hour hike.", "distractors": ["We're leaving at nine for a three-hour hike.", "We're arriving at eight for a three-hour hike."], "variants": ["Partiamo alle 8 per un'escursione di 3 ore.", "Partiamo alle otto per un'escursione di 3 ore.", "Partiamo alle 8 per un'escursione di tre ore."], "commas": [2] },
        { "id": "it-a1-natura-5-u10", "rev": 1, "stage": "chunk", "text": "a piedi", "translation": "on foot", "distractors": ["by bike", "by car"] },
        { "id": "it-a1-natura-5-u11", "rev": 1, "stage": "sentence", "text": "Arriviamo in cima a piedi.", "translation": "We get to the top on foot.", "distractors": ["We get to the top by bike.", "We get to the lake on foot."] },
        { "id": "it-a1-natura-5-u12", "rev": 1, "stage": "word", "text": "tenda", "translation": "tent", "distractors": ["backpack", "cabin"] },
        { "id": "it-a1-natura-5-u13", "rev": 1, "stage": "phrase", "text": "dormire in tenda", "translation": "to sleep in a tent", "distractors": ["to eat in a tent", "to sleep in a hotel"] },
        { "id": "it-a1-natura-5-u14", "rev": 1, "stage": "sentence", "text": "Stasera dormiamo in tenda vicino al fiume.", "translation": "Tonight we're sleeping in a tent near the river.", "distractors": ["Tonight we're sleeping in a hotel near the river.", "Tonight we're sleeping in a tent near the lake."], "commas": [0] },
        { "id": "it-a1-natura-5-u15", "rev": 1, "stage": "word", "text": "natura", "translation": "nature", "distractors": ["weather", "countryside"] },
        { "id": "it-a1-natura-5-u16", "rev": 1, "stage": "sentence", "text": "Mi piace molto la natura.", "translation": "I really like nature.", "distractors": ["I don't like nature much.", "I really like the city."] }
      ]
    },
    {
      "id": "it-a1-natura-6",
      "title": "Il tempo cambia",
      "grammarFocus": ["weather: c'è la nebbia, comincia a piovere", "arriva un temporale"],
      "units": [
        { "id": "it-a1-natura-6-u01", "rev": 1, "stage": "word", "text": "nuvola", "translation": "cloud", "distractors": ["storm", "fog"] },
        { "id": "it-a1-natura-6-u02", "rev": 1, "stage": "phrase", "text": "nuvole nere", "translation": "dark clouds", "distractors": ["white clouds", "dark skies"] },
        { "id": "it-a1-natura-6-u03", "rev": 1, "stage": "sentence", "text": "Ci sono nuvole nere sulla montagna.", "translation": "There are dark clouds over the mountain.", "distractors": ["There are white clouds over the mountain.", "There are dark clouds over the lake."] },
        { "id": "it-a1-natura-6-u04", "rev": 1, "stage": "word", "text": "temporale", "translation": "thunderstorm", "distractors": ["fog", "wind"] },
        { "id": "it-a1-natura-6-u05", "rev": 1, "stage": "chunk", "text": "arriva un temporale", "translation": "a storm is coming", "distractors": ["a storm is ending", "the sun is coming out"] },
        { "id": "it-a1-natura-6-u06", "rev": 1, "stage": "sentence", "text": "Dobbiamo tornare, arriva un temporale!", "translation": "We have to go back, a storm is coming!", "distractors": ["We can stay, a storm is coming!", "We have to go back, it's getting dark!"] },
        { "id": "it-a1-natura-6-u07", "rev": 1, "stage": "word", "text": "cielo", "translation": "sky", "distractors": ["cloud", "sun"] },
        { "id": "it-a1-natura-6-u08", "rev": 1, "stage": "phrase", "text": "il cielo grigio", "translation": "the gray sky", "distractors": ["the blue sky", "the gray sea"] },
        { "id": "it-a1-natura-6-u09", "rev": 1, "stage": "sentence", "text": "Il cielo è grigio e comincia a piovere.", "translation": "The sky is gray and it's starting to rain.", "distractors": ["The sky is blue and it's starting to rain.", "The sky is gray and it's starting to snow."], "commas": [3] },
        { "id": "it-a1-natura-6-u10", "rev": 1, "stage": "word", "text": "nebbia", "translation": "fog", "distractors": ["rain", "snow"] },
        { "id": "it-a1-natura-6-u11", "rev": 1, "stage": "chunk", "text": "c'è la nebbia", "translation": "it's foggy", "distractors": ["it's windy", "it's sunny"] },
        { "id": "it-a1-natura-6-u12", "rev": 1, "stage": "sentence", "text": "In autunno la mattina c'è spesso la nebbia.", "translation": "In autumn it's often foggy in the morning.", "distractors": ["In summer it's often foggy in the morning.", "In autumn it's often windy in the morning."], "commas": [1,3] },
        { "id": "it-a1-natura-6-u13", "rev": 1, "stage": "word", "text": "alba", "translation": "dawn", "distractors": ["sunset", "noon"] },
        { "id": "it-a1-natura-6-u14", "rev": 1, "stage": "sentence", "text": "Partiamo all'alba, quando fa ancora fresco.", "translation": "We're leaving at dawn, when it's still cool.", "distractors": ["We're leaving at sunset, when it's still cool.", "We're leaving at dawn, when it's already hot."] },
        { "id": "it-a1-natura-6-u15", "rev": 1, "stage": "sentence", "text": "In montagna il tempo cambia spesso.", "translation": "In the mountains the weather changes often.", "distractors": ["By the sea the weather changes often.", "In the mountains the weather never changes."], "commas": [1] },
        { "id": "it-a1-natura-6-u16", "rev": 1, "stage": "sentence", "text": "Dopo il temporale esce il sole.", "translation": "After the storm the sun comes out.", "distractors": ["Before the storm the sun comes out.", "After the storm the rain comes."], "commas": [2] }
      ]
    }
  ]
}
