  "lessons": [
    {
      "id": "it-a2-cortesia-1",
      "title": "Potrebbe aiutarmi?",
      "grammarFocus": ["condizionale: potrebbe, potresti, potrei", "sarebbe possibile + infinitive"],
      "units": [
        { "id": "it-a2-cortesia-1-u01", "rev": 1, "stage": "word", "text": "potrebbe", "translation": "could you (formal)", "distractors": ["could I", "would you like"] },
        { "id": "it-a2-cortesia-1-u02", "rev": 1, "stage": "chunk", "text": "potrebbe aiutarmi", "translation": "could you help me", "distractors": ["could I help you", "could you call me"] },
        { "id": "it-a2-cortesia-1-u03", "rev": 1, "stage": "sentence", "text": "Scusi, potrebbe aiutarmi?", "translation": "Excuse me, could you help me?", "distractors": ["Excuse me, could I help you?", "Excuse me, could you call me?"] },
        { "id": "it-a2-cortesia-1-u04", "rev": 1, "stage": "phrase", "text": "per cortesia", "translation": "please", "distractors": ["thank you", "excuse me"] },
        { "id": "it-a2-cortesia-1-u05", "rev": 1, "stage": "sentence", "text": "Potrebbe ripetere, per cortesia?", "translation": "Could you repeat that, please?", "distractors": ["Could you write that down, please?", "Could I repeat that, please?"] },
        { "id": "it-a2-cortesia-1-u06", "rev": 1, "stage": "word", "text": "informazione", "translation": "information", "distractors": ["question", "answer"] },
        { "id": "it-a2-cortesia-1-u07", "rev": 1, "stage": "phrase", "text": "un'informazione", "translation": "some information", "distractors": ["a question", "some advice"] },
        { "id": "it-a2-cortesia-1-u08", "rev": 1, "stage": "sentence", "text": "Buongiorno, vorrei un'informazione.", "translation": "Good morning, I'd like some information.", "distractors": ["Good evening, I'd like some information.", "Good morning, I'd like some advice."] },
        { "id": "it-a2-cortesia-1-u09", "rev": 1, "stage": "chunk", "text": "potresti spiegarmi", "translation": "could you explain to me", "distractors": ["could you tell me", "could I explain to you"] },
        { "id": "it-a2-cortesia-1-u10", "rev": 1, "stage": "sentence", "text": "Potresti spiegarmi come funziona?", "translation": "Could you explain to me how it works?", "distractors": ["Could you explain to me where it is?", "Could I explain to you how it works?"] },
        { "id": "it-a2-cortesia-1-u11", "rev": 1, "stage": "word", "text": "domanda", "translation": "question", "distractors": ["answer", "request"] },
        { "id": "it-a2-cortesia-1-u12", "rev": 1, "stage": "chunk", "text": "potrei farle una domanda", "translation": "could I ask you a question", "distractors": ["could I ask you a favor", "could you ask me a question"] },
        { "id": "it-a2-cortesia-1-u13", "rev": 1, "stage": "sentence", "text": "Scusi, potrei farle una domanda?", "translation": "Excuse me, could I ask you a question?", "distractors": ["Excuse me, could I ask you a favor?", "Excuse me, could you ask me a question?"] },
        { "id": "it-a2-cortesia-1-u14", "rev": 1, "stage": "chunk", "text": "sarebbe possibile", "translation": "would it be possible", "distractors": ["it wasn't possible", "would it be necessary"] },
        { "id": "it-a2-cortesia-1-u15", "rev": 1, "stage": "sentence", "text": "Sarebbe possibile pagare con la carta?", "translation": "Would it be possible to pay by card?", "distractors": ["Would it be possible to pay in cash?", "Would it be possible to book by card?"] },
        { "id": "it-a2-cortesia-1-u16", "rev": 1, "stage": "sentence", "text": "Mi saprebbe dire dov'è la stazione?", "translation": "Could you tell me where the station is?", "distractors": ["Could you tell me where the stop is?", "Could you take me to the station?"] }
      ]
    },
    {
      "id": "it-a2-cortesia-2",
      "title": "Mi piacerebbe...",
      "grammarFocus": ["condizionale: mi piacerebbe, preferirei, vorremmo", "sarebbe bello + infinitive"],
      "units": [
        { "id": "it-a2-cortesia-2-u01", "rev": 1, "stage": "chunk", "text": "mi piacerebbe", "translation": "I would like", "distractors": ["I would prefer", "I like"] },
        { "id": "it-a2-cortesia-2-u02", "rev": 1, "stage": "sentence", "text": "Mi piacerebbe visitare Firenze.", "translation": "I'd like to visit Florence.", "distractors": ["I'd like to live in Florence.", "I liked visiting Florence."] },
        { "id": "it-a2-cortesia-2-u03", "rev": 1, "stage": "chunk", "text": "ci piacerebbe", "translation": "we would like", "distractors": ["they would like", "we like"] },
        { "id": "it-a2-cortesia-2-u04", "rev": 1, "stage": "sentence", "text": "Ci piacerebbe tornare in Italia l'anno prossimo.", "translation": "We'd like to come back to Italy next year.", "distractors": ["We'd like to come back to Italy next month.", "They'd like to come back to Italy next year."] },
        { "id": "it-a2-cortesia-2-u05", "rev": 1, "stage": "word", "text": "preferirei", "translation": "I would prefer", "distractors": ["I would like", "you would prefer"] },
        { "id": "it-a2-cortesia-2-u06", "rev": 1, "stage": "phrase", "text": "vicino alla finestra", "translation": "near the window", "distractors": ["near the door", "far from the window"] },
        { "id": "it-a2-cortesia-2-u07", "rev": 1, "stage": "sentence", "text": "Preferirei un tavolo vicino alla finestra.", "translation": "I'd prefer a table near the window.", "distractors": ["I'd prefer a table near the door.", "I'd prefer a room near the window."] },
        { "id": "it-a2-cortesia-2-u08", "rev": 1, "stage": "word", "text": "sarebbe", "translation": "it would be", "distractors": ["it will be", "it was"] },
        { "id": "it-a2-cortesia-2-u09", "rev": 1, "stage": "chunk", "text": "sarebbe bello", "translation": "it would be nice", "distractors": ["it was nice", "it would be a shame"] },
        { "id": "it-a2-cortesia-2-u10", "rev": 1, "stage": "sentence", "text": "Sarebbe bello andare al mare insieme.", "translation": "It would be nice to go to the seaside together.", "distractors": ["It would be nice to go to the mountains together.", "It was nice to go to the seaside together."] },
