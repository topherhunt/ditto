        { "id": "it-a2-confronti-3-u03", "rev": 1, "stage": "sentence", "text": "Questo è il miglior caffè della città.", "translation": "This is the best coffee in town.", "distractors": ["This is the worst coffee in town.", "This is the best coffee in Italy."] },
