        { "id": "it-a2-confronti-2-u16", "rev": 1, "stage": "sentence", "text": "Rispetto a Milano, Napoli ha un clima più caldo.", "translation": "Compared to Milan, Naples has a warmer climate.", "distractors": ["Compared to Naples, Milan has a warmer climate.", "Compared to Milan, Naples has a colder climate."] }
