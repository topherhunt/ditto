        { "id": "it-a2-confronti-2-u14", "rev": 1, "stage": "sentence", "text": "Il mio paese ha solo mille abitanti.", "translation": "My village has only a thousand inhabitants.", "distractors": ["My village has only a hundred inhabitants.", "My village has more than a thousand inhabitants."], "variants": ["Il mio paese ha solo 1000 abitanti.", "Il mio paese ha solo 1.000 abitanti."] },
