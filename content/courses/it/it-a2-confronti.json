        { "id": "it-a2-confronti-6-u03", "rev": 1, "stage": "sentence", "text": "Oggi sto meglio di ieri.", "translation": "Today I feel better than yesterday.", "distractors": ["Today I feel worse than yesterday.", "Today you feel better than yesterday."] },
