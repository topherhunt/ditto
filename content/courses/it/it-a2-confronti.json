  "lessons": [
    {
      "id": "it-a2-confronti-1",
      "title": "Più grande, più piccolo",
      "grammarFocus": ["più / meno + adjective + di", "maggiore / minore for siblings"],
      "units": [
        { "id": "it-a2-confronti-1-u01", "rev": 1, "stage": "word", "text": "più", "translation": "more", "distractors": ["less", "very"] },
        { "id": "it-a2-confronti-1-u02", "rev": 1, "stage": "phrase", "text": "più alto", "translation": "taller", "distractors": ["shorter", "very tall"] },
        { "id": "it-a2-confronti-1-u03", "rev": 1, "stage": "chunk", "text": "più alto di me", "translation": "taller than me", "distractors": ["shorter than me", "taller than you"] },
        { "id": "it-a2-confronti-1-u04", "rev": 1, "stage": "sentence", "text": "Mio fratello è più alto di me.", "translation": "My brother is taller than me.", "distractors": ["My sister is taller than me.", "My brother is shorter than me."] },
        { "id": "it-a2-confronti-1-u05", "rev": 1, "stage": "word", "text": "meno", "translation": "less", "distractors": ["more", "too"] },
        { "id": "it-a2-confronti-1-u06", "rev": 1, "stage": "phrase", "text": "meno caro", "translation": "cheaper", "distractors": ["more expensive", "very expensive"] },
        { "id": "it-a2-confronti-1-u07", "rev": 1, "stage": "sentence", "text": "Il treno è meno caro dell'aereo.", "translation": "The train is cheaper than the plane.", "distractors": ["The plane is cheaper than the train.", "The train is faster than the plane."] },
        { "id": "it-a2-confronti-1-u08", "rev": 1, "stage": "word", "text": "veloce", "translation": "fast", "distractors": ["slow", "cheap"] },
        { "id": "it-a2-confronti-1-u09", "rev": 1, "stage": "chunk", "text": "più lento della metro", "translation": "slower than the metro", "distractors": ["faster than the metro", "slower than the bus"] },
        { "id": "it-a2-confronti-1-u10", "rev": 1, "stage": "sentence", "text": "L'autobus è più lento della metro.", "translation": "The bus is slower than the metro.", "distractors": ["The bus is faster than the metro.", "The taxi is slower than the metro."] },
        { "id": "it-a2-confronti-1-u11", "rev": 1, "stage": "sentence", "text": "In macchina è più veloce, ma costa di più.", "translation": "By car it's faster, but it costs more.", "distractors": ["By bus it's faster, but it costs more.", "By car it's slower, but it costs less."], "commas": [1] },
        { "id": "it-a2-confronti-1-u12", "rev": 1, "stage": "word", "text": "maggiore", "translation": "older (of siblings)", "distractors": ["younger", "taller"] },
        { "id": "it-a2-confronti-1-u13", "rev": 1, "stage": "phrase", "text": "mia sorella maggiore", "translation": "my older sister", "distractors": ["my younger sister", "my older brother"] },
        { "id": "it-a2-confronti-1-u14", "rev": 1, "stage": "sentence", "text": "Mia sorella maggiore ha tre anni più di me.", "translation": "My older sister is three years older than me.", "distractors": ["My older sister is three years younger than me.", "My older brother is three years older than me."], "variants": ["Mia sorella maggiore ha 3 anni più di me."] },
        { "id": "it-a2-confronti-1-u15", "rev": 1, "stage": "phrase", "text": "mio fratello minore", "translation": "my younger brother", "distractors": ["my older brother", "my younger sister"] },
        { "id": "it-a2-confronti-1-u16", "rev": 1, "stage": "sentence", "text": "Mio fratello minore è più intelligente di me.", "translation": "My younger brother is smarter than me.", "distractors": ["My older brother is smarter than me.", "My younger brother is lazier than me."] }
      ]
    },
    {
      "id": "it-a2-confronti-2",
      "title": "Città o campagna?",
      "grammarFocus": ["più ... che with places and nouns", "rispetto a"],
      "units": [
        { "id": "it-a2-confronti-2-u01", "rev": 1, "stage": "word", "text": "traffico", "translation": "traffic", "distractors": ["noise", "weather"] },
        { "id": "it-a2-confronti-2-u02", "rev": 1, "stage": "sentence", "text": "In città c'è troppo traffico.", "translation": "There's too much traffic in the city.", "distractors": ["There's too much traffic in the country.", "There's too much noise in the city."], "commas": [1] },
        { "id": "it-a2-confronti-2-u03", "rev": 1, "stage": "word", "text": "aria", "translation": "air", "distractors": ["water", "sun"] },
        { "id": "it-a2-confronti-2-u04", "rev": 1, "stage": "phrase", "text": "l'aria pulita", "translation": "clean air", "distractors": ["dirty air", "clean water"] },
        { "id": "it-a2-confronti-2-u05", "rev": 1, "stage": "sentence", "text": "In campagna l'aria è più pulita.", "translation": "In the countryside the air is cleaner.", "distractors": ["In the city the air is cleaner.", "In the countryside the air is dirtier."], "commas": [1] },
        { "id": "it-a2-confronti-2-u06", "rev": 1, "stage": "word", "text": "spazio", "translation": "space", "distractors": ["time", "air"] },
        { "id": "it-a2-confronti-2-u07", "rev": 1, "stage": "phrase", "text": "più spazio", "translation": "more space", "distractors": ["less space", "more time"] },
        { "id": "it-a2-confronti-2-u08", "rev": 1, "stage": "chunk", "text": "più spazio che in città", "translation": "more space than in the city", "distractors": ["less space than in the city", "more space than in the country"] },
        { "id": "it-a2-confronti-2-u09", "rev": 1, "stage": "sentence", "text": "In campagna c'è più spazio che in città.", "translation": "In the country there's more space than in the city.", "distractors": ["In the country there's less space than in the city.", "In the city there's more space than in the country."], "commas": [1] },
        { "id": "it-a2-confronti-2-u10", "rev": 1, "stage": "word", "text": "servizio", "translation": "service", "distractors": ["price", "office"] },
