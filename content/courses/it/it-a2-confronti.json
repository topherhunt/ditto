        { "id": "it-a2-confronti-4-u04", "rev": 1, "stage": "sentence", "text": "Questa valigia è pesantissima!", "translation": "This suitcase is really heavy!", "distractors": ["This suitcase is really light!", "This bag is really heavy!"] },
