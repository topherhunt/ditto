        { "id": "it-a2-confronti-2-u12", "rev": 1, "stage": "sentence", "text": "In città ci sono più servizi, ma anche più traffico.", "translation": "In the city there are more services, but also more traffic.", "distractors": ["In the city there are fewer services, but also less traffic.", "In the city there are more shops, but also more traffic."], "commas": [1] },
