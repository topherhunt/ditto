        { "id": "it-a1-viaggio-4-u05", "rev": 1, "stage": "chunk", "text": "fa caldo", "translation": "it's hot", "distractors": ["it's cold", "it's cloudy"] },
        { "id": "it-a1-viaggio-4-u06", "rev": 1, "stage": "sentence", "text": "Oggi c'è il sole e fa caldo.", "translation": "Today it's sunny and hot.", "distractors": ["Today it's windy and hot.", "Today it's sunny and cold."], "commas": [0] },
        { "id": "it-a1-viaggio-4-u07", "rev": 1, "stage": "word", "text": "pioggia", "translation": "rain", "distractors": ["snow", "wind"] },
