        { "id": "it-a1-viaggio-6-u15", "rev": 1, "stage": "sentence", "text": "Buon viaggio e buone vacanze!", "translation": "Have a good trip and a lovely holiday!", "distractors": ["Have a good trip and a lovely weekend!", "Have a good flight and a lovely holiday!"] }
