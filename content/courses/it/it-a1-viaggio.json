        { "id": "it-a1-viaggio-3-u03", "rev": 1, "stage": "phrase", "text": "una camera doppia", "translation": "a double room", "distractors": ["a single room", "two double rooms"] },
        { "id": "it-a1-viaggio-3-u04", "rev": 1, "stage": "sentence", "text": "Avete una camera doppia libera?", "translation": "Do you have a double room available?", "distractors": ["Do you have a single room available?", "Do you have two double rooms available?"] },
        { "id": "it-a1-viaggio-3-u05", "rev": 1, "stage": "phrase", "text": "una camera singola", "translation": "a single room", "distractors": ["a double room", "a small room"] },
        { "id": "it-a1-viaggio-3-u06", "rev": 1, "stage": "sentence", "text": "Vorrei una camera singola per tre notti.", "translation": "I'd like a single room for three nights.", "distractors": ["I'd like a double room for three nights.", "I'd like a single room for two nights."], "variants": ["Vorrei una camera singola per 3 notti."] },
        { "id": "it-a1-viaggio-3-u07", "rev": 1, "stage": "chunk", "text": "quante notti resta", "translation": "how many nights are you staying", "distractors": ["how many nights do you want", "how many people are staying"] },
