        { "id": "it-a1-viaggio-4-u09", "rev": 1, "stage": "word", "text": "piove", "translation": "it's raining", "distractors": ["it's snowing", "it's windy"] },
        { "id": "it-a1-viaggio-4-u10", "rev": 1, "stage": "sentence", "text": "Oggi piove, ma domani c'è il sole.", "translation": "It's raining today, but tomorrow it'll be sunny.", "distractors": ["It's snowing today, but tomorrow it'll be sunny.", "It's sunny today, but tomorrow it'll rain."] },
        { "id": "it-a1-viaggio-4-u11", "rev": 1, "stage": "word", "text": "nevica", "translation": "it's snowing", "distractors": ["it's raining", "it's cold"] },
        { "id": "it-a1-viaggio-4-u12", "rev": 1, "stage": "sentence", "text": "A gennaio nevica spesso in montagna.", "translation": "In January it often snows in the mountains.", "distractors": ["In January it often rains in the mountains.", "In June it often snows in the mountains."], "commas": [1] },
        { "id": "it-a1-viaggio-4-u13", "rev": 1, "stage": "phrase", "text": "c'è vento", "translation": "it's windy", "distractors": ["it's sunny", "it's snowing"] },
        { "id": "it-a1-viaggio-4-u14", "rev": 1, "stage": "sentence", "text": "È nuvoloso e c'è molto vento.", "translation": "It's cloudy and very windy.", "distractors": ["It's sunny and very windy.", "It's cloudy and there's no wind."] },
        { "id": "it-a1-viaggio-4-u15", "rev": 1, "stage": "phrase", "text": "trenta gradi", "translation": "thirty degrees", "distractors": ["thirteen degrees", "three degrees"], "variants": ["30 gradi"] },
        { "id": "it-a1-viaggio-4-u16", "rev": 1, "stage": "sentence", "text": "A Palermo ci sono trenta gradi.", "translation": "It's thirty degrees in Palermo.", "distractors": ["It's thirteen degrees in Palermo.", "It's thirty degrees in Milan."], "variants": ["A Palermo ci sono 30 gradi."], "commas": [1] }
      ]
