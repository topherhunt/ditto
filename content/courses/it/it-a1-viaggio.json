      "id": "it-a1-viaggio-1",
      "title": "Un biglietto per Roma",
      "grammarFocus": ["un biglietto per + city", "partire and cambiare in the present", "dates: il tre marzo"],
      "units": [
        { "id": "it-a1-viaggio-1-u01", "rev": 1, "stage": "word", "text": "biglietto", "translation": "ticket", "distractors": ["receipt", "seat"] },
        { "id": "it-a1-viaggio-1-u02", "rev": 1, "stage": "phrase", "text": "un biglietto per Roma", "translation": "a ticket to Rome", "distractors": ["two tickets to Rome", "a ticket from Rome"] },
        { "id": "it-a1-viaggio-1-u03", "rev": 1, "stage": "sentence", "text": "Vorrei un biglietto per Roma, per favore.", "translation": "I'd like a ticket to Rome, please.", "distractors": ["I'd like two tickets to Rome, please.", "I'd like a ticket from Rome, please."] },
        { "id": "it-a1-viaggio-1-u04", "rev": 1, "stage": "phrase", "text": "andata e ritorno", "translation": "round trip", "distractors": ["one way", "return only"] },
        { "id": "it-a1-viaggio-1-u05", "rev": 1, "stage": "phrase", "text": "solo andata", "translation": "one way", "distractors": ["round trip", "first class"] },
        { "id": "it-a1-viaggio-1-u06", "rev": 1, "stage": "sentence", "text": "Solo andata o andata e ritorno?", "translation": "One way or round trip?", "distractors": ["One way or first class?", "Round trip or return only?"], "commas": [1] },
        { "id": "it-a1-viaggio-1-u07", "rev": 1, "stage": "sentence", "text": "Andata il tre marzo e ritorno il dieci.", "translation": "Out on the third of March and back on the tenth.", "distractors": ["Out on the third of May and back on the tenth.", "Out on the third of March and back on the twelfth."], "variants": ["Andata il 3 marzo e ritorno il 10.", "Andata il tre marzo e ritorno il 10.", "Andata il 3 marzo e ritorno il dieci."], "commas": [3] },
        { "id": "it-a1-viaggio-1-u08", "rev": 1, "stage": "word", "text": "treno", "translation": "train", "distractors": ["plane", "bus"] },
        { "id": "it-a1-viaggio-1-u09", "rev": 1, "stage": "word", "text": "partire", "translation": "to leave", "distractors": ["to arrive", "to change"] },
        { "id": "it-a1-viaggio-1-u10", "rev": 1, "stage": "chunk", "text": "a che ora parte", "translation": "what time does it leave", "distractors": ["what time does it arrive", "how long does it take"] },
        { "id": "it-a1-viaggio-1-u11", "rev": 1, "stage": "sentence", "text": "A che ora parte il treno per Milano?", "translation": "What time does the train to Milan leave?", "distractors": ["What time does the bus to Milan leave?", "What time does the train from Milan arrive?"] },
        { "id": "it-a1-viaggio-1-u12", "rev": 1, "stage": "word", "text": "binario", "translation": "platform", "distractors": ["ticket office", "waiting room"] },
        { "id": "it-a1-viaggio-1-u13", "rev": 1, "stage": "phrase", "text": "dal binario tre", "translation": "from platform three", "distractors": ["from platform six", "to platform three"], "variants": ["dal binario 3"] },
        { "id": "it-a1-viaggio-1-u14", "rev": 1, "stage": "sentence", "text": "Il treno parte dal binario tre alle nove.", "translation": "The train leaves from platform three at nine.", "distractors": ["The train leaves from platform three at ten.", "The train arrives at platform three at nine."], "variants": ["Il treno parte dal binario 3 alle 9.", "Il treno parte dal binario tre alle 9.", "Il treno parte dal binario 3 alle nove."] },
        { "id": "it-a1-viaggio-1-u15", "rev": 1, "stage": "chunk", "text": "devo cambiare", "translation": "I have to change", "distractors": ["I want to change", "I can't change"] },
        { "id": "it-a1-viaggio-1-u16", "rev": 1, "stage": "sentence", "text": "Devo cambiare a Bologna?", "translation": "Do I have to change in Bologna?", "distractors": ["Can I change in Bologna?", "Do I have to get off in Bologna?"] }
