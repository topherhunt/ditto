        { "id": "it-a1-viaggio-5-u07", "rev": 1, "stage": "sentence", "text": "In inverno c'è molta neve in montagna.", "translation": "In winter there's a lot of snow in the mountains.", "distractors": ["In winter there's a lot of rain in the mountains.", "In summer there's a lot of snow in the mountains."], "commas": [1] },
