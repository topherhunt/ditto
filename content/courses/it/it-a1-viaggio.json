        { "id": "it-a1-viaggio-4-u02", "rev": 1, "stage": "sentence", "text": "Che tempo fa oggi a Roma?", "translation": "What's the weather like in Rome today?", "distractors": ["What's the weather like in Rome tomorrow?", "What's the weather like in Milan today?"] },
