        { "id": "it-a1-viaggio-3-u11", "rev": 1, "stage": "sentence", "text": "La colazione è dalle sette alle dieci.", "translation": "Breakfast is from seven to ten.", "distractors": ["Dinner is from seven to ten.", "Breakfast is from seven to eleven."], "variants": ["La colazione è dalle 7 alle 10.", "La colazione è dalle sette alle 10.", "La colazione è dalle 7 alle dieci."] },
        { "id": "it-a1-viaggio-3-u12", "rev": 1, "stage": "phrase", "text": "la chiave della camera", "translation": "the room key", "distractors": ["the room number", "the car key"] },
        { "id": "it-a1-viaggio-3-u13", "rev": 1, "stage": "sentence", "text": "Ecco la chiave, la camera è al terzo piano.", "translation": "Here's the key, the room is on the third floor.", "distractors": ["Here's the key, the room is on the second floor.", "Here's the bill, the room is on the third floor."], "senses": {"8":"noun"} },
