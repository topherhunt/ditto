        { "id": "it-a1-viaggio-2-u04", "rev": 1, "stage": "phrase", "text": "venti minuti", "translation": "twenty minutes", "distractors": ["ten minutes", "twenty hours"], "variants": ["20 minuti"] },
        { "id": "it-a1-viaggio-2-u05", "rev": 1, "stage": "sentence", "text": "Il treno per Napoli ha venti minuti di ritardo.", "translation": "The train to Naples is twenty minutes late.", "distractors": ["The train to Naples is ten minutes late.", "The train from Naples is twenty minutes early."], "variants": ["Il treno per Napoli ha 20 minuti di ritardo."] },
        { "id": "it-a1-viaggio-2-u06", "rev": 1, "stage": "word", "text": "arrivare", "translation": "to arrive", "distractors": ["to leave", "to wait"] },
        { "id": "it-a1-viaggio-2-u07", "rev": 1, "stage": "chunk", "text": "a che ora arriva", "translation": "what time does it arrive", "distractors": ["what time does it leave", "how late is it"] },
        { "id": "it-a1-viaggio-2-u08", "rev": 1, "stage": "sentence", "text": "A che ora arriva a Firenze?", "translation": "What time does it get to Florence?", "distractors": ["What time does it leave Florence?", "What time does it get to Venice?"] },
        { "id": "it-a1-viaggio-2-u09", "rev": 1, "stage": "word", "text": "orario", "translation": "timetable", "distractors": ["ticket", "delay"] },
        { "id": "it-a1-viaggio-2-u10", "rev": 1, "stage": "sentence", "text": "Scusi, dov'è l'orario dei treni?", "translation": "Excuse me, where is the train timetable?", "distractors": ["Excuse me, where is the bus timetable?", "Excuse me, where is the train station?"] },
        { "id": "it-a1-viaggio-2-u11", "rev": 1, "stage": "word", "text": "aereo", "translation": "plane", "distractors": ["train", "boat"] },
        { "id": "it-a1-viaggio-2-u12", "rev": 1, "stage": "phrase", "text": "all'aeroporto", "translation": "at the airport", "distractors": ["at the station", "from the airport"] },
        { "id": "it-a1-viaggio-2-u13", "rev": 1, "stage": "sentence", "text": "L'aereo parte alle sei e un quarto.", "translation": "The plane leaves at a quarter past six.", "distractors": ["The plane lands at a quarter past six.", "The plane leaves at a quarter to six."], "variants": ["L'aereo parte alle 6 e un quarto."], "senses": {"3":"num"} },
        { "id": "it-a1-viaggio-2-u14", "rev": 1, "stage": "phrase", "text": "l'ultimo treno", "translation": "the last train", "distractors": ["the next train", "the first train"] },
        { "id": "it-a1-viaggio-2-u15", "rev": 1, "stage": "sentence", "text": "L'ultimo treno parte a mezzanotte.", "translation": "The last train leaves at midnight.", "distractors": ["The next train leaves at midnight.", "The last train arrives at midnight."] },
        { "id": "it-a1-viaggio-2-u16", "rev": 1, "stage": "sentence", "text": "Il prossimo treno per l'aeroporto è alle dieci.", "translation": "The next train to the airport is at ten.", "distractors": ["The last train to the airport is at ten.", "The next bus to the airport is at ten."], "variants": ["Il prossimo treno per l'aeroporto è alle 10."] }
