        { "id": "it-a1-viaggio-6-u08", "rev": 1, "stage": "sentence", "text": "Quest'anno andate al lago o in montagna?", "translation": "This year, are you going to the lake or the mountains?", "distractors": ["Next year, are you going to the lake or the mountains?", "This year, are you going to the sea or the mountains?"], "commas": [0] },
