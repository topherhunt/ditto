    {
      "id": "it-a2-tecnologia-1",
      "title": "Il telefono",
      "grammarFocus": ["non... più", "posso + infinitive", "passato prossimo: ho rotto, ho spento"],
      "units": [
        { "id": "it-a2-tecnologia-1-u01", "rev": 1, "stage": "word", "text": "batteria", "translation": "battery", "distractors": ["charger", "screen"] },
        { "id": "it-a2-tecnologia-1-u02", "rev": 1, "stage": "phrase", "text": "la batteria del telefono", "translation": "the phone battery", "distractors": ["the phone screen", "the computer battery"] },
        { "id": "it-a2-tecnologia-1-u03", "rev": 1, "stage": "sentence", "text": "Il mio telefono non ha più batteria.", "translation": "My phone has no battery left.", "distractors": ["My phone has a new battery.", "My computer has no battery left."] },
        { "id": "it-a2-tecnologia-1-u04", "rev": 1, "stage": "word", "text": "caricabatterie", "translation": "charger", "distractors": ["battery", "cable"] },
        { "id": "it-a2-tecnologia-1-u05", "rev": 1, "stage": "chunk", "text": "posso usare", "translation": "can I use", "distractors": ["must I use", "can you use"] },
        { "id": "it-a2-tecnologia-1-u06", "rev": 1, "stage": "sentence", "text": "Scusa, posso usare il tuo caricabatterie?", "translation": "Sorry, can I use your charger?", "distractors": ["Sorry, can I use your phone?", "Sorry, can you use my charger?"] },
        { "id": "it-a2-tecnologia-1-u07", "rev": 1, "stage": "word", "text": "schermo", "translation": "screen", "distractors": ["keyboard", "battery"] },
        { "id": "it-a2-tecnologia-1-u08", "rev": 1, "stage": "phrase", "text": "lo schermo del cellulare", "translation": "the phone screen", "distractors": ["the computer screen", "the phone battery"] },
        { "id": "it-a2-tecnologia-1-u09", "rev": 1, "stage": "sentence", "text": "Ieri ho rotto lo schermo del cellulare.", "translation": "Yesterday I broke my phone screen.", "distractors": ["Today I broke my phone screen.", "Yesterday I broke my computer screen."], "commas": [0] },
        { "id": "it-a2-tecnologia-1-u10", "rev": 1, "stage": "word", "text": "accendere", "translation": "to switch on", "distractors": ["to switch off", "to charge"] },
        { "id": "it-a2-tecnologia-1-u11", "rev": 1, "stage": "word", "text": "spegnere", "translation": "to switch off", "distractors": ["to switch on", "to break"] },
        { "id": "it-a2-tecnologia-1-u12", "rev": 1, "stage": "chunk", "text": "ho spento il telefono", "translation": "I switched off my phone", "distractors": ["I switched on my phone", "I lost my phone"] },
        { "id": "it-a2-tecnologia-1-u13", "rev": 1, "stage": "sentence", "text": "Durante il film ho spento il telefono.", "translation": "During the film I switched off my phone.", "distractors": ["During the film I switched on my phone.", "During the concert I switched off my phone."], "commas": [2] },
        { "id": "it-a2-tecnologia-1-u14", "rev": 1, "stage": "sentence", "text": "Accendo il telefono e guardo i messaggi.", "translation": "I switch on my phone and check my messages.", "distractors": ["I switch off my phone and check my messages.", "I switch on my phone and check my photos."] },
        { "id": "it-a2-tecnologia-1-u15", "rev": 1, "stage": "sentence", "text": "Pronto? Ti sento male.", "translation": "Hello? I can't hear you well.", "distractors": ["Hello? I can hear you well.", "Hello? I can't see you well."] }
      ]
    },
    {
