        { "id": "it-a2-tecnologia-4-u05", "rev": 1, "stage": "sentence", "text": "Ho scaricato un'app per imparare l'italiano.", "translation": "I downloaded an app to learn Italian.", "distractors": ["I deleted an app for learning Italian.", "I downloaded an app to learn German."] },
