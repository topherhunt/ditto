        { "id": "it-a2-tecnologia-2-u03", "rev": 1, "stage": "sentence", "text": "Lavoro sempre con il computer portatile.", "translation": "I always work on my laptop.", "distractors": ["I never work on my laptop.", "I always work on my phone."] },
        { "id": "it-a2-tecnologia-2-u04", "rev": 1, "stage": "word", "text": "tastiera", "translation": "keyboard", "distractors": ["screen", "mouse"] },
        { "id": "it-a2-tecnologia-2-u05", "rev": 1, "stage": "sentence", "text": "La tastiera di questo computer è americana.", "translation": "This computer's keyboard is American.", "distractors": ["This computer's keyboard is German.", "This phone's keyboard is American."] },
        { "id": "it-a2-tecnologia-2-u06", "rev": 1, "stage": "word", "text": "file", "translation": "file", "distractors": ["folder", "photo"] },
        { "id": "it-a2-tecnologia-2-u07", "rev": 1, "stage": "word", "text": "salvare", "translation": "to save", "distractors": ["to delete", "to print"] },
        { "id": "it-a2-tecnologia-2-u08", "rev": 1, "stage": "chunk", "text": "salvare il file", "translation": "to save the file", "distractors": ["to delete the file", "to save the photo"] },
        { "id": "it-a2-tecnologia-2-u09", "rev": 1, "stage": "sentence", "text": "Hai salvato il file sul computer?", "translation": "Did you save the file on the computer?", "distractors": ["Did you delete the file from the computer?", "Did you save the photo on the computer?"] },
        { "id": "it-a2-tecnologia-2-u10", "rev": 1, "stage": "word", "text": "chiavetta", "translation": "USB stick", "distractors": ["charger", "file"] },
        { "id": "it-a2-tecnologia-2-u11", "rev": 1, "stage": "phrase", "text": "su una chiavetta", "translation": "on a USB stick", "distractors": ["on the computer", "on a phone"] },
        { "id": "it-a2-tecnologia-2-u12", "rev": 1, "stage": "sentence", "text": "Ho salvato tutte le foto su una chiavetta.", "translation": "I saved all the photos on a USB stick.", "distractors": ["I deleted all the photos from a USB stick.", "I saved all the files on a USB stick."] },
        { "id": "it-a2-tecnologia-2-u13", "rev": 1, "stage": "chunk", "text": "stampare il biglietto", "translation": "to print the ticket", "distractors": ["to buy the ticket", "to print the photo"] },
        { "id": "it-a2-tecnologia-2-u14", "rev": 1, "stage": "sentence", "text": "Devo stampare il biglietto del treno.", "translation": "I have to print the train ticket.", "distractors": ["I have to buy the train ticket.", "I have to print the plane ticket."] },
        { "id": "it-a2-tecnologia-2-u15", "rev": 1, "stage": "sentence", "text": "Il mio computer è vecchio e molto lento.", "translation": "My computer is old and very slow.", "distractors": ["My computer is new and very slow.", "My phone is old and very slow."] }
      ]
    },
