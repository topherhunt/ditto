  "lessons": [
    {
      "id": "it-a2-successo-1",
      "title": "Mentre camminavo...",
      "grammarFocus": ["mentre + imperfetto", "imperfetto for the background, passato prossimo for the event"],
      "units": [
        { "id": "it-a2-successo-1-u01", "rev": 1, "stage": "word", "text": "mentre", "translation": "while", "distractors": ["when", "after"] },
        { "id": "it-a2-successo-1-u02", "rev": 1, "stage": "chunk", "text": "mentre camminavo", "translation": "while I was walking", "distractors": ["while I was running", "while you were walking"] },
        { "id": "it-a2-successo-1-u03", "rev": 1, "stage": "sentence", "text": "Mentre camminavo, ho incontrato Paolo.", "translation": "While I was walking, I ran into Paolo.", "distractors": ["While I was running, I ran into Paolo.", "While I was walking, I called Paolo."] },
        { "id": "it-a2-successo-1-u04", "rev": 1, "stage": "chunk", "text": "aspettavo l'autobus", "translation": "I was waiting for the bus", "distractors": ["I was taking the bus", "I was waiting for the train"] },
        { "id": "it-a2-successo-1-u05", "rev": 1, "stage": "sentence", "text": "Mentre aspettavo l'autobus, ha cominciato a piovere.", "translation": "While I was waiting for the bus, it started to rain.", "distractors": ["While I was waiting for the train, it started to rain.", "While I was waiting for the bus, it started to snow."] },
        { "id": "it-a2-successo-1-u06", "rev": 1, "stage": "word", "text": "momento", "translation": "moment", "distractors": ["minute", "hour"] },
        { "id": "it-a2-successo-1-u07", "rev": 1, "stage": "phrase", "text": "in quel momento", "translation": "at that moment", "distractors": ["at this moment", "since that moment"] },
        { "id": "it-a2-successo-1-u08", "rev": 1, "stage": "sentence", "text": "In quel momento ho sentito il telefono.", "translation": "At that moment I heard the phone.", "distractors": ["At that moment I answered the phone.", "At that moment I heard the door."] },
        { "id": "it-a2-successo-1-u09", "rev": 1, "stage": "chunk", "text": "mentre dormivo", "translation": "while I was sleeping", "distractors": ["while I was eating", "while she was sleeping"] },
        { "id": "it-a2-successo-1-u10", "rev": 1, "stage": "sentence", "text": "Mentre dormivo, qualcuno ha telefonato.", "translation": "While I was sleeping, someone called.", "distractors": ["While I was eating, someone called.", "While I was sleeping, nobody called."] },
        { "id": "it-a2-successo-1-u11", "rev": 1, "stage": "word", "text": "succedere", "translation": "to happen", "distractors": ["to stop", "to fall"] },
        { "id": "it-a2-successo-1-u12", "rev": 1, "stage": "chunk", "text": "cos'è successo", "translation": "what happened", "distractors": ["what's happening", "how did it happen"] },
        { "id": "it-a2-successo-1-u13", "rev": 1, "stage": "sentence", "text": "Cos'è successo mentre ero fuori?", "translation": "What happened while I was out?", "distractors": ["What happened while you were out?", "What happened after I went out?"] },
        { "id": "it-a2-successo-1-u14", "rev": 1, "stage": "phrase", "text": "la televisione", "translation": "the television", "distractors": ["the radio", "the phone"] },
        { "id": "it-a2-successo-1-u15", "rev": 1, "stage": "sentence", "text": "Mentre cucinavo, i bambini guardavano la televisione.", "translation": "While I was cooking, the children were watching TV.", "distractors": ["While I was cooking, the children were reading.", "While I was eating, the children were watching TV."] }
      ]
    },
    {
      "id": "it-a2-successo-2",
      "title": "All'improvviso",
      "grammarFocus": ["all'improvviso", "a un certo punto", "reflexive fermarsi in the past"],
      "units": [
        { "id": "it-a2-successo-2-u01", "rev": 1, "stage": "word", "text": "rumore", "translation": "noise", "distractors": ["voice", "light"] },
        { "id": "it-a2-successo-2-u02", "rev": 1, "stage": "phrase", "text": "un rumore strano", "translation": "a strange noise", "distractors": ["a strange voice", "a loud noise"] },
        { "id": "it-a2-successo-2-u03", "rev": 1, "stage": "chunk", "text": "all'improvviso", "translation": "suddenly", "distractors": ["slowly", "finally"] },
        { "id": "it-a2-successo-2-u04", "rev": 1, "stage": "sentence", "text": "All'improvviso ho sentito un rumore strano.", "translation": "Suddenly I heard a strange noise.", "distractors": ["Suddenly I made a strange noise.", "Finally I heard a strange noise."], "commas": [0] },
        { "id": "it-a2-successo-2-u05", "rev": 1, "stage": "word", "text": "buio", "translation": "dark", "distractors": ["light", "cold"] },
        { "id": "it-a2-successo-2-u06", "rev": 1, "stage": "sentence", "text": "Era buio e non vedevo niente.", "translation": "It was dark and I couldn't see anything.", "distractors": ["It was cold and I couldn't see anything.", "It was dark and I couldn't hear anything."] },
        { "id": "it-a2-successo-2-u07", "rev": 1, "stage": "word", "text": "gridare", "translation": "to shout", "distractors": ["to cry", "to run"] },
        { "id": "it-a2-successo-2-u08", "rev": 1, "stage": "sentence", "text": "Qualcuno ha gridato dalla strada.", "translation": "Someone shouted from the street.", "distractors": ["Someone called from the street.", "Nobody shouted from the street."] },
        { "id": "it-a2-successo-2-u09", "rev": 1, "stage": "chunk", "text": "a un certo punto", "translation": "at some point", "distractors": ["at the end", "at the right moment"] },
        { "id": "it-a2-successo-2-u10", "rev": 1, "stage": "sentence", "text": "A un certo punto il bambino ha cominciato a piangere.", "translation": "At some point the child started to cry.", "distractors": ["At some point the child started to laugh.", "At the end the child started to cry."], "commas": [3] },
        { "id": "it-a2-successo-2-u11", "rev": 1, "stage": "word", "text": "fermarsi", "translation": "to stop", "distractors": ["to leave", "to fall"] },
        { "id": "it-a2-successo-2-u12", "rev": 1, "stage": "chunk", "text": "si è fermata", "translation": "she stopped", "distractors": ["she left", "she fell"] },
        { "id": "it-a2-successo-2-u13", "rev": 1, "stage": "sentence", "text": "All'improvviso la macchina si è fermata.", "translation": "Suddenly the car stopped.", "distractors": ["Suddenly the bus stopped.", "Suddenly the car left."], "commas": [0] },
        { "id": "it-a2-successo-2-u14", "rev": 1, "stage": "sentence", "text": "Ci siamo fermati perché era troppo buio.", "translation": "We stopped because it was too dark.", "distractors": ["We stopped because it was too cold.", "We left because it was too dark."], "commas": [2] }
      ]
    },
    {
      "id": "it-a2-successo-3",
      "title": "Mi hanno rubato il portafoglio",
      "grammarFocus": ["mi hanno + participle", "accorgersi che", "per caso"],
      "units": [
        { "id": "it-a2-successo-3-u01", "rev": 1, "stage": "word", "text": "portafoglio", "translation": "wallet", "distractors": ["bag", "phone"] },
        { "id": "it-a2-successo-3-u02", "rev": 1, "stage": "word", "text": "rubare", "translation": "to steal", "distractors": ["to lose", "to find"] },
        { "id": "it-a2-successo-3-u03", "rev": 1, "stage": "sentence", "text": "Mi hanno rubato il portafoglio!", "translation": "Someone stole my wallet!", "distractors": ["Someone stole my bag!", "Someone found my wallet!"] },
        { "id": "it-a2-successo-3-u04", "rev": 1, "stage": "phrase", "text": "sull'autobus", "translation": "on the bus", "distractors": ["at the bus stop", "on the train"] },
        { "id": "it-a2-successo-3-u05", "rev": 1, "stage": "sentence", "text": "Mentre ero sull'autobus, qualcuno mi ha rubato il telefono.", "translation": "While I was on the bus, someone stole my phone.", "distractors": ["While I was on the train, someone stole my phone.", "While I was on the bus, someone stole my wallet."] },
        { "id": "it-a2-successo-3-u06", "rev": 1, "stage": "word", "text": "polizia", "translation": "police", "distractors": ["pharmacy", "station"] },
        { "id": "it-a2-successo-3-u07", "rev": 1, "stage": "chunk", "text": "chiamare la polizia", "translation": "to call the police", "distractors": ["to call the doctor", "to wait for the police"] },
        { "id": "it-a2-successo-3-u08", "rev": 1, "stage": "sentence", "text": "Ho chiamato subito la polizia.", "translation": "I called the police right away.", "distractors": ["I called the doctor right away.", "I didn't call the police."] },
        { "id": "it-a2-successo-3-u09", "rev": 1, "stage": "word", "text": "scappare", "translation": "to run away", "distractors": ["to steal", "to shout"] },
        { "id": "it-a2-successo-3-u10", "rev": 1, "stage": "sentence", "text": "L'uomo è scappato verso la stazione.", "translation": "The man ran away toward the station.", "distractors": ["The man walked toward the station.", "The woman ran away toward the station."] },
        { "id": "it-a2-successo-3-u11", "rev": 1, "stage": "word", "text": "accorgersi", "translation": "to notice", "distractors": ["to remember", "to forget"] },
        { "id": "it-a2-successo-3-u12", "rev": 1, "stage": "chunk", "text": "mi sono accorta", "translation": "I noticed", "distractors": ["I remembered", "I forgot"] },
        { "id": "it-a2-successo-3-u13", "rev": 1, "stage": "sentence", "text": "A casa mi sono accorta che la borsa non c'era più.", "translation": "At home I noticed that my bag wasn't there anymore.", "distractors": ["At home I noticed that my wallet wasn't there anymore.", "At work I noticed that my bag wasn't there anymore."], "commas": [1] },
        { "id": "it-a2-successo-3-u14", "rev": 1, "stage": "phrase", "text": "per caso", "translation": "by any chance", "distractors": ["on purpose", "by mistake"] },
        { "id": "it-a2-successo-3-u15", "rev": 1, "stage": "sentence", "text": "Per caso hai visto un portafoglio nero?", "translation": "Did you happen to see a black wallet?", "distractors": ["Did you happen to see a black bag?", "Did you happen to lose a black wallet?"], "commas": [1] }
      ]
    },
    {
      "id": "it-a2-successo-4",
      "title": "Un incidente",
      "grammarFocus": ["c'è stato", "passato prossimo of cadere and rompere"],
      "units": [
        { "id": "it-a2-successo-4-u01", "rev": 1, "stage": "word", "text": "incidente", "translation": "accident", "distractors": ["traffic jam", "fire"] },
        { "id": "it-a2-successo-4-u02", "rev": 1, "stage": "chunk", "text": "c'è stato un incidente", "translation": "there was an accident", "distractors": ["there is an accident", "there was a fire"] },
        { "id": "it-a2-successo-4-u03", "rev": 1, "stage": "sentence", "text": "Ieri c'è stato un incidente in via Roma.", "translation": "Yesterday there was an accident on Via Roma.", "distractors": ["Today there was an accident on Via Roma.", "Yesterday there was a fire on Via Roma."], "commas": [0] },
        { "id": "it-a2-successo-4-u04", "rev": 1, "stage": "word", "text": "pericoloso", "translation": "dangerous", "distractors": ["safe", "busy"] },
        { "id": "it-a2-successo-4-u05", "rev": 1, "stage": "phrase", "text": "una strada pericolosa", "translation": "a dangerous road", "distractors": ["a quiet road", "a dangerous square"] },
        { "id": "it-a2-successo-4-u06", "rev": 1, "stage": "sentence", "text": "Quella strada è molto pericolosa di notte.", "translation": "That road is very dangerous at night.", "distractors": ["That road is very dangerous in the morning.", "That road is very quiet at night."] },
        { "id": "it-a2-successo-4-u07", "rev": 1, "stage": "word", "text": "cadere", "translation": "to fall", "distractors": ["to run", "to stop"] },
        { "id": "it-a2-successo-4-u08", "rev": 1, "stage": "chunk", "text": "sono caduto", "translation": "I fell", "distractors": ["I ran", "I stopped"] },
        { "id": "it-a2-successo-4-u09", "rev": 1, "stage": "sentence", "text": "Mentre andavo in bicicletta, sono caduto.", "translation": "While I was riding my bike, I fell.", "distractors": ["While I was riding my bike, I stopped.", "While I was walking, I fell."] },
        { "id": "it-a2-successo-4-u10", "rev": 1, "stage": "word", "text": "rompere", "translation": "to break", "distractors": ["to lose", "to fix"] },
        { "id": "it-a2-successo-4-u11", "rev": 1, "stage": "chunk", "text": "ho rotto", "translation": "I broke", "distractors": ["I lost", "I fixed"] },
        { "id": "it-a2-successo-4-u12", "rev": 1, "stage": "sentence", "text": "Ho rotto il telefono e non potevo chiamare nessuno.", "translation": "I broke my phone and I couldn't call anyone.", "distractors": ["I lost my phone and I couldn't call anyone.", "I broke my phone and I couldn't find anyone."] },
        { "id": "it-a2-successo-4-u13", "rev": 1, "stage": "sentence", "text": "Il semaforo era rosso, ma la macchina non si è fermata.", "translation": "The light was red, but the car didn't stop.", "distractors": ["The light was green, but the car didn't stop.", "The light was red, but the bus didn't stop."] },
        { "id": "it-a2-successo-4-u14", "rev": 1, "stage": "sentence", "text": "Com'è successo l'incidente?", "translation": "How did the accident happen?", "distractors": ["When did the accident happen?", "Where did the accident happen?"] }
      ]
    },
    {
      "id": "it-a2-successo-5",
      "title": "Per fortuna",
      "grammarFocus": ["per fortuna", "alla fine", "quindi"],
      "units": [
        { "id": "it-a2-successo-5-u01", "rev": 1, "stage": "word", "text": "fortuna", "translation": "luck", "distractors": ["money", "time"] },
        { "id": "it-a2-successo-5-u02", "rev": 1, "stage": "chunk", "text": "per fortuna", "translation": "luckily", "distractors": ["unfortunately", "of course"] },
        { "id": "it-a2-successo-5-u03", "rev": 1, "stage": "sentence", "text": "Per fortuna avevo il telefono con me.", "translation": "Luckily I had my phone with me.", "distractors": ["Luckily I didn't have my phone with me.", "Luckily I had my wallet with me."], "commas": [1] },
        { "id": "it-a2-successo-5-u04", "rev": 1, "stage": "word", "text": "notizia", "translation": "news", "distractors": ["message", "letter"] },
        { "id": "it-a2-successo-5-u05", "rev": 1, "stage": "phrase", "text": "una bella notizia", "translation": "good news", "distractors": ["bad news", "a nice message"] },
        { "id": "it-a2-successo-5-u06", "rev": 1, "stage": "sentence", "text": "Ho ricevuto una bella notizia.", "translation": "I got some good news.", "distractors": ["I got some bad news.", "I gave some good news."] },
        { "id": "it-a2-successo-5-u07", "rev": 1, "stage": "chunk", "text": "alla fine", "translation": "in the end", "distractors": ["at the start", "at some point"] },
        { "id": "it-a2-successo-5-u08", "rev": 1, "stage": "sentence", "text": "Alla fine abbiamo trovato il portafoglio.", "translation": "In the end we found the wallet.", "distractors": ["In the end we lost the wallet.", "At the start we found the wallet."], "commas": [1] },
        { "id": "it-a2-successo-5-u09", "rev": 1, "stage": "word", "text": "quindi", "translation": "so", "distractors": ["but", "because"] },
        { "id": "it-a2-successo-5-u10", "rev": 1, "stage": "sentence", "text": "Pioveva, quindi siamo rimasti a casa.", "translation": "It was raining, so we stayed home.", "distractors": ["It was snowing, so we stayed home.", "It was raining, but we went out."] },
        { "id": "it-a2-successo-5-u11", "rev": 1, "stage": "chunk", "text": "non è successo niente", "translation": "nothing happened", "distractors": ["something happened", "nothing is happening"] },
        { "id": "it-a2-successo-5-u12", "rev": 1, "stage": "sentence", "text": "Per fortuna non è successo niente.", "translation": "Luckily nothing happened.", "distractors": ["Unfortunately nothing happened.", "Luckily something happened."], "commas": [1] },
        { "id": "it-a2-successo-5-u13", "rev": 1, "stage": "sentence", "text": "Meno male!", "translation": "Thank goodness!", "distractors": ["What a shame!", "Not again!"] },
        { "id": "it-a2-successo-5-u14", "rev": 1, "stage": "sentence", "text": "Alla fine è andato tutto bene.", "translation": "In the end everything went well.", "distractors": ["In the end everything went badly.", "At the start everything went well."], "commas": [1] }
      ]
    },
    {
      "id": "it-a2-successo-6",
      "title": "Una giornata strana",
      "grammarFocus": ["telling a story in order: poi, a quel punto, alla fine"],
      "units": [
        { "id": "it-a2-successo-6-u01", "rev": 1, "stage": "word", "text": "strano", "translation": "strange", "distractors": ["normal", "funny"] },
        { "id": "it-a2-successo-6-u02", "rev": 1, "stage": "chunk", "text": "una giornata strana", "translation": "a strange day", "distractors": ["a normal day", "a strange night"] },
        { "id": "it-a2-successo-6-u03", "rev": 1, "stage": "sentence", "text": "Ieri è stata una giornata molto strana.", "translation": "Yesterday was a very strange day.", "distractors": ["Today was a very strange day.", "Yesterday was a very normal day."] },
        { "id": "it-a2-successo-6-u04", "rev": 1, "stage": "sentence", "text": "La mattina mi sono svegliato tardi e ho perso il treno.", "translation": "In the morning I woke up late and missed the train.", "distractors": ["In the morning I woke up early and missed the train.", "In the morning I woke up late and missed the bus."], "commas": [1] },
        { "id": "it-a2-successo-6-u05", "rev": 1, "stage": "phrase", "text": "in ufficio", "translation": "at the office", "distractors": ["at school", "at home"] },
        { "id": "it-a2-successo-6-u06", "rev": 1, "stage": "sentence", "text": "In ufficio non c'era nessuno.", "translation": "There was nobody at the office.", "distractors": ["There was nobody at school.", "Everybody was at the office."], "commas": [1] },
        { "id": "it-a2-successo-6-u07", "rev": 1, "stage": "chunk", "text": "poi all'improvviso", "translation": "then suddenly", "distractors": ["then finally", "then slowly"], "commas": [0] },
        { "id": "it-a2-successo-6-u08", "rev": 1, "stage": "sentence", "text": "Poi all'improvviso ha telefonato mia madre.", "translation": "Then suddenly my mother called.", "distractors": ["Then suddenly my father called.", "Then finally my mother called."], "commas": [0, 1] },
        { "id": "it-a2-successo-6-u09", "rev": 1, "stage": "phrase", "text": "a quel punto", "translation": "at that point", "distractors": ["at the beginning", "at the end"] },
        { "id": "it-a2-successo-6-u10", "rev": 1, "stage": "sentence", "text": "A quel punto ho deciso di tornare a casa.", "translation": "At that point I decided to go back home.", "distractors": ["At that point I decided to stay at home.", "At the end I decided to go back home."], "commas": [2] },
        { "id": "it-a2-successo-6-u11", "rev": 1, "stage": "chunk", "text": "mentre tornavo", "translation": "while I was coming back", "distractors": ["while I was going out", "while you were coming back"] },
        { "id": "it-a2-successo-6-u12", "rev": 1, "stage": "phrase", "text": "un vecchio amico", "translation": "an old friend", "distractors": ["a new friend", "an old teacher"] },
        { "id": "it-a2-successo-6-u13", "rev": 1, "stage": "sentence", "text": "Mentre tornavo, ho incontrato un vecchio amico di scuola.", "translation": "While I was coming back, I ran into an old school friend.", "distractors": ["While I was going out, I ran into an old school friend.", "While I was coming back, I ran into an old teacher."] },
        { "id": "it-a2-successo-6-u14", "rev": 1, "stage": "sentence", "text": "Alla fine siamo andati a cena insieme.", "translation": "In the end we went to dinner together.", "distractors": ["In the end we went to lunch together.", "In the end we didn't go to dinner together."], "commas": [1] }
      ]
    }
  ]
