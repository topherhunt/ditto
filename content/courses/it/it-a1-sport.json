      "title": "Che sport fai?",
      "grammarFocus": ["giocare a + sport", "fare + sport: fare ciclismo"],
      "units": [
        { "id": "it-a1-sport-1-u01", "rev": 1, "stage": "word", "text": "pallavolo", "translation": "volleyball", "distractors": ["basketball", "soccer"] },
        { "id": "it-a1-sport-1-u02", "rev": 1, "stage": "phrase", "text": "giocare a pallavolo", "translation": "to play volleyball", "distractors": ["to play basketball", "to watch volleyball"] },
        { "id": "it-a1-sport-1-u03", "rev": 1, "stage": "sentence", "text": "Gioco a pallavolo con le mie amiche.", "translation": "I play volleyball with my friends.", "distractors": ["I play basketball with my friends.", "I watch volleyball with my friends."] },
        { "id": "it-a1-sport-1-u04", "rev": 1, "stage": "word", "text": "pallacanestro", "translation": "basketball", "distractors": ["volleyball", "tennis"] },
        { "id": "it-a1-sport-1-u05", "rev": 1, "stage": "sentence", "text": "Mio fratello gioca a pallacanestro.", "translation": "My brother plays basketball.", "distractors": ["My sister plays basketball.", "My brother plays volleyball."] },
        { "id": "it-a1-sport-1-u06", "rev": 1, "stage": "chunk", "text": "che sport fai", "translation": "what sport do you do", "distractors": ["what sport do you watch", "what sport does he do"] },
        { "id": "it-a1-sport-1-u07", "rev": 1, "stage": "sentence", "text": "Che sport fai nel tempo libero?", "translation": "What sports do you do in your free time?", "distractors": ["What sports do you watch in your free time?", "What sports does she do in her free time?"] },
        { "id": "it-a1-sport-1-u08", "rev": 1, "stage": "word", "text": "ciclismo", "translation": "cycling", "distractors": ["skiing", "swimming"] },
        { "id": "it-a1-sport-1-u09", "rev": 1, "stage": "chunk", "text": "fare ciclismo", "translation": "to go cycling", "distractors": ["to watch cycling", "to go skiing"] },
        { "id": "it-a1-sport-1-u10", "rev": 1, "stage": "sentence", "text": "Il sabato mattina facciamo ciclismo.", "translation": "On Saturday mornings we go cycling.", "distractors": ["On Sunday mornings we go cycling.", "On Saturday evenings we go cycling."] },
        { "id": "it-a1-sport-1-u11", "rev": 1, "stage": "word", "text": "sciare", "translation": "to ski", "distractors": ["to swim", "to run"] },
        { "id": "it-a1-sport-1-u12", "rev": 1, "stage": "chunk", "text": "sai sciare", "translation": "can you ski", "distractors": ["do you like skiing", "can you swim"] },
        { "id": "it-a1-sport-1-u13", "rev": 1, "stage": "sentence", "text": "Non so sciare, ma nuoto bene.", "translation": "I can't ski, but I swim well.", "distractors": ["I can ski, but I don't swim well.", "I can't ski, but I run well."] },
        { "id": "it-a1-sport-1-u14", "rev": 1, "stage": "phrase", "text": "uno sport divertente", "translation": "a fun sport", "distractors": ["a boring sport", "a fun game"] },
        { "id": "it-a1-sport-1-u15", "rev": 1, "stage": "sentence", "text": "Il tennis è uno sport divertente.", "translation": "Tennis is a fun sport.", "distractors": ["Tennis is a boring sport.", "Soccer is a fun sport."] },
        { "id": "it-a1-sport-1-u16", "rev": 1, "stage": "sentence", "text": "Qual è il tuo sport preferito?", "translation": "What's your favorite sport?", "distractors": ["What's your favorite team?", "Who's your favorite player?"] }
      ]
