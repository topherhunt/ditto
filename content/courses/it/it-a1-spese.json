        { "id": "it-a1-spese-1-u04", "rev": 1, "stage": "sentence", "text": "Al mercato compro frutta e verdura.", "translation": "At the market I buy fruit and vegetables.", "distractors": ["At the market I sell fruit and vegetables.", "At the market I buy fruit and bread."], "commas": [1] },
        { "id": "it-a1-spese-1-u05", "rev": 1, "stage": "chunk", "text": "quanto costano", "translation": "how much are they", "distractors": ["how much is it", "how many are there"] },
        { "id": "it-a1-spese-1-u06", "rev": 1, "stage": "sentence", "text": "Quanto costano queste mele?", "translation": "How much are these apples?", "distractors": ["How much are those apples?", "How much is this apple?"] },
