        { "id": "it-a1-spese-1-u08", "rev": 1, "stage": "phrase", "text": "quei pomodori", "translation": "those tomatoes", "distractors": ["these tomatoes", "those potatoes"] },
        { "id": "it-a1-spese-1-u09", "rev": 1, "stage": "sentence", "text": "E quei pomodori, quanto costano?", "translation": "And those tomatoes, how much are they?", "distractors": ["And these tomatoes, how much are they?", "And those potatoes, how much are they?"] },
        { "id": "it-a1-spese-1-u10", "rev": 1, "stage": "word", "text": "vendere", "translation": "to sell", "distractors": ["to buy", "to spend"] },
        { "id": "it-a1-spese-1-u11", "rev": 1, "stage": "sentence", "text": "Vendete anche la mozzarella?", "translation": "Do you sell mozzarella too?", "distractors": ["Do you buy mozzarella too?", "Do you only sell mozzarella?"] },
        { "id": "it-a1-spese-1-u12", "rev": 1, "stage": "chunk", "text": "serve altro", "translation": "anything else", "distractors": ["anything to drink", "is that too much"] },
        { "id": "it-a1-spese-1-u13", "rev": 1, "stage": "sentence", "text": "Serve altro, signora?", "translation": "Anything else, madam?", "distractors": ["Anything to drink, madam?", "Anything else, sir?"] },
