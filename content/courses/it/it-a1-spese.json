      "units": [
        { "id": "it-a1-spese-1-u01", "rev": 1, "stage": "word", "text": "mercato", "translation": "market", "distractors": ["supermarket", "square"] },
        { "id": "it-a1-spese-1-u02", "rev": 1, "stage": "sentence", "text": "Il sabato vado al mercato.", "translation": "On Saturdays I go to the market.", "distractors": ["On Sundays I go to the market.", "On Saturdays I go to the supermarket."], "commas": [1] },
