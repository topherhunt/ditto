        { "id": "it-a1-famiglia-5-u10", "rev": 1, "stage": "sentence", "text": "Gli zii e i cugini vivono a Napoli.", "translation": "My aunt and uncle and my cousins live in Naples.", "distractors": ["My aunt and uncle and my cousins live in Rome.", "My grandparents and my cousins live in Naples."] },
