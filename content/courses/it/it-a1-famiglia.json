      "id": "it-a1-famiglia-1",
      "title": "La mia famiglia",
      "grammarFocus": ["possessives: mio padre, i miei genitori", "plural articles: i, le"],
      "units": [
        { "id": "it-a1-famiglia-1-u01", "rev": 1, "stage": "word", "text": "famiglia", "translation": "family", "distractors": ["house", "friend"] },
        { "id": "it-a1-famiglia-1-u02", "rev": 1, "stage": "phrase", "text": "la mia famiglia", "translation": "my family", "distractors": ["your family", "my house"] },
        { "id": "it-a1-famiglia-1-u03", "rev": 1, "stage": "sentence", "text": "Questa è la mia famiglia.", "translation": "This is my family.", "distractors": ["This is your family.", "This is my house."] },
        { "id": "it-a1-famiglia-1-u04", "rev": 1, "stage": "word", "text": "padre", "translation": "father", "distractors": ["mother", "brother"] },
        { "id": "it-a1-famiglia-1-u05", "rev": 1, "stage": "phrase", "text": "mio padre e mia madre", "translation": "my father and my mother", "distractors": ["my father and my brother", "your father and your mother"] },
        { "id": "it-a1-famiglia-1-u06", "rev": 1, "stage": "sentence", "text": "Mio padre è italiano, mia madre è inglese.", "translation": "My father is Italian, my mother is English.", "distractors": ["My father is English, my mother is Italian.", "My brother is Italian, my mother is English."] },
        { "id": "it-a1-famiglia-1-u07", "rev": 1, "stage": "word", "text": "genitori", "translation": "parents", "distractors": ["relatives", "grandparents"] },
        { "id": "it-a1-famiglia-1-u08", "rev": 1, "stage": "phrase", "text": "i miei genitori", "translation": "my parents", "distractors": ["your parents", "my grandparents"] },
        { "id": "it-a1-famiglia-1-u09", "rev": 1, "stage": "chunk", "text": "vivono a Torino", "translation": "they live in Turin", "distractors": ["they work in Turin", "we live in Turin"] },
        { "id": "it-a1-famiglia-1-u10", "rev": 1, "stage": "sentence", "text": "I miei genitori vivono a Torino.", "translation": "My parents live in Turin.", "distractors": ["My parents live in Rome.", "My grandparents live in Turin."] },
        { "id": "it-a1-famiglia-1-u11", "rev": 1, "stage": "word", "text": "casa", "translation": "home", "distractors": ["family", "town"] },
        { "id": "it-a1-famiglia-1-u12", "rev": 1, "stage": "chunk", "text": "vivo a casa", "translation": "I live at home", "distractors": ["I live alone", "he lives at home"] },
        { "id": "it-a1-famiglia-1-u13", "rev": 1, "stage": "sentence", "text": "Io vivo a casa con i miei genitori.", "translation": "I live at home with my parents.", "distractors": ["I live at home with my brothers.", "I don't live at home with my parents."] },
        { "id": "it-a1-famiglia-1-u14", "rev": 1, "stage": "phrase", "text": "mamma e papà", "translation": "mum and dad", "distractors": ["mum and grandad", "grandma and dad"] },
        { "id": "it-a1-famiglia-1-u15", "rev": 1, "stage": "sentence", "text": "Ciao mamma, ciao papà!", "translation": "Hi Mum, hi Dad!", "distractors": ["Hi Mum, hi Grandma!", "Thanks Mum, thanks Dad!"], "commas": [0, 2] },
        { "id": "it-a1-famiglia-1-u16", "rev": 1, "stage": "sentence", "text": "Mia madre si chiama Laura, mio padre si chiama Paolo.", "translation": "My mother is called Laura, my father is called Paolo.", "distractors": ["My sister is called Laura, my father is called Paolo.", "My mother is called Laura, my brother is called Paolo."] }
      ]
    },
    {
      "id": "it-a1-famiglia-2",
      "title": "Fratelli e sorelle",
      "grammarFocus": ["plural nouns: fratelli, sorelle", "avere: abbiamo, avete, hanno"],
      "units": [
        { "id": "it-a1-famiglia-2-u01", "rev": 1, "stage": "word", "text": "fratello", "translation": "brother", "distractors": ["sister", "father"] },
        { "id": "it-a1-famiglia-2-u02", "rev": 1, "stage": "word", "text": "sorella", "translation": "sister", "distractors": ["brother", "daughter"] },
        { "id": "it-a1-famiglia-2-u03", "rev": 1, "stage": "phrase", "text": "fratelli e sorelle", "translation": "brothers and sisters", "distractors": ["sons and daughters", "brothers and cousins"] },
        { "id": "it-a1-famiglia-2-u04", "rev": 1, "stage": "sentence", "text": "Hai fratelli o sorelle?", "translation": "Do you have any brothers or sisters?", "distractors": ["Do you have any sons or daughters?", "Does he have any brothers or sisters?"] },
        { "id": "it-a1-famiglia-2-u05", "rev": 1, "stage": "chunk", "text": "ho un fratello", "translation": "I have a brother", "distractors": ["I have a sister", "he has a brother"] },
        { "id": "it-a1-famiglia-2-u06", "rev": 1, "stage": "sentence", "text": "Sì, ho un fratello e due sorelle.", "translation": "Yes, I have a brother and two sisters.", "distractors": ["Yes, I have a sister and two brothers.", "Yes, I have a brother and three sisters."], "variants": ["Sì, ho un fratello e 2 sorelle."] },
        { "id": "it-a1-famiglia-2-u07", "rev": 1, "stage": "word", "text": "unico", "translation": "only", "distractors": ["first", "young"] },
        { "id": "it-a1-famiglia-2-u08", "rev": 1, "stage": "phrase", "text": "figlio unico", "translation": "only child", "distractors": ["only brother", "eldest son"] },
        { "id": "it-a1-famiglia-2-u09", "rev": 1, "stage": "sentence", "text": "No, sono figlia unica.", "translation": "No, I'm an only child.", "distractors": ["No, I have one sister.", "Yes, I'm an only child."] },
        { "id": "it-a1-famiglia-2-u10", "rev": 1, "stage": "chunk", "text": "siamo in cinque", "translation": "there are five of us", "distractors": ["there are four of us", "they are five years old"], "variants": ["siamo in 5"] },
        { "id": "it-a1-famiglia-2-u11", "rev": 1, "stage": "sentence", "text": "In famiglia siamo in cinque.", "translation": "There are five of us in my family.", "distractors": ["There are four of us in my family.", "There are five of us at work."], "variants": ["In famiglia siamo in 5."] },
        { "id": "it-a1-famiglia-2-u12", "rev": 1, "stage": "word", "text": "loro", "translation": "they", "distractors": ["we", "you"] },
        { "id": "it-a1-famiglia-2-u13", "rev": 1, "stage": "sentence", "text": "Loro sono i miei fratelli, Luca e Matteo.", "translation": "They're my brothers, Luca and Matteo.", "distractors": ["They're my cousins, Luca and Matteo.", "They're my friends, Luca and Matteo."] },
        { "id": "it-a1-famiglia-2-u14", "rev": 1, "stage": "phrase", "text": "le mie sorelle", "translation": "my sisters", "distractors": ["my brothers", "your sisters"] },
        { "id": "it-a1-famiglia-2-u15", "rev": 1, "stage": "sentence", "text": "Le mie sorelle hanno dodici e quindici anni.", "translation": "My sisters are twelve and fifteen.", "distractors": ["My sisters are twelve and fifty.", "My brothers are twelve and fifteen."], "variants": ["Le mie sorelle hanno dodici e 15 anni.", "Le mie sorelle hanno 12 e quindici anni.", "Le mie sorelle hanno 12 e 15 anni."] },
        { "id": "it-a1-famiglia-2-u16", "rev": 1, "stage": "sentence", "text": "Anche tu sei figlio unico?", "translation": "Are you an only child too?", "distractors": ["Is he an only child too?", "Do you have a brother too?"] }
      ]
    },
