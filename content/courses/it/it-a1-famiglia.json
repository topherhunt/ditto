        { "id": "it-a1-famiglia-5-u04", "rev": 1, "stage": "sentence", "text": "I miei nonni vivono in un piccolo paese.", "translation": "My grandparents live in a small village.", "distractors": ["My parents live in a small village.", "My grandparents live in a big city."] },
