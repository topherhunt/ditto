        { "id": "it-a1-famiglia-6-u05", "rev": 1, "stage": "sentence", "text": "Non sono sposata, ma vivo con il mio fidanzato.", "translation": "I'm not married, but I live with my boyfriend.", "distractors": ["I'm married, but I don't live with my husband.", "I'm not married, but I live with my brother."] },
        { "id": "it-a1-famiglia-6-u06", "rev": 1, "stage": "phrase", "text": "i nostri figli", "translation": "our children", "distractors": ["your children", "our parents"] },
