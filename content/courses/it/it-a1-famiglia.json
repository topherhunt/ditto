        { "id": "it-a1-famiglia-3-u07", "rev": 1, "stage": "sentence", "text": "Tua madre è una donna molto gentile.", "translation": "Your mother is a very kind woman.", "distractors": ["Your sister is a very kind woman.", "Your mother is a very young woman."] },
