        { "id": "it-a1-famiglia-3-u12", "rev": 1, "stage": "sentence", "text": "I ragazzi sono simpatici e le ragazze sono gentili.", "translation": "The boys are nice and the girls are kind.", "distractors": ["The girls are nice and the boys are kind.", "The boys are nice and the children are kind."] },
