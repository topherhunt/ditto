        { "id": "it-a1-famiglia-3-u10", "rev": 1, "stage": "sentence", "text": "Paolo è simpatico, ma suo fratello è antipatico.", "translation": "Paolo is nice, but his brother is unpleasant.", "distractors": ["Paolo is unpleasant, but his brother is nice.", "Paolo is nice, but his father is unpleasant."] },
