    {
      "id": "it-a1-tempo-libero-1",
      "title": "Cosa fai nel tempo libero?",
      "grammarFocus": ["mi piace + infinitive", "il martedì, la domenica: every week"],
      "units": [
        { "id": "it-a1-tempo-libero-1-u01", "rev": 1, "stage": "phrase", "text": "il tempo libero", "translation": "free time", "distractors": ["work time", "the weekend"] },
        { "id": "it-a1-tempo-libero-1-u02", "rev": 1, "stage": "sentence", "text": "Cosa fai nel tempo libero?", "translation": "What do you do in your free time?", "distractors": ["What do you do at work?", "What do you do in the morning?"] },
        { "id": "it-a1-tempo-libero-1-u03", "rev": 1, "stage": "chunk", "text": "mi piace leggere", "translation": "I like reading", "distractors": ["I like writing", "I don't like reading"] },
        { "id": "it-a1-tempo-libero-1-u04", "rev": 1, "stage": "sentence", "text": "Nel tempo libero mi piace leggere.", "translation": "In my free time, I like reading.", "distractors": ["In my free time, I like writing.", "At work, I like reading."], "commas": [2] },
        { "id": "it-a1-tempo-libero-1-u05", "rev": 1, "stage": "word", "text": "camminare", "translation": "to walk", "distractors": ["to run", "to swim"] },
        { "id": "it-a1-tempo-libero-1-u06", "rev": 1, "stage": "phrase", "text": "una passeggiata", "translation": "a walk", "distractors": ["a run", "a swim"] },
        { "id": "it-a1-tempo-libero-1-u07", "rev": 1, "stage": "sentence", "text": "La domenica faccio una passeggiata al parco.", "translation": "On Sundays I go for a walk in the park.", "distractors": ["On Saturdays I go for a walk in the park.", "On Sundays I go for a run in the park."], "commas": [1] },
        { "id": "it-a1-tempo-libero-1-u08", "rev": 1, "stage": "word", "text": "correre", "translation": "to run", "distractors": ["to walk", "to dance"] },
        { "id": "it-a1-tempo-libero-1-u09", "rev": 1, "stage": "sentence", "text": "Mio fratello corre, io preferisco camminare.", "translation": "My brother runs, I prefer walking.", "distractors": ["My brother walks, I prefer running.", "My sister runs, I prefer walking."] },
        { "id": "it-a1-tempo-libero-1-u10", "rev": 1, "stage": "word", "text": "nuotare", "translation": "to swim", "distractors": ["to run", "to travel"] },
        { "id": "it-a1-tempo-libero-1-u11", "rev": 1, "stage": "phrase", "text": "in piscina", "translation": "at the pool", "distractors": ["at the gym", "in the park"] },
        { "id": "it-a1-tempo-libero-1-u12", "rev": 1, "stage": "sentence", "text": "Il martedì vado a nuotare in piscina.", "translation": "On Tuesdays I go swimming at the pool.", "distractors": ["On Thursdays I go swimming at the pool.", "On Tuesdays I go running in the park."], "commas": [1] },
        { "id": "it-a1-tempo-libero-1-u13", "rev": 1, "stage": "word", "text": "viaggiare", "translation": "to travel", "distractors": ["to walk", "to work"] },
        { "id": "it-a1-tempo-libero-1-u14", "rev": 1, "stage": "sentence", "text": "Ti piace viaggiare?", "translation": "Do you like traveling?", "distractors": ["Do you like walking?", "Do you like working?"] },
        { "id": "it-a1-tempo-libero-1-u15", "rev": 1, "stage": "chunk", "text": "vado in palestra", "translation": "I go to the gym", "distractors": ["I go to the pool", "you go to the gym"] },
        { "id": "it-a1-tempo-libero-1-u16", "rev": 1, "stage": "sentence", "text": "Dopo il lavoro vado spesso in palestra.", "translation": "After work, I often go to the gym.", "distractors": ["Before work, I often go to the gym.", "After work, I never go to the gym."], "commas": [2] }
      ]
    },
    {
      "id": "it-a1-tempo-libero-2",
      "title": "Giochi a calcio?",
      "grammarFocus": ["giocare a + sport", "neanche"],
      "units": [
        { "id": "it-a1-tempo-libero-2-u01", "rev": 1, "stage": "word", "text": "sport", "translation": "sport", "distractors": ["music", "game"] },
        { "id": "it-a1-tempo-libero-2-u02", "rev": 1, "stage": "sentence", "text": "Che sport fai?", "translation": "What sport do you do?", "distractors": ["What sport do you watch?", "What music do you play?"] },
        { "id": "it-a1-tempo-libero-2-u03", "rev": 1, "stage": "word", "text": "giocare", "translation": "to play", "distractors": ["to sing", "to watch"] },
        { "id": "it-a1-tempo-libero-2-u04", "rev": 1, "stage": "word", "text": "calcio", "translation": "soccer", "distractors": ["tennis", "swimming"] },
        { "id": "it-a1-tempo-libero-2-u05", "rev": 1, "stage": "chunk", "text": "giocare a calcio", "translation": "to play soccer", "distractors": ["to play tennis", "to watch soccer"] },
        { "id": "it-a1-tempo-libero-2-u06", "rev": 1, "stage": "sentence", "text": "Giochi a calcio?", "translation": "Do you play soccer?", "distractors": ["Do you play tennis?", "Do you watch soccer?"] },
        { "id": "it-a1-tempo-libero-2-u07", "rev": 1, "stage": "sentence", "text": "Sì, gioco a calcio con i miei amici.", "translation": "Yes, I play soccer with my friends.", "distractors": ["Yes, I play tennis with my friends.", "No, I play soccer with my brothers."] },
        { "id": "it-a1-tempo-libero-2-u08", "rev": 1, "stage": "chunk", "text": "giocare a tennis", "translation": "to play tennis", "distractors": ["to play soccer", "to watch tennis"] },
        { "id": "it-a1-tempo-libero-2-u09", "rev": 1, "stage": "sentence", "text": "Mia sorella gioca a tennis il sabato.", "translation": "My sister plays tennis on Saturdays.", "distractors": ["My sister plays soccer on Saturdays.", "My sister plays tennis on Sundays."] },
        { "id": "it-a1-tempo-libero-2-u10", "rev": 1, "stage": "word", "text": "insieme", "translation": "together", "distractors": ["alone", "again"] },
        { "id": "it-a1-tempo-libero-2-u11", "rev": 1, "stage": "sentence", "text": "Stasera guardiamo il calcio insieme?", "translation": "Shall we watch soccer together tonight?", "distractors": ["Shall we play soccer together tonight?", "Shall we watch soccer together tomorrow?"], "commas": [0] },
        { "id": "it-a1-tempo-libero-2-u12", "rev": 1, "stage": "chunk", "text": "neanche mio fratello", "translation": "not my brother either", "distractors": ["my brother too", "not my sister either"] },
        { "id": "it-a1-tempo-libero-2-u13", "rev": 1, "stage": "sentence", "text": "Io non gioco a calcio, e neanche mio fratello.", "translation": "I don't play soccer, and neither does my brother.", "distractors": ["I play soccer, and so does my brother.", "I don't play tennis, and neither does my brother."] },
        { "id": "it-a1-tempo-libero-2-u14", "rev": 1, "stage": "word", "text": "preferito", "translation": "favorite", "distractors": ["difficult", "fun"] },
        { "id": "it-a1-tempo-libero-2-u15", "rev": 1, "stage": "sentence", "text": "Qual è il tuo sport preferito?", "translation": "What's your favorite sport?", "distractors": ["What's your favorite song?", "What's his favorite sport?"] }
      ]
    },
