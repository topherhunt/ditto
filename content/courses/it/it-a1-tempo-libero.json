        { "id": "it-a1-tempo-libero-6-u02", "rev": 1, "stage": "sentence", "text": "Cosa fate questo weekend?", "translation": "What are you doing this weekend?", "distractors": ["What are you doing this evening?", "Where are you going this weekend?"] },
        { "id": "it-a1-tempo-libero-6-u03", "rev": 1, "stage": "phrase", "text": "il fine settimana", "translation": "the weekend", "distractors": ["the end of the month", "the whole week"] },
        { "id": "it-a1-tempo-libero-6-u04", "rev": 1, "stage": "sentence", "text": "Il fine settimana non lavoro mai.", "translation": "I never work on weekends.", "distractors": ["I always work on weekends.", "I never work on Mondays."], "commas": [2] },
        { "id": "it-a1-tempo-libero-6-u05", "rev": 1, "stage": "word", "text": "quando", "translation": "when", "distractors": ["why", "where"] },
        { "id": "it-a1-tempo-libero-6-u06", "rev": 1, "stage": "sentence", "text": "Quando andiamo a teatro?", "translation": "When are we going to the theater?", "distractors": ["Why are we going to the theater?", "When are we going to the cinema?"] },
