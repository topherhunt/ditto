        { "id": "it-a1-tempo-libero-6-u11", "rev": 1, "stage": "sentence", "text": "È un film davvero divertente.", "translation": "It's a really funny film.", "distractors": ["It's a really boring film.", "It's a really funny song."] },
        { "id": "it-a1-tempo-libero-6-u12", "rev": 1, "stage": "chunk", "text": "vuoi vedere", "translation": "do you want to see", "distractors": ["can you see", "do you want to go"] },
        { "id": "it-a1-tempo-libero-6-u13", "rev": 1, "stage": "sentence", "text": "Vuoi vedere un film domenica sera?", "translation": "Do you want to see a film on Sunday evening?", "distractors": ["Do you want to see a film on Saturday evening?", "Do you want to see a play on Sunday evening?"] },
        { "id": "it-a1-tempo-libero-6-u14", "rev": 1, "stage": "chunk", "text": "a che ora ci vediamo", "translation": "what time shall we meet", "distractors": ["where shall we meet", "what time do we eat"] },
        { "id": "it-a1-tempo-libero-6-u15", "rev": 1, "stage": "sentence", "text": "Va bene, a che ora ci vediamo?", "translation": "Okay, what time shall we meet?", "distractors": ["Okay, where shall we meet?", "Okay, what time does it start?"] }
