    {
      "id": "it-a1-tempo-libero-4",
      "title": "Vuoi venire?",
      "grammarFocus": ["volere: voglio, vuoi, volete", "ti va di + infinitive", "accepting: certo, volentieri"],
      "units": [
        { "id": "it-a1-tempo-libero-4-u01", "rev": 1, "stage": "chunk", "text": "vuoi venire", "translation": "do you want to come", "distractors": ["do you have to come", "do you want to go"] },
        { "id": "it-a1-tempo-libero-4-u02", "rev": 1, "stage": "sentence", "text": "Vuoi venire al cinema con noi?", "translation": "Do you want to come to the cinema with us?", "distractors": ["Do you want to come to the theater with us?", "Do you want to go to the cinema without us?"] },
        { "id": "it-a1-tempo-libero-4-u03", "rev": 1, "stage": "chunk", "text": "ti va di", "translation": "do you feel like", "distractors": ["do you have to", "do you know how to"] },
        { "id": "it-a1-tempo-libero-4-u04", "rev": 1, "stage": "sentence", "text": "Ti va di fare una passeggiata?", "translation": "Do you feel like going for a walk?", "distractors": ["Do you feel like going for a swim?", "Do you have to go for a walk?"] },
        { "id": "it-a1-tempo-libero-4-u05", "rev": 1, "stage": "word", "text": "festa", "translation": "party", "distractors": ["concert", "walk"] },
        { "id": "it-a1-tempo-libero-4-u06", "rev": 1, "stage": "word", "text": "invitare", "translation": "to invite", "distractors": ["to visit", "to come"] },
        { "id": "it-a1-tempo-libero-4-u07", "rev": 1, "stage": "sentence", "text": "Sabato faccio una festa a casa mia.", "translation": "I'm having a party at my place on Saturday.", "distractors": ["I'm having a party at my place on Sunday.", "I'm going to a party at his place on Saturday."], "commas": [0] },
        { "id": "it-a1-tempo-libero-4-u08", "rev": 1, "stage": "sentence", "text": "Voglio invitare tutti i miei amici.", "translation": "I want to invite all my friends.", "distractors": ["I want to invite all my colleagues.", "I don't want to invite all my friends."] },
        { "id": "it-a1-tempo-libero-4-u09", "rev": 1, "stage": "word", "text": "stasera", "translation": "tonight", "distractors": ["tomorrow", "this morning"] },
        { "id": "it-a1-tempo-libero-4-u10", "rev": 1, "stage": "sentence", "text": "Cosa volete fare stasera?", "translation": "What do you want to do tonight?", "distractors": ["What do you want to eat tonight?", "What do you want to do tomorrow?"] },
        { "id": "it-a1-tempo-libero-4-u11", "rev": 1, "stage": "word", "text": "certo", "translation": "of course", "distractors": ["maybe", "never"] },
        { "id": "it-a1-tempo-libero-4-u12", "rev": 1, "stage": "sentence", "text": "Certo, vengo anch'io!", "translation": "Of course, I'm coming too!", "distractors": ["Of course, I'm staying at home!", "Of course not, I'm not coming!"] },
        { "id": "it-a1-tempo-libero-4-u13", "rev": 1, "stage": "chunk", "text": "che bella idea", "translation": "what a nice idea", "distractors": ["what a bad idea", "what a nice party"] },
        { "id": "it-a1-tempo-libero-4-u14", "rev": 1, "stage": "word", "text": "volentieri", "translation": "gladly", "distractors": ["unfortunately", "maybe"] },
        { "id": "it-a1-tempo-libero-4-u15", "rev": 1, "stage": "sentence", "text": "Che bella idea, vengo volentieri!", "translation": "What a nice idea, I'd love to come!", "distractors": ["What a bad idea, I'm not coming!", "What a nice idea, but I can't come!"] }
      ]
    },
    {
      "id": "it-a1-tempo-libero-5",
      "title": "Purtroppo non posso",
      "grammarFocus": ["potere: posso, puoi, può, possiamo", "perché: why and because", "turning down: mi dispiace, magari"],
      "units": [
        { "id": "it-a1-tempo-libero-5-u01", "rev": 1, "stage": "word", "text": "purtroppo", "translation": "unfortunately", "distractors": ["luckily", "of course"] },
        { "id": "it-a1-tempo-libero-5-u02", "rev": 1, "stage": "chunk", "text": "non posso", "translation": "I can't", "distractors": ["I can", "you can't"] },
        { "id": "it-a1-tempo-libero-5-u03", "rev": 1, "stage": "sentence", "text": "Purtroppo non posso, devo lavorare.", "translation": "Unfortunately I can't, I have to work.", "distractors": ["Luckily I can, I don't have to work.", "Unfortunately I can't, I have to study."] },
        { "id": "it-a1-tempo-libero-5-u04", "rev": 1, "stage": "word", "text": "perché", "translation": "why", "distractors": ["when", "where"] },
        { "id": "it-a1-tempo-libero-5-u05", "rev": 1, "stage": "sentence", "text": "Perché non puoi venire?", "translation": "Why can't you come?", "distractors": ["Why can't you stay?", "Why don't you want to come?"] },
        { "id": "it-a1-tempo-libero-5-u06", "rev": 1, "stage": "sentence", "text": "Perché domani ho un esame.", "translation": "Because I have an exam tomorrow.", "distractors": ["Because I have a lesson tomorrow.", "Because I have an exam today."] },
        { "id": "it-a1-tempo-libero-5-u07", "rev": 1, "stage": "chunk", "text": "mi dispiace", "translation": "I'm sorry", "distractors": ["I don't mind", "I'm glad"] },
        { "id": "it-a1-tempo-libero-5-u08", "rev": 1, "stage": "word", "text": "appuntamento", "translation": "appointment", "distractors": ["party", "concert"] },
        { "id": "it-a1-tempo-libero-5-u09", "rev": 1, "stage": "sentence", "text": "Mi dispiace, stasera ho un appuntamento.", "translation": "I'm sorry, I have an appointment tonight.", "distractors": ["I'm sorry, I have a party tonight.", "I'm sorry, I have an appointment tomorrow."] },
        { "id": "it-a1-tempo-libero-5-u10", "rev": 1, "stage": "chunk", "text": "che peccato", "translation": "what a pity", "distractors": ["what a surprise", "what luck"] },
        { "id": "it-a1-tempo-libero-5-u11", "rev": 1, "stage": "word", "text": "magari", "translation": "maybe", "distractors": ["never", "again"] },
        { "id": "it-a1-tempo-libero-5-u12", "rev": 1, "stage": "chunk", "text": "un'altra volta", "translation": "another time", "distractors": ["this time", "every time"] },
        { "id": "it-a1-tempo-libero-5-u13", "rev": 1, "stage": "sentence", "text": "Che peccato! Magari un'altra volta.", "translation": "What a pity! Maybe another time.", "distractors": ["What luck! Maybe another time.", "What a pity! Maybe this time."] },
        { "id": "it-a1-tempo-libero-5-u14", "rev": 1, "stage": "chunk", "text": "possiamo vederci", "translation": "we can meet", "distractors": ["we can't meet", "we can see it"] },
        { "id": "it-a1-tempo-libero-5-u15", "rev": 1, "stage": "sentence", "text": "Però possiamo vederci domenica.", "translation": "But we can meet on Sunday.", "distractors": ["But we can't meet on Sunday.", "But we can meet on Saturday."], "commas": [0] },
        { "id": "it-a1-tempo-libero-5-u16", "rev": 1, "stage": "sentence", "text": "Neanche Marco può venire, purtroppo.", "translation": "Marco can't come either, unfortunately.", "distractors": ["Marco can come too, luckily.", "Marco can't come either, he's busy."] }
      ]
    },
    {
      "id": "it-a1-tempo-libero-6",
