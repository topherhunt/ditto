        { "id": "it-a1-tempo-libero-3-u14", "rev": 1, "stage": "sentence", "text": "Sabato c'è un concerto in piazza.", "translation": "There's a concert in the square on Saturday.", "distractors": ["There's a party in the square on Saturday.", "There's a concert in the square on Sunday."], "commas": [0] },
        { "id": "it-a1-tempo-libero-3-u15", "rev": 1, "stage": "phrase", "text": "una canzone italiana", "translation": "an Italian song", "distractors": ["a French song", "an Italian film"] },
        { "id": "it-a1-tempo-libero-3-u16", "rev": 1, "stage": "sentence", "text": "Questa è la mia canzone preferita!", "translation": "This is my favorite song!", "distractors": ["This is my favorite film!", "This isn't my favorite song!"] }
      ]
