        { "id": "it-a1-tempo-libero-6-u08", "rev": 1, "stage": "sentence", "text": "Con chi vai al cinema?", "translation": "Who are you going to the cinema with?", "distractors": ["Who are you going to the theater with?", "When are you going to the cinema?"] },
        { "id": "it-a1-tempo-libero-6-u09", "rev": 1, "stage": "word", "text": "film", "translation": "film", "distractors": ["song", "play"] },
