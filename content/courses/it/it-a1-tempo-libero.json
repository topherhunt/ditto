      "units": [
        { "id": "it-a1-tempo-libero-3-u01", "rev": 1, "stage": "word", "text": "musica", "translation": "music", "distractors": ["dance", "theater"] },
        { "id": "it-a1-tempo-libero-3-u02", "rev": 1, "stage": "chunk", "text": "ascoltare la musica", "translation": "to listen to music", "distractors": ["to play music", "to listen to the radio"] },
        { "id": "it-a1-tempo-libero-3-u03", "rev": 1, "stage": "sentence", "text": "Mi piace ascoltare la musica italiana.", "translation": "I like listening to Italian music.", "distractors": ["I like playing Italian music.", "I like listening to French music."] },
        { "id": "it-a1-tempo-libero-3-u04", "rev": 1, "stage": "word", "text": "suonare", "translation": "to play (an instrument)", "distractors": ["to sing", "to listen"] },
        { "id": "it-a1-tempo-libero-3-u05", "rev": 1, "stage": "phrase", "text": "la chitarra", "translation": "the guitar", "distractors": ["the piano", "the violin"] },
        { "id": "it-a1-tempo-libero-3-u06", "rev": 1, "stage": "sentence", "text": "Suoni la chitarra?", "translation": "Do you play the guitar?", "distractors": ["Do you play the piano?", "Do you like the guitar?"] },
        { "id": "it-a1-tempo-libero-3-u07", "rev": 1, "stage": "phrase", "text": "il pianoforte", "translation": "the piano", "distractors": ["the guitar", "the drums"] },
        { "id": "it-a1-tempo-libero-3-u08", "rev": 1, "stage": "sentence", "text": "Mia figlia suona il pianoforte da tre anni.", "translation": "My daughter has been playing the piano for three years.", "distractors": ["My daughter has been playing the guitar for three years.", "My son has been playing the piano for two years."], "variants": ["Mia figlia suona il pianoforte da 3 anni."] },
        { "id": "it-a1-tempo-libero-3-u09", "rev": 1, "stage": "word", "text": "cantare", "translation": "to sing", "distractors": ["to dance", "to play"] },
        { "id": "it-a1-tempo-libero-3-u10", "rev": 1, "stage": "word", "text": "ballare", "translation": "to dance", "distractors": ["to sing", "to walk"] },
        { "id": "it-a1-tempo-libero-3-u11", "rev": 1, "stage": "sentence", "text": "Mi piace cantare, ma non so ballare.", "translation": "I like singing, but I can't dance.", "distractors": ["I like dancing, but I can't sing.", "I like singing, and I can dance."] },
        { "id": "it-a1-tempo-libero-3-u12", "rev": 1, "stage": "word", "text": "concerto", "translation": "concert", "distractors": ["party", "film"] },
