  "lessons": [
    {
      "id": "it-a2-weekend-1",
      "title": "Cosa hai fatto ieri?",
      "grammarFocus": ["passato prossimo: ho + -ato, -uto, -ito", "fatto, visto, letto"],
      "units": [
        { "id": "it-a2-weekend-1-u01", "rev": 1, "stage": "word", "text": "ieri", "translation": "yesterday", "distractors": ["today", "tomorrow"] },
        { "id": "it-a2-weekend-1-u02", "rev": 1, "stage": "chunk", "text": "cosa hai fatto", "translation": "what did you do", "distractors": ["what are you doing", "what will you do"] },
        { "id": "it-a2-weekend-1-u03", "rev": 1, "stage": "sentence", "text": "Cosa hai fatto ieri?", "translation": "What did you do yesterday?", "distractors": ["What are you doing today?", "What did you do this morning?"] },
        { "id": "it-a2-weekend-1-u04", "rev": 1, "stage": "phrase", "text": "ho lavorato", "translation": "I worked", "distractors": ["I work", "you worked"] },
        { "id": "it-a2-weekend-1-u05", "rev": 1, "stage": "sentence", "text": "Ieri ho lavorato tutto il giorno.", "translation": "Yesterday I worked all day.", "distractors": ["Yesterday I slept all day.", "Today I worked all morning."], "commas": [0] },
        { "id": "it-a2-weekend-1-u06", "rev": 1, "stage": "phrase", "text": "ieri sera", "translation": "last night", "distractors": ["tonight", "tomorrow night"] },
        { "id": "it-a2-weekend-1-u07", "rev": 1, "stage": "sentence", "text": "Ieri sera ho visto un film.", "translation": "Last night I watched a film.", "distractors": ["Last night I watched a match.", "Tonight I'm watching a film."], "commas": [1] },
        { "id": "it-a2-weekend-1-u08", "rev": 1, "stage": "word", "text": "stamattina", "translation": "this morning", "distractors": ["this evening", "yesterday morning"] },
        { "id": "it-a2-weekend-1-u09", "rev": 1, "stage": "sentence", "text": "Stamattina ho letto il giornale.", "translation": "This morning I read the newspaper.", "distractors": ["This morning I read a book.", "This evening I read the newspaper."], "commas": [0] },
        { "id": "it-a2-weekend-1-u10", "rev": 1, "stage": "chunk", "text": "ho fatto la spesa", "translation": "I did the food shopping", "distractors": ["I made dinner", "I did the cleaning"] },
        { "id": "it-a2-weekend-1-u11", "rev": 1, "stage": "sentence", "text": "Stamattina ho fatto la spesa al mercato.", "translation": "This morning I did the food shopping at the market.", "distractors": ["This morning I did the food shopping at the supermarket.", "Yesterday morning I did the food shopping at the market."], "commas": [0] },
        { "id": "it-a2-weekend-1-u12", "rev": 1, "stage": "word", "text": "pulire", "translation": "to clean", "distractors": ["to cook", "to wash"] },
        { "id": "it-a2-weekend-1-u13", "rev": 1, "stage": "phrase", "text": "ho lavato i piatti", "translation": "I washed the dishes", "distractors": ["I dried the dishes", "I washed the car"] },
        { "id": "it-a2-weekend-1-u14", "rev": 1, "stage": "sentence", "text": "Sabato ho pulito la casa e ho lavato i piatti.", "translation": "On Saturday I cleaned the house and washed the dishes.", "distractors": ["On Sunday I cleaned the house and washed the dishes.", "On Saturday I cleaned the kitchen and washed the dishes."], "commas": [0,4] }
      ]
    },
    {
      "id": "it-a2-weekend-2",
      "title": "Ho mangiato fuori",
      "grammarFocus": ["passato prossimo: abbiamo, hanno", "scelto, preso, bevuto"],
      "units": [
        { "id": "it-a2-weekend-2-u01", "rev": 1, "stage": "word", "text": "fuori", "translation": "out", "distractors": ["in", "at home"] },
        { "id": "it-a2-weekend-2-u02", "rev": 1, "stage": "phrase", "text": "mangiare fuori", "translation": "to eat out", "distractors": ["to eat at home", "to go out"] },
        { "id": "it-a2-weekend-2-u03", "rev": 1, "stage": "sentence", "text": "Ieri sera abbiamo mangiato fuori.", "translation": "Last night we ate out.", "distractors": ["Last night we ate at home.", "Tonight we're eating out."], "commas": [1] },
        { "id": "it-a2-weekend-2-u04", "rev": 1, "stage": "phrase", "text": "abbiamo aspettato", "translation": "we waited", "distractors": ["we ordered", "you waited"] },
        { "id": "it-a2-weekend-2-u05", "rev": 1, "stage": "sentence", "text": "Abbiamo aspettato un tavolo per mezz'ora.", "translation": "We waited half an hour for a table.", "distractors": ["We waited an hour for a table.", "We waited half an hour for the bill."] },
        { "id": "it-a2-weekend-2-u06", "rev": 1, "stage": "word", "text": "scegliere", "translation": "to choose", "distractors": ["to order", "to eat"] },
        { "id": "it-a2-weekend-2-u07", "rev": 1, "stage": "chunk", "text": "ho scelto il pesce", "translation": "I chose the fish", "distractors": ["I chose the meat", "you chose the fish"] },
        { "id": "it-a2-weekend-2-u08", "rev": 1, "stage": "sentence", "text": "Io ho scelto il pesce, Luca ha preso la carne.", "translation": "I chose the fish, Luca had the meat.", "distractors": ["I chose the meat, Luca had the fish.", "I chose the fish, Luca had the pasta."] },
        { "id": "it-a2-weekend-2-u09", "rev": 1, "stage": "phrase", "text": "abbiamo bevuto", "translation": "we drank", "distractors": ["we ate", "they drank"] },
