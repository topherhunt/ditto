        { "id": "it-a1-citta-3-u11", "rev": 1, "stage": "sentence", "text": "Prende la prima a destra e poi la seconda a sinistra.", "translation": "Take the first right and then the second left.", "distractors": ["Take the first left and then the second right.", "Take the second right and then the first left."], "commas": [4] },
