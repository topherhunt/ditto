  "lessons": [
    {
      "id": "it-a1-citta-1",
      "title": "Dov'è la stazione?",
      "grammarFocus": ["dov'è...?", "sapere: sa, so", "qui vicino, lontano, lì"],
      "units": [
        { "id": "it-a1-citta-1-u01", "rev": 1, "stage": "word", "text": "stazione", "translation": "station", "distractors": ["square", "stop"] },
        { "id": "it-a1-citta-1-u02", "rev": 1, "stage": "chunk", "text": "dov'è la stazione", "translation": "where's the station", "distractors": ["where's the stop", "how far is the station"] },
        { "id": "it-a1-citta-1-u03", "rev": 1, "stage": "sentence", "text": "Scusi, dov'è la stazione?", "translation": "Excuse me, where's the station?", "distractors": ["Excuse me, where's the bus stop?", "Excuse me, is the station far?"] },
        { "id": "it-a1-citta-1-u04", "rev": 1, "stage": "word", "text": "museo", "translation": "museum", "distractors": ["church", "cinema"] },
        { "id": "it-a1-citta-1-u05", "rev": 1, "stage": "chunk", "text": "sa dov'è", "translation": "do you know where it is", "distractors": ["do you know what it is", "do you know when it is"] },
        { "id": "it-a1-citta-1-u06", "rev": 1, "stage": "sentence", "text": "Scusi, sa dov'è il museo?", "translation": "Excuse me, do you know where the museum is?", "distractors": ["Excuse me, do you know where the church is?", "Excuse me, do you know when the museum opens?"] },
        { "id": "it-a1-citta-1-u07", "rev": 1, "stage": "sentence", "text": "Mi dispiace, non lo so.", "translation": "I'm sorry, I don't know.", "distractors": ["I'm sorry, I don't understand.", "Yes, I know it."], "senses": {"3": "pron"} },
        { "id": "it-a1-citta-1-u08", "rev": 1, "stage": "word", "text": "lontano", "translation": "far", "distractors": ["near", "here"] },
        { "id": "it-a1-citta-1-u09", "rev": 1, "stage": "sentence", "text": "La stazione è lontana?", "translation": "Is the station far?", "distractors": ["Is the station near?", "Is the stop far?"] },
        { "id": "it-a1-citta-1-u10", "rev": 1, "stage": "phrase", "text": "qui vicino", "translation": "nearby", "distractors": ["far from here", "right here"] },
        { "id": "it-a1-citta-1-u11", "rev": 1, "stage": "sentence", "text": "No, è qui vicino, a cinque minuti.", "translation": "No, it's close by, five minutes away.", "distractors": ["No, it's close by, fifteen minutes away.", "Yes, it's far, five hours away."], "variants": ["No, è qui vicino, a 5 minuti."] },
        { "id": "it-a1-citta-1-u12", "rev": 1, "stage": "word", "text": "chiesa", "translation": "church", "distractors": ["museum", "square"] },
        { "id": "it-a1-citta-1-u13", "rev": 1, "stage": "phrase", "text": "vicino alla chiesa", "translation": "near the church", "distractors": ["behind the church", "far from the church"] },
        { "id": "it-a1-citta-1-u14", "rev": 1, "stage": "word", "text": "lì", "translation": "there", "distractors": ["here", "near"] },
        { "id": "it-a1-citta-1-u15", "rev": 1, "stage": "sentence", "text": "Il museo? È lì, vicino alla chiesa.", "translation": "The museum? It's there, near the church.", "distractors": ["The museum? It's there, behind the church.", "The museum? It's far, near the church."] }
      ]
    },
    {
      "id": "it-a1-citta-2",
      "title": "C'è una farmacia qui vicino?",
      "grammarFocus": ["c'è / ci sono", "cercare, trovare"],
      "units": [
        { "id": "it-a1-citta-2-u01", "rev": 1, "stage": "word", "text": "farmacia", "translation": "pharmacy", "distractors": ["bank", "bakery"] },
        { "id": "it-a1-citta-2-u02", "rev": 1, "stage": "chunk", "text": "c'è una farmacia", "translation": "is there a pharmacy", "distractors": ["is there a bank", "are there any pharmacies"] },
        { "id": "it-a1-citta-2-u03", "rev": 1, "stage": "sentence", "text": "Scusi, c'è una farmacia qui vicino?", "translation": "Excuse me, is there a pharmacy nearby?", "distractors": ["Excuse me, is there a bank nearby?", "Excuse me, is the pharmacy far?"] },
        { "id": "it-a1-citta-2-u04", "rev": 1, "stage": "word", "text": "banca", "translation": "bank", "distractors": ["pharmacy", "bench"] },
        { "id": "it-a1-citta-2-u05", "rev": 1, "stage": "word", "text": "cercare", "translation": "to look for", "distractors": ["to find", "to turn"] },
        { "id": "it-a1-citta-2-u06", "rev": 1, "stage": "sentence", "text": "Buongiorno, cerco una banca.", "translation": "Hello, I'm looking for a bank.", "distractors": ["Hello, I've found a bank.", "Hello, I'm looking for a pharmacy."] },
        { "id": "it-a1-citta-2-u07", "rev": 1, "stage": "word", "text": "supermercato", "translation": "supermarket", "distractors": ["market", "pharmacy"] },
        { "id": "it-a1-citta-2-u08", "rev": 1, "stage": "chunk", "text": "ci sono", "translation": "there are", "distractors": ["there is", "they are here"] },
        { "id": "it-a1-citta-2-u09", "rev": 1, "stage": "sentence", "text": "In questa via ci sono due supermercati.", "translation": "There are two supermarkets on this street.", "distractors": ["There are two pharmacies on this street.", "There's one supermarket on this street."], "commas": [2] },
        { "id": "it-a1-citta-2-u10", "rev": 1, "stage": "word", "text": "ristorante", "translation": "restaurant", "distractors": ["bar", "cinema"] },
        { "id": "it-a1-citta-2-u11", "rev": 1, "stage": "word", "text": "trovare", "translation": "to find", "distractors": ["to look for", "to cross"] },
        { "id": "it-a1-citta-2-u12", "rev": 1, "stage": "sentence", "text": "Non trovo il ristorante.", "translation": "I can't find the restaurant.", "distractors": ["I can't find the bank.", "I've found the restaurant."] },
        { "id": "it-a1-citta-2-u13", "rev": 1, "stage": "word", "text": "cinema", "translation": "cinema", "distractors": ["theater", "museum"] },
        { "id": "it-a1-citta-2-u14", "rev": 1, "stage": "sentence", "text": "Qui non c'è un cinema.", "translation": "There's no cinema here.", "distractors": ["There's a cinema here.", "There's no museum here."] },
        { "id": "it-a1-citta-2-u15", "rev": 1, "stage": "sentence", "text": "Ci sono molti ristoranti qui?", "translation": "Are there many restaurants here?", "distractors": ["Are there many cinemas here?", "Is there a restaurant here?"] }
      ]
    },
    {
      "id": "it-a1-citta-3",
      "title": "A destra, a sinistra",
      "grammarFocus": ["a destra, a sinistra, sempre dritto", "ordinals: la prima, la seconda, la terza", "deve + infinitive"],
      "units": [
        { "id": "it-a1-citta-3-u01", "rev": 1, "stage": "word", "text": "destra", "translation": "right", "distractors": ["left", "straight"] },
        { "id": "it-a1-citta-3-u02", "rev": 1, "stage": "word", "text": "sinistra", "translation": "left", "distractors": ["right", "back"] },
        { "id": "it-a1-citta-3-u03", "rev": 1, "stage": "word", "text": "girare", "translation": "to turn", "distractors": ["to cross", "to continue"] },
        { "id": "it-a1-citta-3-u04", "rev": 1, "stage": "word", "text": "semaforo", "translation": "traffic light", "distractors": ["corner", "crossing"] },
        { "id": "it-a1-citta-3-u05", "rev": 1, "stage": "chunk", "text": "deve girare a sinistra", "translation": "you have to turn left", "distractors": ["you have to turn right", "you don't have to turn left"] },
        { "id": "it-a1-citta-3-u06", "rev": 1, "stage": "sentence", "text": "Al semaforo deve girare a sinistra.", "translation": "At the traffic light you have to turn left.", "distractors": ["At the traffic light you have to turn right.", "After the traffic light you have to turn left."], "commas": [1] },
        { "id": "it-a1-citta-3-u07", "rev": 1, "stage": "sentence", "text": "Devo girare a destra o a sinistra?", "translation": "Do I turn right or left?", "distractors": ["Do I turn right or go straight on?", "Do they turn right or left?"] },
        { "id": "it-a1-citta-3-u08", "rev": 1, "stage": "phrase", "text": "sempre dritto", "translation": "straight on", "distractors": ["always right", "straight back"] },
        { "id": "it-a1-citta-3-u09", "rev": 1, "stage": "sentence", "text": "Continua sempre dritto fino alla piazza.", "translation": "Keep going straight on as far as the square.", "distractors": ["Keep going straight on as far as the station.", "Turn right when you get to the square."] },
