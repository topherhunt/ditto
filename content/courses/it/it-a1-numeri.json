        { "id": "it-a1-numeri-1-u03", "rev": 1, "stage": "word", "text": "sette", "translation": "seven", "distractors": ["six", "seventeen"], "variants": ["7"] },
        { "id": "it-a1-numeri-1-u04", "rev": 1, "stage": "phrase", "text": "sette euro", "translation": "seven euros", "distractors": ["six euros", "seventeen euros"], "variants": ["7 euro"] },
        { "id": "it-a1-numeri-1-u05", "rev": 1, "stage": "sentence", "text": "Sono sette euro, grazie.", "translation": "That's seven euros, thanks.", "distractors": ["That's six euros, thanks.", "That's seventeen euros, thanks."], "variants": ["Sono 7 euro, grazie."] },
        { "id": "it-a1-numeri-1-u06", "rev": 1, "stage": "phrase", "text": "da uno a dieci", "translation": "from one to ten", "distractors": ["from one to twenty", "from two to ten"], "variants": ["da uno a 10", "da 1 a dieci", "da 1 a 10"] },
        { "id": "it-a1-numeri-1-u07", "rev": 1, "stage": "sentence", "text": "Due panini costano dieci euro.", "translation": "Two sandwiches cost ten euros.", "distractors": ["Two croissants cost ten euros.", "Two sandwiches cost eight euros."], "variants": ["Due panini costano 10 euro.", "2 panini costano dieci euro.", "2 panini costano 10 euro."] },
        { "id": "it-a1-numeri-1-u08", "rev": 1, "stage": "phrase", "text": "undici euro", "translation": "eleven euros", "distractors": ["seven euros", "twelve euros"], "variants": ["11 euro"] },
        { "id": "it-a1-numeri-1-u09", "rev": 1, "stage": "sentence", "text": "Un vino e una birra sono undici euro.", "translation": "A wine and a beer are eleven euros.", "distractors": ["A wine and a beer are seven euros.", "A wine and a coffee are eleven euros."], "variants": ["Un vino e una birra sono 11 euro."] },
        { "id": "it-a1-numeri-1-u10", "rev": 1, "stage": "chunk", "text": "costa quindici euro", "translation": "it costs fifteen euros", "distractors": ["it costs fifty euros", "they cost fifteen euros"], "variants": ["costa 15 euro"] },
        { "id": "it-a1-numeri-1-u11", "rev": 1, "stage": "sentence", "text": "La bottiglia di vino costa quindici euro.", "translation": "The bottle of wine costs fifteen euros.", "distractors": ["The bottle of wine costs fifty euros.", "The glass of wine costs fifteen euros."], "variants": ["La bottiglia di vino costa 15 euro."] },
        { "id": "it-a1-numeri-1-u12", "rev": 1, "stage": "phrase", "text": "dodici, tredici, quattordici", "translation": "twelve, thirteen, fourteen", "distractors": ["twenty, thirty, forty", "two, three, four"], "variants": ["12, 13, 14"] },
        { "id": "it-a1-numeri-1-u13", "rev": 1, "stage": "word", "text": "numero", "translation": "number", "distractors": ["name", "phone"] },
        { "id": "it-a1-numeri-1-u14", "rev": 1, "stage": "sentence", "text": "Il numero è diciassette, non sedici.", "translation": "The number is seventeen, not sixteen.", "distractors": ["The number is sixteen, not seventeen.", "The number is seven, not six."], "variants": ["Il numero è diciassette, non 16.", "Il numero è 17, non sedici.", "Il numero è 17, non 16."] },
        { "id": "it-a1-numeri-1-u15", "rev": 1, "stage": "phrase", "text": "otto o nove", "translation": "eight or nine", "distractors": ["eight and nine", "eighteen or nineteen"], "variants": ["otto o 9", "8 o nove", "8 o 9"] },
        { "id": "it-a1-numeri-1-u16", "rev": 1, "stage": "sentence", "text": "Sono otto euro, non nove.", "translation": "That's eight euros, not nine.", "distractors": ["That's nine euros, not eight.", "That's eighteen euros, not nine."], "variants": ["Sono otto euro, non 9.", "Sono 8 euro, non nove.", "Sono 8 euro, non 9."] }
      ]
    },
    {
      "id": "it-a1-numeri-2",
      "title": "Quanti anni hai?",
      "grammarFocus": ["avere: ho, hai, ha", "age: ho vent'anni"],
      "units": [
        { "id": "it-a1-numeri-2-u01", "rev": 1, "stage": "word", "text": "avere", "translation": "to have", "distractors": ["to be", "to want"] },
        { "id": "it-a1-numeri-2-u02", "rev": 1, "stage": "chunk", "text": "quanti anni hai", "translation": "how old are you", "distractors": ["how old is he", "how many do you have"] },
        { "id": "it-a1-numeri-2-u03", "rev": 1, "stage": "sentence", "text": "Paola, quanti anni hai?", "translation": "Paola, how old are you?", "distractors": ["Paola, how old is he?", "Paola, where do you live?"] },
        { "id": "it-a1-numeri-2-u04", "rev": 1, "stage": "word", "text": "anno", "translation": "year", "distractors": ["month", "day"] },
        { "id": "it-a1-numeri-2-u05", "rev": 1, "stage": "chunk", "text": "ho vent'anni", "translation": "I'm twenty", "distractors": ["I'm thirty", "he's twenty"], "variants": ["ho 20 anni"] },
        { "id": "it-a1-numeri-2-u06", "rev": 1, "stage": "sentence", "text": "Ho vent'anni, e tu?", "translation": "I'm twenty, and you?", "distractors": ["I'm thirty, and you?", "He's twenty, and you?"], "variants": ["Ho 20 anni, e tu?"] },
        { "id": "it-a1-numeri-2-u07", "rev": 1, "stage": "phrase", "text": "trenta, quaranta, cinquanta, sessanta", "translation": "thirty, forty, fifty, sixty", "distractors": ["thirteen, fourteen, fifteen, sixteen", "thirty, forty, fifty, seventy"], "variants": ["30, 40, 50, 60"] },
        { "id": "it-a1-numeri-2-u08", "rev": 1, "stage": "chunk", "text": "ha trent'anni", "translation": "he's thirty", "distractors": ["I'm thirty", "he's thirteen"], "variants": ["ha 30 anni"] },
        { "id": "it-a1-numeri-2-u09", "rev": 1, "stage": "word", "text": "diciotto", "translation": "eighteen", "distractors": ["eighty", "eight"], "variants": ["18"] },
        { "id": "it-a1-numeri-2-u10", "rev": 1, "stage": "sentence", "text": "Marco ha trent'anni, Anna ha diciotto anni.", "translation": "Marco is thirty, Anna is eighteen.", "distractors": ["Marco is thirteen, Anna is eighteen.", "Marco is thirty, Anna is eighty."], "variants": ["Marco ha trent'anni, Anna ha 18 anni.", "Marco ha 30 anni, Anna ha diciotto anni.", "Marco ha 30 anni, Anna ha 18 anni."] },
        { "id": "it-a1-numeri-2-u11", "rev": 1, "stage": "phrase", "text": "settanta, ottanta, novanta, cento", "translation": "seventy, eighty, ninety, a hundred", "distractors": ["seventeen, eighteen, nineteen, twenty", "sixty, seventy, eighty, ninety"], "variants": ["70, 80, 90, 100"] },
        { "id": "it-a1-numeri-2-u12", "rev": 1, "stage": "sentence", "text": "La signora Bianchi ha ottant'anni.", "translation": "Mrs Bianchi is eighty.", "distractors": ["Mrs Bianchi is eighteen.", "Mr Bianchi is eighty."], "variants": ["La signora Bianchi ha 80 anni."] },
        { "id": "it-a1-numeri-2-u13", "rev": 1, "stage": "sentence", "text": "Settant'anni? Non è vero!", "translation": "Seventy? That's not true!", "distractors": ["Seventeen? That's not true!", "Seventy? That's true!"], "variants": ["70 anni? Non è vero!"] },
        { "id": "it-a1-numeri-2-u14", "rev": 1, "stage": "phrase", "text": "il mio amico", "translation": "my friend", "distractors": ["your friend", "his friend"] },
        { "id": "it-a1-numeri-2-u15", "rev": 1, "stage": "sentence", "text": "Il mio amico ha cinquant'anni.", "translation": "My friend is fifty.", "distractors": ["Your friend is fifty.", "My friend is fifteen."], "variants": ["Il mio amico ha 50 anni."] },
        { "id": "it-a1-numeri-2-u16", "rev": 1, "stage": "sentence", "text": "Hai sedici anni, vero?", "translation": "You're sixteen, aren't you?", "distractors": ["You're sixty, aren't you?", "He's sixteen, isn't he?"], "variants": ["Hai 16 anni, vero?"] }
      ]
    },
    {
      "id": "it-a1-numeri-3",
      "title": "Il numero di telefono",
      "grammarFocus": ["qual è...?", "mio and tuo: il mio numero, il tuo numero"],
      "units": [
        { "id": "it-a1-numeri-3-u01", "rev": 1, "stage": "word", "text": "telefono", "translation": "phone", "distractors": ["number", "name"] },
        { "id": "it-a1-numeri-3-u02", "rev": 1, "stage": "phrase", "text": "numero di telefono", "translation": "phone number", "distractors": ["house number", "phone bill"] },
        { "id": "it-a1-numeri-3-u03", "rev": 1, "stage": "chunk", "text": "qual è", "translation": "what is", "distractors": ["where is", "who is"] },
        { "id": "it-a1-numeri-3-u04", "rev": 1, "stage": "sentence", "text": "Qual è il tuo numero di telefono?", "translation": "What's your phone number?", "distractors": ["What's my phone number?", "What's your house number?"] },
        { "id": "it-a1-numeri-3-u05", "rev": 1, "stage": "word", "text": "cellulare", "translation": "mobile phone", "distractors": ["landline", "computer"] },
        { "id": "it-a1-numeri-3-u06", "rev": 1, "stage": "sentence", "text": "Hai un numero di cellulare?", "translation": "Do you have a mobile number?", "distractors": ["Does he have a mobile number?", "Do you have a mobile phone?"] },
        { "id": "it-a1-numeri-3-u07", "rev": 1, "stage": "word", "text": "prefisso", "translation": "area code", "distractors": ["phone number", "country"] },
        { "id": "it-a1-numeri-3-u08", "rev": 1, "stage": "sentence", "text": "Il prefisso di Roma è zero sei.", "translation": "The area code for Rome is zero six.", "distractors": ["The area code for Milan is zero six.", "The area code for Rome is zero nine."], "variants": ["Il prefisso di Roma è 06.", "Il prefisso di Roma è 0 6."] },
        { "id": "it-a1-numeri-3-u09", "rev": 1, "stage": "phrase", "text": "tre tre otto", "translation": "three three eight", "distractors": ["three three six", "three eight eight"], "variants": ["338", "3 3 8"] },
        { "id": "it-a1-numeri-3-u10", "rev": 1, "stage": "sentence", "text": "Scusi, è tre tre otto o tre tre sei?", "translation": "Sorry, is it three three eight or three three six?", "distractors": ["Sorry, is it three three eight or three six six?", "Sorry, is it three eight eight or three three six?"], "variants": ["Scusi, è tre tre otto o 336?", "Scusi, è 338 o tre tre sei?", "Scusi, è 338 o 336?", "Scusi, è 3 3 8 o 3 3 6?"] },
        { "id": "it-a1-numeri-3-u11", "rev": 1, "stage": "sentence", "text": "Può ripetere il numero, per favore?", "translation": "Could you repeat the number, please?", "distractors": ["Could you write the number, please?", "Could you repeat the name, please?"] },
        { "id": "it-a1-numeri-3-u12", "rev": 1, "stage": "chunk", "text": "il mio numero", "translation": "my number", "distractors": ["your number", "my name"] },
        { "id": "it-a1-numeri-3-u13", "rev": 1, "stage": "chunk", "text": "ti scrivo il mio numero", "translation": "I'll write you my number", "distractors": ["I'll write you my name", "you'll write me your number"] },
        { "id": "it-a1-numeri-3-u14", "rev": 1, "stage": "sentence", "text": "Ti scrivo il mio numero qui.", "translation": "I'll write my number here for you.", "distractors": ["I'll write my name here for you.", "Write your number here for me."] },
        { "id": "it-a1-numeri-3-u15", "rev": 1, "stage": "sentence", "text": "Hai il numero di Marco?", "translation": "Do you have Marco's number?", "distractors": ["Does Marco have your number?", "Do you have Marco's address?"] }
      ]
    },
    {
      "id": "it-a1-numeri-4",
      "title": "Che ore sono?",
      "grammarFocus": ["che ore sono? / è l'una, sono le tre", "e mezza, e un quarto, meno un quarto"],
      "units": [
        { "id": "it-a1-numeri-4-u01", "rev": 1, "stage": "word", "text": "ora", "translation": "hour", "distractors": ["minute", "day"] },
        { "id": "it-a1-numeri-4-u02", "rev": 1, "stage": "chunk", "text": "che ore sono", "translation": "what time is it", "distractors": ["what day is it", "how old are you"] },
        { "id": "it-a1-numeri-4-u03", "rev": 1, "stage": "sentence", "text": "Scusi, che ore sono?", "translation": "Excuse me, what time is it?", "distractors": ["Excuse me, what day is it?", "Excuse me, what's the date?"] },
        { "id": "it-a1-numeri-4-u04", "rev": 1, "stage": "chunk", "text": "sono le tre", "translation": "it's three o'clock", "distractors": ["it's two o'clock", "it's three minutes"], "variants": ["sono le 3"] },
        { "id": "it-a1-numeri-4-u05", "rev": 1, "stage": "sentence", "text": "Sono le tre e venti.", "translation": "It's twenty past three.", "distractors": ["It's twenty to three.", "It's ten past three."], "variants": ["Sono le tre e 20.", "Sono le 3 e venti.", "Sono le 3 e 20."] },
        { "id": "it-a1-numeri-4-u06", "rev": 1, "stage": "phrase", "text": "le otto e mezza", "translation": "half past eight", "distractors": ["half past nine", "a quarter past eight"], "variants": ["le 8 e mezza"] },
        { "id": "it-a1-numeri-4-u07", "rev": 1, "stage": "sentence", "text": "Adesso sono le otto e mezza.", "translation": "It's half past eight now.", "distractors": ["It's half past nine now.", "It's a quarter past eight now."], "variants": ["Adesso sono le 8 e mezza."] },
        { "id": "it-a1-numeri-4-u08", "rev": 1, "stage": "word", "text": "quarto", "translation": "quarter", "distractors": ["half", "minute"] },
        { "id": "it-a1-numeri-4-u09", "rev": 1, "stage": "phrase", "text": "meno un quarto", "translation": "a quarter to", "distractors": ["a quarter past", "half past"] },
        { "id": "it-a1-numeri-4-u10", "rev": 1, "stage": "sentence", "text": "Sono le nove meno un quarto.", "translation": "It's a quarter to nine.", "distractors": ["It's a quarter past nine.", "It's a quarter to eight."], "variants": ["Sono le 9 meno un quarto."] },
        { "id": "it-a1-numeri-4-u11", "rev": 1, "stage": "chunk", "text": "è l'una", "translation": "it's one o'clock", "distractors": ["it's two o'clock", "it's noon"] },
        { "id": "it-a1-numeri-4-u12", "rev": 1, "stage": "sentence", "text": "È l'una e un quarto.", "translation": "It's a quarter past one.", "distractors": ["It's a quarter to one.", "It's half past one."] },
        { "id": "it-a1-numeri-4-u13", "rev": 1, "stage": "word", "text": "mezzogiorno", "translation": "noon", "distractors": ["midnight", "afternoon"] },
        { "id": "it-a1-numeri-4-u14", "rev": 1, "stage": "sentence", "text": "Adesso è mezzogiorno.", "translation": "It's noon now.", "distractors": ["It's midnight now.", "It's not noon now."] },
        { "id": "it-a1-numeri-4-u15", "rev": 1, "stage": "word", "text": "mezzanotte", "translation": "midnight", "distractors": ["noon", "evening"] },
        { "id": "it-a1-numeri-4-u16", "rev": 1, "stage": "sentence", "text": "È mezzanotte, buonanotte!", "translation": "It's midnight, good night!", "distractors": ["It's noon, good night!", "It's midnight, good morning!"] }
      ]
    },
    {
      "id": "it-a1-numeri-5",
      "title": "A che ora apre?",
      "grammarFocus": ["a che ora?", "alle + time: alle nove, all'una", "fino a"],
      "units": [
        { "id": "it-a1-numeri-5-u01", "rev": 1, "stage": "word", "text": "negozio", "translation": "shop", "distractors": ["office", "market"] },
        { "id": "it-a1-numeri-5-u02", "rev": 1, "stage": "chunk", "text": "a che ora apre", "translation": "what time does it open", "distractors": ["what time does it close", "what time is it"] },
        { "id": "it-a1-numeri-5-u03", "rev": 1, "stage": "sentence", "text": "A che ora apre il negozio?", "translation": "What time does the shop open?", "distractors": ["What time does the shop close?", "What time does the bank open?"] },
        { "id": "it-a1-numeri-5-u04", "rev": 1, "stage": "phrase", "text": "alle nove", "translation": "at nine", "distractors": ["at ten", "before nine"], "variants": ["alle 9"] },
        { "id": "it-a1-numeri-5-u05", "rev": 1, "stage": "sentence", "text": "Apre alle nove di mattina.", "translation": "It opens at nine in the morning.", "distractors": ["It closes at nine in the morning.", "It opens at nine in the evening."], "variants": ["Apre alle 9 di mattina."] },
        { "id": "it-a1-numeri-5-u06", "rev": 1, "stage": "word", "text": "chiudere", "translation": "to close", "distractors": ["to open", "to pay"] },
        { "id": "it-a1-numeri-5-u07", "rev": 1, "stage": "sentence", "text": "Il negozio chiude alle diciannove e trenta.", "translation": "The shop closes at seven thirty p.m.", "distractors": ["The shop opens at seven thirty p.m.", "The shop closes at nine thirty p.m."], "variants": ["Il negozio chiude alle diciannove e 30.", "Il negozio chiude alle 19 e trenta.", "Il negozio chiude alle 19 e 30.", "Il negozio chiude alle 19:30."] },
        { "id": "it-a1-numeri-5-u08", "rev": 1, "stage": "word", "text": "chiuso", "translation": "closed", "distractors": ["open", "full"] },
        { "id": "it-a1-numeri-5-u09", "rev": 1, "stage": "phrase", "text": "fino alle quattro", "translation": "until four", "distractors": ["from four", "after four"], "variants": ["fino alle 4"] },
        { "id": "it-a1-numeri-5-u10", "rev": 1, "stage": "sentence", "text": "Il pomeriggio è chiuso fino alle quattro.", "translation": "In the afternoon it's closed until four.", "distractors": ["In the afternoon it's open until four.", "In the morning it's closed until four."], "variants": ["Il pomeriggio è chiuso fino alle 4."] },
        { "id": "it-a1-numeri-5-u11", "rev": 1, "stage": "sentence", "text": "Sei qui fino alle sei?", "translation": "Are you here until six?", "distractors": ["Are you here until seven?", "Is he here until six?"], "variants": ["Sei qui fino alle 6?"], "senses": {"4": "num"} },
        { "id": "it-a1-numeri-5-u12", "rev": 1, "stage": "chunk", "text": "mancano dieci minuti", "translation": "it's ten minutes to", "distractors": ["it's ten minutes past", "it was ten minutes ago"], "variants": ["mancano 10 minuti"] },
        { "id": "it-a1-numeri-5-u13", "rev": 1, "stage": "sentence", "text": "Mancano dieci minuti alle otto.", "translation": "It's ten minutes to eight.", "distractors": ["It's ten minutes past eight.", "It's ten minutes to nine."], "variants": ["Mancano dieci minuti alle 8.", "Mancano 10 minuti alle otto.", "Mancano 10 minuti alle 8."] },
        { "id": "it-a1-numeri-5-u14", "rev": 1, "stage": "sentence", "text": "Scusi, a che ora chiude oggi?", "translation": "Excuse me, what time do you close today?", "distractors": ["Excuse me, what time do you open today?", "Excuse me, what time do you close tomorrow?"] }
      ]
    },
    {
      "id": "it-a1-numeri-6",
      "title": "I giorni della settimana",
      "grammarFocus": ["days of the week", "il sabato = on Saturdays", "oggi, domani"],
      "units": [
        { "id": "it-a1-numeri-6-u01", "rev": 1, "stage": "word", "text": "giorno", "translation": "day", "distractors": ["week", "year"] },
        { "id": "it-a1-numeri-6-u02", "rev": 1, "stage": "chunk", "text": "che giorno è", "translation": "what day is it", "distractors": ["what time is it", "how old is he"] },
        { "id": "it-a1-numeri-6-u03", "rev": 1, "stage": "sentence", "text": "Che giorno è oggi?", "translation": "What day is it today?", "distractors": ["What time is it today?", "What day is it tomorrow?"] },
        { "id": "it-a1-numeri-6-u04", "rev": 1, "stage": "phrase", "text": "lunedì, martedì, mercoledì", "translation": "Monday, Tuesday, Wednesday", "distractors": ["Tuesday, Wednesday, Thursday", "Sunday, Monday, Tuesday"] },
        { "id": "it-a1-numeri-6-u05", "rev": 1, "stage": "sentence", "text": "Oggi è giovedì, domani è venerdì.", "translation": "Today is Thursday, tomorrow is Friday.", "distractors": ["Today is Friday, tomorrow is Saturday.", "Today is Thursday, yesterday was Wednesday."] },
        { "id": "it-a1-numeri-6-u06", "rev": 1, "stage": "word", "text": "settimana", "translation": "week", "distractors": ["month", "weekend"] },
        { "id": "it-a1-numeri-6-u07", "rev": 1, "stage": "sentence", "text": "Il negozio è aperto sette giorni alla settimana.", "translation": "The shop is open seven days a week.", "distractors": ["The shop is open six days a week.", "The shop is open seven hours a day."], "variants": ["Il negozio è aperto 7 giorni alla settimana."] },
        { "id": "it-a1-numeri-6-u08", "rev": 1, "stage": "phrase", "text": "il sabato", "translation": "on Saturdays", "distractors": ["this Saturday", "on Sundays"] },
        { "id": "it-a1-numeri-6-u09", "rev": 1, "stage": "sentence", "text": "Il sabato è aperto, la domenica è chiuso.", "translation": "It's open on Saturdays and closed on Sundays.", "distractors": ["It's closed on Saturdays and open on Sundays.", "It's open on Saturdays and closed on Mondays."] },
        { "id": "it-a1-numeri-6-u10", "rev": 1, "stage": "phrase", "text": "venerdì sera", "translation": "Friday evening", "distractors": ["Friday morning", "Saturday evening"] },
        { "id": "it-a1-numeri-6-u11", "rev": 1, "stage": "sentence", "text": "Venerdì sera no, ma sabato mattina va bene.", "translation": "Not Friday evening, but Saturday morning is fine.", "distractors": ["Not Friday morning, but Saturday evening is fine.", "Not Friday evening, but Sunday morning is fine."], "commas": [1] },
        { "id": "it-a1-numeri-6-u12", "rev": 1, "stage": "word", "text": "tardi", "translation": "late", "distractors": ["early", "soon"] },
        { "id": "it-a1-numeri-6-u13", "rev": 1, "stage": "sentence", "text": "È tardi, sono le undici di notte.", "translation": "It's late, it's eleven at night.", "distractors": ["It's early, it's eleven at night.", "It's late, it's eleven in the morning."], "variants": ["È tardi, sono le 11 di notte."] },
        { "id": "it-a1-numeri-6-u14", "rev": 1, "stage": "word", "text": "presto", "translation": "early", "distractors": ["late", "now"] },
        { "id": "it-a1-numeri-6-u15", "rev": 1, "stage": "sentence", "text": "Sabato alle sette? È presto!", "translation": "Saturday at seven? That's early!", "distractors": ["Saturday at seven? That's late!", "Sunday at seven? That's early!"], "variants": ["Sabato alle 7? È presto!"] }
      ]
    }
  ]
}
