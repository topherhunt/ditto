  "lessons": [
    {
      "id": "it-a2-feste-1",
      "title": "Buon compleanno!",
      "grammarFocus": ["buon compleanno, tanti auguri", "dates: il tre maggio", "ti as an indirect object"],
      "units": [
        { "id": "it-a2-feste-1-u01", "rev": 1, "stage": "chunk", "text": "buon compleanno", "translation": "happy birthday", "distractors": ["happy anniversary", "happy holidays"] },
        { "id": "it-a2-feste-1-u02", "rev": 1, "stage": "sentence", "text": "Buon compleanno, Marco!", "translation": "Happy birthday, Marco!", "distractors": ["Happy anniversary, Marco!", "Happy New Year, Marco!"] },
        { "id": "it-a2-feste-1-u03", "rev": 1, "stage": "phrase", "text": "tanti auguri", "translation": "best wishes", "distractors": ["many thanks", "many gifts"] },
        { "id": "it-a2-feste-1-u04", "rev": 1, "stage": "sentence", "text": "Tanti auguri, nonna!", "translation": "Best wishes, Grandma!", "distractors": ["Many thanks, Grandma!", "Best wishes, Grandpa!"] },
        { "id": "it-a2-feste-1-u05", "rev": 1, "stage": "word", "text": "data", "translation": "date", "distractors": ["year", "time"] },
        { "id": "it-a2-feste-1-u06", "rev": 1, "stage": "sentence", "text": "Il mio compleanno è il tre maggio.", "translation": "My birthday is on May third.", "distractors": ["My birthday is on May fourth.", "My brother's birthday is on May third."], "variants": ["Il mio compleanno è il 3 maggio."] },
        { "id": "it-a2-feste-1-u07", "rev": 1, "stage": "word", "text": "festeggiare", "translation": "to celebrate", "distractors": ["to invite", "to thank"] },
        { "id": "it-a2-feste-1-u08", "rev": 1, "stage": "sentence", "text": "Domani Giulia festeggia i suoi trent'anni.", "translation": "Tomorrow Giulia is celebrating her thirtieth birthday.", "distractors": ["Tomorrow Giulia is celebrating her fortieth birthday.", "Today Giulia is celebrating her thirtieth birthday."], "variants": ["Domani Giulia festeggia i suoi 30 anni."], "commas": [0] },
        { "id": "it-a2-feste-1-u09", "rev": 1, "stage": "word", "text": "torta", "translation": "cake", "distractors": ["candle", "card"] },
        { "id": "it-a2-feste-1-u10", "rev": 1, "stage": "phrase", "text": "una torta al cioccolato", "translation": "a chocolate cake", "distractors": ["a fruit cake", "a chocolate bar"] },
        { "id": "it-a2-feste-1-u11", "rev": 1, "stage": "sentence", "text": "Ti ho fatto una torta al cioccolato.", "translation": "I made you a chocolate cake.", "distractors": ["You made me a chocolate cake.", "I bought you a chocolate cake."] },
        { "id": "it-a2-feste-1-u12", "rev": 1, "stage": "word", "text": "candela", "translation": "candle", "distractors": ["cake", "flower"] },
        { "id": "it-a2-feste-1-u13", "rev": 1, "stage": "phrase", "text": "trenta candele", "translation": "thirty candles", "distractors": ["thirteen candles", "thirty cakes"], "variants": ["30 candele"] },
        { "id": "it-a2-feste-1-u14", "rev": 1, "stage": "sentence", "text": "Sulla torta ci sono trenta candele!", "translation": "There are thirty candles on the cake!", "distractors": ["There are thirteen candles on the cake!", "There are thirty candles on the table!"], "variants": ["Sulla torta ci sono 30 candele!"] },
        { "id": "it-a2-feste-1-u15", "rev": 1, "stage": "sentence", "text": "Mi hai fatto una bella sorpresa, grazie!", "translation": "You gave me a lovely surprise, thanks!", "distractors": ["I gave you a lovely surprise, thanks!", "You gave me a lovely present, thanks!"] }
      ]
    },
    {
      "id": "it-a2-feste-2",
      "title": "Cosa gli regalo?",
      "grammarFocus": ["gli = to him, to them", "le = to her", "regalare and dare"],
      "units": [
        { "id": "it-a2-feste-2-u01", "rev": 1, "stage": "word", "text": "regalo", "translation": "gift", "distractors": ["card", "party"] },
        { "id": "it-a2-feste-2-u02", "rev": 1, "stage": "chunk", "text": "cosa gli regalo", "translation": "what should I get him", "distractors": ["what did I get him", "what should I get her"], "senses": { "1": "pron"} },
        { "id": "it-a2-feste-2-u03", "rev": 1, "stage": "sentence", "text": "È il compleanno di Luca: cosa gli regalo?", "translation": "It's Luca's birthday: what should I get him?", "distractors": ["It's Luca's birthday: what did you get him?", "It's Luca's party: what should I get him?"], "senses": { "6": "pron"} },
        { "id": "it-a2-feste-2-u04", "rev": 1, "stage": "phrase", "text": "un regalo utile", "translation": "a useful gift", "distractors": ["a useless gift", "a useful book"] },
        { "id": "it-a2-feste-2-u05", "rev": 1, "stage": "sentence", "text": "Gli regaliamo qualcosa di utile.", "translation": "We'll give him something useful.", "distractors": ["We'll give her something useful.", "We'll give him something pretty."], "senses": { "0": "pron"} },
        { "id": "it-a2-feste-2-u06", "rev": 1, "stage": "word", "text": "carino", "translation": "pretty", "distractors": ["useful", "expensive"] },
        { "id": "it-a2-feste-2-u07", "rev": 1, "stage": "sentence", "text": "Questa borsa è carina, ma costa troppo.", "translation": "This bag is pretty, but it costs too much.", "distractors": ["This bag is pretty, and it doesn't cost much.", "This shirt is pretty, but it costs too much."] },
        { "id": "it-a2-feste-2-u08", "rev": 1, "stage": "chunk", "text": "le regalo dei fiori", "translation": "I'll give her some flowers", "distractors": ["I'll give him some flowers", "I'll give her some chocolates"], "senses": { "0": "pron"} },
        { "id": "it-a2-feste-2-u09", "rev": 1, "stage": "sentence", "text": "Per la festa della mamma le regalo dei fiori.", "translation": "For Mother's Day, I'm giving her flowers.", "distractors": ["For Mother's Day, I'm giving her chocolates.", "For her birthday, I'm giving her flowers."], "commas": [4], "senses": { "5": "pron"} },
        { "id": "it-a2-feste-2-u10", "rev": 1, "stage": "word", "text": "anniversario", "translation": "anniversary", "distractors": ["birthday", "wedding"] },
        { "id": "it-a2-feste-2-u11", "rev": 1, "stage": "sentence", "text": "I miei genitori festeggiano l'anniversario di matrimonio.", "translation": "My parents are celebrating their wedding anniversary.", "distractors": ["My grandparents are celebrating their wedding anniversary.", "My parents celebrated their wedding anniversary."] },
        { "id": "it-a2-feste-2-u12", "rev": 1, "stage": "word", "text": "dare", "translation": "to give", "distractors": ["to take", "to send"] },
        { "id": "it-a2-feste-2-u13", "rev": 1, "stage": "sentence", "text": "Gli diamo un regalo insieme?", "translation": "Shall we give them a present together?", "distractors": ["Shall we give them a present separately?", "Shall we send them a present together?"], "senses": { "0": "pron"} },
        { "id": "it-a2-feste-2-u14", "rev": 1, "stage": "chunk", "text": "le ho dato", "translation": "I gave her", "distractors": ["I gave him", "she gave me"], "senses": { "0": "pron"} },
        { "id": "it-a2-feste-2-u15", "rev": 1, "stage": "sentence", "text": "Le ho dato il mio regalo, ma non l'ha ancora aperto.", "translation": "I gave her my gift, but she hasn't opened it yet.", "distractors": ["I gave him my gift, but he hasn't opened it yet.", "I gave her my gift, and she has already opened it."], "senses": { "0": "pron"} }
      ]
    },
    {
      "id": "it-a2-feste-3",
      "title": "Le piacciono i fiori",
      "grammarFocus": ["piacere with every person: mi, ti, gli, le, ci, vi", "ti è piaciuto"],
      "units": [
        { "id": "it-a2-feste-3-u01", "rev": 1, "stage": "chunk", "text": "le piacciono", "translation": "she likes", "distractors": ["he likes", "she liked"], "senses": { "0": "pron"} },
        { "id": "it-a2-feste-3-u02", "rev": 1, "stage": "sentence", "text": "Le piacciono molto i fiori.", "translation": "She really likes flowers.", "distractors": ["He really likes flowers.", "She doesn't like flowers."], "senses": { "0": "pron"} },
        { "id": "it-a2-feste-3-u03", "rev": 1, "stage": "word", "text": "fiore", "translation": "flower", "distractors": ["plant", "gift"] },
        { "id": "it-a2-feste-3-u04", "rev": 1, "stage": "phrase", "text": "fiori rossi", "translation": "red flowers", "distractors": ["white flowers", "red candles"] },
        { "id": "it-a2-feste-3-u05", "rev": 1, "stage": "sentence", "text": "Le porto dei fiori rossi o bianchi?", "translation": "Shall I bring her red or white flowers?", "distractors": ["Shall I bring him red or white flowers?", "Shall I bring her red or yellow flowers?"], "senses": { "0": "pron"} },
        { "id": "it-a2-feste-3-u06", "rev": 1, "stage": "chunk", "text": "gli piace", "translation": "he likes", "distractors": ["she likes", "he liked"], "senses": { "0": "pron"} },
        { "id": "it-a2-feste-3-u07", "rev": 1, "stage": "word", "text": "cioccolato", "translation": "chocolate", "distractors": ["candy", "cake"] },
        { "id": "it-a2-feste-3-u08", "rev": 1, "stage": "sentence", "text": "Gli piace tanto il cioccolato.", "translation": "He really likes chocolate.", "distractors": ["She really likes chocolate.", "He really likes cake."], "senses": { "0": "pron"} },
        { "id": "it-a2-feste-3-u09", "rev": 1, "stage": "chunk", "text": "vi piacciono", "translation": "you all like", "distractors": ["we like", "they like"] },
        { "id": "it-a2-feste-3-u10", "rev": 1, "stage": "sentence", "text": "Ragazzi, vi piacciono i dolci?", "translation": "Guys, do you like sweets?", "distractors": ["Guys, did you like the sweets?", "Guys, do you like chocolate?"] },
        { "id": "it-a2-feste-3-u11", "rev": 1, "stage": "phrase", "text": "i regali utili", "translation": "useful gifts", "distractors": ["pretty gifts", "useful cards"] },
        { "id": "it-a2-feste-3-u12", "rev": 1, "stage": "sentence", "text": "A mio padre piacciono i regali utili.", "translation": "My father likes useful gifts.", "distractors": ["My mother likes useful gifts.", "My father likes pretty gifts."] },
        { "id": "it-a2-feste-3-u13", "rev": 1, "stage": "sentence", "text": "Ti è piaciuto il regalo?", "translation": "Did you like the gift?", "distractors": ["Did he like the gift?", "Do you like the gift?"] },
        { "id": "it-a2-feste-3-u14", "rev": 1, "stage": "sentence", "text": "Sì, mi è piaciuto moltissimo, grazie!", "translation": "Yes, I liked it very much, thanks!", "distractors": ["Yes, she liked it very much, thanks!", "No, I didn't like it much, thanks!"] }
      ]
    },
    {
      "id": "it-a2-feste-4",
      "title": "La festa",
      "grammarFocus": ["vi and ci as indirect objects", "offrire, dare una festa"],
      "units": [
        { "id": "it-a2-feste-4-u01", "rev": 1, "stage": "word", "text": "festa", "translation": "party", "distractors": ["dinner", "gift"] },
        { "id": "it-a2-feste-4-u02", "rev": 1, "stage": "word", "text": "invito", "translation": "invitation", "distractors": ["gift", "card"] },
        { "id": "it-a2-feste-4-u03", "rev": 1, "stage": "sentence", "text": "Ho ricevuto un invito alla festa di Anna.", "translation": "I got an invitation to Anna's party.", "distractors": ["I sent an invitation to Anna's party.", "I got an invitation to Anna's wedding."] },
        { "id": "it-a2-feste-4-u04", "rev": 1, "stage": "word", "text": "ospite", "translation": "guest", "distractors": ["neighbor", "friend"] },
        { "id": "it-a2-feste-4-u05", "rev": 1, "stage": "phrase", "text": "venti ospiti", "translation": "twenty guests", "distractors": ["thirty guests", "twenty friends"], "variants": ["20 ospiti"] },
        { "id": "it-a2-feste-4-u06", "rev": 1, "stage": "sentence", "text": "Sabato diamo una festa con venti ospiti.", "translation": "On Saturday we're throwing a party with twenty guests.", "distractors": ["On Sunday we're throwing a party with twenty guests.", "On Saturday we're going to a party with twenty guests."], "variants": ["Sabato diamo una festa con 20 ospiti."], "commas": [0] },
        { "id": "it-a2-feste-4-u07", "rev": 1, "stage": "chunk", "text": "vi offro qualcosa", "translation": "I'll offer you something", "distractors": ["you'll offer me something", "I'll offer them something"] },
        { "id": "it-a2-feste-4-u08", "rev": 1, "stage": "sentence", "text": "Benvenuti! Vi offro qualcosa da bere?", "translation": "Welcome! Can I offer you something to drink?", "distractors": ["Welcome! Can I offer you something to eat?", "Welcome! Can you offer me something to drink?"] },
        { "id": "it-a2-feste-4-u09", "rev": 1, "stage": "word", "text": "brindare", "translation": "to toast", "distractors": ["to celebrate", "to dance"] },
        { "id": "it-a2-feste-4-u10", "rev": 1, "stage": "phrase", "text": "con lo spumante", "translation": "with sparkling wine", "distractors": ["with red wine", "with the cake"] },
        { "id": "it-a2-feste-4-u11", "rev": 1, "stage": "sentence", "text": "Abbiamo brindato alla salute di Anna con lo spumante.", "translation": "We drank to Anna's health with sparkling wine.", "distractors": ["We drank to Anna's health with red wine.", "We drank to Marco's health with sparkling wine."] },
        { "id": "it-a2-feste-4-u12", "rev": 1, "stage": "chunk", "text": "ci ha offerto la cena", "translation": "he treated us to dinner", "distractors": ["we treated him to dinner", "he treated us to lunch"] },
        { "id": "it-a2-feste-4-u13", "rev": 1, "stage": "sentence", "text": "Il papà di Anna ci ha offerto la cena.", "translation": "Anna's dad treated us to dinner.", "distractors": ["Anna's mom treated us to dinner.", "Anna's dad treated us to lunch."] },
        { "id": "it-a2-feste-4-u14", "rev": 1, "stage": "chunk", "text": "ci siamo divertiti", "translation": "we had fun", "distractors": ["we got bored", "you had fun"] },
        { "id": "it-a2-feste-4-u15", "rev": 1, "stage": "sentence", "text": "È stata una bella festa: ci siamo divertiti molto.", "translation": "It was a great party: we had a lot of fun.", "distractors": ["It was a great party: they had a lot of fun.", "It was a great dinner: we had a lot of fun."] }
      ]
    },
    {
      "id": "it-a2-feste-5",
      "title": "Natale e Capodanno",
      "grammarFocus": ["a Natale, a Capodanno", "vi mandiamo, ci regalano"],
      "units": [
        { "id": "it-a2-feste-5-u01", "rev": 1, "stage": "phrase", "text": "buon Natale", "translation": "Merry Christmas", "distractors": ["Happy New Year", "Happy Easter"] },
        { "id": "it-a2-feste-5-u02", "rev": 1, "stage": "sentence", "text": "Buon Natale a tutti!", "translation": "Merry Christmas, everyone!", "distractors": ["Happy New Year, everyone!", "Merry Christmas to you too!"] },
        { "id": "it-a2-feste-5-u03", "rev": 1, "stage": "word", "text": "tradizione", "translation": "tradition", "distractors": ["holiday", "celebration"] },
        { "id": "it-a2-feste-5-u04", "rev": 1, "stage": "phrase", "text": "il panettone", "translation": "the panettone", "distractors": ["the Christmas tree", "the chocolate cake"] },
        { "id": "it-a2-feste-5-u05", "rev": 1, "stage": "sentence", "text": "In Italia è tradizione mangiare il panettone a Natale.", "translation": "In Italy it's a tradition to eat panettone at Christmas.", "distractors": ["In Italy it's a tradition to eat panettone at Easter.", "In Italy it's a tradition to make panettone at Christmas."], "commas": [1] },
        { "id": "it-a2-feste-5-u06", "rev": 1, "stage": "word", "text": "cartolina", "translation": "card", "distractors": ["letter", "invitation"] },
        { "id": "it-a2-feste-5-u07", "rev": 1, "stage": "chunk", "text": "vi mandiamo", "translation": "we're sending you", "distractors": ["we're sending them", "you're sending us"] },
        { "id": "it-a2-feste-5-u08", "rev": 1, "stage": "sentence", "text": "Vi mandiamo una cartolina di auguri da Roma.", "translation": "We're sending you a greeting card from Rome.", "distractors": ["We're sending them a greeting card from Rome.", "We're sending you a greeting card from Milan."] },
        { "id": "it-a2-feste-5-u09", "rev": 1, "stage": "phrase", "text": "la vigilia di Natale", "translation": "Christmas Eve", "distractors": ["Christmas Day", "New Year's Eve"] },
        { "id": "it-a2-feste-5-u10", "rev": 1, "stage": "sentence", "text": "La vigilia di Natale ceniamo tutti insieme dai nonni.", "translation": "On Christmas Eve we all have dinner together at our grandparents'.", "distractors": ["On Christmas Eve we all have lunch together at our grandparents'.", "On New Year's Eve we all have dinner together at our grandparents'."], "commas": [3] },
        { "id": "it-a2-feste-5-u11", "rev": 1, "stage": "phrase", "text": "a Capodanno", "translation": "at New Year's", "distractors": ["at Christmas", "at Easter"] },
        { "id": "it-a2-feste-5-u12", "rev": 1, "stage": "sentence", "text": "A Capodanno festeggiamo con gli amici in piazza.", "translation": "At New Year's we celebrate with friends in the square.", "distractors": ["At Christmas we celebrate with friends in the square.", "At New Year's we celebrate with family at home."], "commas": [1] },
        { "id": "it-a2-feste-5-u13", "rev": 1, "stage": "word", "text": "mezzanotte", "translation": "midnight", "distractors": ["noon", "evening"] },
        { "id": "it-a2-feste-5-u14", "rev": 1, "stage": "sentence", "text": "A mezzanotte brindiamo con lo spumante.", "translation": "At midnight we toast with sparkling wine.", "distractors": ["At noon we toast with sparkling wine.", "At midnight we toast with red wine."], "commas": [1] },
        { "id": "it-a2-feste-5-u15", "rev": 1, "stage": "chunk", "text": "ci regalano", "translation": "they give us", "distractors": ["we give them", "they gave us"] },
        { "id": "it-a2-feste-5-u16", "rev": 1, "stage": "sentence", "text": "A Natale i nonni ci regalano sempre un libro.", "translation": "At Christmas our grandparents always give us a book.", "distractors": ["At Christmas our grandparents always give us a sweater.", "At Easter our grandparents always give us a book."], "commas": [1] }
      ]
    },
    {
      "id": "it-a2-feste-6",
      "title": "Grazie del regalo",
      "grammarFocus": ["grazie di / grazie per", "ringraziare + direct object: la ringrazio"],
      "units": [
        { "id": "it-a2-feste-6-u01", "rev": 1, "stage": "chunk", "text": "grazie del regalo", "translation": "thanks for the gift", "distractors": ["thanks for the invitation", "thanks for the card"] },
        { "id": "it-a2-feste-6-u02", "rev": 1, "stage": "sentence", "text": "Grazie del regalo, è bellissimo!", "translation": "Thanks for the gift, it's beautiful!", "distractors": ["Thanks for the gift, it's very useful!", "Thanks for the flowers, they're beautiful!"] },
        { "id": "it-a2-feste-6-u03", "rev": 1, "stage": "word", "text": "ringraziare", "translation": "to thank", "distractors": ["to invite", "to give"] },
        { "id": "it-a2-feste-6-u04", "rev": 1, "stage": "chunk", "text": "ti ringrazio", "translation": "I thank you", "distractors": ["you thank me", "I thank him"] },
        { "id": "it-a2-feste-6-u05", "rev": 1, "stage": "sentence", "text": "Ti ringrazio tanto per i fiori.", "translation": "Thank you so much for the flowers.", "distractors": ["Thank you so much for the chocolates.", "He thanks you so much for the flowers."] },
        { "id": "it-a2-feste-6-u06", "rev": 1, "stage": "word", "text": "sorpresa", "translation": "surprise", "distractors": ["present", "party"] },
        { "id": "it-a2-feste-6-u07", "rev": 1, "stage": "sentence", "text": "Che bella sorpresa!", "translation": "What a lovely surprise!", "distractors": ["What a lovely present!", "What a strange surprise!"] },
        { "id": "it-a2-feste-6-u08", "rev": 1, "stage": "chunk", "text": "ci è piaciuta molto", "translation": "we really liked it", "distractors": ["they really liked it", "we didn't like it much"] },
        { "id": "it-a2-feste-6-u09", "rev": 1, "stage": "sentence", "text": "La cena ci è piaciuta molto, grazie dell'invito!", "translation": "We really enjoyed the dinner, thanks for the invitation!", "distractors": ["We really enjoyed the party, thanks for the invitation!", "They really enjoyed the dinner, thanks for the invitation!"] },
        { "id": "it-a2-feste-6-u10", "rev": 1, "stage": "word", "text": "utile", "translation": "useful", "distractors": ["pretty", "expensive"] },
        { "id": "it-a2-feste-6-u11", "rev": 1, "stage": "sentence", "text": "Il tuo regalo è molto utile: lo uso ogni giorno.", "translation": "Your gift is very useful: I use it every day.", "distractors": ["Your gift is very useful: I use it every week.", "Your gift is very pretty: I wear it every day."], "senses": { "6": "pron"} },
        { "id": "it-a2-feste-6-u12", "rev": 1, "stage": "chunk", "text": "le telefono", "translation": "I'll call her", "distractors": ["I'll call him", "she'll call me"], "senses": { "0": "pron"} },
        { "id": "it-a2-feste-6-u13", "rev": 1, "stage": "sentence", "text": "Stasera le telefono e la ringrazio.", "translation": "Tonight I'll call her and thank her.", "distractors": ["Tonight I'll call him and thank him.", "Tomorrow I'll call her and thank her."], "senses": { "1": "pron", "4": "pron"} },
        { "id": "it-a2-feste-6-u14", "rev": 1, "stage": "sentence", "text": "Vi ringraziamo tutti per questa bellissima festa.", "translation": "We thank you all for this wonderful party.", "distractors": ["They thank you all for this wonderful party.", "We thank you all for this wonderful dinner."] }
      ]
    }
  ]
}
