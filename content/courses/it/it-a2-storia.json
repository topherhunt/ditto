  "lessons": [
    {
      "id": "it-a2-storia-1",
      "title": "Sono andato a Roma",
      "grammarFocus": ["passato prossimo with essere", "participle agreement: andato, andata, andati"],
      "units": [
        { "id": "it-a2-storia-1-u01", "rev": 1, "stage": "chunk", "text": "sono andato", "translation": "I went", "distractors": ["I came", "you went"] },
        { "id": "it-a2-storia-1-u02", "rev": 1, "stage": "sentence", "text": "L'estate scorsa sono andato a Roma.", "translation": "Last summer I went to Rome.", "distractors": ["Last winter I went to Rome.", "Next summer I'm going to Rome."], "commas": [1] },
        { "id": "it-a2-storia-1-u03", "rev": 1, "stage": "phrase", "text": "siamo andati", "translation": "we went", "distractors": ["we came", "they went"] },
        { "id": "it-a2-storia-1-u04", "rev": 1, "stage": "sentence", "text": "Siamo andati in vacanza in Sicilia.", "translation": "We went on holiday to Sicily.", "distractors": ["We went on holiday to Sardinia.", "They went on holiday to Sicily."] },
        { "id": "it-a2-storia-1-u05", "rev": 1, "stage": "word", "text": "rimanere", "translation": "to stay, to remain", "distractors": ["to leave", "to come back"] },
        { "id": "it-a2-storia-1-u06", "rev": 1, "stage": "sentence", "text": "Sono rimasta a Roma una settimana.", "translation": "I stayed in Rome for a week.", "distractors": ["I stayed in Rome for a month.", "I lived in Rome for a week."] },
        { "id": "it-a2-storia-1-u07", "rev": 1, "stage": "word", "text": "durante", "translation": "during", "distractors": ["before", "after"] },
        { "id": "it-a2-storia-1-u08", "rev": 1, "stage": "phrase", "text": "durante il viaggio", "translation": "during the trip", "distractors": ["after the trip", "during the holiday"] },
        { "id": "it-a2-storia-1-u09", "rev": 1, "stage": "sentence", "text": "Durante il viaggio ho conosciuto molta gente.", "translation": "During the trip I met a lot of people.", "distractors": ["After the trip I met a lot of people.", "During the trip I met very few people."], "commas": [2] },
        { "id": "it-a2-storia-1-u10", "rev": 1, "stage": "word", "text": "divertirsi", "translation": "to have fun", "distractors": ["to get bored", "to rest"] },
        { "id": "it-a2-storia-1-u11", "rev": 1, "stage": "chunk", "text": "ci siamo divertiti", "translation": "we had a great time", "distractors": ["we got bored", "they had a great time"] },
        { "id": "it-a2-storia-1-u12", "rev": 1, "stage": "sentence", "text": "Ci siamo divertiti molto!", "translation": "We had a lot of fun!", "distractors": ["We didn't have much fun!", "They had a lot of fun!"] },
        { "id": "it-a2-storia-1-u13", "rev": 1, "stage": "phrase", "text": "all'estero", "translation": "abroad", "distractors": ["at home", "in the north"] },
        { "id": "it-a2-storia-1-u14", "rev": 1, "stage": "sentence", "text": "Sei mai stato all'estero?", "translation": "Have you ever been abroad?", "distractors": ["Have you ever lived abroad?", "Have you ever been to the north?"] },
        { "id": "it-a2-storia-1-u15", "rev": 1, "stage": "sentence", "text": "Sì, sono stata in Francia e in Spagna.", "translation": "Yes, I've been to France and Spain.", "distractors": ["No, I've never been to France or Spain.", "Yes, I've been to France and Germany."] }
      ]
    },
    {
      "id": "it-a2-storia-2",
      "title": "Siamo arrivati tardi",
      "grammarFocus": ["essere with verbs of motion", "salire su, scendere da, entrare in"],
      "units": [
        { "id": "it-a2-storia-2-u01", "rev": 1, "stage": "phrase", "text": "siamo arrivati", "translation": "we arrived", "distractors": ["we left", "they arrived"] },
        { "id": "it-a2-storia-2-u02", "rev": 1, "stage": "sentence", "text": "Siamo arrivati tardi in albergo.", "translation": "We got to the hotel late.", "distractors": ["We left the hotel late.", "We got to the hotel early."] },
        { "id": "it-a2-storia-2-u03", "rev": 1, "stage": "phrase", "text": "il treno è partito", "translation": "the train left", "distractors": ["the train arrived", "the train is leaving"] },
        { "id": "it-a2-storia-2-u04", "rev": 1, "stage": "sentence", "text": "Il treno è partito con un'ora di ritardo.", "translation": "The train left an hour late.", "distractors": ["The train arrived an hour late.", "The train left two hours late."] },
        { "id": "it-a2-storia-2-u05", "rev": 1, "stage": "word", "text": "salire", "translation": "to get on, to go up", "distractors": ["to get off", "to go in"] },
        { "id": "it-a2-storia-2-u06", "rev": 1, "stage": "phrase", "text": "sul treno", "translation": "on the train", "distractors": ["off the train", "on the bus"] },
        { "id": "it-a2-storia-2-u07", "rev": 1, "stage": "sentence", "text": "Maria è salita sul treno per Napoli.", "translation": "Maria got on the train to Naples.", "distractors": ["Maria got off the train to Naples.", "Maria got on the bus to Naples."] },
        { "id": "it-a2-storia-2-u08", "rev": 1, "stage": "word", "text": "scendere", "translation": "to get off, to go down", "distractors": ["to get on", "to go out"] },
        { "id": "it-a2-storia-2-u09", "rev": 1, "stage": "phrase", "text": "dall'autobus", "translation": "off the bus", "distractors": ["on the bus", "off the train"] },
        { "id": "it-a2-storia-2-u10", "rev": 1, "stage": "sentence", "text": "Sono scesa dall'autobus in centro.", "translation": "I got off the bus in the town center.", "distractors": ["I got on the bus in the town center.", "I got off the train in the town center."] },
        { "id": "it-a2-storia-2-u11", "rev": 1, "stage": "word", "text": "entrare", "translation": "to go in, to enter", "distractors": ["to go out", "to go up"] },
        { "id": "it-a2-storia-2-u12", "rev": 1, "stage": "sentence", "text": "Siamo entrati in un piccolo ristorante.", "translation": "We went into a small restaurant.", "distractors": ["We went into a big restaurant.", "They went into a small restaurant."] },
        { "id": "it-a2-storia-2-u13", "rev": 1, "stage": "phrase", "text": "siamo tornati", "translation": "we came back", "distractors": ["we went out", "they came back"] },
        { "id": "it-a2-storia-2-u14", "rev": 1, "stage": "sentence", "text": "Siamo tornati a casa a mezzanotte.", "translation": "We got home at midnight.", "distractors": ["We left home at midnight.", "We got home at noon."] },
        { "id": "it-a2-storia-2-u15", "rev": 1, "stage": "sentence", "text": "E tu, sei uscito ieri sera?", "translation": "And you, did you go out last night?", "distractors": ["And you, did you stay in last night?", "And you, did you go out this morning?"] }
      ]
    },
    {
      "id": "it-a2-storia-3",
      "title": "Sono nata a Napoli",
      "grammarFocus": ["nato, cresciuto, morto", "the points of the compass: al nord, a est"],
      "units": [
        { "id": "it-a2-storia-3-u01", "rev": 1, "stage": "word", "text": "nascere", "translation": "to be born", "distractors": ["to grow up", "to live"] },
        { "id": "it-a2-storia-3-u02", "rev": 1, "stage": "chunk", "text": "sono nata", "translation": "I was born", "distractors": ["I grew up", "I got married"] },
        { "id": "it-a2-storia-3-u03", "rev": 1, "stage": "word", "text": "crescere", "translation": "to grow up", "distractors": ["to be born", "to move"] },
        { "id": "it-a2-storia-3-u04", "rev": 1, "stage": "sentence", "text": "Sono nata a Napoli, ma sono cresciuta a Milano.", "translation": "I was born in Naples, but I grew up in Milan.", "distractors": ["I was born in Milan, but I grew up in Naples.", "I was born in Naples, and I live in Milan."] },
        { "id": "it-a2-storia-3-u05", "rev": 1, "stage": "phrase", "text": "del nord", "translation": "in the north", "distractors": ["in the south", "in the east"] },
        { "id": "it-a2-storia-3-u06", "rev": 1, "stage": "sentence", "text": "Mio padre è nato in un piccolo paese del nord.", "translation": "My father was born in a small village in the north.", "distractors": ["My mother was born in a small village in the north.", "My father was born in a small village in the south."] },
        { "id": "it-a2-storia-3-u07", "rev": 1, "stage": "word", "text": "regione", "translation": "region", "distractors": ["city", "country"] },
        { "id": "it-a2-storia-3-u08", "rev": 1, "stage": "sentence", "text": "Di che regione sei?", "translation": "What region are you from?", "distractors": ["What city are you from?", "What region do you live in?"] },
        { "id": "it-a2-storia-3-u09", "rev": 1, "stage": "sentence", "text": "Sono della Puglia, una regione del sud.", "translation": "I'm from Puglia, a region in the south.", "distractors": ["I'm from Puglia, a region in the north.", "I'm from Puglia, a city in the south."] },
        { "id": "it-a2-storia-3-u10", "rev": 1, "stage": "sentence", "text": "Torino è a ovest e Venezia è a est.", "translation": "Turin is in the west and Venice is in the east.", "distractors": ["Turin is in the east and Venice is in the west.", "Turin is in the north and Venice is in the south."], "commas": [3] },
        { "id": "it-a2-storia-3-u11", "rev": 1, "stage": "word", "text": "età", "translation": "age", "distractors": ["year", "life"] },
        { "id": "it-a2-storia-3-u12", "rev": 1, "stage": "chunk", "text": "è morta", "translation": "she died", "distractors": ["she was born", "he died"] },
        { "id": "it-a2-storia-3-u13", "rev": 1, "stage": "phrase", "text": "all'età di novant'anni", "translation": "at the age of ninety", "distractors": ["at the age of nineteen", "for ninety years"], "variants": ["all'età di 90 anni"] },
        { "id": "it-a2-storia-3-u14", "rev": 1, "stage": "sentence", "text": "Mia nonna è morta all'età di novant'anni.", "translation": "My grandmother died at the age of ninety.", "distractors": ["My grandfather died at the age of ninety.", "My grandmother died at the age of nineteen."], "variants": ["Mia nonna è morta all'età di 90 anni."] }
      ]
    },
    {
      "id": "it-a2-storia-4",
      "title": "Mi sono trasferito",
      "grammarFocus": ["reflexive verbs in the past: mi sono, ci siamo", "stato: essere in the past"],
      "units": [
        { "id": "it-a2-storia-4-u01", "rev": 1, "stage": "word", "text": "trasferirsi", "translation": "to move (to another place)", "distractors": ["to travel", "to come back"] },
        { "id": "it-a2-storia-4-u02", "rev": 1, "stage": "chunk", "text": "mi sono trasferito", "translation": "I moved", "distractors": ["I traveled", "you moved"] },
        { "id": "it-a2-storia-4-u03", "rev": 1, "stage": "sentence", "text": "Due anni fa mi sono trasferito a Bologna.", "translation": "Two years ago I moved to Bologna.", "distractors": ["Ten years ago I moved to Bologna.", "Two years ago I moved away from Bologna."], "variants": ["2 anni fa mi sono trasferito a Bologna."], "commas": [2], "senses": {"2":"ago"} },
        { "id": "it-a2-storia-4-u04", "rev": 1, "stage": "phrase", "text": "per lavoro", "translation": "for work", "distractors": ["for love", "for school"] },
        { "id": "it-a2-storia-4-u05", "rev": 1, "stage": "sentence", "text": "Ci siamo trasferiti a Londra per lavoro.", "translation": "We moved to London for work.", "distractors": ["We moved to London to study.", "They moved to London for work."] },
        { "id": "it-a2-storia-4-u06", "rev": 1, "stage": "phrase", "text": "vivere all'estero", "translation": "to live abroad", "distractors": ["to work abroad", "to live in the south"] },
        { "id": "it-a2-storia-4-u07", "rev": 1, "stage": "sentence", "text": "Mia sorella vive all'estero da cinque anni.", "translation": "My sister has lived abroad for five years.", "distractors": ["My sister has lived abroad for fifteen years.", "My brother has lived abroad for five years."], "variants": ["Mia sorella vive all'estero da 5 anni."] },
        { "id": "it-a2-storia-4-u08", "rev": 1, "stage": "chunk", "text": "mi sono svegliata", "translation": "I woke up", "distractors": ["I got up", "she woke up"] },
        { "id": "it-a2-storia-4-u09", "rev": 1, "stage": "sentence", "text": "La prima mattina mi sono svegliata alle cinque.", "translation": "On the first morning I woke up at five.", "distractors": ["On the last morning I woke up at five.", "On the first morning I woke up at nine."], "variants": ["La prima mattina mi sono svegliata alle 5."], "commas": [2] },
        { "id": "it-a2-storia-4-u10", "rev": 1, "stage": "phrase", "text": "i primi mesi", "translation": "the first months", "distractors": ["the last months", "the first weeks"] },
        { "id": "it-a2-storia-4-u11", "rev": 1, "stage": "sentence", "text": "I primi mesi sono stati difficili.", "translation": "The first months were hard.", "distractors": ["The first months were easy.", "The first weeks were hard."] },
        { "id": "it-a2-storia-4-u12", "rev": 1, "stage": "word", "text": "triste", "translation": "sad", "distractors": ["happy", "tired"] },
        { "id": "it-a2-storia-4-u13", "rev": 1, "stage": "sentence", "text": "Sono stato triste quando sono partito.", "translation": "I was sad when I left.", "distractors": ["I was happy when I left.", "I was sad when I arrived."], "commas": [2] },
        { "id": "it-a2-storia-4-u14", "rev": 1, "stage": "word", "text": "felice", "translation": "happy", "distractors": ["sad", "busy"] },
        { "id": "it-a2-storia-4-u15", "rev": 1, "stage": "sentence", "text": "Adesso sono felice e ho molti amici qui.", "translation": "Now I'm happy and I have lots of friends here.", "distractors": ["Now I'm happy but I have no friends here.", "Now I'm sad and I have lots of friends here."], "commas": [0,2] }
      ]
    },
