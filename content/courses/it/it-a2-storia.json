        { "id": "it-a2-storia-5-u02", "rev": 1, "stage": "chunk", "text": "ci siamo sposati", "translation": "we got married", "distractors": ["we got engaged", "they got married"] },
        { "id": "it-a2-storia-5-u03", "rev": 1, "stage": "sentence", "text": "Ci siamo sposati dieci anni fa.", "translation": "We got married ten years ago.", "distractors": ["We got engaged ten years ago.", "We got married two years ago."], "variants": ["Ci siamo sposati 10 anni fa."], "senses": {"5":"ago"} },
        { "id": "it-a2-storia-5-u04", "rev": 1, "stage": "word", "text": "innamorarsi", "translation": "to fall in love", "distractors": ["to get married", "to meet"] },
        { "id": "it-a2-storia-5-u05", "rev": 1, "stage": "sentence", "text": "Ci siamo conosciuti all'università e ci siamo innamorati.", "translation": "We met at university and fell in love.", "distractors": ["We met at work and fell in love.", "We met at university and became friends."] },
        { "id": "it-a2-storia-5-u06", "rev": 1, "stage": "word", "text": "matrimonio", "translation": "wedding", "distractors": ["party", "birthday"] },
        { "id": "it-a2-storia-5-u07", "rev": 1, "stage": "phrase", "text": "il matrimonio di mia sorella", "translation": "my sister's wedding", "distractors": ["my brother's wedding", "my sister's party"] },
        { "id": "it-a2-storia-5-u08", "rev": 1, "stage": "sentence", "text": "Mia sorella si è sposata a giugno, in Toscana.", "translation": "My sister got married in June, in Tuscany.", "distractors": ["My sister got married in July, in Tuscany.", "My brother got married in June, in Tuscany."] },
        { "id": "it-a2-storia-5-u09", "rev": 1, "stage": "sentence", "text": "Il matrimonio è stato molto bello.", "translation": "The wedding was really lovely.", "distractors": ["The wedding was really boring.", "The party was really lovely."] },
        { "id": "it-a2-storia-5-u10", "rev": 1, "stage": "chunk", "text": "è nato", "translation": "he was born", "distractors": ["she was born", "he died"] },
        { "id": "it-a2-storia-5-u11", "rev": 1, "stage": "sentence", "text": "Poi è nato nostro figlio.", "translation": "Then our son was born.", "distractors": ["Then our daughter was born.", "Then our son got married."], "commas": [0] },
        { "id": "it-a2-storia-5-u12", "rev": 1, "stage": "word", "text": "diventare", "translation": "to become", "distractors": ["to stay", "to come"] },
        { "id": "it-a2-storia-5-u13", "rev": 1, "stage": "sentence", "text": "E così siamo diventati genitori.", "translation": "And so we became parents.", "distractors": ["And so we became grandparents.", "And so they became parents."], "commas": [1] },
        { "id": "it-a2-storia-5-u14", "rev": 1, "stage": "phrase", "text": "molto felici", "translation": "very happy", "distractors": ["very sad", "not very happy"] },
        { "id": "it-a2-storia-5-u15", "rev": 1, "stage": "sentence", "text": "Siamo molto felici insieme.", "translation": "We're very happy together.", "distractors": ["We aren't happy together.", "We're very happy here."] }
      ]
    },
    {
      "id": "it-a2-storia-6",
      "title": "La mia vita",
      "grammarFocus": ["laurearsi in + subject", "life events in the passato prossimo"],
      "units": [
        { "id": "it-a2-storia-6-u01", "rev": 1, "stage": "word", "text": "vita", "translation": "life", "distractors": ["story", "age"] },
        { "id": "it-a2-storia-6-u02", "rev": 1, "stage": "phrase", "text": "la storia della mia vita", "translation": "the story of my life", "distractors": ["the story of my family", "the history of my city"] },
        { "id": "it-a2-storia-6-u03", "rev": 1, "stage": "sentence", "text": "Questa è la storia della mia vita.", "translation": "This is the story of my life.", "distractors": ["This is the story of my family.", "That was the story of my life."] },
        { "id": "it-a2-storia-6-u04", "rev": 1, "stage": "word", "text": "liceo", "translation": "high school", "distractors": ["university", "primary school"] },
        { "id": "it-a2-storia-6-u05", "rev": 1, "stage": "sentence", "text": "Ho fatto il liceo a Torino.", "translation": "I went to high school in Turin.", "distractors": ["I went to university in Turin.", "I taught at a high school in Turin."] },
        { "id": "it-a2-storia-6-u06", "rev": 1, "stage": "word", "text": "laurearsi", "translation": "to graduate", "distractors": ["to study", "to get married"] },
        { "id": "it-a2-storia-6-u07", "rev": 1, "stage": "chunk", "text": "mi sono laureata", "translation": "I graduated", "distractors": ["I studied", "she graduated"] },
        { "id": "it-a2-storia-6-u08", "rev": 1, "stage": "sentence", "text": "Mi sono laureata in lingue a Bologna.", "translation": "I graduated in languages in Bologna.", "distractors": ["I studied languages in Bologna.", "I graduated in languages in Rome."] },
        { "id": "it-a2-storia-6-u09", "rev": 1, "stage": "phrase", "text": "dopo la laurea", "translation": "after my degree", "distractors": ["before my degree", "during my degree"] },
        { "id": "it-a2-storia-6-u10", "rev": 1, "stage": "sentence", "text": "Dopo la laurea ho cominciato a lavorare.", "translation": "After my degree I started working.", "distractors": ["Before my degree I started working.", "After my degree I started teaching."], "commas": [2] },
        { "id": "it-a2-storia-6-u11", "rev": 1, "stage": "phrase", "text": "uno studio in centro", "translation": "a practice in the town center", "distractors": ["a house in the town center", "a practice outside town"] },
        { "id": "it-a2-storia-6-u12", "rev": 1, "stage": "sentence", "text": "Mia madre è medico e ha uno studio in centro.", "translation": "My mother is a doctor and has a practice in the town center.", "distractors": ["My father is a doctor and has a practice in the town center.", "My mother is a lawyer and has a practice in the town center."], "commas": [3] },
        { "id": "it-a2-storia-6-u13", "rev": 1, "stage": "phrase", "text": "tutta la vita", "translation": "all his life", "distractors": ["all his youth", "half his life"] },
        { "id": "it-a2-storia-6-u14", "rev": 1, "stage": "sentence", "text": "Mio nonno ha lavorato in fabbrica tutta la vita.", "translation": "My grandfather worked in a factory all his life.", "distractors": ["My grandfather worked in an office all his life.", "My grandmother worked in a factory all her life."] },
        { "id": "it-a2-storia-6-u15", "rev": 1, "stage": "sentence", "text": "Ho avuto una vita felice.", "translation": "I've had a happy life.", "distractors": ["I've had a sad life.", "You've had a happy life."] }
      ]
