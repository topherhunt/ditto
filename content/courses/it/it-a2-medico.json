  "lessons": [
    {
      "id": "it-a2-medico-1",
      "title": "Non mi sento bene",
      "grammarFocus": ["sentirsi", "stare bene / stare male", "andare dal dottore"],
      "units": [
        { "id": "it-a2-medico-1-u01", "rev": 1, "stage": "chunk", "text": "non mi sento bene", "translation": "I don't feel well", "distractors": ["I feel well", "you don't feel well"] },
        { "id": "it-a2-medico-1-u02", "rev": 1, "stage": "sentence", "text": "Oggi non mi sento molto bene.", "translation": "I don't feel very well today.", "distractors": ["I didn't feel very well yesterday.", "She doesn't feel very well today."], "commas": [0] },
        { "id": "it-a2-medico-1-u03", "rev": 1, "stage": "word", "text": "malato", "translation": "sick", "distractors": ["tired", "busy"] },
        { "id": "it-a2-medico-1-u04", "rev": 1, "stage": "sentence", "text": "Mio figlio è malato e oggi non va a scuola.", "translation": "My son is sick and isn't going to school today.", "distractors": ["My daughter is sick and isn't going to school today.", "My son is tired and isn't going to school today."] },
        { "id": "it-a2-medico-1-u05", "rev": 1, "stage": "word", "text": "salute", "translation": "health", "distractors": ["illness", "life"] },
        { "id": "it-a2-medico-1-u06", "rev": 1, "stage": "sentence", "text": "Come va la salute?", "translation": "How's your health?", "distractors": ["How's your family?", "How's your work?"] },
        { "id": "it-a2-medico-1-u07", "rev": 1, "stage": "chunk", "text": "come si sente", "translation": "how are you feeling", "distractors": ["how were you feeling", "how do they feel"] },
        { "id": "it-a2-medico-1-u08", "rev": 1, "stage": "sentence", "text": "Come si sente oggi, signora?", "translation": "How are you feeling today, ma'am?", "distractors": ["How did you feel yesterday, ma'am?", "How are you feeling today, sir?"] },
        { "id": "it-a2-medico-1-u09", "rev": 1, "stage": "chunk", "text": "mi sento stanca", "translation": "I feel tired", "distractors": ["I feel better", "you feel tired"] },
        { "id": "it-a2-medico-1-u10", "rev": 1, "stage": "sentence", "text": "Mi sento stanca e ho sempre freddo.", "translation": "I feel tired and I'm always cold.", "distractors": ["I feel tired and I'm always hot.", "I feel fine and I'm always cold."] },
        { "id": "it-a2-medico-1-u11", "rev": 1, "stage": "word", "text": "dottore", "translation": "doctor", "distractors": ["nurse", "pharmacist"] },
        { "id": "it-a2-medico-1-u12", "rev": 1, "stage": "phrase", "text": "dal dottore", "translation": "to the doctor's", "distractors": ["to the pharmacy", "to the hospital"] },
        { "id": "it-a2-medico-1-u13", "rev": 1, "stage": "sentence", "text": "Devo andare dal dottore.", "translation": "I have to go to the doctor's.", "distractors": ["I want to go to the doctor's.", "I have to go to the pharmacy."] },
        { "id": "it-a2-medico-1-u14", "rev": 1, "stage": "sentence", "text": "Ieri non sono andato al lavoro perché stavo male.", "translation": "Yesterday I didn't go to work because I felt sick.", "distractors": ["Yesterday I didn't go to school because I felt sick.", "Yesterday I didn't go to work because I was tired."], "commas": [0, 5] }
      ]
    },
    {
      "id": "it-a2-medico-2",
      "title": "Mi fa male la testa",
      "grammarFocus": ["mi fa male / mi fanno male", "avere mal di + body part"],
      "units": [
        { "id": "it-a2-medico-2-u01", "rev": 1, "stage": "word", "text": "testa", "translation": "head", "distractors": ["throat", "back"] },
        { "id": "it-a2-medico-2-u02", "rev": 1, "stage": "chunk", "text": "mi fa male", "translation": "it hurts", "distractors": ["it doesn't hurt", "it hurts you"] },
        { "id": "it-a2-medico-2-u03", "rev": 1, "stage": "sentence", "text": "Mi fa male la testa.", "translation": "My head hurts.", "distractors": ["My back hurts.", "My head doesn't hurt."] },
        { "id": "it-a2-medico-2-u04", "rev": 1, "stage": "phrase", "text": "mal di gola", "translation": "a sore throat", "distractors": ["a headache", "a stomachache"] },
        { "id": "it-a2-medico-2-u05", "rev": 1, "stage": "sentence", "text": "Ho mal di gola da tre giorni.", "translation": "I've had a sore throat for three days.", "distractors": ["I've had a sore throat for two days.", "I've had a headache for three days."], "variants": ["Ho mal di gola da 3 giorni."] },
        { "id": "it-a2-medico-2-u06", "rev": 1, "stage": "word", "text": "schiena", "translation": "back", "distractors": ["belly", "leg"] },
        { "id": "it-a2-medico-2-u07", "rev": 1, "stage": "chunk", "text": "mi fanno male", "translation": "they hurt", "distractors": ["they don't hurt", "they hurt you"] },
        { "id": "it-a2-medico-2-u08", "rev": 1, "stage": "phrase", "text": "le gambe", "translation": "the legs", "distractors": ["the arms", "the hands"] },
        { "id": "it-a2-medico-2-u09", "rev": 1, "stage": "sentence", "text": "Mi fanno male le gambe e la schiena.", "translation": "My legs and back hurt.", "distractors": ["My arms and back hurt.", "My legs and head hurt."] },
        { "id": "it-a2-medico-2-u10", "rev": 1, "stage": "phrase", "text": "mal di pancia", "translation": "a stomachache", "distractors": ["a toothache", "a sore throat"] },
        { "id": "it-a2-medico-2-u11", "rev": 1, "stage": "sentence", "text": "Il bambino ha mal di pancia.", "translation": "The child has a stomachache.", "distractors": ["The child has a headache.", "The child has a sore throat."] },
        { "id": "it-a2-medico-2-u12", "rev": 1, "stage": "word", "text": "braccio", "translation": "arm", "distractors": ["leg", "hand"] },
        { "id": "it-a2-medico-2-u13", "rev": 1, "stage": "sentence", "text": "Sono caduto e mi fa male il braccio.", "translation": "I fell and my arm hurts.", "distractors": ["I fell and my leg hurts.", "I fell and my arm doesn't hurt."] },
        { "id": "it-a2-medico-2-u14", "rev": 1, "stage": "sentence", "text": "Dove ti fa male?", "translation": "Where does it hurt?", "distractors": ["When does it hurt?", "Why does it hurt?"] },
        { "id": "it-a2-medico-2-u15", "rev": 1, "stage": "phrase", "text": "mal di denti", "translation": "a toothache", "distractors": ["a headache", "an earache"] },
        { "id": "it-a2-medico-2-u16", "rev": 1, "stage": "sentence", "text": "Mio marito ha un forte mal di denti.", "translation": "My husband has a bad toothache.", "distractors": ["My husband has a bad headache.", "My wife has a bad toothache."] }
      ]
    },
    {
      "id": "it-a2-medico-3",
      "title": "Dal medico",
      "grammarFocus": ["da quanto tempo...?", "bisogna + infinitive"],
      "units": [
        { "id": "it-a2-medico-3-u01", "rev": 1, "stage": "word", "text": "visita", "translation": "examination", "distractors": ["prescription", "medicine"] },
        { "id": "it-a2-medico-3-u02", "rev": 1, "stage": "chunk", "text": "ho un appuntamento", "translation": "I have an appointment", "distractors": ["I had an appointment", "I need an appointment"] },
        { "id": "it-a2-medico-3-u03", "rev": 1, "stage": "sentence", "text": "Buongiorno, ho un appuntamento con il dottor Rossi.", "translation": "Good morning, I have an appointment with Dr. Rossi.", "distractors": ["Good morning, I need an appointment with Dr. Rossi.", "Good evening, I have an appointment with Dr. Rossi."] },
        { "id": "it-a2-medico-3-u04", "rev": 1, "stage": "word", "text": "dolore", "translation": "pain", "distractors": ["fever", "cough"] },
        { "id": "it-a2-medico-3-u05", "rev": 1, "stage": "phrase", "text": "un dolore forte", "translation": "a bad pain", "distractors": ["a slight pain", "a bad cough"] },
        { "id": "it-a2-medico-3-u06", "rev": 1, "stage": "chunk", "text": "da quanto tempo", "translation": "how long", "distractors": ["how often", "how many times"] },
        { "id": "it-a2-medico-3-u07", "rev": 1, "stage": "sentence", "text": "Da quanto tempo ha questo dolore?", "translation": "How long have you had this pain?", "distractors": ["How often do you have this pain?", "How long have you had this cough?"] },
        { "id": "it-a2-medico-3-u08", "rev": 1, "stage": "sentence", "text": "Da una settimana, più o meno.", "translation": "For a week, more or less.", "distractors": ["For a month, more or less.", "For a year, more or less."] },
        { "id": "it-a2-medico-3-u09", "rev": 1, "stage": "phrase", "text": "le orecchie", "translation": "the ears", "distractors": ["the eyes", "the nose"] },
        { "id": "it-a2-medico-3-u10", "rev": 1, "stage": "sentence", "text": "Il dottore mi ha guardato la gola e le orecchie.", "translation": "The doctor looked at my throat and ears.", "distractors": ["The doctor looked at my throat and nose.", "The nurse looked at my throat and ears."] },
        { "id": "it-a2-medico-3-u11", "rev": 1, "stage": "chunk", "text": "una visita di controllo", "translation": "a checkup", "distractors": ["an emergency visit", "a home visit"] },
        { "id": "it-a2-medico-3-u12", "rev": 1, "stage": "sentence", "text": "Devo fare una visita di controllo ogni anno.", "translation": "I have to have a checkup every year.", "distractors": ["I have to have a checkup every month.", "I want to have a checkup every year."] },
        { "id": "it-a2-medico-3-u13", "rev": 1, "stage": "word", "text": "bisogna", "translation": "it's necessary", "distractors": ["it's possible", "it's forbidden"] },
        { "id": "it-a2-medico-3-u14", "rev": 1, "stage": "sentence", "text": "Bisogna prendere un appuntamento?", "translation": "Do you need to make an appointment?", "distractors": ["Can you make an appointment?", "Do you need to cancel an appointment?"] }
      ]
    },
    {
      "id": "it-a2-medico-4",
