        { "id": "it-a2-medico-6-u03", "rev": 1, "stage": "sentence", "text": "Grazie, oggi sto molto meglio.", "translation": "Thanks, I'm much better today.", "distractors": ["Thanks, I'm much worse today.", "Thanks, I was much better yesterday."] },
        { "id": "it-a2-medico-6-u04", "rev": 1, "stage": "word", "text": "guarire", "translation": "to recover", "distractors": ["to get sick", "to rest"] },
        { "id": "it-a2-medico-6-u05", "rev": 1, "stage": "sentence", "text": "Sono guarito in una settimana.", "translation": "I recovered in a week.", "distractors": ["I recovered in a month.", "I got sick in a week."] },
        { "id": "it-a2-medico-6-u06", "rev": 1, "stage": "sentence", "text": "Per fortuna la temperatura è scesa.", "translation": "Luckily my temperature has gone down.", "distractors": ["Luckily my temperature has gone up.", "Luckily the pain has gone down."], "commas": [1] },
        { "id": "it-a2-medico-6-u07", "rev": 1, "stage": "chunk", "text": "ho bisogno di", "translation": "I need", "distractors": ["I don't need", "you need"] },
        { "id": "it-a2-medico-6-u08", "rev": 1, "stage": "sentence", "text": "Ho ancora bisogno della medicina?", "translation": "Do I still need the medicine?", "distractors": ["Do you still need the medicine?", "Do I still need the prescription?"] },
        { "id": "it-a2-medico-6-u09", "rev": 1, "stage": "chunk", "text": "bisogna riposarsi", "translation": "you need to rest", "distractors": ["you need to go out", "you don't need to rest"] },
        { "id": "it-a2-medico-6-u10", "rev": 1, "stage": "sentence", "text": "Però bisogna riposarsi ancora qualche giorno.", "translation": "But you still need to rest for a few days.", "distractors": ["But you still need to work for a few days.", "But you need to rest for a few weeks."], "commas": [0] },
        { "id": "it-a2-medico-6-u11", "rev": 1, "stage": "chunk", "text": "mi sono fatto male", "translation": "I hurt myself", "distractors": ["I hurt you", "he hurt himself"] },
        { "id": "it-a2-medico-6-u12", "rev": 1, "stage": "phrase", "text": "al pronto soccorso", "translation": "to the emergency room", "distractors": ["to the pharmacy", "to the doctor's"] },
        { "id": "it-a2-medico-6-u13", "rev": 1, "stage": "sentence", "text": "Sabato mi sono fatto male alla mano e sono andato al pronto soccorso.", "translation": "On Saturday I hurt my hand and went to the emergency room.", "distractors": ["On Saturday I hurt my foot and went to the emergency room.", "On Sunday I hurt my hand and went to the pharmacy."], "commas": [0, 6] },
        { "id": "it-a2-medico-6-u14", "rev": 1, "stage": "sentence", "text": "Adesso sto bene e posso tornare al lavoro.", "translation": "Now I'm fine and I can go back to work.", "distractors": ["Now I'm fine and I have to go back to work.", "Now I'm sick and I can't go back to work."], "commas": [0] }
      ]
