        { "id": "it-a2-medico-4-u02", "rev": 1, "stage": "chunk", "text": "ho la febbre", "translation": "I have a fever", "distractors": ["I had a fever", "I have a cold"] },
        { "id": "it-a2-medico-4-u03", "rev": 1, "stage": "sentence", "text": "Ho la febbre da ieri sera.", "translation": "I've had a fever since last night.", "distractors": ["I've had a cough since last night.", "I've had a fever since yesterday morning."] },
        { "id": "it-a2-medico-4-u04", "rev": 1, "stage": "phrase", "text": "una brutta tosse", "translation": "a bad cough", "distractors": ["a bad cold", "a slight cough"] },
        { "id": "it-a2-medico-4-u05", "rev": 1, "stage": "sentence", "text": "Ho anche una brutta tosse.", "translation": "I also have a bad cough.", "distractors": ["I also have a bad cold.", "I only have a bad cough."] },
        { "id": "it-a2-medico-4-u06", "rev": 1, "stage": "word", "text": "raffreddore", "translation": "cold", "distractors": ["cough", "flu"] },
        { "id": "it-a2-medico-4-u07", "rev": 1, "stage": "phrase", "text": "il naso chiuso", "translation": "a blocked nose", "distractors": ["a runny nose", "a blocked ear"] },
        { "id": "it-a2-medico-4-u08", "rev": 1, "stage": "sentence", "text": "Ho il naso chiuso e respiro con la bocca.", "translation": "My nose is blocked and I'm breathing through my mouth.", "distractors": ["My ears are blocked and I'm breathing through my mouth.", "My nose is blocked and I can't breathe at all."] },
        { "id": "it-a2-medico-4-u09", "rev": 1, "stage": "word", "text": "influenza", "translation": "flu", "distractors": ["cold", "allergy"] },
        { "id": "it-a2-medico-4-u10", "rev": 1, "stage": "sentence", "text": "È solo un raffreddore o è l'influenza?", "translation": "Is it just a cold, or is it the flu?", "distractors": ["Is it just a cough, or is it the flu?", "Is it just a cold, or is it an allergy?"], "commas": [3] },
        { "id": "it-a2-medico-4-u11", "rev": 1, "stage": "phrase", "text": "tutto il corpo", "translation": "the whole body", "distractors": ["the whole head", "half the body"] },
        { "id": "it-a2-medico-4-u12", "rev": 1, "stage": "sentence", "text": "Con l'influenza mi fa male tutto il corpo.", "translation": "With the flu my whole body hurts.", "distractors": ["With a cold my whole body hurts.", "With the flu my whole head hurts."], "commas": [1] },
        { "id": "it-a2-medico-4-u13", "rev": 1, "stage": "word", "text": "grave", "translation": "serious", "distractors": ["slight", "normal"] },
        { "id": "it-a2-medico-4-u14", "rev": 1, "stage": "chunk", "text": "niente di grave", "translation": "nothing serious", "distractors": ["something serious", "nothing new"] },
        { "id": "it-a2-medico-4-u15", "rev": 1, "stage": "sentence", "text": "Non è niente di grave, è solo l'influenza.", "translation": "It's nothing serious, it's just the flu.", "distractors": ["It's nothing serious, it's just a cold.", "It's something serious, it's not just the flu."] },
        { "id": "it-a2-medico-4-u16", "rev": 1, "stage": "sentence", "text": "Deve restare a letto per tre giorni.", "translation": "You have to stay in bed for three days.", "distractors": ["You have to stay in bed for two days.", "You don't have to stay in bed for three days."], "variants": ["Deve restare a letto per 3 giorni."] }
      ]
