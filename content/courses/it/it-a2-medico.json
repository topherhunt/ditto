        { "id": "it-a2-medico-5-u02", "rev": 1, "stage": "word", "text": "ricetta", "translation": "prescription", "distractors": ["medicine", "receipt"] },
        { "id": "it-a2-medico-5-u03", "rev": 1, "stage": "chunk", "text": "senza ricetta", "translation": "without a prescription", "distractors": ["with a prescription", "without a receipt"] },
        { "id": "it-a2-medico-5-u04", "rev": 1, "stage": "sentence", "text": "Posso comprare questa medicina senza ricetta?", "translation": "Can I buy this medicine without a prescription?", "distractors": ["Can I buy this syrup without a prescription?", "Can I buy this medicine without a receipt?"] },
        { "id": "it-a2-medico-5-u05", "rev": 1, "stage": "word", "text": "compressa", "translation": "tablet", "distractors": ["drop", "syrup"] },
        { "id": "it-a2-medico-5-u06", "rev": 1, "stage": "chunk", "text": "due volte al giorno", "translation": "twice a day", "distractors": ["three times a day", "twice a week"], "variants": ["2 volte al giorno"] },
        { "id": "it-a2-medico-5-u07", "rev": 1, "stage": "sentence", "text": "Deve prendere una compressa due volte al giorno.", "translation": "You have to take one tablet twice a day.", "distractors": ["You have to take two tablets once a day.", "You have to take one tablet three times a day."], "variants": ["Deve prendere una compressa 2 volte al giorno."] },
        { "id": "it-a2-medico-5-u08", "rev": 1, "stage": "phrase", "text": "dopo i pasti", "translation": "after meals", "distractors": ["before meals", "during meals"] },
        { "id": "it-a2-medico-5-u09", "rev": 1, "stage": "sentence", "text": "Bisogna prendere le compresse dopo i pasti.", "translation": "You need to take the tablets after meals.", "distractors": ["You need to take the tablets before meals.", "You need to take the syrup after meals."] },
        { "id": "it-a2-medico-5-u10", "rev": 1, "stage": "phrase", "text": "uno sciroppo per la tosse", "translation": "a cough syrup", "distractors": ["a syrup for a fever", "cough tablets"] },
        { "id": "it-a2-medico-5-u11", "rev": 1, "stage": "sentence", "text": "Avete uno sciroppo per la tosse?", "translation": "Do you have a cough syrup?", "distractors": ["Do you have a syrup for a fever?", "Do you have tablets for a cough?"] },
        { "id": "it-a2-medico-5-u12", "rev": 1, "stage": "word", "text": "allergico", "translation": "allergic", "distractors": ["sick", "sensitive"] },
        { "id": "it-a2-medico-5-u13", "rev": 1, "stage": "sentence", "text": "È allergico a qualche medicina?", "translation": "Are you allergic to any medicine?", "distractors": ["Are you taking any medicine?", "Are you allergic to any food?"] },
        { "id": "it-a2-medico-5-u14", "rev": 1, "stage": "sentence", "text": "No, ma sono allergica al pesce.", "translation": "No, but I'm allergic to fish.", "distractors": ["Yes, and I'm allergic to fish.", "No, but I'm allergic to eggs."] }
      ]
    },
    {
      "id": "it-a2-medico-6",
      "title": "Sto meglio",
      "grammarFocus": ["stare meglio", "avere bisogno di", "guarire (-isc-)"],
