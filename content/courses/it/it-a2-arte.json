        { "id": "it-a2-arte-3-u06", "rev": 1, "stage": "sentence", "text": "Davanti alla chiesa c'è una statua antica.", "translation": "In front of the church there's an ancient statue.", "distractors": ["Behind the church there's an ancient statue.", "In front of the church there's a modern statue."], "commas": [2] },
