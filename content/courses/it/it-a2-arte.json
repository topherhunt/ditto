    {
      "id": "it-a2-arte-1",
      "title": "Al museo",
      "grammarFocus": ["c'è una mostra", "passato prossimo: abbiamo visitato", "c'era (imperfetto)"],
      "units": [
        { "id": "it-a2-arte-1-u01", "rev": 1, "stage": "word", "text": "mostra", "translation": "exhibition", "distractors": ["museum", "ticket"] },
        { "id": "it-a2-arte-1-u02", "rev": 1, "stage": "phrase", "text": "una mostra d'arte moderna", "translation": "a modern art exhibition", "distractors": ["an ancient art exhibition", "a modern art museum"] },
        { "id": "it-a2-arte-1-u03", "rev": 1, "stage": "sentence", "text": "Al museo c'è una mostra d'arte moderna.", "translation": "There's a modern art exhibition at the museum.", "distractors": ["There's an ancient art exhibition at the museum.", "There's a modern art exhibition at the church."], "commas": [1] },
        { "id": "it-a2-arte-1-u04", "rev": 1, "stage": "word", "text": "biglietteria", "translation": "ticket office", "distractors": ["entrance", "gift shop"] },
        { "id": "it-a2-arte-1-u05", "rev": 1, "stage": "phrase", "text": "alla biglietteria", "translation": "at the ticket office", "distractors": ["at the entrance", "at the station"] },
        { "id": "it-a2-arte-1-u06", "rev": 1, "stage": "sentence", "text": "Abbiamo comprato i biglietti alla biglietteria.", "translation": "We bought the tickets at the ticket office.", "distractors": ["We bought the tickets at the station.", "We sold the tickets at the ticket office."] },
        { "id": "it-a2-arte-1-u07", "rev": 1, "stage": "word", "text": "guida", "translation": "guide", "distractors": ["ticket", "map"] },
        { "id": "it-a2-arte-1-u08", "rev": 1, "stage": "phrase", "text": "con una guida", "translation": "with a guide", "distractors": ["without a guide", "with a map"] },
        { "id": "it-a2-arte-1-u09", "rev": 1, "stage": "sentence", "text": "Abbiamo visitato il museo con una guida molto brava.", "translation": "We visited the museum with a very good guide.", "distractors": ["We visited the church with a very good guide.", "We visited the museum with a very young guide."] },
        { "id": "it-a2-arte-1-u10", "rev": 1, "stage": "word", "text": "famoso", "translation": "famous", "distractors": ["beautiful", "old"] },
        { "id": "it-a2-arte-1-u11", "rev": 1, "stage": "phrase", "text": "un museo famoso", "translation": "a famous museum", "distractors": ["a famous church", "a small museum"] },
        { "id": "it-a2-arte-1-u12", "rev": 1, "stage": "sentence", "text": "Gli Uffizi sono un museo molto famoso.", "translation": "The Uffizi is a very famous museum.", "distractors": ["The Uffizi is a very small museum.", "The Uffizi is a very famous church."] },
        { "id": "it-a2-arte-1-u13", "rev": 1, "stage": "chunk", "text": "il museo è chiuso", "translation": "the museum is closed", "distractors": ["the museum is open", "the church is closed"] },
        { "id": "it-a2-arte-1-u14", "rev": 1, "stage": "sentence", "text": "Il lunedì il museo è chiuso.", "translation": "On Mondays the museum is closed.", "distractors": ["On Mondays the museum is open.", "On Sundays the museum is closed."], "commas": [1] },
        { "id": "it-a2-arte-1-u15", "rev": 1, "stage": "sentence", "text": "Quando siamo arrivati, c'era già tanta gente.", "translation": "When we arrived, there were already lots of people.", "distractors": ["When we arrived, there was nobody there yet.", "When we left, there were already lots of people."] }
      ]
    },
    {
      "id": "it-a2-arte-2",
      "title": "Un quadro famoso",
      "grammarFocus": ["di for the artist: un quadro di Caravaggio", "fa: cinque secoli fa", "mentre + imperfetto"],
      "units": [
        { "id": "it-a2-arte-2-u01", "rev": 1, "stage": "word", "text": "quadro", "translation": "painting", "distractors": ["statue", "photo"] },
        { "id": "it-a2-arte-2-u02", "rev": 1, "stage": "phrase", "text": "un quadro famoso", "translation": "a famous painting", "distractors": ["a famous statue", "an ugly painting"] },
        { "id": "it-a2-arte-2-u03", "rev": 1, "stage": "sentence", "text": "Questo quadro è molto famoso.", "translation": "This painting is very famous.", "distractors": ["This statue is very famous.", "This painting isn't very famous."] },
        { "id": "it-a2-arte-2-u04", "rev": 1, "stage": "word", "text": "pittore", "translation": "painter", "distractors": ["writer", "actor"] },
        { "id": "it-a2-arte-2-u05", "rev": 1, "stage": "word", "text": "dipingere", "translation": "to paint", "distractors": ["to sell", "to draw"] },
        { "id": "it-a2-arte-2-u06", "rev": 1, "stage": "chunk", "text": "ha dipinto", "translation": "he painted", "distractors": ["he sold", "they painted"] },
        { "id": "it-a2-arte-2-u07", "rev": 1, "stage": "sentence", "text": "Chi ha dipinto questo quadro?", "translation": "Who painted this picture?", "distractors": ["Who sold this picture?", "Who painted this fresco?"] },
        { "id": "it-a2-arte-2-u08", "rev": 1, "stage": "sentence", "text": "È un quadro di Caravaggio.", "translation": "It's a painting by Caravaggio.", "distractors": ["It's a statue by Caravaggio.", "It's a painting of Caravaggio."] },
        { "id": "it-a2-arte-2-u09", "rev": 1, "stage": "phrase", "text": "cinque secoli fa", "translation": "five centuries ago", "distractors": ["five years ago", "three centuries ago"], "variants": ["5 secoli fa"] },
        { "id": "it-a2-arte-2-u10", "rev": 1, "stage": "sentence", "text": "Il pittore ha dipinto questo quadro cinque secoli fa.", "translation": "The painter painted this picture five centuries ago.", "distractors": ["The painter painted this picture five years ago.", "The painter sold this picture five centuries ago."], "variants": ["Il pittore ha dipinto questo quadro 5 secoli fa."] },
        { "id": "it-a2-arte-2-u11", "rev": 1, "stage": "phrase", "text": "un'opera d'arte", "translation": "a work of art", "distractors": ["a work of history", "an art book"] },
        { "id": "it-a2-arte-2-u12", "rev": 1, "stage": "sentence", "text": "Per me è un'opera d'arte bellissima.", "translation": "In my opinion it's a beautiful work of art.", "distractors": ["In my opinion it's an ugly work of art.", "In my opinion it's a beautiful piece of music."], "commas": [1] },
        { "id": "it-a2-arte-2-u13", "rev": 1, "stage": "chunk", "text": "i colori erano bellissimi", "translation": "the colors were beautiful", "distractors": ["the colors are beautiful", "the colors were ugly"] },
        { "id": "it-a2-arte-2-u14", "rev": 1, "stage": "sentence", "text": "I colori del quadro erano bellissimi.", "translation": "The colors of the painting were beautiful.", "distractors": ["The colors of the statue were beautiful.", "The colors of the painting were dark."] },
        { "id": "it-a2-arte-2-u15", "rev": 1, "stage": "sentence", "text": "Mentre guardavo il quadro, è arrivata la guida.", "translation": "While I was looking at the painting, the guide arrived.", "distractors": ["While I was looking at the painting, the guide left.", "While I was looking at the statue, the guide arrived."] }
      ]
