      "units": [
        { "id": "it-a1-cucina-5-u01", "rev": 1, "stage": "word", "text": "forno", "translation": "oven", "distractors": ["frying pan", "fridge"] },
        { "id": "it-a1-cucina-5-u02", "rev": 1, "stage": "phrase", "text": "a centottanta gradi", "translation": "to a hundred and eighty degrees", "distractors": ["to a hundred and sixty degrees", "to eighty degrees"], "variants": ["a 180 gradi"] },
        { "id": "it-a1-cucina-5-u03", "rev": 1, "stage": "sentence", "text": "Scaldo il forno a centottanta gradi.", "translation": "I heat the oven to a hundred and eighty degrees.", "distractors": ["I heat the oven to a hundred and sixty degrees.", "I heat the pan to a hundred and eighty degrees."], "variants": ["Scaldo il forno a 180 gradi."] },
        { "id": "it-a1-cucina-5-u04", "rev": 1, "stage": "phrase", "text": "nel forno caldo", "translation": "in the hot oven", "distractors": ["in the cold oven", "in the hot pan"] },
        { "id": "it-a1-cucina-5-u05", "rev": 1, "stage": "sentence", "text": "Metto la torta nel forno caldo.", "translation": "I put the cake in the hot oven.", "distractors": ["I put the bread in the hot oven.", "I put the cake in the cold oven."] },
        { "id": "it-a1-cucina-5-u06", "rev": 1, "stage": "word", "text": "cottura", "translation": "cooking", "distractors": ["recipe", "oven"] },
        { "id": "it-a1-cucina-5-u07", "rev": 1, "stage": "phrase", "text": "quaranta minuti di cottura", "translation": "forty minutes of cooking", "distractors": ["fourteen minutes of cooking", "forty minutes of preparation"], "variants": ["40 minuti di cottura"] },
        { "id": "it-a1-cucina-5-u08", "rev": 1, "stage": "sentence", "text": "Ci vogliono quaranta minuti di cottura.", "translation": "It takes forty minutes to cook.", "distractors": ["It takes fourteen minutes to cook.", "It takes forty minutes to prepare."], "variants": ["Ci vogliono 40 minuti di cottura."] },
        { "id": "it-a1-cucina-5-u09", "rev": 1, "stage": "word", "text": "pronto", "translation": "ready", "distractors": ["cooked", "hot"] },
