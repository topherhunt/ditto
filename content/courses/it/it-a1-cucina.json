        { "id": "it-a1-cucina-5-u14", "rev": 1, "stage": "sentence", "text": "Sulla pizza metto il basilico fresco.", "translation": "I put fresh basil on the pizza.", "distractors": ["I put fresh basil on the pasta.", "I put fresh garlic on the pizza."], "commas": [1] },
        { "id": "it-a1-cucina-5-u15", "rev": 1, "stage": "sentence", "text": "La pizza cuoce in forno per dieci minuti.", "translation": "The pizza bakes in the oven for ten minutes.", "distractors": ["The pizza bakes in the oven for twenty minutes.", "The bread bakes in the oven for ten minutes."], "variants": ["La pizza cuoce in forno per 10 minuti."] },
        { "id": "it-a1-cucina-5-u16", "rev": 1, "stage": "sentence", "text": "Il forno è ancora caldo.", "translation": "The oven is still hot.", "distractors": ["The oven is already cold.", "The pan is still hot."] }
      ]
    },
    {
      "id": "it-a1-cucina-6",
      "title": "Una cena per amici",
      "grammarFocus": ["noi forms: prepariamo, abbiamo", "mi aiuti a + infinitive"],
      "units": [
        { "id": "it-a1-cucina-6-u01", "rev": 1, "stage": "word", "text": "cucinare", "translation": "to cook", "distractors": ["to eat", "to order"] },
        { "id": "it-a1-cucina-6-u02", "rev": 1, "stage": "chunk", "text": "mi piace cucinare", "translation": "I like cooking", "distractors": ["I like eating", "I don't like cooking"] },
        { "id": "it-a1-cucina-6-u03", "rev": 1, "stage": "sentence", "text": "Mi piace molto cucinare per gli amici.", "translation": "I really like cooking for friends.", "distractors": ["I really like eating with friends.", "I don't like cooking for friends."] },
        { "id": "it-a1-cucina-6-u04", "rev": 1, "stage": "word", "text": "ospite", "translation": "guest", "distractors": ["friend", "neighbor"] },
        { "id": "it-a1-cucina-6-u05", "rev": 1, "stage": "phrase", "text": "otto ospiti", "translation": "eight guests", "distractors": ["eight friends", "eighteen guests"], "variants": ["8 ospiti"] },
        { "id": "it-a1-cucina-6-u06", "rev": 1, "stage": "sentence", "text": "Sabato abbiamo otto ospiti a cena.", "translation": "On Saturday we have eight guests for dinner.", "distractors": ["On Sunday we have eight guests for dinner.", "On Saturday we have eight guests for lunch."], "variants": ["Sabato abbiamo 8 ospiti a cena."], "commas": [0] },
        { "id": "it-a1-cucina-6-u07", "rev": 1, "stage": "word", "text": "preparare", "translation": "to make", "distractors": ["to order", "to invite"] },
        { "id": "it-a1-cucina-6-u08", "rev": 1, "stage": "sentence", "text": "Cosa prepariamo?", "translation": "What shall we make?", "distractors": ["What shall we order?", "Where shall we eat?"] },
        { "id": "it-a1-cucina-6-u09", "rev": 1, "stage": "phrase", "text": "un primo e un dolce", "translation": "a first course and a dessert", "distractors": ["a first course and a salad", "a starter and a dessert"] },
        { "id": "it-a1-cucina-6-u10", "rev": 1, "stage": "sentence", "text": "Prepariamo un antipasto, un primo e un dolce.", "translation": "We're making a starter, a first course and a dessert.", "distractors": ["We're making a starter, a first course and a salad.", "We're ordering a starter, a first course and a dessert."] },
        { "id": "it-a1-cucina-6-u11", "rev": 1, "stage": "word", "text": "aiutare", "translation": "to help", "distractors": ["to invite", "to wait"] },
        { "id": "it-a1-cucina-6-u12", "rev": 1, "stage": "sentence", "text": "Mi aiuti a tagliare le verdure?", "translation": "Can you help me cut the vegetables?", "distractors": ["Can you help me wash the vegetables?", "Can you help me cut the bread?"] },
        { "id": "it-a1-cucina-6-u13", "rev": 1, "stage": "word", "text": "cucchiaio", "translation": "spoon", "distractors": ["fork", "knife"] },
        { "id": "it-a1-cucina-6-u14", "rev": 1, "stage": "phrase", "text": "forchette e cucchiai", "translation": "forks and spoons", "distractors": ["knives and spoons", "forks and plates"] },
        { "id": "it-a1-cucina-6-u15", "rev": 1, "stage": "sentence", "text": "Sul tavolo ci sono piatti, forchette e bicchieri.", "translation": "On the table there are plates, forks and glasses.", "distractors": ["On the table there are plates, spoons and glasses.", "On the table there are plates, forks and bottles."], "commas": [1] },
        { "id": "it-a1-cucina-6-u16", "rev": 1, "stage": "sentence", "text": "La cena è pronta, tutti a tavola!", "translation": "Dinner's ready, everyone to the table!", "distractors": ["Lunch is ready, everyone to the table!", "Dinner's ready, everyone to the kitchen!"], "senses": {"4":"pron"} }
      ]
    }
