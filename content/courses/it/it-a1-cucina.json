      "id": "it-a1-cucina-3",
      "title": "La ricetta",
      "grammarFocus": ["prima... poi...", "noi forms: mettiamo, mescoliamo"],
      "units": [
        { "id": "it-a1-cucina-3-u01", "rev": 1, "stage": "word", "text": "ricetta", "translation": "recipe", "distractors": ["ingredient", "menu"] },
        { "id": "it-a1-cucina-3-u02", "rev": 1, "stage": "phrase", "text": "la ricetta della nonna", "translation": "grandma's recipe", "distractors": ["grandma's kitchen", "mom's recipe"] },
        { "id": "it-a1-cucina-3-u03", "rev": 1, "stage": "sentence", "text": "Questa è la ricetta della nonna.", "translation": "This is grandma's recipe.", "distractors": ["This is mom's recipe.", "This isn't grandma's recipe."] },
        { "id": "it-a1-cucina-3-u04", "rev": 1, "stage": "word", "text": "pentola", "translation": "pot", "distractors": ["frying pan", "plate"] },
        { "id": "it-a1-cucina-3-u05", "rev": 1, "stage": "sentence", "text": "Prima metto l'acqua nella pentola.", "translation": "First I put the water in the pot.", "distractors": ["Then I put the water in the pot.", "First I put the oil in the pot."], "commas": [0] },
        { "id": "it-a1-cucina-3-u06", "rev": 1, "stage": "chunk", "text": "l'acqua bolle", "translation": "the water is boiling", "distractors": ["the water is cold", "the oil is boiling"] },
        { "id": "it-a1-cucina-3-u07", "rev": 1, "stage": "word", "text": "aggiungere", "translation": "to add", "distractors": ["to stir", "to pour"] },
        { "id": "it-a1-cucina-3-u08", "rev": 1, "stage": "sentence", "text": "L'acqua bolle, adesso aggiungo il sale.", "translation": "The water's boiling, now I'll add the salt.", "distractors": ["The water's boiling, now I'll add the pasta.", "The water's cold, now I'll add the salt."] },
        { "id": "it-a1-cucina-3-u09", "rev": 1, "stage": "word", "text": "mescolare", "translation": "to stir", "distractors": ["to boil", "to add"] },
        { "id": "it-a1-cucina-3-u10", "rev": 1, "stage": "chunk", "text": "mescolare bene", "translation": "to stir well", "distractors": ["to cook well", "to stir a little"] },
        { "id": "it-a1-cucina-3-u11", "rev": 1, "stage": "sentence", "text": "Poi mettiamo la pasta e mescoliamo bene.", "translation": "Then we put in the pasta and stir well.", "distractors": ["First we put in the pasta and stir well.", "Then we put in the rice and stir well."], "commas": [0] },
        { "id": "it-a1-cucina-3-u12", "rev": 1, "stage": "phrase", "text": "il sugo di pomodoro", "translation": "the tomato sauce", "distractors": ["the meat sauce", "the tomato soup"] },
        { "id": "it-a1-cucina-3-u13", "rev": 1, "stage": "sentence", "text": "Il sugo cuoce piano per un'ora.", "translation": "The sauce cooks slowly for an hour.", "distractors": ["The sauce cooks fast for an hour.", "The sauce cooks slowly for a minute."] },
        { "id": "it-a1-cucina-3-u14", "rev": 1, "stage": "phrase", "text": "ottanta grammi", "translation": "eighty grams", "distractors": ["eighteen grams", "eighty kilos"], "variants": ["80 grammi"] },
        { "id": "it-a1-cucina-3-u15", "rev": 1, "stage": "sentence", "text": "Bastano ottanta grammi a persona.", "translation": "Eighty grams per person is enough.", "distractors": ["Eighteen grams per person is enough.", "Eighty grams per person is too much."], "variants": ["Bastano 80 grammi a persona."] },
        { "id": "it-a1-cucina-3-u16", "rev": 1, "stage": "sentence", "text": "È una ricetta molto facile.", "translation": "It's a very easy recipe.", "distractors": ["It's a very hard recipe.", "It's a very old recipe."] }
      ]
    },
    {
      "id": "it-a1-cucina-4",
      "title": "In padella",
      "grammarFocus": ["scaldare, friggere in the present", "a fuoco basso"],
      "units": [
        { "id": "it-a1-cucina-4-u01", "rev": 1, "stage": "word", "text": "padella", "translation": "frying pan", "distractors": ["pot", "plate"] },
        { "id": "it-a1-cucina-4-u02", "rev": 1, "stage": "word", "text": "scaldare", "translation": "to heat", "distractors": ["to cool", "to fry"] },
        { "id": "it-a1-cucina-4-u03", "rev": 1, "stage": "phrase", "text": "un po' d'olio", "translation": "a little oil", "distractors": ["a little butter", "a lot of oil"] },
        { "id": "it-a1-cucina-4-u04", "rev": 1, "stage": "sentence", "text": "Scaldo un po' d'olio in padella.", "translation": "I heat a little oil in the pan.", "distractors": ["I heat a little butter in the pan.", "I heat a lot of oil in the pan."] },
        { "id": "it-a1-cucina-4-u05", "rev": 1, "stage": "word", "text": "aglio", "translation": "garlic", "distractors": ["onion", "pepper"] },
        { "id": "it-a1-cucina-4-u06", "rev": 1, "stage": "phrase", "text": "l'aglio e il peperoncino", "translation": "the garlic and the chili pepper", "distractors": ["the garlic and the basil", "the onion and the chili pepper"] },
        { "id": "it-a1-cucina-4-u07", "rev": 1, "stage": "sentence", "text": "Aggiungo l'aglio e il peperoncino.", "translation": "I add the garlic and the chili pepper.", "distractors": ["I add the onion and the chili pepper.", "I add the garlic and the black pepper."] },
        { "id": "it-a1-cucina-4-u08", "rev": 1, "stage": "chunk", "text": "a fuoco basso", "translation": "over low heat", "distractors": ["over high heat", "in the oven"] },
        { "id": "it-a1-cucina-4-u09", "rev": 1, "stage": "sentence", "text": "Cuocio la cipolla a fuoco basso per cinque minuti.", "translation": "I cook the onion over low heat for five minutes.", "distractors": ["I cook the onion over high heat for five minutes.", "I cook the garlic over low heat for five minutes."], "variants": ["Cuocio la cipolla a fuoco basso per 5 minuti."] },
        { "id": "it-a1-cucina-4-u10", "rev": 1, "stage": "word", "text": "friggere", "translation": "to fry", "distractors": ["to boil", "to bake"] },
        { "id": "it-a1-cucina-4-u11", "rev": 1, "stage": "sentence", "text": "Friggo le patate nell'olio caldo.", "translation": "I fry the potatoes in hot oil.", "distractors": ["I fry the tomatoes in hot oil.", "I fry the potatoes in hot butter."] },
        { "id": "it-a1-cucina-4-u12", "rev": 1, "stage": "phrase", "text": "il pollo in padella", "translation": "the chicken in the pan", "distractors": ["the fish in the pan", "the chicken in the oven"] },
        { "id": "it-a1-cucina-4-u13", "rev": 1, "stage": "sentence", "text": "Devi girare spesso il pollo.", "translation": "You have to turn the chicken often.", "distractors": ["You have to turn the fish often.", "You don't have to turn the chicken."] },
        { "id": "it-a1-cucina-4-u14", "rev": 1, "stage": "word", "text": "pepe", "translation": "pepper", "distractors": ["salt", "oil"] },
        { "id": "it-a1-cucina-4-u15", "rev": 1, "stage": "chunk", "text": "sale e pepe", "translation": "salt and pepper", "distractors": ["salt and oil", "sugar and pepper"] },
        { "id": "it-a1-cucina-4-u16", "rev": 1, "stage": "sentence", "text": "Poi aggiungo sale e pepe.", "translation": "Then I add salt and pepper.", "distractors": ["First I add salt and pepper.", "Then I add salt and oil."], "commas": [0] }
      ]
    },
    {
