        { "id": "it-a1-cucina-5-u11", "rev": 1, "stage": "sentence", "text": "Dopo un'ora la torta è pronta.", "translation": "After an hour the cake is ready.", "distractors": ["After a minute the cake is ready.", "After an hour the bread is ready."], "commas": [1] },
        { "id": "it-a1-cucina-5-u12", "rev": 1, "stage": "word", "text": "basilico", "translation": "basil", "distractors": ["garlic", "parsley"] },
