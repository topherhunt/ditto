        { "id": "it-a1-tavola-5-u02", "rev": 1, "stage": "chunk", "text": "ho fame", "translation": "I'm hungry", "distractors": ["I'm thirsty", "I'm full"] },
        { "id": "it-a1-tavola-5-u03", "rev": 1, "stage": "sentence", "text": "Ho fame, andiamo a mangiare?", "translation": "I'm hungry, shall we go and eat?", "distractors": ["I'm thirsty, shall we go and eat?", "I'm hungry, shall we go home?"] },
        { "id": "it-a1-tavola-5-u04", "rev": 1, "stage": "chunk", "text": "ho sete", "translation": "I'm thirsty", "distractors": ["I'm hungry", "I'm tired"] },
