        { "id": "it-a1-tavola-4-u08", "rev": 1, "stage": "chunk", "text": "ti piace", "translation": "do you like", "distractors": ["I like", "do you want"] },
        { "id": "it-a1-tavola-4-u09", "rev": 1, "stage": "phrase", "text": "la cucina italiana", "translation": "Italian food", "distractors": ["French food", "Italian wine"] },
        { "id": "it-a1-tavola-4-u10", "rev": 1, "stage": "sentence", "text": "Ti piace la cucina italiana?", "translation": "Do you like Italian food?", "distractors": ["Do you like French food?", "Do you like Italian wine?"] },
        { "id": "it-a1-tavola-4-u11", "rev": 1, "stage": "word", "text": "preferire", "translation": "to prefer", "distractors": ["to order", "to like"] },
        { "id": "it-a1-tavola-4-u12", "rev": 1, "stage": "sentence", "text": "Io preferisco la carne, e tu?", "translation": "I prefer meat, how about you?", "distractors": ["I prefer fish, how about you?", "I don't eat meat, how about you?"] },
        { "id": "it-a1-tavola-4-u13", "rev": 1, "stage": "word", "text": "vegetariano", "translation": "vegetarian", "distractors": ["hungry", "Italian"] },
        { "id": "it-a1-tavola-4-u14", "rev": 1, "stage": "sentence", "text": "Sono vegetariana, non mangio carne.", "translation": "I'm vegetarian, I don't eat meat.", "distractors": ["I'm vegetarian, I don't eat fish.", "I'm not vegetarian, I eat meat."] },
        { "id": "it-a1-tavola-4-u15", "rev": 1, "stage": "word", "text": "piccante", "translation": "spicy", "distractors": ["sweet", "salty"] },
        { "id": "it-a1-tavola-4-u16", "rev": 1, "stage": "sentence", "text": "Questo piatto è troppo piccante per me.", "translation": "This dish is too spicy for me.", "distractors": ["This dish isn't spicy enough for me.", "This dish is too salty for me."] }
      ]
    },
    {
