        { "id": "it-a1-tavola-5-u06", "rev": 1, "stage": "sentence", "text": "Ho sete, vorrei bere un po' d'acqua.", "translation": "I'm thirsty, I'd like to drink some water.", "distractors": ["I'm hungry, I'd like to drink some water.", "I'm thirsty, I'd like to drink some wine."] },
        { "id": "it-a1-tavola-5-u07", "rev": 1, "stage": "chunk", "text": "cosa bevi", "translation": "what are you drinking", "distractors": ["what are you eating", "what are we drinking"] },
        { "id": "it-a1-tavola-5-u08", "rev": 1, "stage": "sentence", "text": "Cosa bevete, vino o birra?", "translation": "What are you drinking, wine or beer?", "distractors": ["What are you eating, meat or fish?", "What are you drinking, wine or water?"] },
        { "id": "it-a1-tavola-5-u09", "rev": 1, "stage": "phrase", "text": "del pane", "translation": "some bread", "distractors": ["some cheese", "no bread"] },
        { "id": "it-a1-tavola-5-u10", "rev": 1, "stage": "sentence", "text": "Mi porta ancora del pane, per favore?", "translation": "Could you bring me some more bread, please?", "distractors": ["Could you bring me some more wine, please?", "Could you bring me the bill, please?"] },
        { "id": "it-a1-tavola-5-u11", "rev": 1, "stage": "phrase", "text": "olio e sale", "translation": "oil and salt", "distractors": ["oil and vinegar", "salt and pepper"] },
        { "id": "it-a1-tavola-5-u12", "rev": 1, "stage": "sentence", "text": "Scusi, mi porta olio e sale per l'insalata?", "translation": "Excuse me, could you bring me oil and salt for the salad?", "distractors": ["Excuse me, could you bring me oil and salt for the bread?", "Excuse me, could you bring me salt and pepper for the salad?"] },
        { "id": "it-a1-tavola-5-u13", "rev": 1, "stage": "sentence", "text": "Beviamo del vino rosso?", "translation": "Shall we drink some red wine?", "distractors": ["Shall we drink some white wine?", "Shall we have some red meat?"] },
        { "id": "it-a1-tavola-5-u14", "rev": 1, "stage": "phrase", "text": "una mela", "translation": "an apple", "distractors": ["an orange", "a pear"] },
        { "id": "it-a1-tavola-5-u15", "rev": 1, "stage": "sentence", "text": "Non ho molta fame, mangio solo una mela.", "translation": "I'm not very hungry, I'll just eat an apple.", "distractors": ["I'm very hungry, I'll eat an apple.", "I'm not very hungry, I'll just eat some bread."] }
      ]
    },
    {
      "id": "it-a1-tavola-6",
      "title": "Il dolce e il conto",
      "grammarFocus": ["buono / cattivo / ottimo", "basta così", "ci porta...?"],
      "units": [
