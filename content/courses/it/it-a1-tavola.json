  "lessons": [
    {
      "id": "it-a1-tavola-1",
      "title": "Un tavolo per due",
      "grammarFocus": ["vorrei + infinitive", "c'è posto?", "per + number of people"],
      "units": [
        { "id": "it-a1-tavola-1-u01", "rev": 1, "stage": "word", "text": "tavolo", "translation": "table", "distractors": ["chair", "menu"] },
        { "id": "it-a1-tavola-1-u02", "rev": 1, "stage": "phrase", "text": "un tavolo per due", "translation": "a table for two", "distractors": ["a table for three", "a room for two"], "variants": ["un tavolo per 2"] },
        { "id": "it-a1-tavola-1-u03", "rev": 1, "stage": "sentence", "text": "Buonasera, avete un tavolo per due?", "translation": "Good evening, do you have a table for two?", "distractors": ["Good evening, do you have a table for three?", "Good morning, do you have a room for two?"], "variants": ["Buonasera, avete un tavolo per 2?"] },
        { "id": "it-a1-tavola-1-u04", "rev": 1, "stage": "chunk", "text": "c'è posto", "translation": "there's room", "distractors": ["there's no room", "there's a menu"] },
        { "id": "it-a1-tavola-1-u05", "rev": 1, "stage": "sentence", "text": "Siamo in quattro, c'è posto?", "translation": "There are four of us, is there room?", "distractors": ["There are two of us, is there room?", "There are four of us, is it open?"], "variants": ["Siamo in 4, c'è posto?"] },
        { "id": "it-a1-tavola-1-u06", "rev": 1, "stage": "word", "text": "prenotare", "translation": "to book", "distractors": ["to order", "to pay"] },
        { "id": "it-a1-tavola-1-u07", "rev": 1, "stage": "chunk", "text": "vorrei prenotare un tavolo", "translation": "I'd like to book a table", "distractors": ["I'd like to pay for a table", "I'd like to book a room"] },
        { "id": "it-a1-tavola-1-u08", "rev": 1, "stage": "phrase", "text": "per domani sera", "translation": "for tomorrow evening", "distractors": ["for this evening", "for tomorrow morning"] },
        { "id": "it-a1-tavola-1-u09", "rev": 1, "stage": "sentence", "text": "Vorrei prenotare un tavolo per domani sera.", "translation": "I'd like to book a table for tomorrow evening.", "distractors": ["I'd like to book a table for tomorrow morning.", "I'd like to pay for a table for tomorrow evening."] },
        { "id": "it-a1-tavola-1-u10", "rev": 1, "stage": "word", "text": "persona", "translation": "person", "distractors": ["name", "place"] },
        { "id": "it-a1-tavola-1-u11", "rev": 1, "stage": "phrase", "text": "alle otto", "translation": "at eight", "distractors": ["at nine", "after eight"], "variants": ["alle 8"] },
        { "id": "it-a1-tavola-1-u12", "rev": 1, "stage": "sentence", "text": "Per cinque persone, alle otto.", "translation": "For five people, at eight.", "distractors": ["For five people, at nine.", "For eight people, at five."], "variants": ["Per 5 persone, alle 8.", "Per cinque persone, alle 8.", "Per 5 persone, alle otto."] },
        { "id": "it-a1-tavola-1-u13", "rev": 1, "stage": "chunk", "text": "a che nome", "translation": "under what name", "distractors": ["at what time", "for how many"] },
        { "id": "it-a1-tavola-1-u14", "rev": 1, "stage": "sentence", "text": "Va bene, a che nome?", "translation": "All right, under what name?", "distractors": ["All right, at what time?", "All right, for how many people?"] },
        { "id": "it-a1-tavola-1-u15", "rev": 1, "stage": "word", "text": "occupato", "translation": "taken", "distractors": ["free", "closed"] },
        { "id": "it-a1-tavola-1-u16", "rev": 1, "stage": "sentence", "text": "Oggi è tutto occupato, ma domani c'è posto.", "translation": "We're fully booked today, but there's room tomorrow.", "distractors": ["We're fully booked tomorrow, but there's room today.", "We're closed today, but there's room tomorrow."] }
      ]
    },
    {
      "id": "it-a1-tavola-2",
      "title": "Il menù",
      "grammarFocus": ["mi porta...?", "cosa mi consiglia?", "del: il piatto del giorno"],
      "units": [
        { "id": "it-a1-tavola-2-u01", "rev": 1, "stage": "word", "text": "menù", "translation": "menu", "distractors": ["bill", "wine list"] },
        { "id": "it-a1-tavola-2-u02", "rev": 1, "stage": "chunk", "text": "mi porta", "translation": "could you bring me", "distractors": ["could you show me", "I'll bring you"] },
        { "id": "it-a1-tavola-2-u03", "rev": 1, "stage": "sentence", "text": "Scusi, mi porta il menù?", "translation": "Excuse me, could you bring me the menu?", "distractors": ["Excuse me, could you bring me the bill?", "Excuse me, could you show me the menu?"] },
        { "id": "it-a1-tavola-2-u04", "rev": 1, "stage": "sentence", "text": "Prego, ecco il menù.", "translation": "Here you are, here's the menu.", "distractors": ["Here you are, here's the bill.", "Thank you, here's the menu."] },
        { "id": "it-a1-tavola-2-u05", "rev": 1, "stage": "word", "text": "cosa", "translation": "what", "distractors": ["who", "where"] },
        { "id": "it-a1-tavola-2-u06", "rev": 1, "stage": "chunk", "text": "cosa mi consiglia", "translation": "what do you recommend", "distractors": ["what do you want", "who do you recommend"] },
        { "id": "it-a1-tavola-2-u07", "rev": 1, "stage": "sentence", "text": "Cosa ci consiglia oggi?", "translation": "What do you recommend for us today?", "distractors": ["What do you recommend for me today?", "What do you have for us today?"] },
        { "id": "it-a1-tavola-2-u08", "rev": 1, "stage": "word", "text": "piatto", "translation": "dish", "distractors": ["glass", "table"] },
        { "id": "it-a1-tavola-2-u09", "rev": 1, "stage": "phrase", "text": "il piatto del giorno", "translation": "the dish of the day", "distractors": ["the wine of the day", "the dish of the week"] },
        { "id": "it-a1-tavola-2-u10", "rev": 1, "stage": "sentence", "text": "Consiglio il piatto del giorno.", "translation": "I recommend the dish of the day.", "distractors": ["I recommend the wine of the day.", "I'll have the dish of the day."] },
        { "id": "it-a1-tavola-2-u11", "rev": 1, "stage": "word", "text": "pesce", "translation": "fish", "distractors": ["meat", "chicken"] },
        { "id": "it-a1-tavola-2-u12", "rev": 1, "stage": "phrase", "text": "molto buono", "translation": "very good", "distractors": ["not very good", "too sweet"] },
        { "id": "it-a1-tavola-2-u13", "rev": 1, "stage": "sentence", "text": "Oggi il pesce è molto buono.", "translation": "The fish is very good today.", "distractors": ["The meat is very good today.", "The fish isn't very good today."], "commas": [0] },
        { "id": "it-a1-tavola-2-u14", "rev": 1, "stage": "word", "text": "carne", "translation": "meat", "distractors": ["fish", "bread"] },
        { "id": "it-a1-tavola-2-u15", "rev": 1, "stage": "chunk", "text": "cosa desidera", "translation": "what would you like", "distractors": ["what do you recommend", "what do you have"] },
        { "id": "it-a1-tavola-2-u16", "rev": 1, "stage": "sentence", "text": "Allora, cosa desidera, carne o pesce?", "translation": "So, what would you like, meat or fish?", "distractors": ["So, what do you recommend, meat or fish?", "So, what would you like, meat or pasta?"] }
      ]
    },
