        { "id": "it-a1-tavola-3-u02", "rev": 1, "stage": "sentence", "text": "Scusi, posso ordinare?", "translation": "Excuse me, can I order?", "distractors": ["Excuse me, can I pay?", "Excuse me, can you order?"] },
        { "id": "it-a1-tavola-3-u03", "rev": 1, "stage": "word", "text": "pasta", "translation": "pasta", "distractors": ["rice", "bread"] },
        { "id": "it-a1-tavola-3-u04", "rev": 1, "stage": "phrase", "text": "la pasta al pomodoro", "translation": "pasta with tomato sauce", "distractors": ["rice with tomato sauce", "pasta with cheese"] },
        { "id": "it-a1-tavola-3-u05", "rev": 1, "stage": "word", "text": "primo", "translation": "first course", "distractors": ["main course", "dessert"] },
        { "id": "it-a1-tavola-3-u06", "rev": 1, "stage": "sentence", "text": "Per primo prendo la pasta al pomodoro.", "translation": "For the first course, I'll have pasta with tomato sauce.", "distractors": ["For the main course, I'll have pasta with tomato sauce.", "For the first course, I'll have rice with tomato sauce."], "commas": [1] },
        { "id": "it-a1-tavola-3-u07", "rev": 1, "stage": "word", "text": "secondo", "translation": "main course", "distractors": ["first course", "side dish"] },
        { "id": "it-a1-tavola-3-u08", "rev": 1, "stage": "phrase", "text": "il pollo con le patate", "translation": "chicken with potatoes", "distractors": ["fish with potatoes", "chicken with salad"] },
        { "id": "it-a1-tavola-3-u09", "rev": 1, "stage": "sentence", "text": "Di secondo vorrei il pollo con le patate.", "translation": "For the main course, I'd like the chicken with potatoes.", "distractors": ["For the first course, I'd like the chicken with potatoes.", "For the main course, I'd like the fish with salad."], "commas": [1] },
        { "id": "it-a1-tavola-3-u10", "rev": 1, "stage": "phrase", "text": "di contorno", "translation": "on the side", "distractors": ["as a starter", "as a main course"] },
        { "id": "it-a1-tavola-3-u11", "rev": 1, "stage": "sentence", "text": "Di contorno un'insalata, per favore.", "translation": "A salad on the side, please.", "distractors": ["A salad as a starter, please.", "Potatoes on the side, please."], "commas": [1] },
        { "id": "it-a1-tavola-3-u12", "rev": 1, "stage": "chunk", "text": "niente antipasto", "translation": "no starter", "distractors": ["no dessert", "just a starter"] },
        { "id": "it-a1-tavola-3-u13", "rev": 1, "stage": "sentence", "text": "Niente antipasto per me, solo un primo.", "translation": "No starter for me, just a first course.", "distractors": ["No dessert for me, just a first course.", "A starter for me, and a first course."], "commas": [1] },
        { "id": "it-a1-tavola-3-u14", "rev": 1, "stage": "chunk", "text": "senza carne", "translation": "without meat", "distractors": ["with meat", "without cheese"] },
        { "id": "it-a1-tavola-3-u15", "rev": 1, "stage": "sentence", "text": "C'è un primo senza carne?", "translation": "Is there a first course without meat?", "distractors": ["Is there a first course with meat?", "Is there a dessert without meat?"] },
        { "id": "it-a1-tavola-3-u16", "rev": 1, "stage": "sentence", "text": "Allora prendo il riso con le verdure.", "translation": "Then I'll have the rice with vegetables.", "distractors": ["Then I'll have the rice with fish.", "Then I'll have the pasta with vegetables."], "commas": [0] }
      ]
    },
    {
      "id": "it-a1-tavola-4",
