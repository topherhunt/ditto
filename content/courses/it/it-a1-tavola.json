        { "id": "it-a1-tavola-4-u02", "rev": 1, "stage": "sentence", "text": "Mi piace molto la pizza.", "translation": "I really like pizza.", "distractors": ["I don't really like pizza.", "I really like pasta."] },
        { "id": "it-a1-tavola-4-u03", "rev": 1, "stage": "chunk", "text": "non mi piace", "translation": "I don't like", "distractors": ["I like", "you don't like"] },
        { "id": "it-a1-tavola-4-u04", "rev": 1, "stage": "sentence", "text": "Non mi piace il formaggio.", "translation": "I don't like cheese.", "distractors": ["I like cheese.", "I don't like fish."] },
        { "id": "it-a1-tavola-4-u05", "rev": 1, "stage": "chunk", "text": "mi piacciono", "translation": "I like them", "distractors": ["I don't like them", "you like them"] },
        { "id": "it-a1-tavola-4-u06", "rev": 1, "stage": "phrase", "text": "i pomodori", "translation": "the tomatoes", "distractors": ["the potatoes", "the tomato"] },
