        { "id": "it-a1-tavola-6-u02", "rev": 1, "stage": "sentence", "text": "Prendete il dolce o la frutta?", "translation": "Will you have dessert or fruit?", "distractors": ["Will you have dessert or coffee?", "Will you have a starter or fruit?"] },
        { "id": "it-a1-tavola-6-u03", "rev": 1, "stage": "word", "text": "gelato", "translation": "ice cream", "distractors": ["cake", "fruit"] },
        { "id": "it-a1-tavola-6-u04", "rev": 1, "stage": "phrase", "text": "un gelato e un caffè", "translation": "an ice cream and a coffee", "distractors": ["an ice cream and a tea", "an ice cream or a coffee"] },
        { "id": "it-a1-tavola-6-u05", "rev": 1, "stage": "sentence", "text": "Per me un gelato e un caffè, grazie.", "translation": "For me, an ice cream and a coffee, thanks.", "distractors": ["For me, an ice cream and a tea, thanks.", "For me, just a coffee, thanks."], "commas": [1] },
        { "id": "it-a1-tavola-6-u06", "rev": 1, "stage": "word", "text": "buono", "translation": "good", "distractors": ["bad", "sweet"] },
        { "id": "it-a1-tavola-6-u07", "rev": 1, "stage": "sentence", "text": "Questo gelato è molto buono!", "translation": "This ice cream is really good!", "distractors": ["This ice cream isn't very good!", "This coffee is really good!"] },
        { "id": "it-a1-tavola-6-u08", "rev": 1, "stage": "word", "text": "cattivo", "translation": "bad", "distractors": ["good", "cold"] },
        { "id": "it-a1-tavola-6-u09", "rev": 1, "stage": "sentence", "text": "Non è cattivo, ma preferisco il pesce.", "translation": "It's not bad, but I prefer fish.", "distractors": ["It's not good, but I prefer fish.", "It's not bad, but I prefer meat."] },
        { "id": "it-a1-tavola-6-u10", "rev": 1, "stage": "chunk", "text": "basta così", "translation": "that's enough", "distractors": ["a bit more", "that's too little"] },
        { "id": "it-a1-tavola-6-u11", "rev": 1, "stage": "sentence", "text": "No, basta così, grazie.", "translation": "No, that's enough, thanks.", "distractors": ["Yes, a bit more, thanks.", "No, that's too little, thanks."] },
