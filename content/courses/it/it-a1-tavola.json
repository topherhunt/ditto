        { "id": "it-a1-tavola-6-u13", "rev": 1, "stage": "sentence", "text": "Scusi, ci porta il conto?", "translation": "Excuse me, could you bring us the bill?", "distractors": ["Excuse me, could you bring us the menu?", "Excuse me, could you bring me some water?"] },
        { "id": "it-a1-tavola-6-u14", "rev": 1, "stage": "word", "text": "ottimo", "translation": "excellent", "distractors": ["terrible", "enough"] },
        { "id": "it-a1-tavola-6-u15", "rev": 1, "stage": "chunk", "text": "tutto ottimo", "translation": "everything was excellent", "distractors": ["everything was terrible", "nothing was excellent"] },
        { "id": "it-a1-tavola-6-u16", "rev": 1, "stage": "sentence", "text": "Tutto ottimo, grazie, anche il dolce!", "translation": "Everything was excellent, thanks, the dessert too!", "distractors": ["Everything was excellent, thanks, except the dessert!", "Everything was cold, thanks, the dessert too!"] }
      ]
