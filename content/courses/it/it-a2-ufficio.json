  "lessons": [
    {
      "id": "it-a2-ufficio-1",
      "title": "La riunione",
      "grammarFocus": ["c'è + noun", "dovere + infinitive", "del, nella"],
      "units": [
        { "id": "it-a2-ufficio-1-u01", "rev": 1, "stage": "word", "text": "riunione", "translation": "meeting", "distractors": ["break", "deadline"] },
        { "id": "it-a2-ufficio-1-u02", "rev": 1, "stage": "phrase", "text": "una riunione importante", "translation": "an important meeting", "distractors": ["a long meeting", "an important client"] },
        { "id": "it-a2-ufficio-1-u03", "rev": 1, "stage": "sentence", "text": "C'è una riunione alle dieci.", "translation": "There's a meeting at ten.", "distractors": ["There's a meeting at two.", "There's a break at ten."], "variants": ["C'è una riunione alle 10."] },
        { "id": "it-a2-ufficio-1-u04", "rev": 1, "stage": "word", "text": "sala", "translation": "room", "distractors": ["desk", "office"] },
        { "id": "it-a2-ufficio-1-u05", "rev": 1, "stage": "phrase", "text": "la sala riunioni", "translation": "the meeting room", "distractors": ["the waiting room", "the boss's office"] },
        { "id": "it-a2-ufficio-1-u06", "rev": 1, "stage": "sentence", "text": "La riunione è nella sala riunioni.", "translation": "The meeting is in the meeting room.", "distractors": ["The meeting is in the boss's office.", "The break is in the meeting room."] },
        { "id": "it-a2-ufficio-1-u07", "rev": 1, "stage": "word", "text": "progetto", "translation": "project", "distractors": ["contract", "meeting"] },
        { "id": "it-a2-ufficio-1-u08", "rev": 1, "stage": "phrase", "text": "il nuovo progetto", "translation": "the new project", "distractors": ["the old project", "the new client"] },
        { "id": "it-a2-ufficio-1-u09", "rev": 1, "stage": "chunk", "text": "parlare del progetto", "translation": "to talk about the project", "distractors": ["to write about the project", "to talk to the client"] },
        { "id": "it-a2-ufficio-1-u10", "rev": 1, "stage": "sentence", "text": "Oggi dobbiamo parlare del nuovo progetto.", "translation": "Today we need to talk about the new project.", "distractors": ["Tomorrow we need to talk about the new project.", "Today we need to talk about the new client."], "commas": [0] },
        { "id": "it-a2-ufficio-1-u11", "rev": 1, "stage": "word", "text": "responsabile", "translation": "person in charge", "distractors": ["colleague", "client"] },
        { "id": "it-a2-ufficio-1-u12", "rev": 1, "stage": "chunk", "text": "è il responsabile del progetto", "translation": "he's in charge of the project", "distractors": ["he's new on the project", "he's in charge of the office"] },
        { "id": "it-a2-ufficio-1-u13", "rev": 1, "stage": "sentence", "text": "Marco è il responsabile del progetto.", "translation": "Marco is in charge of the project.", "distractors": ["Marco is new on the project.", "Marco is in charge of the office."] },
        { "id": "it-a2-ufficio-1-u14", "rev": 1, "stage": "chunk", "text": "preparare la presentazione", "translation": "to prepare the presentation", "distractors": ["to print the presentation", "to prepare the meeting room"] },
        { "id": "it-a2-ufficio-1-u15", "rev": 1, "stage": "sentence", "text": "Stamattina ho preparato la presentazione per la riunione.", "translation": "This morning I prepared the presentation for the meeting.", "distractors": ["This evening I prepared the presentation for the meeting.", "This morning I prepared the presentation for the client."], "commas": [0] },
        { "id": "it-a2-ufficio-1-u16", "rev": 1, "stage": "sentence", "text": "La riunione è finita a mezzogiorno.", "translation": "The meeting ended at noon.", "distractors": ["The meeting started at noon.", "The meeting ended at midnight."] }
      ]
    },
    {
      "id": "it-a2-ufficio-2",
      "title": "Le email",
      "grammarFocus": ["passato prossimo: ho mandato, ho ricevuto", "già / non ancora", "in allegato"],
      "units": [
        { "id": "it-a2-ufficio-2-u01", "rev": 1, "stage": "word", "text": "email", "translation": "email", "distractors": ["letter", "phone call"] },
        { "id": "it-a2-ufficio-2-u02", "rev": 1, "stage": "phrase", "text": "un'email importante", "translation": "an important email", "distractors": ["an important letter", "a long email"] },
        { "id": "it-a2-ufficio-2-u03", "rev": 1, "stage": "sentence", "text": "Ho ricevuto un'email importante da Marco.", "translation": "I got an important email from Marco.", "distractors": ["I sent an important email to Marco.", "I got a long email from Marco."] },
        { "id": "it-a2-ufficio-2-u04", "rev": 1, "stage": "word", "text": "rispondere", "translation": "to reply", "distractors": ["to read", "to send"] },
        { "id": "it-a2-ufficio-2-u05", "rev": 1, "stage": "chunk", "text": "rispondere all'email", "translation": "to reply to the email", "distractors": ["to read the email", "to reply to the message"] },
        { "id": "it-a2-ufficio-2-u06", "rev": 1, "stage": "sentence", "text": "Non ho ancora risposto all'email di Giulia.", "translation": "I haven't replied to Giulia's email yet.", "distractors": ["I've already replied to Giulia's email.", "I haven't read Giulia's email yet."] },
        { "id": "it-a2-ufficio-2-u07", "rev": 1, "stage": "word", "text": "allegato", "translation": "attachment", "distractors": ["subject line", "signature"] },
        { "id": "it-a2-ufficio-2-u08", "rev": 1, "stage": "phrase", "text": "le foto in allegato", "translation": "the attached photos", "distractors": ["the printed photos", "the attached videos"] },
        { "id": "it-a2-ufficio-2-u09", "rev": 1, "stage": "sentence", "text": "Ho mandato le foto in allegato.", "translation": "I sent the photos as an attachment.", "distractors": ["I got the photos as an attachment.", "I sent the videos as an attachment."] },
        { "id": "it-a2-ufficio-2-u10", "rev": 1, "stage": "word", "text": "cliente", "translation": "client", "distractors": ["colleague", "boss"] },
        { "id": "it-a2-ufficio-2-u11", "rev": 1, "stage": "phrase", "text": "un nuovo cliente", "translation": "a new client", "distractors": ["an old client", "a new colleague"] },
        { "id": "it-a2-ufficio-2-u12", "rev": 1, "stage": "chunk", "text": "scrivere al cliente", "translation": "to write to the client", "distractors": ["to call the client", "to write to the boss"] },
        { "id": "it-a2-ufficio-2-u13", "rev": 1, "stage": "sentence", "text": "Devo scrivere un'email al nuovo cliente.", "translation": "I have to write an email to the new client.", "distractors": ["I have to write a letter to the new client.", "I have to write an email to the new colleague."] },
        { "id": "it-a2-ufficio-2-u14", "rev": 1, "stage": "chunk", "text": "hai già mandato", "translation": "have you already sent", "distractors": ["have you already read", "haven't you sent yet"] },
        { "id": "it-a2-ufficio-2-u15", "rev": 1, "stage": "sentence", "text": "Hai già mandato l'email a tutti?", "translation": "Have you already sent the email to everyone?", "distractors": ["Have you already read the email?", "Have you already sent the email to the client?"] },
        { "id": "it-a2-ufficio-2-u16", "rev": 1, "stage": "sentence", "text": "Sì, ho mandato l'email stamattina.", "translation": "Yes, I sent the email this morning.", "distractors": ["No, I sent the email this evening.", "Yes, I read the email this morning."], "commas": [3] }
      ]
    },
    {
      "id": "it-a2-ufficio-3",
      "title": "Il capo",
      "grammarFocus": ["possessives: il mio capo, la tua scrivania", "passato prossimo with essere and avere", "dire di sì"],
      "units": [
        { "id": "it-a2-ufficio-3-u01", "rev": 1, "stage": "word", "text": "capo", "translation": "boss", "distractors": ["client", "colleague"] },
        { "id": "it-a2-ufficio-3-u02", "rev": 1, "stage": "phrase", "text": "il mio capo", "translation": "my boss", "distractors": ["your boss", "my colleague"] },
        { "id": "it-a2-ufficio-3-u03", "rev": 1, "stage": "word", "text": "puntuale", "translation": "punctual", "distractors": ["late", "polite"] },
        { "id": "it-a2-ufficio-3-u04", "rev": 1, "stage": "sentence", "text": "Il mio capo è sempre puntuale.", "translation": "My boss is always punctual.", "distractors": ["My boss is never punctual.", "My colleague is always punctual."] },
        { "id": "it-a2-ufficio-3-u05", "rev": 1, "stage": "word", "text": "contratto", "translation": "contract", "distractors": ["salary", "meeting"] },
        { "id": "it-a2-ufficio-3-u06", "rev": 1, "stage": "chunk", "text": "firmare il contratto", "translation": "to sign the contract", "distractors": ["to print the contract", "to sign the letter"] },
        { "id": "it-a2-ufficio-3-u07", "rev": 1, "stage": "sentence", "text": "Il capo deve ancora firmare il contratto.", "translation": "The boss still has to sign the contract.", "distractors": ["The boss has already signed the contract.", "The client still has to sign the contract."] },
        { "id": "it-a2-ufficio-3-u08", "rev": 1, "stage": "word", "text": "scrivania", "translation": "desk", "distractors": ["chair", "office"] },
        { "id": "it-a2-ufficio-3-u09", "rev": 1, "stage": "phrase", "text": "sulla scrivania", "translation": "on the desk", "distractors": ["under the desk", "on the table"] },
        { "id": "it-a2-ufficio-3-u10", "rev": 1, "stage": "sentence", "text": "Ho messo il contratto sulla tua scrivania.", "translation": "I put the contract on your desk.", "distractors": ["I put the contract on my desk.", "I put the letter on your desk."] },
        { "id": "it-a2-ufficio-3-u11", "rev": 1, "stage": "phrase", "text": "un buon stipendio", "translation": "a good salary", "distractors": ["a low salary", "a good contract"] },
        { "id": "it-a2-ufficio-3-u12", "rev": 1, "stage": "sentence", "text": "Nel nuovo lavoro ho un buon stipendio.", "translation": "In my new job I have a good salary.", "distractors": ["In my old job I had a good salary.", "In my new job I have a good contract."], "commas": [2] },
        { "id": "it-a2-ufficio-3-u13", "rev": 1, "stage": "chunk", "text": "sono andata dal capo", "translation": "I went to see the boss", "distractors": ["I went with the boss", "I called the boss"] },
        { "id": "it-a2-ufficio-3-u14", "rev": 1, "stage": "sentence", "text": "Ieri sono andata dal capo per parlare dello stipendio.", "translation": "Yesterday I went to see the boss to talk about my salary.", "distractors": ["Today I went to see the boss to talk about my salary.", "Yesterday I went to see the boss to talk about my contract."], "commas": [0] },
        { "id": "it-a2-ufficio-3-u15", "rev": 1, "stage": "sentence", "text": "Il capo ha detto di sì.", "translation": "The boss said yes.", "distractors": ["The boss said no.", "The client said yes."] }
      ]
    },
    {
      "id": "it-a2-ufficio-4",
      "title": "Una scadenza",
      "grammarFocus": ["entro + time", "passato prossimo: ho stampato, ho fatto", "c'è un problema"],
      "units": [
        { "id": "it-a2-ufficio-4-u01", "rev": 1, "stage": "word", "text": "scadenza", "translation": "deadline", "distractors": ["meeting", "holiday"] },
        { "id": "it-a2-ufficio-4-u02", "rev": 1, "stage": "phrase", "text": "la scadenza del progetto", "translation": "the project deadline", "distractors": ["the project meeting", "the contract deadline"] },
        { "id": "it-a2-ufficio-4-u03", "rev": 1, "stage": "sentence", "text": "La scadenza del progetto è venerdì.", "translation": "The project deadline is Friday.", "distractors": ["The project deadline is Thursday.", "The project meeting is Friday."] },
        { "id": "it-a2-ufficio-4-u04", "rev": 1, "stage": "word", "text": "entro", "translation": "by", "distractors": ["after", "since"] },
        { "id": "it-a2-ufficio-4-u05", "rev": 1, "stage": "phrase", "text": "entro domani", "translation": "by tomorrow", "distractors": ["by Monday", "after tomorrow"] },
        { "id": "it-a2-ufficio-4-u06", "rev": 1, "stage": "sentence", "text": "Devo finire tutto entro domani.", "translation": "I have to finish everything by tomorrow.", "distractors": ["I have to finish everything by Monday.", "I have to start everything by tomorrow."] },
        { "id": "it-a2-ufficio-4-u07", "rev": 1, "stage": "word", "text": "stampare", "translation": "to print", "distractors": ["to sign", "to send"] },
        { "id": "it-a2-ufficio-4-u08", "rev": 1, "stage": "word", "text": "stampante", "translation": "printer", "distractors": ["desk", "screen"] },
        { "id": "it-a2-ufficio-4-u09", "rev": 1, "stage": "sentence", "text": "C'è un problema: la stampante non funziona.", "translation": "There's a problem: the printer isn't working.", "distractors": ["There's no problem: the printer is working.", "There's a problem: the phone isn't working."] },
        { "id": "it-a2-ufficio-4-u10", "rev": 1, "stage": "chunk", "text": "ho stampato il contratto", "translation": "I printed the contract", "distractors": ["I signed the contract", "I didn't print the contract"] },
        { "id": "it-a2-ufficio-4-u11", "rev": 1, "stage": "sentence", "text": "Ho stampato il contratto per il cliente.", "translation": "I printed the contract for the client.", "distractors": ["I signed the contract for the client.", "I printed the contract for the boss."] },
        { "id": "it-a2-ufficio-4-u12", "rev": 1, "stage": "word", "text": "straordinario", "translation": "overtime", "distractors": ["day off", "break"] },
        { "id": "it-a2-ufficio-4-u13", "rev": 1, "stage": "sentence", "text": "Ho fatto due ore di straordinario.", "translation": "I did two hours of overtime.", "distractors": ["I did ten hours of overtime.", "I took a two-hour break."], "variants": ["Ho fatto 2 ore di straordinario."] },
        { "id": "it-a2-ufficio-4-u14", "rev": 1, "stage": "sentence", "text": "Siamo rimasti in ufficio fino alle nove.", "translation": "We stayed at the office until nine.", "distractors": ["We stayed at the office until seven.", "We got to the office at nine."], "variants": ["Siamo rimasti in ufficio fino alle 9."] },
        { "id": "it-a2-ufficio-4-u15", "rev": 1, "stage": "sentence", "text": "Finalmente abbiamo finito il progetto!", "translation": "We've finally finished the project!", "distractors": ["We've finally started the project!", "We haven't finished the project yet!"] }
      ]
    },
    {
      "id": "it-a2-ufficio-5",
      "title": "Il colloquio",
      "grammarFocus": ["passato prossimo: ho mandato, hanno assunto", "anni di esperienza", "fare una domanda"],
      "units": [
        { "id": "it-a2-ufficio-5-u01", "rev": 1, "stage": "word", "text": "colloquio", "translation": "interview", "distractors": ["meeting", "exam"] },
        { "id": "it-a2-ufficio-5-u02", "rev": 1, "stage": "phrase", "text": "un colloquio di lavoro", "translation": "a job interview", "distractors": ["a job offer", "a work meeting"] },
        { "id": "it-a2-ufficio-5-u03", "rev": 1, "stage": "sentence", "text": "Domani ho un colloquio di lavoro.", "translation": "Tomorrow I have a job interview.", "distractors": ["Today I have a job interview.", "Tomorrow I have a work meeting."], "commas": [0] },
        { "id": "it-a2-ufficio-5-u04", "rev": 1, "stage": "word", "text": "curriculum", "translation": "CV", "distractors": ["cover letter", "passport"] },
        { "id": "it-a2-ufficio-5-u05", "rev": 1, "stage": "sentence", "text": "Ho mandato il curriculum a tre aziende.", "translation": "I sent my CV to three companies.", "distractors": ["I sent my CV to two companies.", "I got CVs from three companies."], "variants": ["Ho mandato il curriculum a 3 aziende."] },
        { "id": "it-a2-ufficio-5-u06", "rev": 1, "stage": "word", "text": "esperienza", "translation": "experience", "distractors": ["degree", "salary"] },
        { "id": "it-a2-ufficio-5-u07", "rev": 1, "stage": "phrase", "text": "molta esperienza", "translation": "a lot of experience", "distractors": ["little experience", "a lot of work"] },
        { "id": "it-a2-ufficio-5-u08", "rev": 1, "stage": "sentence", "text": "Ho cinque anni di esperienza in un'azienda tedesca.", "translation": "I have five years of experience at a German company.", "distractors": ["I have five years of experience at a French company.", "I have two years of experience at a German company."], "variants": ["Ho 5 anni di esperienza in un'azienda tedesca."] },
        { "id": "it-a2-ufficio-5-u09", "rev": 1, "stage": "word", "text": "candidato", "translation": "candidate", "distractors": ["client", "boss"] },
        { "id": "it-a2-ufficio-5-u10", "rev": 1, "stage": "phrase", "text": "l'ultimo candidato", "translation": "the last candidate", "distractors": ["the first candidate", "the last client"] },
        { "id": "it-a2-ufficio-5-u11", "rev": 1, "stage": "sentence", "text": "L'ultimo candidato è arrivato in ritardo.", "translation": "The last candidate arrived late.", "distractors": ["The first candidate arrived late.", "The last candidate arrived early."] },
        { "id": "it-a2-ufficio-5-u12", "rev": 1, "stage": "word", "text": "assumere", "translation": "to hire", "distractors": ["to fire", "to pay"] },
        { "id": "it-a2-ufficio-5-u13", "rev": 1, "stage": "sentence", "text": "L'azienda ha assunto due nuovi ingegneri.", "translation": "The company has hired two new engineers.", "distractors": ["The company has fired two engineers.", "The company has hired two new doctors."], "variants": ["L'azienda ha assunto 2 nuovi ingegneri."] },
        { "id": "it-a2-ufficio-5-u14", "rev": 1, "stage": "chunk", "text": "fare una domanda", "translation": "to ask a question", "distractors": ["to answer a question", "to ask for a favor"] },
        { "id": "it-a2-ufficio-5-u15", "rev": 1, "stage": "sentence", "text": "Posso fare una domanda sullo stipendio?", "translation": "Can I ask a question about the salary?", "distractors": ["Can I answer a question about the salary?", "Can I ask a question about the contract?"] }
      ]
    },
    {
      "id": "it-a2-ufficio-6",
      "title": "In pausa",
      "grammarFocus": ["fare una pausa", "ci vediamo", "andare in ferie"],
      "units": [
        { "id": "it-a2-ufficio-6-u01", "rev": 1, "stage": "word", "text": "pausa", "translation": "break", "distractors": ["meeting", "shift"] },
        { "id": "it-a2-ufficio-6-u02", "rev": 1, "stage": "chunk", "text": "fare una pausa", "translation": "to take a break", "distractors": ["to have a meeting", "to take a day off"] },
        { "id": "it-a2-ufficio-6-u03", "rev": 1, "stage": "sentence", "text": "Facciamo una pausa di dieci minuti?", "translation": "Shall we take a ten-minute break?", "distractors": ["Shall we take a two-minute break?", "Shall we have a ten-minute meeting?"], "variants": ["Facciamo una pausa di 10 minuti?"] },
        { "id": "it-a2-ufficio-6-u04", "rev": 1, "stage": "word", "text": "macchinetta", "translation": "machine", "distractors": ["printer", "desk"] },
        { "id": "it-a2-ufficio-6-u05", "rev": 1, "stage": "phrase", "text": "alla macchinetta del caffè", "translation": "at the coffee machine", "distractors": ["at the printer", "at the coffee bar"] },
        { "id": "it-a2-ufficio-6-u06", "rev": 1, "stage": "sentence", "text": "Ci vediamo alla macchinetta del caffè.", "translation": "See you at the coffee machine.", "distractors": ["See you at the printer.", "Let's talk at the coffee machine."] },
        { "id": "it-a2-ufficio-6-u07", "rev": 1, "stage": "word", "text": "turno", "translation": "shift", "distractors": ["break", "overtime"] },
        { "id": "it-a2-ufficio-6-u08", "rev": 1, "stage": "phrase", "text": "il turno di notte", "translation": "the night shift", "distractors": ["the day shift", "the night train"] },
        { "id": "it-a2-ufficio-6-u09", "rev": 1, "stage": "sentence", "text": "Questa settimana Anna fa il turno di notte.", "translation": "This week Anna is on the night shift.", "distractors": ["Next week Anna is on the night shift.", "This week Anna is on the day shift."], "commas": [2] },
        { "id": "it-a2-ufficio-6-u10", "rev": 1, "stage": "word", "text": "ferie", "translation": "time off", "distractors": ["overtime", "shifts"] },
        { "id": "it-a2-ufficio-6-u11", "rev": 1, "stage": "chunk", "text": "andare in ferie", "translation": "to go on holiday", "distractors": ["to come back from holiday", "to go to a meeting"] },
        { "id": "it-a2-ufficio-6-u12", "rev": 1, "stage": "sentence", "text": "Ad agosto vado in ferie per tre settimane.", "translation": "In August I'm going on holiday for three weeks.", "distractors": ["In July I'm going on holiday for three weeks.", "In August I'm going on holiday for two weeks."], "variants": ["Ad agosto vado in ferie per 3 settimane."], "commas": [1] },
        { "id": "it-a2-ufficio-6-u13", "rev": 1, "stage": "word", "text": "licenziare", "translation": "to fire", "distractors": ["to hire", "to pay"] },
        { "id": "it-a2-ufficio-6-u14", "rev": 1, "stage": "sentence", "text": "Hai sentito? Hanno licenziato un collega di Luca.", "translation": "Did you hear? They fired a colleague of Luca's.", "distractors": ["Did you hear? They hired a colleague of Luca's.", "Did you hear? They fired Luca's boss."] },
        { "id": "it-a2-ufficio-6-u15", "rev": 1, "stage": "chunk", "text": "torno alla mia scrivania", "translation": "I'm going back to my desk", "distractors": ["I'm leaving my desk", "I'm going back to my office"] },
        { "id": "it-a2-ufficio-6-u16", "rev": 1, "stage": "sentence", "text": "Bene, adesso torno al lavoro.", "translation": "Right, now I'm going back to work.", "distractors": ["Right, now I'm leaving work.", "Right, now I'm going back home."], "commas": [1] }
      ]
    }
  ]
}
