        { "id": "it-a2-bambino-1-u02", "rev": 1, "stage": "phrase", "text": "da bambino", "translation": "as a child", "distractors": ["as a teacher", "with a child"] },
        { "id": "it-a2-bambino-1-u03", "rev": 1, "stage": "chunk", "text": "quando ero piccolo", "translation": "when I was little", "distractors": ["when I was old", "when you were little"] },
        { "id": "it-a2-bambino-1-u04", "rev": 1, "stage": "word", "text": "timido", "translation": "shy", "distractors": ["lively", "tired"] },
        { "id": "it-a2-bambino-1-u05", "rev": 1, "stage": "sentence", "text": "Quando ero piccolo, ero molto timido.", "translation": "When I was little, I was very shy.", "distractors": ["When I was little, I was very lively.", "When I was little, I was very tall."] },
        { "id": "it-a2-bambino-1-u06", "rev": 1, "stage": "phrase", "text": "una bambina vivace", "translation": "a lively little girl", "distractors": ["a shy little girl", "a lively old woman"] },
        { "id": "it-a2-bambino-1-u07", "rev": 1, "stage": "sentence", "text": "Mia sorella era una bambina molto vivace.", "translation": "My sister was a very lively little girl.", "distractors": ["My sister was a very shy little girl.", "My mother was a very lively little girl."] },
        { "id": "it-a2-bambino-1-u08", "rev": 1, "stage": "sentence", "text": "Com'eri da bambino?", "translation": "What were you like as a child?", "distractors": ["Where were you as a child?", "What was he like as a child?"] },
        { "id": "it-a2-bambino-1-u09", "rev": 1, "stage": "word", "text": "infanzia", "translation": "childhood", "distractors": ["old age", "holiday"] },
        { "id": "it-a2-bambino-1-u10", "rev": 1, "stage": "phrase", "text": "la mia infanzia", "translation": "my childhood", "distractors": ["your childhood", "my family"] },
        { "id": "it-a2-bambino-1-u11", "rev": 1, "stage": "sentence", "text": "La mia infanzia è stata felice.", "translation": "My childhood was happy.", "distractors": ["My childhood was sad.", "My family was happy."] },
        { "id": "it-a2-bambino-1-u12", "rev": 1, "stage": "word", "text": "avevo", "translation": "I had", "distractors": ["I have", "I was"] },
        { "id": "it-a2-bambino-1-u13", "rev": 1, "stage": "chunk", "text": "avevo otto anni", "translation": "I was eight", "distractors": ["I was nine", "I'm eight"], "variants": ["avevo 8 anni"] },
        { "id": "it-a2-bambino-1-u14", "rev": 1, "stage": "sentence", "text": "Quando avevo otto anni, abitavamo a Roma.", "translation": "When I was eight, we lived in Rome.", "distractors": ["When I was eight, we worked in Rome.", "When I was ten, we lived in Rome."], "variants": ["Quando avevo 8 anni, abitavamo a Roma."] },
        { "id": "it-a2-bambino-1-u15", "rev": 1, "stage": "phrase", "text": "tanti amici", "translation": "lots of friends", "distractors": ["few friends", "lots of cousins"] },
        { "id": "it-a2-bambino-1-u16", "rev": 1, "stage": "sentence", "text": "Da bambina ero timida, ma avevo tanti amici.", "translation": "As a child I was shy, but I had lots of friends.", "distractors": ["As a child I was shy, but I had lots of cousins.", "As a child I was lively, but I had few friends."], "commas": [1] }
      ]
    },
