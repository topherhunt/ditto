        { "id": "it-a2-bambino-2-u07", "rev": 1, "stage": "sentence", "text": "In giardino c'era un albero molto grande.", "translation": "In the garden there was a very big tree.", "distractors": ["In the park there was a very big tree.", "In the garden there was a very small tree."], "commas": [1] },
        { "id": "it-a2-bambino-2-u08", "rev": 1, "stage": "word", "text": "pallone", "translation": "ball", "distractors": ["doll", "bike"] },
        { "id": "it-a2-bambino-2-u09", "rev": 1, "stage": "chunk", "text": "giocare a pallone", "translation": "to play ball", "distractors": ["to play tennis", "to buy a ball"] },
        { "id": "it-a2-bambino-2-u10", "rev": 1, "stage": "sentence", "text": "Con i miei cugini giocavamo sempre a pallone.", "translation": "We always played ball with my cousins.", "distractors": ["We never played ball with my cousins.", "We always played ball with my brothers."], "commas": [3] },
        { "id": "it-a2-bambino-2-u11", "rev": 1, "stage": "phrase", "text": "le bambole", "translation": "the dolls", "distractors": ["the balls", "the toys"] },
        { "id": "it-a2-bambino-2-u12", "rev": 1, "stage": "sentence", "text": "Mia sorella giocava con le bambole.", "translation": "My sister played with dolls.", "distractors": ["My brother played with dolls.", "My sister played with the dog."] },
        { "id": "it-a2-bambino-2-u13", "rev": 1, "stage": "word", "text": "giocattolo", "translation": "toy", "distractors": ["game", "doll"] },
        { "id": "it-a2-bambino-2-u14", "rev": 1, "stage": "sentence", "text": "Non avevamo molti giocattoli, ma eravamo felici.", "translation": "We didn't have many toys, but we were happy.", "distractors": ["We had lots of toys, and we were happy.", "We didn't have many friends, but we were happy."] },
        { "id": "it-a2-bambino-2-u15", "rev": 1, "stage": "phrase", "text": "il tuo gioco preferito", "translation": "your favorite game", "distractors": ["my favorite game", "your favorite toy"] },
        { "id": "it-a2-bambino-2-u16", "rev": 1, "stage": "sentence", "text": "Qual era il tuo gioco preferito?", "translation": "What was your favorite game?", "distractors": ["What was your favorite toy?", "Where was your favorite game?"] }
      ]
    },
    {
      "id": "it-a2-bambino-3",
      "title": "Ogni estate",
      "grammarFocus": ["imperfetto for habits", "di solito, ogni estate"],
      "units": [
        { "id": "it-a2-bambino-3-u01", "rev": 1, "stage": "phrase", "text": "ogni estate", "translation": "every summer", "distractors": ["every winter", "last summer"] },
        { "id": "it-a2-bambino-3-u02", "rev": 1, "stage": "word", "text": "campagna", "translation": "countryside", "distractors": ["mountains", "seaside"] },
        { "id": "it-a2-bambino-3-u03", "rev": 1, "stage": "phrase", "text": "in campagna", "translation": "in the countryside", "distractors": ["in the city", "in the mountains"] },
        { "id": "it-a2-bambino-3-u04", "rev": 1, "stage": "sentence", "text": "Ogni estate andavamo in campagna dai nonni.", "translation": "Every summer we went to our grandparents' in the countryside.", "distractors": ["Every winter we went to our grandparents' in the countryside.", "Every summer we went to our cousins' in the countryside."], "commas": [1] },
        { "id": "it-a2-bambino-3-u05", "rev": 1, "stage": "chunk", "text": "di solito", "translation": "usually", "distractors": ["never", "always"] },
        { "id": "it-a2-bambino-3-u06", "rev": 1, "stage": "sentence", "text": "Di solito partivamo a luglio.", "translation": "We usually left in July.", "distractors": ["We usually left in June.", "We never left in July."], "commas": [1] },
        { "id": "it-a2-bambino-3-u07", "rev": 1, "stage": "word", "text": "animale", "translation": "animal", "distractors": ["plant", "toy"] },
        { "id": "it-a2-bambino-3-u08", "rev": 1, "stage": "sentence", "text": "I nonni avevano tanti animali.", "translation": "My grandparents had lots of animals.", "distractors": ["My grandparents had lots of trees.", "My grandparents had no animals."] },
        { "id": "it-a2-bambino-3-u09", "rev": 1, "stage": "phrase", "text": "un cane e due gatti", "translation": "a dog and two cats", "distractors": ["a dog and three cats", "a cat and two dogs"], "variants": ["un cane e 2 gatti"] },
        { "id": "it-a2-bambino-3-u10", "rev": 1, "stage": "sentence", "text": "Mio nonno aveva un cane e due gatti.", "translation": "My grandfather had a dog and two cats.", "distractors": ["My grandfather had a dog and three cats.", "My uncle had a dog and two cats."], "variants": ["Mio nonno aveva un cane e 2 gatti."] },
        { "id": "it-a2-bambino-3-u11", "rev": 1, "stage": "word", "text": "facevamo", "translation": "we used to do", "distractors": ["we do", "we used to have"] },
        { "id": "it-a2-bambino-3-u12", "rev": 1, "stage": "chunk", "text": "facevamo lunghe passeggiate", "translation": "we used to take long walks", "distractors": ["we used to take short walks", "we used to take long trips"] },
        { "id": "it-a2-bambino-3-u13", "rev": 1, "stage": "sentence", "text": "La sera facevamo lunghe passeggiate.", "translation": "In the evening we took long walks.", "distractors": ["In the morning we took long walks.", "In the evening we took short walks."], "commas": [1] },
        { "id": "it-a2-bambino-3-u14", "rev": 1, "stage": "phrase", "text": "nel lago", "translation": "in the lake", "distractors": ["in the sea", "in the pool"] },
        { "id": "it-a2-bambino-3-u15", "rev": 1, "stage": "sentence", "text": "Quando faceva caldo, nuotavamo nel lago.", "translation": "When it was hot, we swam in the lake.", "distractors": ["When it was cold, we swam in the lake.", "When it was hot, we swam in the sea."] },
        { "id": "it-a2-bambino-3-u16", "rev": 1, "stage": "sentence", "text": "Mi piaceva tanto andare in campagna.", "translation": "I really liked going to the countryside.", "distractors": ["I really liked going to the seaside.", "I didn't like going to the countryside."] }
      ]
    },
    {
      "id": "it-a2-bambino-4",
