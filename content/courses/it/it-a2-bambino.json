      "grammarFocus": ["imperfetto of -ere verbs", "reflexives in the imperfetto"],
      "units": [
        { "id": "it-a2-bambino-4-u01", "rev": 1, "stage": "word", "text": "maestra", "translation": "teacher (primary school)", "distractors": ["nurse", "classmate"] },
        { "id": "it-a2-bambino-4-u02", "rev": 1, "stage": "phrase", "text": "la mia maestra", "translation": "my teacher", "distractors": ["my classmate", "my aunt"] },
        { "id": "it-a2-bambino-4-u03", "rev": 1, "stage": "sentence", "text": "La mia maestra si chiamava Anna.", "translation": "My teacher was called Anna.", "distractors": ["My classmate was called Anna.", "My aunt was called Anna."] },
        { "id": "it-a2-bambino-4-u04", "rev": 1, "stage": "sentence", "text": "Era giovane e molto gentile.", "translation": "She was young and very kind.", "distractors": ["She was old and very kind.", "She was young and very strict."] },
        { "id": "it-a2-bambino-4-u05", "rev": 1, "stage": "word", "text": "compagno", "translation": "classmate", "distractors": ["teacher", "cousin"] },
        { "id": "it-a2-bambino-4-u06", "rev": 1, "stage": "phrase", "text": "i compagni di scuola", "translation": "classmates", "distractors": ["school teachers", "schoolbooks"] },
        { "id": "it-a2-bambino-4-u07", "rev": 1, "stage": "sentence", "text": "Andavo a scuola a piedi con i miei compagni.", "translation": "I walked to school with my classmates.", "distractors": ["I took the bus to school with my classmates.", "I walked to school with my brothers."], "commas": [4] },
        { "id": "it-a2-bambino-4-u08", "rev": 1, "stage": "word", "text": "disegnare", "translation": "to draw", "distractors": ["to write", "to sing"] },
        { "id": "it-a2-bambino-4-u09", "rev": 1, "stage": "sentence", "text": "Mi piaceva molto disegnare.", "translation": "I really liked drawing.", "distractors": ["I didn't like drawing.", "I really liked singing."] },
        { "id": "it-a2-bambino-4-u10", "rev": 1, "stage": "chunk", "text": "ero brava in italiano", "translation": "I was good at Italian", "distractors": ["I was bad at Italian", "I was good at English"] },
        { "id": "it-a2-bambino-4-u11", "rev": 1, "stage": "sentence", "text": "Non ero bravo in inglese, ma leggevo tanto.", "translation": "I wasn't good at English, but I read a lot.", "distractors": ["I wasn't good at English, but I wrote a lot.", "I was good at English, and I read a lot."] },
        { "id": "it-a2-bambino-4-u12", "rev": 1, "stage": "phrase", "text": "alle otto", "translation": "at eight", "distractors": ["at nine", "at seven"], "variants": ["alle 8"] },
        { "id": "it-a2-bambino-4-u13", "rev": 1, "stage": "sentence", "text": "Le lezioni cominciavano alle otto.", "translation": "Lessons started at eight.", "distractors": ["Lessons ended at eight.", "Lessons started at nine."], "variants": ["Le lezioni cominciavano alle 8."] },
        { "id": "it-a2-bambino-4-u14", "rev": 1, "stage": "phrase", "text": "i compiti", "translation": "homework", "distractors": ["the lessons", "the exams"] },
        { "id": "it-a2-bambino-4-u15", "rev": 1, "stage": "sentence", "text": "Il pomeriggio facevo i compiti con mia madre.", "translation": "In the afternoon I did my homework with my mother.", "distractors": ["In the morning I did my homework with my mother.", "In the afternoon I did my homework with my father."], "commas": [1] }
      ]
    },
    {
      "id": "it-a2-bambino-5",
      "title": "Avevo paura",
      "grammarFocus": ["avere paura di", "sognare di + infinitive", "credere a"],
      "units": [
        { "id": "it-a2-bambino-5-u01", "rev": 1, "stage": "word", "text": "paura", "translation": "fear", "distractors": ["hunger", "thirst"] },
        { "id": "it-a2-bambino-5-u02", "rev": 1, "stage": "chunk", "text": "avevo paura", "translation": "I was afraid", "distractors": ["I was hungry", "I am afraid"] },
        { "id": "it-a2-bambino-5-u03", "rev": 1, "stage": "phrase", "text": "dei cani", "translation": "of dogs", "distractors": ["of cats", "of the dark"] },
        { "id": "it-a2-bambino-5-u04", "rev": 1, "stage": "sentence", "text": "Da piccola avevo paura dei cani.", "translation": "As a little girl I was afraid of dogs.", "distractors": ["As a little girl I was afraid of cats.", "As a little girl I was afraid of the sea."], "commas": [1] },
        { "id": "it-a2-bambino-5-u05", "rev": 1, "stage": "sentence", "text": "Di cosa avevi paura?", "translation": "What were you afraid of?", "distractors": ["Who were you afraid of?", "What are you afraid of?"] },
        { "id": "it-a2-bambino-5-u06", "rev": 1, "stage": "word", "text": "piangere", "translation": "to cry", "distractors": ["to laugh", "to sleep"] },
        { "id": "it-a2-bambino-5-u07", "rev": 1, "stage": "phrase", "text": "piangeva sempre", "translation": "he always cried", "distractors": ["he never cried", "he always laughed"] },
        { "id": "it-a2-bambino-5-u08", "rev": 1, "stage": "sentence", "text": "Mio fratello piccolo piangeva sempre di notte.", "translation": "My little brother always cried at night.", "distractors": ["My little brother always laughed at night.", "My big brother always cried at night."] },
        { "id": "it-a2-bambino-5-u09", "rev": 1, "stage": "word", "text": "ridere", "translation": "to laugh", "distractors": ["to cry", "to run"] },
        { "id": "it-a2-bambino-5-u10", "rev": 1, "stage": "sentence", "text": "Ridevamo tanto insieme.", "translation": "We laughed a lot together.", "distractors": ["We cried a lot together.", "We laughed a lot alone."] },
        { "id": "it-a2-bambino-5-u11", "rev": 1, "stage": "word", "text": "credere", "translation": "to believe", "distractors": ["to know", "to see"] },
        { "id": "it-a2-bambino-5-u12", "rev": 1, "stage": "chunk", "text": "credevo a tutto", "translation": "I believed everything", "distractors": ["I believed nothing", "I understood everything"] },
        { "id": "it-a2-bambino-5-u13", "rev": 1, "stage": "sentence", "text": "Da bambino credevo a tutto.", "translation": "As a child I believed everything.", "distractors": ["As a child I believed nothing.", "As a child I understood everything."], "commas": [1] },
        { "id": "it-a2-bambino-5-u14", "rev": 1, "stage": "word", "text": "sognare", "translation": "to dream", "distractors": ["to sleep", "to draw"] },
        { "id": "it-a2-bambino-5-u15", "rev": 1, "stage": "chunk", "text": "sognavo di diventare", "translation": "I dreamed of becoming", "distractors": ["I was afraid of becoming", "I decided to become"] },
        { "id": "it-a2-bambino-5-u16", "rev": 1, "stage": "sentence", "text": "Sognavo di diventare medico.", "translation": "I dreamed of becoming a doctor.", "distractors": ["I dreamed of becoming a teacher.", "I decided to become a doctor."] }
      ]
