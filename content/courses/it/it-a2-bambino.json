    {
      "id": "it-a2-bambino-6",
      "title": "Mi ricordo",
      "grammarFocus": ["ricordarsi di", "ricordare", "raccontare"],
      "units": [
        { "id": "it-a2-bambino-6-u01", "rev": 1, "stage": "chunk", "text": "mi ricordo", "translation": "I remember", "distractors": ["I forget", "you remember"], "senses": { "1": "rsi" } },
        { "id": "it-a2-bambino-6-u02", "rev": 1, "stage": "sentence", "text": "Mi ricordo bene di mia nonna.", "translation": "I remember my grandmother well.", "distractors": ["I don't remember my grandmother well.", "I remember my grandfather well."], "senses": { "1": "rsi" } },
        { "id": "it-a2-bambino-6-u03", "rev": 1, "stage": "chunk", "text": "ti ricordi", "translation": "you remember", "distractors": ["you forget", "I remember"] },
        { "id": "it-a2-bambino-6-u04", "rev": 1, "stage": "sentence", "text": "Ti ricordi di Marco, il mio compagno di scuola?", "translation": "Do you remember Marco, my classmate?", "distractors": ["Do you remember Marco, my teacher?", "Did you meet Marco, my classmate?"] },
        { "id": "it-a2-bambino-6-u05", "rev": 1, "stage": "word", "text": "ricordare", "translation": "to remember", "distractors": ["to forget", "to repeat"] },
        { "id": "it-a2-bambino-6-u06", "rev": 1, "stage": "sentence", "text": "Non ricordo il nome della mia maestra.", "translation": "I don't remember my teacher's name.", "distractors": ["I don't remember my classmate's name.", "I remember my teacher's name."] },
        { "id": "it-a2-bambino-6-u07", "rev": 1, "stage": "word", "text": "raccontare", "translation": "to tell", "distractors": ["to read", "to write"] },
        { "id": "it-a2-bambino-6-u08", "rev": 1, "stage": "word", "text": "fiaba", "translation": "fairy tale", "distractors": ["song", "film"] },
        { "id": "it-a2-bambino-6-u09", "rev": 1, "stage": "chunk", "text": "mi raccontava una fiaba", "translation": "she told me a fairy tale", "distractors": ["she read me a fairy tale", "I told her a fairy tale"] },
        { "id": "it-a2-bambino-6-u10", "rev": 1, "stage": "sentence", "text": "Ogni sera mia nonna mi raccontava una fiaba.", "translation": "Every evening my grandmother told me a fairy tale.", "distractors": ["Every morning my grandmother told me a fairy tale.", "Every evening my mother told me a fairy tale."], "commas": [1] },
        { "id": "it-a2-bambino-6-u11", "rev": 1, "stage": "phrase", "text": "il mio sogno", "translation": "my dream", "distractors": ["your dream", "my fear"] },
        { "id": "it-a2-bambino-6-u12", "rev": 1, "stage": "sentence", "text": "Il mio sogno era fare il cuoco.", "translation": "My dream was to be a cook.", "distractors": ["My dream was to be a doctor.", "Your dream was to be a cook."] },
        { "id": "it-a2-bambino-6-u13", "rev": 1, "stage": "phrase", "text": "tanta gente", "translation": "lots of people", "distractors": ["few people", "lots of friends"] },
        { "id": "it-a2-bambino-6-u14", "rev": 1, "stage": "sentence", "text": "Mi ricordo che a Natale c'era sempre tanta gente.", "translation": "I remember that at Christmas there were always lots of people.", "distractors": ["I remember that at Easter there were always lots of people.", "I remember that at Christmas there were never many people."], "senses": { "1": "rsi" } },
        { "id": "it-a2-bambino-6-u15", "rev": 1, "stage": "sentence", "text": "Che bei tempi!", "translation": "What good times!", "distractors": ["What hard times!", "What good friends!"], "senses": { "0": "det" } }
      ]
    }
  ]
