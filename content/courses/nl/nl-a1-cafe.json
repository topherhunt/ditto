{
  "id": "nl-a1-cafe",
  "language": "nl",
  "level": "A1",
  "order": 1,
  "title": "In het café",
  "description": { "en": "Ordering and paying at a Dutch café" },
  "track": "main",
  "requires": [],
  "introduces": ["koffie", "een", "alstublieft", "ik", "willen", "graag", "thee", "met", "melk", "voor", "mij", "één", "broodje", "kaas", "de", "rekening", "mogen", "betalen", "kaart", "hoeveel", "kosten", "het", "drie", "euro", "dank", "u", "wel"],
  "lexicon": {
    "koffie": { "lemma": "koffie", "pos": "NOUN", "gloss": {"en": "coffee (de koffie)"} },
    "een": { "lemma": "een", "pos": "DET", "gloss": {"en": "a, an (unstressed)"} },
    "alstublieft": { "lemma": "alstublieft", "pos": "INTJ", "gloss": {"en": "please; also here you are (formal)"} },
    "ik": { "lemma": "ik", "pos": "PRON", "gloss": {"en": "I"} },
    "wil": { "lemma": "willen", "pos": "VERB", "gloss": {"en": "want (ik wil)"} },
    "graag": { "lemma": "graag", "pos": "ADV", "gloss": {"en": "gladly; ik wil graag = I would like"} },
    "thee": { "lemma": "thee", "pos": "NOUN", "gloss": {"en": "tea (de thee)"} },
    "met": { "lemma": "met", "pos": "ADP", "gloss": {"en": "with"} },
    "melk": { "lemma": "melk", "pos": "NOUN", "gloss": {"en": "milk (de melk)"} },
    "voor": { "lemma": "voor", "pos": "ADP", "gloss": {"en": "for"} },
    "mij": { "lemma": "mij", "pos": "PRON", "gloss": {"en": "me (stressed)"} },
    "één": { "lemma": "één", "pos": "NUM", "gloss": {"en": "one; the accents mark the numeral, unlike een = a"} },
    "broodje": { "lemma": "broodje", "pos": "NOUN", "gloss": {"en": "bread roll, sandwich (het broodje)"} },
    "kaas": { "lemma": "kaas", "pos": "NOUN", "gloss": {"en": "cheese; broodje kaas = cheese roll"} },
    "de": { "lemma": "de", "pos": "DET", "gloss": {"en": "the (common gender)"} },
    "rekening": { "lemma": "rekening", "pos": "NOUN", "gloss": {"en": "bill, check"} },
    "mag": { "lemma": "mogen", "pos": "AUX", "gloss": {"en": "may (mag ik = may I)"} },
    "betalen": { "lemma": "betalen", "pos": "VERB", "gloss": {"en": "to pay"} },
    "kaart": { "lemma": "kaart", "pos": "NOUN", "gloss": {"en": "card"} },
    "hoeveel": { "lemma": "hoeveel", "pos": "ADV", "gloss": {"en": "how much, how many"} },
    "kost": { "lemma": "kosten", "pos": "VERB", "gloss": {"en": "costs (het kost)"} },
    "het": { "lemma": "het", "pos": "PRON", "gloss": {"en": "it"} },
    "drie": { "lemma": "drie", "pos": "NUM", "gloss": {"en": "three"} },
    "euro": { "lemma": "euro", "pos": "NOUN", "gloss": {"en": "euro; stays singular after a number"} },
    "dank": { "lemma": "dank", "pos": "NOUN", "gloss": {"en": "thanks"} },
    "u": { "lemma": "u", "pos": "PRON", "gloss": {"en": "you (formal)"} },
    "wel": { "lemma": "wel", "pos": "ADV", "gloss": {"en": "indeed; dank u wel = thank you very much"} }
  },
  "lessons": [
    {
      "id": "nl-a1-cafe-1",
      "title": "Een koffie, alstublieft",
      "grammarFocus": { "en": ["een vs. één", "ik wil graag + noun"] },
      "units": [
        { "id": "nl-a1-cafe-1-u01", "rev": 1, "stage": "word", "text": "koffie",
          "translation": { "en": "coffee" },
          "distractors": { "en": ["tea", "milk"] } },
        { "id": "nl-a1-cafe-1-u02", "rev": 1, "stage": "phrase", "text": "een koffie",
          "translation": { "en": "a coffee" },
          "distractors": { "en": ["one coffee", "the coffee"] } },
        { "id": "nl-a1-cafe-1-u03", "rev": 1, "stage": "word", "text": "alstublieft",
          "translation": { "en": "please" },
          "distractors": { "en": ["thank you", "excuse me"] } },
        { "id": "nl-a1-cafe-1-u04", "rev": 1, "stage": "sentence", "text": "Een koffie, alstublieft.",
          "translation": { "en": "A coffee, please." },
          "distractors": { "en": ["One coffee, thanks.", "A tea, please."] } },
        { "id": "nl-a1-cafe-1-u05", "rev": 1, "stage": "chunk", "text": "ik wil graag",
          "translation": { "en": "I would like" },
          "distractors": { "en": ["I will pay", "I have to"] } },
        { "id": "nl-a1-cafe-1-u06", "rev": 1, "stage": "sentence", "text": "Ik wil graag een thee met melk.",
          "translation": { "en": "I'd like a tea with milk." },
          "distractors": { "en": ["I'd like a coffee with milk.", "I'd like a tea without milk."] } },
        { "id": "nl-a1-cafe-1-u07", "rev": 1, "stage": "phrase", "text": "één broodje",
          "translation": { "en": "one bread roll" },
          "distractors": { "en": ["a bread roll", "one cheese"] } },
        { "id": "nl-a1-cafe-1-u08", "rev": 1, "stage": "sentence", "text": "Voor mij één broodje kaas.",
          "translation": { "en": "For me, one cheese roll." },
          "distractors": { "en": ["For me, a cheese sandwich and a tea.", "For you, one cheese roll."] } }
      ]
    },
    {
      "id": "nl-a1-cafe-2",
      "title": "Mag ik betalen?",
      "grammarFocus": { "en": ["mag ik + infinitive at the end", "inversion in questions"] },
      "units": [
        { "id": "nl-a1-cafe-2-u01", "rev": 1, "stage": "phrase", "text": "de rekening",
          "translation": { "en": "the bill" },
          "distractors": { "en": ["the card", "the menu"] } },
        { "id": "nl-a1-cafe-2-u02", "rev": 1, "stage": "sentence", "text": "Mag ik de rekening?",
          "translation": { "en": "Can I have the bill?" },
          "distractors": { "en": ["Can I pay by card?", "Where is the bill?"] } },
        { "id": "nl-a1-cafe-2-u03", "rev": 1, "stage": "chunk", "text": "mag ik betalen",
          "translation": { "en": "may I pay" },
          "distractors": { "en": ["I want to pay", "may you pay"] } },
        { "id": "nl-a1-cafe-2-u04", "rev": 1, "stage": "sentence", "text": "Mag ik met de kaart betalen?",
          "translation": { "en": "Can I pay by card?" },
          "distractors": { "en": ["Can I pay in cash?", "Can you pay by card?"] } },
        { "id": "nl-a1-cafe-2-u05", "rev": 1, "stage": "sentence", "text": "Hoeveel kost het?",
          "translation": { "en": "How much is it?" },
          "distractors": { "en": ["How many are there?", "What is it?"] } },
        { "id": "nl-a1-cafe-2-u06", "rev": 1, "stage": "sentence", "text": "Het kost drie euro.", "variants": ["Het kost 3 euro."],
          "translation": { "en": "It costs three euros." },
          "distractors": { "en": ["It costs two euros.", "It costs three dollars."] } },
        { "id": "nl-a1-cafe-2-u07", "rev": 1, "stage": "sentence", "text": "Dank u wel!",
          "translation": { "en": "Thank you very much!" },
          "distractors": { "en": ["You're welcome!", "Goodbye!"] } }
      ]
    }
  ]
}
