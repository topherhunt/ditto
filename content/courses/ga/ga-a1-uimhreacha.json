{
  "id": "ga-a1-uimhreacha",
  "language": "ga",
  "level": "A1",
  "order": 3,
  "title": "Uimhreacha agus Am",
  "description": { "en": "Count to ten, count things, pay, give your age, tell the time, and name the days of the week" },
  "track": "main",
  "requires": ["ga-a1-caife"],
  "introduces": ["aon","dó","trí","ceathair","cúig","seacht","ocht","naoi","deich","amháin","euro","fad","cent","caoga","fiche","sóinseáil","aois","óg","bliain","tríocha","daichead","am","clog","leathuair","tar","éis","ceathrú","chun","meán","lá","feic","dé","Luan","Máirt","Céadaoin","Déardaoin","Aoine","Satharn","Domhnach","amárach","inné","seachtain"],
  "lexicon": {
    "a#num": { "lemma": "a", "pos": "PART", "gloss": { "en": "particle before a number said on its own: a haon, a dó; puts h before a vowel" } },
    "haon": { "lemma": "aon", "pos": "NUM", "gloss": { "en": "one (aon, with h after a: a haon)" } },
    "dó#two": { "lemma": "dó", "pos": "NUM", "gloss": { "en": "two (counting: a dó)" } },
    "trí": { "lemma": "trí", "pos": "NUM", "gloss": { "en": "three; lenites a noun: trí ghloine" } },
    "ceathair": { "lemma": "ceathair", "pos": "NUM", "gloss": { "en": "four (counting: a ceathair)" } },
    "cúig": { "lemma": "cúig", "pos": "NUM", "gloss": { "en": "five; lenites a noun: cúig phíosa" } },
    "sé#six": { "lemma": "sé", "pos": "NUM", "gloss": { "en": "six; lenites a noun: sé chathaoir" } },
    "seacht": { "lemma": "seacht", "pos": "NUM", "gloss": { "en": "seven; eclipses a noun: seacht gcupán" } },
    "hocht": { "lemma": "ocht", "pos": "NUM", "gloss": { "en": "eight (ocht, with h after a: a hocht)" } },
    "naoi": { "lemma": "naoi", "pos": "NUM", "gloss": { "en": "nine; eclipses a noun" } },
    "deich": { "lemma": "deich", "pos": "NUM", "gloss": { "en": "ten; eclipses a noun: deich gceapaire" } },
    "amháin": { "lemma": "amháin", "pos": "NUM", "gloss": { "en": "one (after the noun): cupán amháin; only: níl sé ach ..." } },
    "dhá": { "lemma": "dó", "pos": "NUM", "gloss": { "en": "two (before a noun; lenites it): dhá chupán" } },
    "chupán": { "lemma": "cupán", "pos": "NOUN", "gloss": { "en": "cup (cupán, lenited after dhá, trí ...)" } },
    "ceithre": { "lemma": "ceathair", "pos": "NUM", "gloss": { "en": "four (before a noun; lenites it): ceithre cheapaire" } },
    "cheapaire": { "lemma": "ceapaire", "pos": "NOUN", "gloss": { "en": "sandwich (ceapaire, lenited after a number)" } },
    "linn": { "lemma": "le", "pos": "ADP", "gloss": { "en": "with us (le + sinn); ba mhaith linn = we'd like" } },
    "phíosa": { "lemma": "píosa", "pos": "NOUN", "gloss": { "en": "piece (píosa, lenited after a number)" } },
    "leo": { "lemma": "le", "pos": "ADP", "gloss": { "en": "with them (le + iad); ba mhaith leo = they'd like" } },
    "gcupán": { "lemma": "cupán", "pos": "NOUN", "gloss": { "en": "cup (cupán, eclipsed after seacht, ocht ...)" } },
    "ocht": { "lemma": "ocht", "pos": "NUM", "gloss": { "en": "eight; eclipses a noun: ocht mbord" } },
    "mbord": { "lemma": "bord", "pos": "NOUN", "gloss": { "en": "table (bord, eclipsed after seacht, ocht ...)" } },
    "gceapaire": { "lemma": "ceapaire", "pos": "NOUN", "gloss": { "en": "sandwich (ceapaire, eclipsed after seacht to deich, or ar an)" } },
    "euro": { "lemma": "euro", "pos": "NOUN", "gloss": { "en": "euro (never changes: trí euro)" } },
    "gcáca": { "lemma": "cáca", "pos": "NOUN", "gloss": { "en": "cake (cáca, eclipsed after ar an)" } },
    "n-euro": { "lemma": "euro", "pos": "NOUN", "gloss": { "en": "euro (with n- after seacht to deich: deich n-euro)" } },
    "fad": { "lemma": "fad", "pos": "NOUN", "gloss": { "en": "length; ar fad = altogether, in total" } },
    "cent": { "lemma": "cent", "pos": "NOUN", "gloss": { "en": "cent (never changes: caoga cent)" } },
    "caoga": { "lemma": "caoga", "pos": "NUM", "gloss": { "en": "fifty" } },
    "mbainne": { "lemma": "bainne", "pos": "NOUN", "gloss": { "en": "milk (bainne, eclipsed after ar an)" } },
    "fiche": { "lemma": "fiche", "pos": "NUM", "gloss": { "en": "twenty" } },
    "shóinseáil": { "lemma": "sóinseáil", "pos": "NOUN", "gloss": { "en": "change, coins (sóinseáil, lenited after do or mo)" } },
    "cén": { "lemma": "cé", "pos": "PRON", "gloss": { "en": "which, what (cé + an): cén aois? cén t-am?" } },
    "aois": { "lemma": "aois", "pos": "NOUN", "gloss": { "en": "age (feminine); d'aois = of age, old" } },
    "thú": { "lemma": "tú", "pos": "PRON", "gloss": { "en": "you (tú, lenited after the copula and some verbs)" } },
    "óg": { "lemma": "óg", "pos": "ADJ", "gloss": { "en": "young" } },
    "an-óg": { "lemma": "óg", "pos": "ADJ", "gloss": { "en": "very young (an- lenites: an-óg)" } },
    "bliain": { "lemma": "bliain", "pos": "NOUN", "gloss": { "en": "year (feminine); after 1, 20, 30...: fiche bliain" } },
    "d'aois": { "lemma": "aois", "pos": "NOUN", "gloss": { "en": "of age (de + aois): fiche bliain d'aois = twenty years old" } },
    "bhliain": { "lemma": "bliain", "pos": "NOUN", "gloss": { "en": "year (bliain, lenited after dhá)" } },
    "bliana": { "lemma": "bliain", "pos": "NOUN", "gloss": { "en": "years (after trí to sé: trí bliana)" } },
    "mbliana": { "lemma": "bliain", "pos": "NOUN", "gloss": { "en": "years (bliana, eclipsed after seacht to deich)" } },
    "tríocha": { "lemma": "tríocha", "pos": "NUM", "gloss": { "en": "thirty" } },
    "daichead": { "lemma": "daichead", "pos": "NUM", "gloss": { "en": "forty" } },
    "t-am": { "lemma": "am", "pos": "NOUN", "gloss": { "en": "time (am, with t- after an: cén t-am é?)" } },
    "a#oc": { "lemma": "a", "pos": "PART", "gloss": { "en": "of (in a chlog = o'clock, lit. of the clock)" } },
    "chlog": { "lemma": "clog", "pos": "NOUN", "gloss": { "en": "clock (clog, lenited after a): a chlog = o'clock" } },
    "leathuair": { "lemma": "leathuair", "pos": "NOUN", "gloss": { "en": "half an hour; leathuair tar éis a dó = half past two" } },
    "tar": { "lemma": "tar", "pos": "VERB", "gloss": { "en": "come; tar éis = after, past" } },
    "éis": { "lemma": "éis", "pos": "NOUN", "gloss": { "en": "tar éis = after, past" } },
    "ceathrú": { "lemma": "ceathrú", "pos": "NOUN", "gloss": { "en": "quarter" } },
    "chun": { "lemma": "chun", "pos": "ADP", "gloss": { "en": "towards, to: ceathrú chun a deich = quarter to ten" } },
    "meán": { "lemma": "meán", "pos": "NOUN", "gloss": { "en": "middle; meán lae = noon, meán oíche = midnight" } },
    "lae": { "lemma": "lá", "pos": "NOUN", "gloss": { "en": "of day (lá in the genitive): meán lae = noon" } },
    "feicfidh": { "lemma": "feic", "pos": "VERB", "gloss": { "en": "will see (future of feic): feicfidh mé thú = see you" } },
    "dé": { "lemma": "dé", "pos": "NOUN", "gloss": { "en": "day (before a weekday: Dé Luain = on Monday)" } },
    "luain": { "lemma": "Luan", "pos": "NOUN", "gloss": { "en": "Monday (Luan in the genitive: Dé Luain)" } },
    "máirt": { "lemma": "Máirt", "pos": "NOUN", "gloss": { "en": "Tuesday (feminine): Dé Máirt" } },
    "céadaoin": { "lemma": "Céadaoin", "pos": "NOUN", "gloss": { "en": "Wednesday: Dé Céadaoin" } },
    "déardaoin": { "lemma": "Déardaoin", "pos": "NOUN", "gloss": { "en": "Thursday" } },
    "haoine": { "lemma": "Aoine", "pos": "NOUN", "gloss": { "en": "Friday (Aoine, with h after Dé: Dé hAoine)" } },
    "sathairn": { "lemma": "Satharn", "pos": "NOUN", "gloss": { "en": "Saturday (Satharn in the genitive: Dé Sathairn)" } },
    "domhnaigh": { "lemma": "Domhnach", "pos": "NOUN", "gloss": { "en": "Sunday (Domhnach in the genitive: Dé Domhnaigh)" } },
    "lá": { "lemma": "lá", "pos": "NOUN", "gloss": { "en": "day (masculine)" } },
    "ann": { "lemma": "i", "pos": "ADP", "gloss": { "en": "in it, there (i + é); tá ... ann = there is ..." } },
    "luan": { "lemma": "Luan", "pos": "NOUN", "gloss": { "en": "Monday: inniu an Luan = today is Monday" } },
    "amárach": { "lemma": "amárach", "pos": "ADV", "gloss": { "en": "tomorrow" } },
    "mháirt": { "lemma": "Máirt", "pos": "NOUN", "gloss": { "en": "Tuesday (Máirt, lenited after an): amárach an Mháirt" } },
    "inné": { "lemma": "inné", "pos": "ADV", "gloss": { "en": "yesterday" } },
    "domhnach": { "lemma": "Domhnach", "pos": "NOUN", "gloss": { "en": "Sunday: inné an Domhnach = yesterday was Sunday" } },
    "tseachtain": { "lemma": "seachtain", "pos": "NOUN", "gloss": { "en": "week (seachtain, feminine, with t- after sa: sa tseachtain)" } }
  },
  "lessons": [
    {
      "id": "ga-a1-uimhreacha-1",
      "title": "A haon, a dó, a trí",
      "grammarFocus": { "en": ["counting on their own, numbers take a: a haon, a dó, a trí","a puts h before a vowel: a haon, a hocht"] },
      "units": [
        { "id": "ga-a1-uimhreacha-1-u01", "rev": 1, "stage": "phrase", "text": "a haon", "variants": ["1"], "senses": {"0":"num"},
          "translation": { "en": "one" },
          "distractors": { "en": ["two","three"] } },
        { "id": "ga-a1-uimhreacha-1-u02", "rev": 1, "stage": "phrase", "text": "a dó", "variants": ["2"], "senses": {"0":"num","1":"two"},
          "translation": { "en": "two" },
          "distractors": { "en": ["one","three"] } },
        { "id": "ga-a1-uimhreacha-1-u03", "rev": 1, "stage": "phrase", "text": "a trí", "variants": ["3"], "senses": {"0":"num"},
          "translation": { "en": "three" },
          "distractors": { "en": ["two","four"] } },
        { "id": "ga-a1-uimhreacha-1-u04", "rev": 1, "stage": "phrase", "text": "a ceathair", "variants": ["4"], "senses": {"0":"num"},
          "translation": { "en": "four" },
          "distractors": { "en": ["five","three"] } },
        { "id": "ga-a1-uimhreacha-1-u05", "rev": 1, "stage": "phrase", "text": "a cúig", "variants": ["5"], "senses": {"0":"num"},
          "translation": { "en": "five" },
          "distractors": { "en": ["four","six"] } },
        { "id": "ga-a1-uimhreacha-1-u06", "rev": 1, "stage": "phrase", "text": "a sé", "variants": ["6"], "senses": {"0":"num","1":"six"},
          "translation": { "en": "six" },
          "distractors": { "en": ["seven","five"] } },
        { "id": "ga-a1-uimhreacha-1-u07", "rev": 1, "stage": "phrase", "text": "a seacht", "variants": ["7"], "senses": {"0":"num"},
          "translation": { "en": "seven" },
          "distractors": { "en": ["eight","six"] } },
        { "id": "ga-a1-uimhreacha-1-u08", "rev": 1, "stage": "phrase", "text": "a hocht", "variants": ["8"], "senses": {"0":"num"},
          "translation": { "en": "eight" },
          "distractors": { "en": ["seven","nine"] } },
        { "id": "ga-a1-uimhreacha-1-u09", "rev": 1, "stage": "phrase", "text": "a naoi", "variants": ["9"], "senses": {"0":"num"},
          "translation": { "en": "nine" },
          "distractors": { "en": ["eight","ten"] } },
        { "id": "ga-a1-uimhreacha-1-u10", "rev": 1, "stage": "phrase", "text": "a deich", "variants": ["10"], "senses": {"0":"num"},
          "translation": { "en": "ten" },
          "distractors": { "en": ["nine","eight"] } },
        { "id": "ga-a1-uimhreacha-1-u11", "rev": 1, "stage": "sentence", "text": "A haon, a dó, a trí!", "senses": {"0":"num","2":"num","3":"two","4":"num"},
          "translation": { "en": "One, two, three!" },
          "distractors": { "en": ["One, two, four!","Two, three, four!"] } },
        { "id": "ga-a1-uimhreacha-1-u12", "rev": 1, "stage": "sentence", "text": "A ceathair, a cúig, a sé.", "senses": {"0":"num","2":"num","4":"num","5":"six"},
          "translation": { "en": "Four, five, six." },
          "distractors": { "en": ["Four, five, seven.","Three, four, five."] } },
        { "id": "ga-a1-uimhreacha-1-u13", "rev": 1, "stage": "sentence", "text": "A seacht, a hocht, a naoi, a deich!", "senses": {"0":"num","2":"num","4":"num","6":"num"},
          "translation": { "en": "Seven, eight, nine, ten!" },
          "distractors": { "en": ["Six, seven, eight, nine!","Seven, eight, nine, eleven!"] } },
        { "id": "ga-a1-uimhreacha-1-u14", "rev": 1, "stage": "sentence", "text": "A dó agus a dó, sin a ceathair.", "senses": {"0":"num","1":"two","3":"num","4":"two","6":"num"},
          "translation": { "en": "Two and two, that's four." },
          "distractors": { "en": ["Two and three, that's five.","Two and two, that's three."] } }
      ]
    },
    {
      "id": "ga-a1-uimhreacha-2",
      "title": "Dhá chupán tae",
      "grammarFocus": { "en": ["a number before a noun drops the a","1 to 6 lenite the noun: dhá chupán, trí chupán; 7 to 10 eclipse it: seacht gcupán","the noun stays singular, and amháin (one) comes after it"] },
      "units": [
        { "id": "ga-a1-uimhreacha-2-u01", "rev": 1, "stage": "phrase", "text": "cupán amháin",
          "translation": { "en": "one cup" },
          "distractors": { "en": ["two cups","one glass"] } },
        { "id": "ga-a1-uimhreacha-2-u02", "rev": 1, "stage": "phrase", "text": "dhá chupán", "variants": ["2 chupán"],
          "translation": { "en": "two cups" },
          "distractors": { "en": ["three cups","two glasses"] } },
        { "id": "ga-a1-uimhreacha-2-u03", "rev": 1, "stage": "sentence", "text": "Dhá chupán tae, le do thoil.",
          "translation": { "en": "Two cups of tea, please." },
          "distractors": { "en": ["Three cups of tea, please.","Two cups of coffee, please."] } },
        { "id": "ga-a1-uimhreacha-2-u04", "rev": 1, "stage": "phrase", "text": "trí ghloine", "variants": ["3 ghloine"],
          "translation": { "en": "three glasses" },
          "distractors": { "en": ["two glasses","three cups"] } },
        { "id": "ga-a1-uimhreacha-2-u05", "rev": 1, "stage": "sentence", "text": "Trí ghloine uisce, le do thoil.",
          "translation": { "en": "Three glasses of water, please." },
          "distractors": { "en": ["Two glasses of water, please.","Three glasses of milk, please."] } },
        { "id": "ga-a1-uimhreacha-2-u06", "rev": 1, "stage": "phrase", "text": "ceithre cheapaire", "variants": ["4 cheapaire"],
          "translation": { "en": "four sandwiches" },
          "distractors": { "en": ["five sandwiches","four cakes"] } },
        { "id": "ga-a1-uimhreacha-2-u07", "rev": 1, "stage": "sentence", "text": "Ba mhaith linn ceithre cheapaire.",
          "translation": { "en": "We'd like four sandwiches." },
          "distractors": { "en": ["We'd like five sandwiches.","I'd like four sandwiches."] } },
        { "id": "ga-a1-uimhreacha-2-u08", "rev": 1, "stage": "phrase", "text": "cúig phíosa", "variants": ["5 phíosa"],
          "translation": { "en": "five pieces" },
          "distractors": { "en": ["six pieces","four pieces"] } },
        { "id": "ga-a1-uimhreacha-2-u09", "rev": 1, "stage": "sentence", "text": "Ba mhaith leo cúig phíosa cáca.",
          "translation": { "en": "They'd like five pieces of cake." },
          "distractors": { "en": ["We'd like five pieces of cake.","They'd like six pieces of cake."] } },
        { "id": "ga-a1-uimhreacha-2-u10", "rev": 1, "stage": "phrase", "text": "sé chathaoir", "variants": ["6 chathaoir"], "senses": {"0":"six"},
          "translation": { "en": "six chairs" },
          "distractors": { "en": ["seven chairs","six tables"] } },
        { "id": "ga-a1-uimhreacha-2-u11", "rev": 1, "stage": "sentence", "text": "Tá sé chathaoir anseo.", "senses": {"1":"six"},
          "translation": { "en": "There are six chairs here." },
          "distractors": { "en": ["There are seven chairs here.","There are six tables here."] } },
        { "id": "ga-a1-uimhreacha-2-u12", "rev": 1, "stage": "phrase", "text": "seacht gcupán", "variants": ["7 gcupán"],
          "translation": { "en": "seven cups" },
          "distractors": { "en": ["eight cups","seven glasses"] } },
        { "id": "ga-a1-uimhreacha-2-u13", "rev": 1, "stage": "phrase", "text": "ocht mbord", "variants": ["8 mbord"],
          "translation": { "en": "eight tables" },
          "distractors": { "en": ["nine tables","eight chairs"] } },
        { "id": "ga-a1-uimhreacha-2-u14", "rev": 1, "stage": "sentence", "text": "Tá ocht mbord sa chaife.",
          "translation": { "en": "There are eight tables in the café." },
          "distractors": { "en": ["There are nine tables in the café.","There are eight chairs in the café."] } },
        { "id": "ga-a1-uimhreacha-2-u15", "rev": 1, "stage": "phrase", "text": "deich gceapaire", "variants": ["10 gceapaire"],
          "translation": { "en": "ten sandwiches" },
          "distractors": { "en": ["nine sandwiches","ten cakes"] } },
        { "id": "ga-a1-uimhreacha-2-u16", "rev": 1, "stage": "sentence", "text": "Deich gceapaire, le do thoil!",
          "translation": { "en": "Ten sandwiches, please!" },
          "distractors": { "en": ["Nine sandwiches, please!","Ten cakes, please!"] } }
      ]
    },
    {
      "id": "ga-a1-uimhreacha-3",
      "title": "Cé mhéad atá ar an gcáca?",
      "grammarFocus": { "en": ["ar an eclipses: cáca, ar an gcáca","tá trí euro air = it's three euro (lit. three euro is on it)","euro never changes, but takes n- after 7 to 10: deich n-euro"] },
      "units": [
        { "id": "ga-a1-uimhreacha-3-u01", "rev": 1, "stage": "word", "text": "euro",
          "translation": { "en": "euro" },
          "distractors": { "en": ["cent","pound"] } },
        { "id": "ga-a1-uimhreacha-3-u02", "rev": 1, "stage": "sentence", "text": "Cé mhéad atá ar an gcáca?",
          "translation": { "en": "How much is the cake?" },
          "distractors": { "en": ["How much is the coffee?","Where is the cake?"] } },
        { "id": "ga-a1-uimhreacha-3-u03", "rev": 1, "stage": "phrase", "text": "dhá euro", "variants": ["2 euro"],
          "translation": { "en": "two euros" },
          "distractors": { "en": ["three euros","two cents"] } },
        { "id": "ga-a1-uimhreacha-3-u04", "rev": 1, "stage": "sentence", "text": "Sin dhá euro, le do thoil.", "variants": ["Sin 2 euro, le do thoil."],
          "translation": { "en": "That's two euros, please." },
          "distractors": { "en": ["That's three euros, please.","That's two cents, please."] } },
        { "id": "ga-a1-uimhreacha-3-u05", "rev": 1, "stage": "phrase", "text": "trí euro", "variants": ["3 euro"],
          "translation": { "en": "three euros" },
          "distractors": { "en": ["two euros","four euros"] } },
        { "id": "ga-a1-uimhreacha-3-u06", "rev": 1, "stage": "sentence", "text": "Tá trí euro ar an tae.", "variants": ["Tá 3 euro ar an tae."],
          "translation": { "en": "The tea is three euros." },
          "distractors": { "en": ["The tea is two euros.","The coffee is three euros."] } },
        { "id": "ga-a1-uimhreacha-3-u07", "rev": 1, "stage": "sentence", "text": "Cé mhéad atá ar an gceapaire?",
          "translation": { "en": "How much is the sandwich?" },
          "distractors": { "en": ["How much is the cake?","How many sandwiches are there?"] } },
        { "id": "ga-a1-uimhreacha-3-u08", "rev": 1, "stage": "phrase", "text": "cúig euro", "variants": ["5 euro"],
          "translation": { "en": "five euros" },
          "distractors": { "en": ["six euros","five cents"] } },
        { "id": "ga-a1-uimhreacha-3-u09", "rev": 1, "stage": "sentence", "text": "Tá cúig euro air.", "variants": ["Tá 5 euro air."],
          "translation": { "en": "It's five euros." },
          "distractors": { "en": ["It's four euros.","It's five cents."] } },
        { "id": "ga-a1-uimhreacha-3-u10", "rev": 1, "stage": "phrase", "text": "deich n-euro", "variants": ["10 euro"],
          "translation": { "en": "ten euros" },
          "distractors": { "en": ["nine euros","ten cents"] } },
        { "id": "ga-a1-uimhreacha-3-u11", "rev": 1, "stage": "sentence", "text": "Sin deich n-euro ar fad.", "variants": ["Sin 10 euro ar fad."],
          "translation": { "en": "That's ten euros altogether." },
          "distractors": { "en": ["That's nine euros altogether.","That's ten euros each."] } },
        { "id": "ga-a1-uimhreacha-3-u12", "rev": 1, "stage": "word", "text": "cent",
          "translation": { "en": "cent" },
          "distractors": { "en": ["euro","pound"] } },
        { "id": "ga-a1-uimhreacha-3-u13", "rev": 1, "stage": "phrase", "text": "caoga cent", "variants": ["50 cent"],
          "translation": { "en": "fifty cents" },
          "distractors": { "en": ["fifteen cents","five cents"] } },
        { "id": "ga-a1-uimhreacha-3-u14", "rev": 1, "stage": "sentence", "text": "Tá caoga cent ar an mbainne.", "variants": ["Tá 50 cent ar an mbainne."],
          "translation": { "en": "The milk is fifty cents." },
          "distractors": { "en": ["The milk is fifteen cents.","The bread is fifty cents."] } },
        { "id": "ga-a1-uimhreacha-3-u15", "rev": 1, "stage": "phrase", "text": "fiche euro", "variants": ["20 euro"],
          "translation": { "en": "twenty euros" },
          "distractors": { "en": ["twelve euros","thirty euros"] } },
        { "id": "ga-a1-uimhreacha-3-u16", "rev": 1, "stage": "sentence", "text": "Seo duit fiche euro.", "variants": ["Seo duit 20 euro."],
          "translation": { "en": "Here's twenty euros." },
          "distractors": { "en": ["Here's twelve euros.","Here's thirty euros."] } },
        { "id": "ga-a1-uimhreacha-3-u17", "rev": 1, "stage": "sentence", "text": "Go raibh maith agat, seo do shóinseáil.",
          "translation": { "en": "Thank you, here's your change." },
          "distractors": { "en": ["Thank you, here's your bill.","Thank you, here's my change."] } }
      ]
    },
    {
      "id": "ga-a1-uimhreacha-4",
      "title": "Cén aois thú?",
      "grammarFocus": { "en": ["cén aois thú? = how old are you?","bliain (year) after numbers: dhá bhliain, trí bliana, seacht mbliana, fiche bliain","d'aois = of age"] },
      "units": [
        { "id": "ga-a1-uimhreacha-4-u01", "rev": 1, "stage": "sentence", "text": "Cén aois thú?",
          "translation": { "en": "How old are you?" },
          "distractors": { "en": ["How are you?","What's your name?"] } },
        { "id": "ga-a1-uimhreacha-4-u02", "rev": 1, "stage": "word", "text": "óg",
          "translation": { "en": "young" },
          "distractors": { "en": ["old","tall"] } },
        { "id": "ga-a1-uimhreacha-4-u03", "rev": 1, "stage": "sentence", "text": "Tá tú an-óg!",
          "translation": { "en": "You're very young!" },
          "distractors": { "en": ["You're very old!","You're very tall!"] } },
        { "id": "ga-a1-uimhreacha-4-u04", "rev": 1, "stage": "chunk", "text": "fiche bliain d'aois", "variants": ["20 bliain d'aois"],
          "translation": { "en": "twenty years old" },
          "distractors": { "en": ["twelve years old","thirty years old"] } },
        { "id": "ga-a1-uimhreacha-4-u05", "rev": 1, "stage": "sentence", "text": "Tá mé fiche bliain d'aois.", "variants": ["Tá mé 20 bliain d'aois."],
          "translation": { "en": "I'm twenty years old." },
          "distractors": { "en": ["I'm twelve years old.","I'm thirty years old."] } },
        { "id": "ga-a1-uimhreacha-4-u06", "rev": 1, "stage": "phrase", "text": "dhá bhliain", "variants": ["2 bhliain"],
          "translation": { "en": "two years" },
          "distractors": { "en": ["three years","two months"] } },
        { "id": "ga-a1-uimhreacha-4-u07", "rev": 1, "stage": "sentence", "text": "Níl sé ach dhá bhliain d'aois.", "variants": ["Níl sé ach 2 bhliain d'aois."],
          "translation": { "en": "He's only two years old." },
          "distractors": { "en": ["He's only three years old.","She's only two years old."] } },
        { "id": "ga-a1-uimhreacha-4-u08", "rev": 1, "stage": "phrase", "text": "trí bliana", "variants": ["3 bliana"],
          "translation": { "en": "three years" },
          "distractors": { "en": ["two years","three months"] } },
        { "id": "ga-a1-uimhreacha-4-u09", "rev": 1, "stage": "sentence", "text": "Tá sí trí bliana d'aois.", "variants": ["Tá sí 3 bliana d'aois."],
          "translation": { "en": "She's three years old." },
          "distractors": { "en": ["He's three years old.","She's two years old."] } },
        { "id": "ga-a1-uimhreacha-4-u10", "rev": 1, "stage": "phrase", "text": "seacht mbliana", "variants": ["7 mbliana"],
          "translation": { "en": "seven years" },
          "distractors": { "en": ["eight years","seven months"] } },
        { "id": "ga-a1-uimhreacha-4-u11", "rev": 1, "stage": "sentence", "text": "Tá sé seacht mbliana d'aois.", "variants": ["Tá sé 7 mbliana d'aois."],
          "translation": { "en": "He's seven years old." },
          "distractors": { "en": ["He's eight years old.","She's seven years old."] } },
        { "id": "ga-a1-uimhreacha-4-u12", "rev": 1, "stage": "word", "text": "tríocha", "variants": ["30"],
          "translation": { "en": "thirty" },
          "distractors": { "en": ["thirteen","three"] } },
        { "id": "ga-a1-uimhreacha-4-u13", "rev": 1, "stage": "sentence", "text": "Tá mé tríocha bliain d'aois.", "variants": ["Tá mé 30 bliain d'aois."],
          "translation": { "en": "I'm thirty years old." },
          "distractors": { "en": ["I'm thirteen years old.","I'm forty years old."] } },
        { "id": "ga-a1-uimhreacha-4-u14", "rev": 1, "stage": "word", "text": "daichead", "variants": ["40"],
          "translation": { "en": "forty" },
          "distractors": { "en": ["fourteen","fifty"] } },
        { "id": "ga-a1-uimhreacha-4-u15", "rev": 1, "stage": "sentence", "text": "An bhfuil tú daichead bliain d'aois?", "variants": ["An bhfuil tú 40 bliain d'aois?"], "senses": {"0":"q"},
          "translation": { "en": "Are you forty years old?" },
          "distractors": { "en": ["Are you fifty years old?","Is she forty years old?"] } },
        { "id": "ga-a1-uimhreacha-4-u16", "rev": 1, "stage": "sentence", "text": "Níl! Tá mé tríocha a cúig.", "variants": ["Níl! Tá mé 35."], "senses": {"4":"num"},
          "translation": { "en": "No! I'm thirty-five." },
          "distractors": { "en": ["Yes! I'm thirty-five.","No! I'm forty-five."] } }
      ]
    },
    {
      "id": "ga-a1-uimhreacha-5",
      "title": "Cén t-am é?",
      "grammarFocus": { "en": ["cén t-am é? = what time is it?","a chlog = o'clock","leathuair tar éis = half past; ceathrú tar éis = quarter past; ceathrú chun = quarter to"] },
      "units": [
        { "id": "ga-a1-uimhreacha-5-u01", "rev": 1, "stage": "sentence", "text": "Cén t-am é?",
          "translation": { "en": "What time is it?" },
          "distractors": { "en": ["What day is it?","How old is he?"] } },
        { "id": "ga-a1-uimhreacha-5-u02", "rev": 1, "stage": "phrase", "text": "a chlog", "senses": {"0":"oc"},
          "translation": { "en": "o'clock" },
          "distractors": { "en": ["half past","quarter to"] } },
        { "id": "ga-a1-uimhreacha-5-u03", "rev": 1, "stage": "sentence", "text": "Tá sé a trí a chlog.", "senses": {"2":"num","4":"oc"},
          "translation": { "en": "It's three o'clock." },
          "distractors": { "en": ["It's two o'clock.","It's half past three."] } },
        { "id": "ga-a1-uimhreacha-5-u04", "rev": 1, "stage": "sentence", "text": "Tá sé a haon a chlog.", "senses": {"2":"num","4":"oc"},
          "translation": { "en": "It's one o'clock." },
          "distractors": { "en": ["It's eleven o'clock.","It's half past one."] } },
        { "id": "ga-a1-uimhreacha-5-u05", "rev": 1, "stage": "phrase", "text": "leathuair tar éis",
          "translation": { "en": "half past" },
          "distractors": { "en": ["quarter past","quarter to"] } },
        { "id": "ga-a1-uimhreacha-5-u06", "rev": 1, "stage": "sentence", "text": "Tá sé leathuair tar éis a dó.", "senses": {"5":"num","6":"two"},
          "translation": { "en": "It's half past two." },
          "distractors": { "en": ["It's half past three.","It's quarter past two."] } },
        { "id": "ga-a1-uimhreacha-5-u07", "rev": 1, "stage": "phrase", "text": "ceathrú tar éis",
          "translation": { "en": "quarter past" },
          "distractors": { "en": ["half past","quarter to"] } },
        { "id": "ga-a1-uimhreacha-5-u08", "rev": 1, "stage": "sentence", "text": "Tá sé ceathrú tar éis a sé.", "senses": {"5":"num","6":"six"},
          "translation": { "en": "It's quarter past six." },
          "distractors": { "en": ["It's quarter to six.","It's half past six."] } },
        { "id": "ga-a1-uimhreacha-5-u09", "rev": 1, "stage": "phrase", "text": "ceathrú chun",
          "translation": { "en": "quarter to" },
          "distractors": { "en": ["quarter past","half past"] } },
        { "id": "ga-a1-uimhreacha-5-u10", "rev": 1, "stage": "sentence", "text": "Tá sé ceathrú chun a deich.", "senses": {"4":"num"},
          "translation": { "en": "It's quarter to ten." },
          "distractors": { "en": ["It's quarter past ten.","It's quarter to nine."] } },
        { "id": "ga-a1-uimhreacha-5-u11", "rev": 1, "stage": "phrase", "text": "meán lae",
          "translation": { "en": "noon" },
          "distractors": { "en": ["midnight","morning"] } },
        { "id": "ga-a1-uimhreacha-5-u12", "rev": 1, "stage": "sentence", "text": "Tá sé meán lae.",
          "translation": { "en": "It's noon." },
          "distractors": { "en": ["It's midnight.","It's one o'clock."] } },
        { "id": "ga-a1-uimhreacha-5-u13", "rev": 1, "stage": "phrase", "text": "meán oíche",
          "translation": { "en": "midnight" },
          "distractors": { "en": ["noon","tonight"] } },
        { "id": "ga-a1-uimhreacha-5-u14", "rev": 1, "stage": "sentence", "text": "Tá sé meán oíche, oíche mhaith!",
          "translation": { "en": "It's midnight, good night!" },
          "distractors": { "en": ["It's noon, good night!","It's midnight, good morning!"] } },
        { "id": "ga-a1-uimhreacha-5-u15", "rev": 1, "stage": "sentence", "text": "Feicfidh mé thú ar a naoi a chlog.", "senses": {"4":"num","6":"oc"},
          "translation": { "en": "See you at nine o'clock." },
          "distractors": { "en": ["See you at five o'clock.","See you at half past nine."] } }
      ]
    },
    {
      "id": "ga-a1-uimhreacha-6",
      "title": "Dé Luain",
      "grammarFocus": { "en": ["the days take Dé: Dé Luain = on Monday; Dé hAoine = on Friday (h before a vowel)","Déardaoin (Thursday) is one word","inné = yesterday, inniu = today, amárach = tomorrow"] },
      "units": [
        { "id": "ga-a1-uimhreacha-6-u01", "rev": 1, "stage": "phrase", "text": "Dé Luain",
          "translation": { "en": "Monday" },
          "distractors": { "en": ["Tuesday","Sunday"] } },
        { "id": "ga-a1-uimhreacha-6-u02", "rev": 1, "stage": "phrase", "text": "Dé Máirt",
          "translation": { "en": "Tuesday" },
          "distractors": { "en": ["Monday","Thursday"] } },
        { "id": "ga-a1-uimhreacha-6-u03", "rev": 1, "stage": "phrase", "text": "Dé Céadaoin",
          "translation": { "en": "Wednesday" },
          "distractors": { "en": ["Thursday","Tuesday"] } },
        { "id": "ga-a1-uimhreacha-6-u04", "rev": 1, "stage": "word", "text": "Déardaoin",
          "translation": { "en": "Thursday" },
          "distractors": { "en": ["Wednesday","Friday"] } },
        { "id": "ga-a1-uimhreacha-6-u05", "rev": 1, "stage": "phrase", "text": "Dé hAoine",
          "translation": { "en": "Friday" },
          "distractors": { "en": ["Saturday","Thursday"] } },
        { "id": "ga-a1-uimhreacha-6-u06", "rev": 1, "stage": "phrase", "text": "Dé Sathairn",
          "translation": { "en": "Saturday" },
          "distractors": { "en": ["Sunday","Friday"] } },
        { "id": "ga-a1-uimhreacha-6-u07", "rev": 1, "stage": "phrase", "text": "Dé Domhnaigh",
          "translation": { "en": "Sunday" },
          "distractors": { "en": ["Saturday","Monday"] } },
        { "id": "ga-a1-uimhreacha-6-u08", "rev": 1, "stage": "sentence", "text": "Cén lá atá ann inniu?",
          "translation": { "en": "What day is it today?" },
          "distractors": { "en": ["What time is it today?","What day was it yesterday?"] } },
        { "id": "ga-a1-uimhreacha-6-u09", "rev": 1, "stage": "sentence", "text": "Inniu an Luan.",
          "translation": { "en": "Today is Monday." },
          "distractors": { "en": ["Today is Tuesday.","Tomorrow is Monday."] } },
        { "id": "ga-a1-uimhreacha-6-u10", "rev": 1, "stage": "word", "text": "amárach",
          "translation": { "en": "tomorrow" },
          "distractors": { "en": ["yesterday","today"] } },
        { "id": "ga-a1-uimhreacha-6-u11", "rev": 1, "stage": "sentence", "text": "Amárach an Mháirt.",
          "translation": { "en": "Tomorrow is Tuesday." },
          "distractors": { "en": ["Tomorrow is Thursday.","Yesterday was Tuesday."] } },
        { "id": "ga-a1-uimhreacha-6-u12", "rev": 1, "stage": "word", "text": "inné",
          "translation": { "en": "yesterday" },
          "distractors": { "en": ["tomorrow","today"] } },
        { "id": "ga-a1-uimhreacha-6-u13", "rev": 1, "stage": "sentence", "text": "Inné an Domhnach.",
          "translation": { "en": "Yesterday was Sunday." },
          "distractors": { "en": ["Yesterday was Saturday.","Tomorrow is Sunday."] } },
        { "id": "ga-a1-uimhreacha-6-u14", "rev": 1, "stage": "sentence", "text": "Dé hAoine atá ann inniu!",
          "translation": { "en": "It's Friday today!" },
          "distractors": { "en": ["It's Thursday today!","It was Friday yesterday!"] } },
        { "id": "ga-a1-uimhreacha-6-u15", "rev": 1, "stage": "sentence", "text": "Tá mé saor Dé Sathairn.",
          "translation": { "en": "I'm free on Saturday." },
          "distractors": { "en": ["I'm free on Sunday.","I'm not free on Saturday."] } },
        { "id": "ga-a1-uimhreacha-6-u16", "rev": 1, "stage": "sentence", "text": "Feicfidh mé thú Déardaoin.",
          "translation": { "en": "See you on Thursday." },
          "distractors": { "en": ["See you on Wednesday.","See you on Tuesday."] } },
        { "id": "ga-a1-uimhreacha-6-u17", "rev": 1, "stage": "sentence", "text": "Tá seacht lá sa tseachtain.", "variants": ["Tá 7 lá sa tseachtain."],
          "translation": { "en": "There are seven days in the week." },
          "distractors": { "en": ["There are six days in the week.","There are seven days in the month."] } }
      ]
    }
  ]
}
