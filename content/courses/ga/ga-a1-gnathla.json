    "éistim": { "lemma": "éist", "pos": "VERB", "gloss": { "en": "I listen; éistim le = I listen to" } },
    "leaba": { "lemma": "leaba", "pos": "NOUN", "gloss": { "en": "bed (feminine)" } },
    "léim": { "lemma": "léigh", "pos": "VERB", "gloss": { "en": "I read" } },
    "glaoim": { "lemma": "glaoigh", "pos": "VERB", "gloss": { "en": "I call; glaoim ar = I call (someone)" } },
    "bhféachann": { "lemma": "féach", "pos": "VERB", "gloss": { "en": "look, watch (féachann, eclipsed after an)" } },
    "fhéachaim": { "lemma": "féach", "pos": "VERB", "gloss": { "en": "I look, I watch (féachaim, lenited after ní)" } },
    "raidió": { "lemma": "raidió", "pos": "NOUN", "gloss": { "en": "radio (masculine)" } },
    "chodladh": { "lemma": "codail", "pos": "VERB", "gloss": { "en": "sleeping (codladh, lenited after a): téim a chodladh = I go to bed" } },
