{
  "id": "ga-a1-gnathla",
  "language": "ga",
  "level": "A1",
  "order": 6,
  "title": "Gnáthlá",
  "description": { "en": "Describe your day from getting up to going to bed, with the present tense for habits" },
  "track": "main",
  "requires": ["ga-a1-obair"],
  "introduces": ["éirigh","luath","déanach","glac","cithfholcadh","glan","fiacail","seomra","folcadh","bricfeasta","im","téigh","bus","traein","rothar","de","siúl","cos","carr","lón","dtí","dinnéar","blasta","cistin","tráthnóna","féach","teilifís","ceol","éist","leaba","léigh","glaoigh","raidió","codail","déag","dúiseacht","sámh","ansin","sásta"],
  "lexicon": {
    "éirím": { "lemma": "éirigh", "pos": "VERB", "gloss": { "en": "I get up, I rise" } },
    "luath": { "lemma": "luath", "pos": "ADJ", "gloss": { "en": "early; go luath = early (adverb), soon" } },
