    "itheann": { "lemma": "ith", "pos": "VERB", "gloss": { "en": "eats (he, she, they, you)" } },
    "tagann": { "lemma": "tar", "pos": "VERB", "gloss": { "en": "comes (he, she, they, you)" } },
    "déanann": { "lemma": "déan", "pos": "VERB", "gloss": { "en": "does, makes (he, she, they, you)" } },
    "féachann": { "lemma": "féach", "pos": "VERB", "gloss": { "en": "looks; féachann sí ar = she watches" } },
    "sásta": { "lemma": "sásta", "pos": "ADJ", "gloss": { "en": "happy, content, satisfied" } }
  },
  "lessons": [
    {
      "id": "ga-a1-gnathla-1",
      "title": "Éirím go luath",
      "grammarFocus": { "en": ["the present tense for habits: -im or -aim = I: éirím = I get up, ólaim = I drink","ní lenites: ní ólaim (a vowel doesn't change)"] },
      "units": [
        { "id": "ga-a1-gnathla-1-u01", "rev": 1, "stage": "phrase", "text": "éirím",
          "translation": { "en": "I get up" },
          "distractors": { "en": ["I go to bed","I got up"] } },
        { "id": "ga-a1-gnathla-1-u02", "rev": 1, "stage": "sentence", "text": "Éirím ar a seacht a chlog.", "senses": {"2":"num","4":"oc"},
          "translation": { "en": "I get up at seven o'clock." },
          "distractors": { "en": ["I get up at eight o'clock.","I go to bed at seven o'clock."] } },
        { "id": "ga-a1-gnathla-1-u03", "rev": 1, "stage": "word", "text": "luath",
          "translation": { "en": "early" },
          "distractors": { "en": ["late","often"] } },
        { "id": "ga-a1-gnathla-1-u04", "rev": 1, "stage": "sentence", "text": "Éirím go luath gach maidin.",
          "translation": { "en": "I get up early every morning." },
          "distractors": { "en": ["I get up late every morning.","I get up early every night."] } },
        { "id": "ga-a1-gnathla-1-u05", "rev": 1, "stage": "word", "text": "déanach",
          "translation": { "en": "late" },
          "distractors": { "en": ["early","slow"] } },
        { "id": "ga-a1-gnathla-1-u06", "rev": 1, "stage": "sentence", "text": "Éiríonn mo dheartháir go déanach.",
          "translation": { "en": "My brother gets up late." },
          "distractors": { "en": ["My brother gets up early.","My sister gets up late."] } },
        { "id": "ga-a1-gnathla-1-u07", "rev": 1, "stage": "phrase", "text": "glacaim cithfholcadh",
          "translation": { "en": "I take a shower" },
          "distractors": { "en": ["I take a bath","I have breakfast"] } },
        { "id": "ga-a1-gnathla-1-u08", "rev": 1, "stage": "sentence", "text": "Glacaim cithfholcadh gach maidin.",
          "translation": { "en": "I take a shower every morning." },
          "distractors": { "en": ["I take a bath every morning.","I take a shower every night."] } },
        { "id": "ga-a1-gnathla-1-u09", "rev": 1, "stage": "phrase", "text": "glanaim m'fhiacla",
          "translation": { "en": "I brush my teeth" },
          "distractors": { "en": ["I wash my face","I brush my hair"] } },
        { "id": "ga-a1-gnathla-1-u10", "rev": 1, "stage": "sentence", "text": "Glanaim m'fhiacla sa seomra folctha.",
          "translation": { "en": "I brush my teeth in the bathroom." },
          "distractors": { "en": ["I brush my teeth in the kitchen.","I wash my face in the bathroom."] } },
        { "id": "ga-a1-gnathla-1-u11", "rev": 1, "stage": "word", "text": "bricfeasta",
          "translation": { "en": "breakfast" },
          "distractors": { "en": ["lunch","dinner"] } },
        { "id": "ga-a1-gnathla-1-u12", "rev": 1, "stage": "phrase", "text": "mo bhricfeasta",
          "translation": { "en": "my breakfast" },
          "distractors": { "en": ["my lunch","your breakfast"] } },
        { "id": "ga-a1-gnathla-1-u13", "rev": 1, "stage": "sentence", "text": "Ithim mo bhricfeasta ar a hocht.", "senses": {"4":"num"},
          "translation": { "en": "I eat my breakfast at eight." },
          "distractors": { "en": ["I eat my lunch at eight.","I eat my breakfast at nine."] } },
        { "id": "ga-a1-gnathla-1-u14", "rev": 1, "stage": "phrase", "text": "ólaim",
          "translation": { "en": "I drink" },
          "distractors": { "en": ["I eat","I make"] } },
        { "id": "ga-a1-gnathla-1-u15", "rev": 1, "stage": "sentence", "text": "Ólaim cupán caife ar maidin.",
          "translation": { "en": "I drink a cup of coffee in the morning." },
          "distractors": { "en": ["I drink a cup of tea in the morning.","I drink a cup of coffee at night."] } },
        { "id": "ga-a1-gnathla-1-u16", "rev": 1, "stage": "sentence", "text": "Ní ólaim tae ar maidin.",
          "translation": { "en": "I don't drink tea in the morning." },
          "distractors": { "en": ["I drink tea in the morning.","I don't drink coffee in the morning."] } },
        { "id": "ga-a1-gnathla-1-u17", "rev": 1, "stage": "word", "text": "im",
          "translation": { "en": "butter" },
          "distractors": { "en": ["bread","milk"] } },
        { "id": "ga-a1-gnathla-1-u18", "rev": 1, "stage": "sentence", "text": "Ithim arán donn agus im.",
          "translation": { "en": "I eat brown bread and butter." },
          "distractors": { "en": ["I eat white bread and butter.","I eat brown bread and cheese."] } }
      ]
    },
    {
      "id": "ga-a1-gnathla-2",
      "title": "Téim ag obair",
      "grammarFocus": { "en": ["téim = I go, téann sí = she goes","ar an eclipses: bus, ar an mbus","ag obair = to work, ar scoil = to school"] },
      "units": [
        { "id": "ga-a1-gnathla-2-u01", "rev": 1, "stage": "phrase", "text": "téim",
          "translation": { "en": "I go" },
          "distractors": { "en": ["I come","I went"] } },
        { "id": "ga-a1-gnathla-2-u02", "rev": 1, "stage": "sentence", "text": "Téim ag obair ar a naoi.", "senses": {"4":"num"},
          "translation": { "en": "I go to work at nine." },
          "distractors": { "en": ["I go to school at nine.","I go to work at eight."] } },
        { "id": "ga-a1-gnathla-2-u03", "rev": 1, "stage": "phrase", "text": "ar an mbus",
          "translation": { "en": "by bus" },
          "distractors": { "en": ["by train","by car"] } },
        { "id": "ga-a1-gnathla-2-u04", "rev": 1, "stage": "sentence", "text": "Téim ag obair ar an mbus.",
          "translation": { "en": "I go to work by bus." },
          "distractors": { "en": ["I go to work by train.","I go to school by bus."] } },
        { "id": "ga-a1-gnathla-2-u05", "rev": 1, "stage": "phrase", "text": "ar an traein",
          "translation": { "en": "by train" },
          "distractors": { "en": ["by bus","by bike"] } },
        { "id": "ga-a1-gnathla-2-u06", "rev": 1, "stage": "sentence", "text": "Téann m'athair ag obair ar an traein.",
          "translation": { "en": "My father goes to work by train." },
          "distractors": { "en": ["My mother goes to work by train.","My father goes to work by bus."] } },
        { "id": "ga-a1-gnathla-2-u07", "rev": 1, "stage": "word", "text": "rothar",
          "translation": { "en": "bike" },
          "distractors": { "en": ["car","bus"] } },
        { "id": "ga-a1-gnathla-2-u08", "rev": 1, "stage": "phrase", "text": "ar scoil",
          "translation": { "en": "to school" },
          "distractors": { "en": ["to work","at home"] } },
        { "id": "ga-a1-gnathla-2-u09", "rev": 1, "stage": "sentence", "text": "Téann sí ar scoil ar a rothar.", "senses": {"5":"her"},
          "translation": { "en": "She goes to school on her bike." },
          "distractors": { "en": ["He goes to school on his bike.","She goes to work on her bike."] } },
        { "id": "ga-a1-gnathla-2-u10", "rev": 1, "stage": "phrase", "text": "de shiúl na gcos",
          "translation": { "en": "on foot" },
          "distractors": { "en": ["by bike","by car"] } },
        { "id": "ga-a1-gnathla-2-u11", "rev": 1, "stage": "sentence", "text": "Téim ar scoil de shiúl na gcos.",
          "translation": { "en": "I walk to school." },
          "distractors": { "en": ["I go to school by bus.","I walk to work."] } },
        { "id": "ga-a1-gnathla-2-u12", "rev": 1, "stage": "word", "text": "carr",
          "translation": { "en": "car" },
          "distractors": { "en": ["bus","train"] } },
        { "id": "ga-a1-gnathla-2-u13", "rev": 1, "stage": "phrase", "text": "sa charr",
          "translation": { "en": "in the car" },
          "distractors": { "en": ["on the bus","in the house"] } },
        { "id": "ga-a1-gnathla-2-u14", "rev": 1, "stage": "sentence", "text": "Téann siad ag obair sa charr.",
          "translation": { "en": "They go to work in the car." },
          "distractors": { "en": ["We go to work in the car.","They go to school in the car."] } },
        { "id": "ga-a1-gnathla-2-u15", "rev": 1, "stage": "sentence", "text": "Conas a théann tú ag obair?", "senses": {"1":"rel"},
          "translation": { "en": "How do you get to work?" },
          "distractors": { "en": ["When do you go to work?","Where do you work?"] } },
        { "id": "ga-a1-gnathla-2-u16", "rev": 1, "stage": "sentence", "text": "An dtéann tú ar an mbus?", "senses": {"0":"q"},
          "translation": { "en": "Do you go by bus?" },
          "distractors": { "en": ["Do you go by train?","Does she go by bus?"] } },
        { "id": "ga-a1-gnathla-2-u17", "rev": 1, "stage": "sentence", "text": "Téim, gach lá.",
          "translation": { "en": "Yes, every day." },
          "distractors": { "en": ["No, never.","Yes, every week."] } }
      ]
    },
    {
      "id": "ga-a1-gnathla-3",
      "title": "Am lóin",
      "grammarFocus": { "en": ["bím = I am (usually), bíonn sé = it is (usually): the habitual form of tá","go dtí = until, to"] },
      "units": [
        { "id": "ga-a1-gnathla-3-u01", "rev": 1, "stage": "phrase", "text": "bím",
          "translation": { "en": "I'm usually" },
          "distractors": { "en": ["I was","I will be"] } },
        { "id": "ga-a1-gnathla-3-u02", "rev": 1, "stage": "sentence", "text": "Bím an-ghnóthach ar maidin.",
          "translation": { "en": "I'm usually very busy in the morning." },
          "distractors": { "en": ["I'm usually very tired in the morning.","I'm usually very busy at night."] } },
        { "id": "ga-a1-gnathla-3-u03", "rev": 1, "stage": "word", "text": "lón",
          "translation": { "en": "lunch" },
          "distractors": { "en": ["breakfast","dinner"] } },
        { "id": "ga-a1-gnathla-3-u04", "rev": 1, "stage": "sentence", "text": "Ithim mo lón ar a haon a chlog.", "senses": {"4":"num","6":"oc"},
          "translation": { "en": "I eat my lunch at one o'clock." },
          "distractors": { "en": ["I eat my breakfast at one o'clock.","I eat my lunch at two o'clock."] } },
        { "id": "ga-a1-gnathla-3-u05", "rev": 1, "stage": "phrase", "text": "go dtí",
          "translation": { "en": "until" },
          "distractors": { "en": ["after","before"] } },
        { "id": "ga-a1-gnathla-3-u06", "rev": 1, "stage": "sentence", "text": "Bím ag obair go dtí a cúig.", "senses": {"5":"num"},
          "translation": { "en": "I work until five." },
          "distractors": { "en": ["I work until six.","I work after five."] } },
        { "id": "ga-a1-gnathla-3-u07", "rev": 1, "stage": "word", "text": "dinnéar",
          "translation": { "en": "dinner" },
          "distractors": { "en": ["lunch","breakfast"] } },
        { "id": "ga-a1-gnathla-3-u08", "rev": 1, "stage": "sentence", "text": "Ithimid an dinnéar ar a seacht.", "senses": {"4":"num"},
          "translation": { "en": "We eat dinner at seven." },
          "distractors": { "en": ["They eat dinner at seven.","We eat lunch at seven."] } },
        { "id": "ga-a1-gnathla-3-u09", "rev": 1, "stage": "word", "text": "blasta",
          "translation": { "en": "tasty" },
          "distractors": { "en": ["cold","sweet"] } },
        { "id": "ga-a1-gnathla-3-u10", "rev": 1, "stage": "sentence", "text": "Bíonn an dinnéar blasta.",
          "translation": { "en": "Dinner is always tasty." },
          "distractors": { "en": ["Dinner is always cold.","Lunch is always tasty."] } },
        { "id": "ga-a1-gnathla-3-u11", "rev": 1, "stage": "phrase", "text": "déanaim",
          "translation": { "en": "I make, I do" },
          "distractors": { "en": ["I eat","I made"] } },
        { "id": "ga-a1-gnathla-3-u12", "rev": 1, "stage": "sentence", "text": "Déanaim an dinnéar gach oíche.",
          "translation": { "en": "I make dinner every night." },
          "distractors": { "en": ["I eat dinner every night.","I make lunch every night."] } },
        { "id": "ga-a1-gnathla-3-u13", "rev": 1, "stage": "sentence", "text": "Ní dhéanaim an dinnéar Dé hAoine.",
          "translation": { "en": "I don't make dinner on Friday." },
          "distractors": { "en": ["I make dinner on Friday.","I don't make dinner on Thursday."] } },
        { "id": "ga-a1-gnathla-3-u14", "rev": 1, "stage": "word", "text": "cistin",
          "translation": { "en": "kitchen" },
          "distractors": { "en": ["bathroom","bedroom"] } },
        { "id": "ga-a1-gnathla-3-u15", "rev": 1, "stage": "phrase", "text": "sa chistin",
          "translation": { "en": "in the kitchen" },
          "distractors": { "en": ["in the bathroom","in the café"] } },
        { "id": "ga-a1-gnathla-3-u16", "rev": 1, "stage": "sentence", "text": "Bím sa chistin ar a sé.", "senses": {"4":"num","5":"six"},
          "translation": { "en": "I'm usually in the kitchen at six." },
          "distractors": { "en": ["I'm usually in the kitchen at seven.","I'm usually in the bathroom at six."] } },
        { "id": "ga-a1-gnathla-3-u17", "rev": 1, "stage": "sentence", "text": "Bíonn m'athair sa chistin freisin.",
          "translation": { "en": "My father's usually in the kitchen too." },
          "distractors": { "en": ["My mother's usually in the kitchen too.","My father's never in the kitchen."] } }
      ]
    },
    {
      "id": "ga-a1-gnathla-4",
      "title": "Tráthnóna",
      "grammarFocus": { "en": ["some verbs need a preposition: féachaim ar = I watch; éistim le = I listen to; glaoim ar = I call","le + an = leis an"] },
      "units": [
        { "id": "ga-a1-gnathla-4-u01", "rev": 1, "stage": "word", "text": "tráthnóna",
          "translation": { "en": "evening" },
          "distractors": { "en": ["morning","night"] } },
        { "id": "ga-a1-gnathla-4-u02", "rev": 1, "stage": "sentence", "text": "Tagaim abhaile ar a sé tráthnóna.", "senses": {"3":"num","4":"six"},
          "translation": { "en": "I come home at six in the evening." },
          "distractors": { "en": ["I go home at six in the evening.","I come home at six in the morning."] } },
        { "id": "ga-a1-gnathla-4-u03", "rev": 1, "stage": "phrase", "text": "féachaim ar an teilifís",
          "translation": { "en": "I watch TV" },
          "distractors": { "en": ["I listen to the radio","I watched TV"] } },
        { "id": "ga-a1-gnathla-4-u04", "rev": 1, "stage": "sentence", "text": "Féachaim ar an teilifís tar éis an dinnéir.",
          "translation": { "en": "I watch TV after dinner." },
          "distractors": { "en": ["I watch TV before dinner.","I listen to the radio after dinner."] } },
        { "id": "ga-a1-gnathla-4-u05", "rev": 1, "stage": "word", "text": "ceol",
          "translation": { "en": "music" },
          "distractors": { "en": ["radio","book"] } },
        { "id": "ga-a1-gnathla-4-u06", "rev": 1, "stage": "phrase", "text": "éistim le ceol",
          "translation": { "en": "I listen to music" },
          "distractors": { "en": ["I play music","I listen to the radio"] } },
        { "id": "ga-a1-gnathla-4-u07", "rev": 1, "stage": "sentence", "text": "Éistim le ceol sa charr.",
          "translation": { "en": "I listen to music in the car." },
          "distractors": { "en": ["I listen to music in the kitchen.","I play music in the car."] } },
        { "id": "ga-a1-gnathla-4-u08", "rev": 1, "stage": "word", "text": "leaba",
          "translation": { "en": "bed" },
          "distractors": { "en": ["room","chair"] } },
        { "id": "ga-a1-gnathla-4-u09", "rev": 1, "stage": "phrase", "text": "léim",
          "translation": { "en": "I read" },
          "distractors": { "en": ["I write","I sleep"] } },
        { "id": "ga-a1-gnathla-4-u10", "rev": 1, "stage": "sentence", "text": "Léim leabhar sa leaba.",
          "translation": { "en": "I read a book in bed." },
          "distractors": { "en": ["I read a book in the kitchen.","I write a book in bed."] } },
        { "id": "ga-a1-gnathla-4-u11", "rev": 1, "stage": "sentence", "text": "Glaoim ar mo mháthair gach Domhnach.",
          "translation": { "en": "I call my mother every Sunday." },
          "distractors": { "en": ["I call my father every Sunday.","I visit my mother every Sunday."] } },
        { "id": "ga-a1-gnathla-4-u12", "rev": 1, "stage": "sentence", "text": "An bhféachann tú ar an teilifís?", "senses": {"0":"q"},
          "translation": { "en": "Do you watch TV?" },
          "distractors": { "en": ["Do you listen to the radio?","Does he watch TV?"] } },
        { "id": "ga-a1-gnathla-4-u13", "rev": 1, "stage": "sentence", "text": "Ní fhéachaim, ach éistim leis an raidió.",
          "translation": { "en": "No, but I listen to the radio." },
          "distractors": { "en": ["Yes, and I listen to the radio.","No, but I listen to music."] } }
      ]
    },
    {
      "id": "ga-a1-gnathla-5",
      "title": "Téim a chodladh",
      "grammarFocus": { "en": ["téim a chodladh = I go to bed (lit. I go to sleep)","11 and 12 add déag: a haon déag, a dó dhéag"] },
      "units": [
        { "id": "ga-a1-gnathla-5-u01", "rev": 1, "stage": "phrase", "text": "a chodladh", "senses": {"0":"to"},
          "translation": { "en": "to bed, to sleep" },
          "distractors": { "en": ["to work","to school"] } },
        { "id": "ga-a1-gnathla-5-u02", "rev": 1, "stage": "sentence", "text": "Téim a chodladh ar a haon déag.", "senses": {"1":"to","4":"num"},
          "translation": { "en": "I go to bed at eleven." },
          "distractors": { "en": ["I go to bed at twelve.","I get up at eleven."] } },
        { "id": "ga-a1-gnathla-5-u03", "rev": 1, "stage": "sentence", "text": "Téann na páistí a chodladh ar a hocht.", "senses": {"3":"to","6":"num"},
