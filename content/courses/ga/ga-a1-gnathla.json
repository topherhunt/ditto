    "dhéag": { "lemma": "déag", "pos": "NUM", "gloss": { "en": "-teen (déag, lenited after dó): a dó dhéag = twelve" } },
    "dhúiseacht": { "lemma": "dúiseacht", "pos": "NOUN", "gloss": { "en": "waking (dúiseacht, lenited after mo): i mo dhúiseacht = awake" } },
    "codlaím": { "lemma": "codail", "pos": "VERB", "gloss": { "en": "I sleep" } },
    "chodlaím": { "lemma": "codail", "pos": "VERB", "gloss": { "en": "I sleep (codlaím, lenited after ní)" } },
    "codladh": { "lemma": "codail", "pos": "VERB", "gloss": { "en": "sleep, sleeping (verbal noun of codail)" } },
    "sámh": { "lemma": "sámh", "pos": "ADJ", "gloss": { "en": "peaceful; codladh sámh = sleep well" } },
