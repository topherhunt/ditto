          "distractors": { "en": ["The children get up at eight.","The children go to bed at nine."] } },
        { "id": "ga-a1-gnathla-5-u04", "rev": 1, "stage": "phrase", "text": "a dó dhéag", "senses": {"0":"num","1":"two"},
          "translation": { "en": "twelve" },
          "distractors": { "en": ["eleven","two"] } },
        { "id": "ga-a1-gnathla-5-u05", "rev": 1, "stage": "sentence", "text": "Bím i mo dhúiseacht go dtí a dó dhéag.", "senses": {"6":"num","7":"two"},
          "translation": { "en": "I'm usually awake until twelve." },
          "distractors": { "en": ["I'm usually asleep until twelve.","I'm usually awake until eleven."] } },
        { "id": "ga-a1-gnathla-5-u06", "rev": 1, "stage": "phrase", "text": "codlaím",
          "translation": { "en": "I sleep" },
          "distractors": { "en": ["I get up","I slept"] } },
        { "id": "ga-a1-gnathla-5-u07", "rev": 1, "stage": "sentence", "text": "Codlaím go maith.",
          "translation": { "en": "I sleep well." },
          "distractors": { "en": ["I don't sleep well.","You sleep well."] } },
        { "id": "ga-a1-gnathla-5-u08", "rev": 1, "stage": "sentence", "text": "Ní chodlaím go maith.",
          "translation": { "en": "I don't sleep well." },
          "distractors": { "en": ["I sleep well.","She doesn't sleep well."] } },
        { "id": "ga-a1-gnathla-5-u09", "rev": 1, "stage": "phrase", "text": "san oíche",
          "translation": { "en": "at night" },
          "distractors": { "en": ["in the morning","at noon"] } },
        { "id": "ga-a1-gnathla-5-u10", "rev": 1, "stage": "sentence", "text": "Bím tuirseach san oíche.",
          "translation": { "en": "I'm usually tired at night." },
          "distractors": { "en": ["I'm usually tired in the morning.","I'm never tired at night."] } },
        { "id": "ga-a1-gnathla-5-u11", "rev": 1, "stage": "sentence", "text": "Oíche mhaith, codladh sámh!",
          "translation": { "en": "Good night, sleep well!" },
          "distractors": { "en": ["Good morning, sleep well!","Good night, see you soon!"] } }
      ]
    },
    {
      "id": "ga-a1-gnathla-6",
      "title": "Mo ghnáthlá",
      "grammarFocus": { "en": ["he and she forms end in -ann or -eann: ólaim, ólann sí; éirím, éiríonn sí","a whole day, start to finish"] },
      "units": [
        { "id": "ga-a1-gnathla-6-u01", "rev": 1, "stage": "sentence", "text": "Éiríonn Áine ar a sé a chlog.", "senses": {"3":"num","4":"six","5":"oc"},
          "translation": { "en": "Áine gets up at six o'clock." },
          "distractors": { "en": ["Áine goes to bed at six o'clock.","Áine gets up at seven o'clock."] } },
        { "id": "ga-a1-gnathla-6-u02", "rev": 1, "stage": "sentence", "text": "Ólann sí cupán caife sa chistin.",
          "translation": { "en": "She drinks a cup of coffee in the kitchen." },
          "distractors": { "en": ["She drinks a cup of tea in the kitchen.","He drinks a cup of coffee in the kitchen."] } },
        { "id": "ga-a1-gnathla-6-u03", "rev": 1, "stage": "word", "text": "ansin",
          "translation": { "en": "then, there" },
          "distractors": { "en": ["now","here"] } },
        { "id": "ga-a1-gnathla-6-u04", "rev": 1, "stage": "sentence", "text": "Ansin, téann sí ag obair ar an traein.",
          "translation": { "en": "Then she goes to work by train." },
          "distractors": { "en": ["Then she goes to work by bus.","Then he goes to work by train."] } },
        { "id": "ga-a1-gnathla-6-u05", "rev": 1, "stage": "sentence", "text": "Oibríonn sí in oifig go dtí a cúig.", "senses": {"6":"num"},
          "translation": { "en": "She works in an office until five." },
          "distractors": { "en": ["She works in a shop until five.","She works in an office until six."] } },
        { "id": "ga-a1-gnathla-6-u06", "rev": 1, "stage": "sentence", "text": "Itheann sí a lón ar a haon.", "senses": {"2":"her","5":"num"},
          "translation": { "en": "She eats her lunch at one." },
          "distractors": { "en": ["She eats her breakfast at one.","He eats his lunch at one."] } },
        { "id": "ga-a1-gnathla-6-u07", "rev": 1, "stage": "sentence", "text": "Tagann sí abhaile ar a sé.", "senses": {"4":"num","5":"six"},
          "translation": { "en": "She comes home at six." },
          "distractors": { "en": ["She goes home at six.","She comes home at seven."] } },
        { "id": "ga-a1-gnathla-6-u08", "rev": 1, "stage": "sentence", "text": "Déanann sí an dinnéar, agus féachann sí ar an teilifís.",
          "translation": { "en": "She makes dinner, and she watches TV." },
          "distractors": { "en": ["She eats dinner, and she watches TV.","She makes dinner, and she listens to the radio."] } },
        { "id": "ga-a1-gnathla-6-u09", "rev": 1, "stage": "sentence", "text": "Téann sí a chodladh ar a haon déag.", "senses": {"2":"to","5":"num"},
          "translation": { "en": "She goes to bed at eleven." },
          "distractors": { "en": ["She gets up at eleven.","She goes to bed at twelve."] } },
        { "id": "ga-a1-gnathla-6-u10", "rev": 1, "stage": "word", "text": "sásta",
          "translation": { "en": "happy, content" },
          "distractors": { "en": ["tired","busy"] } },
        { "id": "ga-a1-gnathla-6-u11", "rev": 1, "stage": "sentence", "text": "Bíonn sí tuirseach, ach bíonn sí sásta.",
          "translation": { "en": "She's usually tired, but she's happy." },
          "distractors": { "en": ["She's usually happy, but she's tired.","He's usually tired, but he's happy."] } }
      ]
    }
  ]
