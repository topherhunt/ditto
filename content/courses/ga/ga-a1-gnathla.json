    "tráthnóna": { "lemma": "tráthnóna", "pos": "NOUN", "gloss": { "en": "evening, afternoon; as an adverb: in the evening" } },
    "tagaim": { "lemma": "tar", "pos": "VERB", "gloss": { "en": "I come" } },
    "féachaim": { "lemma": "féach", "pos": "VERB", "gloss": { "en": "I look; féachaim ar = I watch" } },
    "teilifís": { "lemma": "teilifís", "pos": "NOUN", "gloss": { "en": "television (feminine)" } },
    "dinnéir": { "lemma": "dinnéar", "pos": "NOUN", "gloss": { "en": "of dinner (dinnéar in the genitive): tar éis an dinnéir = after dinner" } },
