    "m'fhiacla": { "lemma": "fiacail", "pos": "NOUN", "gloss": { "en": "my teeth (mo + fiacla, lenited: m'fhiacla)" } },
    "seomra": { "lemma": "seomra", "pos": "NOUN", "gloss": { "en": "room (masculine); seomra folctha = bathroom" } },
    "folctha": { "lemma": "folcadh", "pos": "NOUN", "gloss": { "en": "of bathing (folcadh in the genitive): seomra folctha = bathroom" } },
