    "dinnéar": { "lemma": "dinnéar", "pos": "NOUN", "gloss": { "en": "dinner (masculine)" } },
    "ithimid": { "lemma": "ith", "pos": "VERB", "gloss": { "en": "we eat" } },
    "blasta": { "lemma": "blasta", "pos": "ADJ", "gloss": { "en": "tasty" } },
    "bíonn": { "lemma": "bí", "pos": "VERB", "gloss": { "en": "is (usually, as a habit)" } },
