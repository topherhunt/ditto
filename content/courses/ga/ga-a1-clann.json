{
  "id": "ga-a1-clann",
  "language": "ga",
  "level": "A1",
  "order": 4,
  "title": "An Chlann",
  "description": { "en": "Talk about your family: parents, brothers and sisters, children, and what people look like" },
  "track": "main",
  "requires": ["ga-a1-uimhreacha"],
  "introduces": ["máthair","athair","clann","mac","iníon","triúr","ceathrar","páiste","teach","ár","siad","mór","bhur","baile","ard","beag","sean","seanmháthair","gruaig","fionn","súil","gorm","cuma","ochtó","seanathair","aintín","uncail","seisear"],
  "lexicon": {
    "máthair": { "lemma": "máthair", "pos": "NOUN", "gloss": { "en": "mother (feminine)" } },
    "mháthair": { "lemma": "máthair", "pos": "NOUN", "gloss": { "en": "mother (máthair, lenited after mo, do, or a = his)" } },
    "athair": { "lemma": "athair", "pos": "NOUN", "gloss": { "en": "father (masculine)" } },
    "m'athair": { "lemma": "athair", "pos": "NOUN", "gloss": { "en": "my father (mo becomes m' before a vowel)" } },
    "clann": { "lemma": "clann", "pos": "NOUN", "gloss": { "en": "family, children (feminine)" } },
    "chlann": { "lemma": "clann", "pos": "NOUN", "gloss": { "en": "family (clann, lenited after mo or sa)" } },
    "mac": { "lemma": "mac", "pos": "NOUN", "gloss": { "en": "son (masculine); mac léinn = student" } },
    "mhac": { "lemma": "mac", "pos": "NOUN", "gloss": { "en": "son (mac, lenited after mo, a = his, or beirt)" } },
    "iníon": { "lemma": "iníon", "pos": "NOUN", "gloss": { "en": "daughter (feminine)" } },
    "m'iníon": { "lemma": "iníon", "pos": "NOUN", "gloss": { "en": "my daughter (mo becomes m' before a vowel)" } },
    "beirt": { "lemma": "beirt", "pos": "NOUN", "gloss": { "en": "two (people): tá beirt againn = there are two of us" } },
    "aici": { "lemma": "ag", "pos": "ADP", "gloss": { "en": "at her (ag + í); tá súile gorma aici = she has blue eyes" } },
    "triúr": { "lemma": "triúr", "pos": "NOUN", "gloss": { "en": "three (people)" } },
    "ceathrar": { "lemma": "ceathrar", "pos": "NOUN", "gloss": { "en": "four (people)" } },
    "againn": { "lemma": "ag", "pos": "ADP", "gloss": { "en": "at us (ag + sinn); níl páistí againn = we don't have children" } },
    "páistí": { "lemma": "páiste", "pos": "NOUN", "gloss": { "en": "children (páiste = child)" } },
    "a#his": { "lemma": "a", "pos": "DET", "gloss": { "en": "his; lenites: a mháthair = his mother" } },
    "a#her": { "lemma": "a", "pos": "DET", "gloss": { "en": "her; no lenition, h before a vowel: a máthair, a hathair = her mother, her father" } },
    "hathair": { "lemma": "athair", "pos": "NOUN", "gloss": { "en": "father (athair, with h after a = her)" } },
    "hiníon": { "lemma": "iníon", "pos": "NOUN", "gloss": { "en": "daughter (iníon, with h after a = her)" } },
    "dá": { "lemma": "do", "pos": "ADP", "gloss": { "en": "to his, to her (do + a): cad is ainm dá mháthair? = what's his mother's name?" } },
    "nóra": { "lemma": "Nóra", "pos": "PROPN", "gloss": { "en": "Nóra (a woman's name)" } },
    "teach": { "lemma": "teach", "pos": "NOUN", "gloss": { "en": "house (masculine)" } },
    "ár": { "lemma": "ár", "pos": "DET", "gloss": { "en": "our; eclipses: ár dteach, ár n-athair" } },
    "dteach": { "lemma": "teach", "pos": "NOUN", "gloss": { "en": "house (teach, eclipsed after ár, a = their, bhur)" } },
    "n-athair": { "lemma": "athair", "pos": "NOUN", "gloss": { "en": "father (athair, with n- after ár or a = their)" } },
    "siad": { "lemma": "siad", "pos": "PRON", "gloss": { "en": "they" } },
    "gcónaí": { "lemma": "cónaí", "pos": "NOUN", "gloss": { "en": "dwelling (cónaí, eclipsed after ina = in their): tá siad ina gcónaí = they live" } },
    "a#their": { "lemma": "a", "pos": "DET", "gloss": { "en": "their; eclipses: a dteach = their house" } },
    "an-mhór": { "lemma": "mór", "pos": "ADJ", "gloss": { "en": "very big (an- lenites: an-mhór)" } },
    "bhur": { "lemma": "bhur", "pos": "DET", "gloss": { "en": "your (to several people); eclipses: bhur dteach" } },
    "bhaile": { "lemma": "baile", "pos": "NOUN", "gloss": { "en": "home, town (baile, lenited after sa): sa bhaile = at home" } },
    "ard": { "lemma": "ard", "pos": "ADJ", "gloss": { "en": "tall, high" } },
    "beag": { "lemma": "beag", "pos": "ADJ", "gloss": { "en": "small, little" } },
    "sean": { "lemma": "sean", "pos": "ADJ", "gloss": { "en": "old" } },
    "sheanmháthair": { "lemma": "seanmháthair", "pos": "NOUN", "gloss": { "en": "grandmother (seanmháthair, lenited after mo)" } },
    "gruaig": { "lemma": "gruaig", "pos": "NOUN", "gloss": { "en": "hair (feminine)" } },
    "dhubh": { "lemma": "dubh", "pos": "ADJ", "gloss": { "en": "black (dubh, lenited after a feminine noun: gruaig dhubh)" } },
    "dhonn": { "lemma": "donn", "pos": "ADJ", "gloss": { "en": "brown (donn, lenited after a feminine noun: gruaig dhonn)" } },
    "fhionn": { "lemma": "fionn", "pos": "ADJ", "gloss": { "en": "fair, blond (fionn, lenited after a feminine noun: gruaig fhionn)" } },
    "súile": { "lemma": "súil", "pos": "NOUN", "gloss": { "en": "eyes (súil = eye)" } },
    "gorma": { "lemma": "gorm", "pos": "ADJ", "gloss": { "en": "blue (plural form, after a plural noun: súile gorma)" } },
    "donna": { "lemma": "donn", "pos": "ADJ", "gloss": { "en": "brown (plural form, after a plural noun: súile donna)" } },
    "ag": { "lemma": "ag", "pos": "ADP", "gloss": { "en": "at; tá deartháir ag Liam = Liam has a brother" } },
    "chuma": { "lemma": "cuma", "pos": "NOUN", "gloss": { "en": "look, appearance (cuma, feminine, lenited after cén): cén chuma atá air? = what does he look like?" } },
    "seanmháthair": { "lemma": "seanmháthair", "pos": "NOUN", "gloss": { "en": "grandmother (feminine)" } },
    "ochtó": { "lemma": "ochtó", "pos": "NUM", "gloss": { "en": "eighty" } },
    "seanathair": { "lemma": "seanathair", "pos": "NOUN", "gloss": { "en": "grandfather (masculine)" } },
    "sheanathair": { "lemma": "seanathair", "pos": "NOUN", "gloss": { "en": "grandfather (seanathair, lenited after mo)" } },
    "aintín": { "lemma": "aintín", "pos": "NOUN", "gloss": { "en": "aunt (feminine)" } },
    "m'aintín": { "lemma": "aintín", "pos": "NOUN", "gloss": { "en": "my aunt (mo becomes m' before a vowel)" } },
    "uncail": { "lemma": "uncail", "pos": "NOUN", "gloss": { "en": "uncle (masculine)" } },
    "m'uncail": { "lemma": "uncail", "pos": "NOUN", "gloss": { "en": "my uncle (mo becomes m' before a vowel)" } },
    "mhór": { "lemma": "mór", "pos": "ADJ", "gloss": { "en": "big (mór, lenited after a feminine noun: clann mhór)" } },
    "seisear": { "lemma": "seisear", "pos": "NOUN", "gloss": { "en": "six people" } }
  },
  "lessons": [
    {
      "id": "ga-a1-clann-1",
      "title": "Mo chlann",
      "grammarFocus": { "en": ["mo lenites a consonant: máthair, mo mháthair","before a vowel mo becomes m': athair, m'athair"] },
      "units": [
        { "id": "ga-a1-clann-1-u01", "rev": 1, "stage": "word", "text": "máthair",
          "translation": { "en": "mother" },
          "distractors": { "en": ["father","sister"] } },
        { "id": "ga-a1-clann-1-u02", "rev": 1, "stage": "phrase", "text": "mo mháthair",
          "translation": { "en": "my mother" },
          "distractors": { "en": ["my father","your mother"] } },
        { "id": "ga-a1-clann-1-u03", "rev": 1, "stage": "sentence", "text": "Seo í mo mháthair.",
          "translation": { "en": "This is my mother." },
          "distractors": { "en": ["This is my father.","Is this my mother?"] } },
        { "id": "ga-a1-clann-1-u04", "rev": 1, "stage": "word", "text": "athair",
          "translation": { "en": "father" },
          "distractors": { "en": ["mother","brother"] } },
        { "id": "ga-a1-clann-1-u05", "rev": 1, "stage": "phrase", "text": "m'athair",
          "translation": { "en": "my father" },
          "distractors": { "en": ["my mother","your father"] } },
        { "id": "ga-a1-clann-1-u06", "rev": 1, "stage": "sentence", "text": "Seo é m'athair, Seán.",
          "translation": { "en": "This is my father, Seán." },
          "distractors": { "en": ["This is my brother, Seán.","This is my mother, Seán."] } },
        { "id": "ga-a1-clann-1-u07", "rev": 1, "stage": "word", "text": "clann",
          "translation": { "en": "family (your children and parents)" },
          "distractors": { "en": ["friends","parents"] } },
        { "id": "ga-a1-clann-1-u08", "rev": 1, "stage": "phrase", "text": "mo chlann",
          "translation": { "en": "my family" },
          "distractors": { "en": ["your family","my friends"] } },
        { "id": "ga-a1-clann-1-u09", "rev": 1, "stage": "sentence", "text": "Is as Corcaigh mo chlann.",
          "translation": { "en": "My family is from Cork." },
          "distractors": { "en": ["My family lives in Cork.","My friends are from Cork."] } },
        { "id": "ga-a1-clann-1-u10", "rev": 1, "stage": "word", "text": "mac",
          "translation": { "en": "son" },
          "distractors": { "en": ["daughter","brother"] } },
        { "id": "ga-a1-clann-1-u11", "rev": 1, "stage": "phrase", "text": "mo mhac",
          "translation": { "en": "my son" },
          "distractors": { "en": ["my daughter","your son"] } },
        { "id": "ga-a1-clann-1-u12", "rev": 1, "stage": "sentence", "text": "Seo é mo mhac, Liam.",
          "translation": { "en": "This is my son, Liam." },
          "distractors": { "en": ["This is my brother, Liam.","This is my daughter, Liam."] } },
        { "id": "ga-a1-clann-1-u13", "rev": 1, "stage": "word", "text": "iníon",
          "translation": { "en": "daughter" },
          "distractors": { "en": ["son","sister"] } },
        { "id": "ga-a1-clann-1-u14", "rev": 1, "stage": "phrase", "text": "m'iníon",
          "translation": { "en": "my daughter" },
          "distractors": { "en": ["my son","your daughter"] } },
        { "id": "ga-a1-clann-1-u15", "rev": 1, "stage": "sentence", "text": "Seo í m'iníon, Áine.",
          "translation": { "en": "This is my daughter, Áine." },
          "distractors": { "en": ["This is my sister, Áine.","This is my son, Áine."] } },
        { "id": "ga-a1-clann-1-u16", "rev": 1, "stage": "phrase", "text": "do mháthair",
          "translation": { "en": "your mother" },
          "distractors": { "en": ["my mother","your father"] } },
        { "id": "ga-a1-clann-1-u17", "rev": 1, "stage": "sentence", "text": "Cá bhfuil do mháthair ina cónaí?",
          "translation": { "en": "Where does your mother live?" },
          "distractors": { "en": ["Where does your father live?","Where is your mother from?"] } },
        { "id": "ga-a1-clann-1-u18", "rev": 1, "stage": "sentence", "text": "Tá m'athair ina chónaí i gCorcaigh.",
          "translation": { "en": "My father lives in Cork." },
          "distractors": { "en": ["My mother lives in Cork.","My father is from Cork."] } }
      ]
    },
    {
      "id": "ga-a1-clann-2",
      "title": "Cé mhéad deartháir atá agat?",
      "grammarFocus": { "en": ["brothers and sisters are something you have: tá deartháir agam = I have a brother","people are counted with beirt (2), triúr (3), ceathrar (4): cé mhéad deartháir atá agat? Beirt. = how many brothers do you have? Two."] },
      "units": [
        { "id": "ga-a1-clann-2-u01", "rev": 1, "stage": "sentence", "text": "An bhfuil deartháir agat?", "senses": {"0":"q"},
          "translation": { "en": "Do you have a brother?" },
          "distractors": { "en": ["Do you have a sister?","Is your brother here?"] } },
        { "id": "ga-a1-clann-2-u02", "rev": 1, "stage": "sentence", "text": "Tá deartháir amháin agam.",
          "translation": { "en": "I have one brother." },
          "distractors": { "en": ["I have two brothers.","I have one sister."] } },
        { "id": "ga-a1-clann-2-u03", "rev": 2, "stage": "sentence", "text": "Tá deirfiúr amháin agam freisin.",
          "translation": { "en": "I also have one sister." },
          "distractors": { "en": ["I also have two sisters.","I also have one brother."] } },
        { "id": "ga-a1-clann-2-u04", "rev": 2, "stage": "sentence", "text": "Cé mhéad deartháir atá agat?",
          "translation": { "en": "How many brothers do you have?" },
          "distractors": { "en": ["How many sisters do you have?","How old is your brother?"] } },
        { "id": "ga-a1-clann-2-u05", "rev": 2, "stage": "word", "text": "beirt",
          "translation": { "en": "two (people)" },
          "distractors": { "en": ["three (people)","two (things)"] } },
        { "id": "ga-a1-clann-2-u06", "rev": 2, "stage": "sentence", "text": "Beirt, Seán agus Liam.",
          "translation": { "en": "Two, Seán and Liam." },
          "distractors": { "en": ["Three, Seán and Liam.","Two, Seán and Máire."] } },
        { "id": "ga-a1-clann-2-u07", "rev": 2, "stage": "sentence", "text": "Cé mhéad deirfiúr atá aici?",
          "translation": { "en": "How many sisters does she have?" },
          "distractors": { "en": ["How many sisters does he have?","How many brothers does she have?"] } },
        { "id": "ga-a1-clann-2-u08", "rev": 2, "stage": "word", "text": "triúr",
          "translation": { "en": "three (people)" },
          "distractors": { "en": ["two (people)","four (people)"] } },
        { "id": "ga-a1-clann-2-u09", "rev": 2, "stage": "sentence", "text": "Triúr, agus deartháir amháin.",
          "translation": { "en": "Three, and one brother." },
          "distractors": { "en": ["Two, and one brother.","Three, and one sister."] } },
        { "id": "ga-a1-clann-2-u10", "rev": 2, "stage": "word", "text": "ceathrar",
          "translation": { "en": "four (people)" },
          "distractors": { "en": ["three (people)","five (people)"] } },
        { "id": "ga-a1-clann-2-u11", "rev": 2, "stage": "sentence", "text": "Tá ceathrar againn sa chlann.",
          "translation": { "en": "There are four of us in the family." },
          "distractors": { "en": ["There are three of us in the family.","There are four of them in the family."] } },
        { "id": "ga-a1-clann-2-u12", "rev": 2, "stage": "sentence", "text": "Níl deartháir ná deirfiúr agam.",
          "translation": { "en": "I don't have a brother or a sister." },
          "distractors": { "en": ["I have a brother and a sister.","I don't have a brother, but I have a sister."] } },
        { "id": "ga-a1-clann-2-u13", "rev": 1, "stage": "word", "text": "páistí",
          "translation": { "en": "children" },
          "distractors": { "en": ["parents","sisters"] } },
        { "id": "ga-a1-clann-2-u14", "rev": 1, "stage": "sentence", "text": "An bhfuil páistí agat?", "senses": {"0":"q"},
          "translation": { "en": "Do you have children?" },
          "distractors": { "en": ["Do you have parents?","Do they have children?"] } },
        { "id": "ga-a1-clann-2-u15", "rev": 1, "stage": "sentence", "text": "Tá, beirt mhac agus iníon amháin.",
          "translation": { "en": "Yes, two sons and one daughter." },
          "distractors": { "en": ["Yes, two daughters and one son.","Yes, three sons and one daughter."] } },
        { "id": "ga-a1-clann-2-u16", "rev": 1, "stage": "sentence", "text": "Níl páistí againn.",
          "translation": { "en": "We don't have children." },
          "distractors": { "en": ["We have children.","They don't have children."] } }
      ]
    },
    {
      "id": "ga-a1-clann-3",
      "title": "A mháthair agus a máthair",
      "grammarFocus": { "en": ["a means his, her or their; the mutation tells you which","a (his) lenites: a mháthair = his mother","a (her) doesn't, and puts h before a vowel: a máthair, a hathair = her mother, her father"] },
      "units": [
        { "id": "ga-a1-clann-3-u01", "rev": 1, "stage": "phrase", "text": "a mháthair", "senses": {"0":"his"},
          "translation": { "en": "his mother" },
          "distractors": { "en": ["her mother","my mother"] } },
        { "id": "ga-a1-clann-3-u02", "rev": 1, "stage": "phrase", "text": "a máthair", "senses": {"0":"her"},
          "translation": { "en": "her mother" },
          "distractors": { "en": ["his mother","your mother"] } },
        { "id": "ga-a1-clann-3-u03", "rev": 1, "stage": "sentence", "text": "Seo é Liam agus a mháthair.", "senses": {"4":"his"},
          "translation": { "en": "This is Liam and his mother." },
          "distractors": { "en": ["This is Liam and her mother.","This is Liam and my mother."] } },
        { "id": "ga-a1-clann-3-u04", "rev": 1, "stage": "sentence", "text": "Seo í Áine agus a máthair.", "senses": {"4":"her"},
          "translation": { "en": "This is Áine and her mother." },
          "distractors": { "en": ["This is Áine and his mother.","This is Áine and her father."] } },
        { "id": "ga-a1-clann-3-u05", "rev": 1, "stage": "phrase", "text": "a athair", "senses": {"0":"his"},
          "translation": { "en": "his father" },
          "distractors": { "en": ["her father","his mother"] } },
        { "id": "ga-a1-clann-3-u06", "rev": 1, "stage": "phrase", "text": "a hathair", "senses": {"0":"her"},
          "translation": { "en": "her father" },
          "distractors": { "en": ["his father","her mother"] } },
        { "id": "ga-a1-clann-3-u07", "rev": 1, "stage": "sentence", "text": "Tá a hathair ina chónaí i nGaillimh.", "senses": {"1":"her"},
          "translation": { "en": "Her father lives in Galway." },
          "distractors": { "en": ["His father lives in Galway.","Her mother lives in Galway."] } },
        { "id": "ga-a1-clann-3-u08", "rev": 1, "stage": "sentence", "text": "Tá a athair ina chónaí i gCorcaigh.", "senses": {"1":"his"},
          "translation": { "en": "His father lives in Cork." },
          "distractors": { "en": ["Her father lives in Cork.","His father is from Cork."] } },
        { "id": "ga-a1-clann-3-u09", "rev": 1, "stage": "phrase", "text": "a mhac", "senses": {"0":"his"},
          "translation": { "en": "his son" },
          "distractors": { "en": ["her son","his daughter"] } },
        { "id": "ga-a1-clann-3-u10", "rev": 1, "stage": "sentence", "text": "Tá a mhac seacht mbliana d'aois.", "variants": ["Tá a mhac 7 mbliana d'aois."], "senses": {"1":"his"},
          "translation": { "en": "His son is seven years old." },
          "distractors": { "en": ["Her son is seven years old.","His daughter is seven years old."] } },
        { "id": "ga-a1-clann-3-u11", "rev": 1, "stage": "phrase", "text": "a hiníon", "senses": {"0":"her"},
          "translation": { "en": "her daughter" },
          "distractors": { "en": ["his daughter","her son"] } },
        { "id": "ga-a1-clann-3-u12", "rev": 1, "stage": "sentence", "text": "Tá a hiníon fiche bliain d'aois.", "variants": ["Tá a hiníon 20 bliain d'aois."], "senses": {"1":"her"},
          "translation": { "en": "Her daughter is twenty years old." },
          "distractors": { "en": ["His daughter is twenty years old.","Her son is twenty years old."] } },
        { "id": "ga-a1-clann-3-u13", "rev": 1, "stage": "sentence", "text": "Cad is ainm dá mháthair?",
          "translation": { "en": "What's his mother's name?" },
          "distractors": { "en": ["What's her mother's name?","What's your mother's name?"] } },
        { "id": "ga-a1-clann-3-u14", "rev": 1, "stage": "sentence", "text": "Nóra is ainm dá máthair.",
          "translation": { "en": "Her mother's name is Nóra." },
          "distractors": { "en": ["His mother's name is Nóra.","My mother's name is Nóra."] } }
      ]
    },
    {
      "id": "ga-a1-clann-4",
      "title": "Ár dteach",
      "grammarFocus": { "en": ["ár (our), bhur (your, to several people) and a (their) eclipse: teach, ár dteach","before a vowel they add n-: ár n-athair"] },
      "units": [
        { "id": "ga-a1-clann-4-u01", "rev": 1, "stage": "word", "text": "teach",
          "translation": { "en": "house" },
          "distractors": { "en": ["family","school"] } },
        { "id": "ga-a1-clann-4-u02", "rev": 1, "stage": "phrase", "text": "ár dteach",
          "translation": { "en": "our house" },
          "distractors": { "en": ["your house","their house"] } },
        { "id": "ga-a1-clann-4-u03", "rev": 1, "stage": "sentence", "text": "Seo é ár dteach.",
          "translation": { "en": "This is our house." },
          "distractors": { "en": ["This is their house.","This is my house."] } },
        { "id": "ga-a1-clann-4-u04", "rev": 1, "stage": "phrase", "text": "ár n-athair",
          "translation": { "en": "our father" },
          "distractors": { "en": ["our mother","their father"] } },
        { "id": "ga-a1-clann-4-u05", "rev": 1, "stage": "sentence", "text": "Tá ár n-athair sa teach.",
          "translation": { "en": "Our father is in the house." },
          "distractors": { "en": ["Our mother is in the house.","Their father is in the house."] } },
