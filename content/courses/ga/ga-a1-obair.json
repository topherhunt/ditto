    "ea": { "lemma": "ea", "pos": "PRON", "gloss": { "en": "it; is ea = yes (to an is question)" } },
    "léinn": { "lemma": "léann", "pos": "NOUN", "gloss": { "en": "learning (léann in the genitive): mac léinn = student" } },
    "cócaire": { "lemma": "cócaire", "pos": "NOUN", "gloss": { "en": "cook, chef (masculine)" } },
    "feirmeoir": { "lemma": "feirmeoir", "pos": "NOUN", "gloss": { "en": "farmer (masculine)" } },
    "post": { "lemma": "post", "pos": "NOUN", "gloss": { "en": "job, post (masculine)" } },
    "obair": { "lemma": "obair", "pos": "NOUN", "gloss": { "en": "work (feminine); ag obair = working" } },
    "siopa": { "lemma": "siopa", "pos": "NOUN", "gloss": { "en": "shop (masculine)" } },
    "oifig": { "lemma": "oifig", "pos": "NOUN", "gloss": { "en": "office (feminine)" } },
