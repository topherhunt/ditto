    "san": { "lemma": "i", "pos": "ADP", "gloss": { "en": "in the (i + an, before a vowel): san ospidéal" } },
    "bialann": { "lemma": "bialann", "pos": "NOUN", "gloss": { "en": "restaurant (feminine)" } },
    "mbialann": { "lemma": "bialann", "pos": "NOUN", "gloss": { "en": "restaurant (bialann, eclipsed after i)" } },
    "scoil": { "lemma": "scoil", "pos": "NOUN", "gloss": { "en": "school (feminine)" } },
    "crua": { "lemma": "crua", "pos": "ADJ", "gloss": { "en": "hard; go crua = hard (adverb)" } },
    "gnóthach": { "lemma": "gnóthach", "pos": "ADJ", "gloss": { "en": "busy" } },
    "an-ghnóthach": { "lemma": "gnóthach", "pos": "ADJ", "gloss": { "en": "very busy (an- lenites: an-ghnóthach)" } },
    "foghlaim": { "lemma": "foghlaim", "pos": "VERB", "gloss": { "en": "learning, to learn (verbal noun)" } },
    "staidéar": { "lemma": "staidéar", "pos": "NOUN", "gloss": { "en": "study; ag staidéar = studying" } },
    "ollscoil": { "lemma": "ollscoil", "pos": "NOUN", "gloss": { "en": "university (feminine)" } },
    "múineadh": { "lemma": "múin", "pos": "VERB", "gloss": { "en": "teaching, to teach (verbal noun of múin)" } },
    "rang": { "lemma": "rang", "pos": "NOUN", "gloss": { "en": "class (masculine)" } },
    "duine": { "lemma": "duine", "pos": "NOUN", "gloss": { "en": "person (masculine); fiche duine = twenty people" } },
    "leabhar": { "lemma": "leabhar", "pos": "NOUN", "gloss": { "en": "book (masculine)" } },
    "foclóir": { "lemma": "foclóir", "pos": "NOUN", "gloss": { "en": "dictionary (masculine)" } },
    "deacair": { "lemma": "deacair", "pos": "ADJ", "gloss": { "en": "difficult" } },
    "ghaeilge": { "lemma": "Gaeilge", "pos": "NOUN", "gloss": { "en": "Irish (Gaeilge, lenited after an): an Ghaeilge" } },
    "éasca": { "lemma": "éasca", "pos": "ADJ", "gloss": { "en": "easy" } },
    "a#rel": { "lemma": "a", "pos": "PART", "gloss": { "en": "that, which (links a question word to its verb; lenites): cad a dhéanann tú?" } },
    "dhéanann": { "lemma": "déan", "pos": "VERB", "gloss": { "en": "do, does, make (déanann, lenited after a)" } },
    "oibrím": { "lemma": "oibrigh", "pos": "VERB", "gloss": { "en": "I work" } },
    "banc": { "lemma": "banc", "pos": "NOUN", "gloss": { "en": "bank (masculine)" } },
    "mbanc": { "lemma": "banc", "pos": "NOUN", "gloss": { "en": "bank (banc, eclipsed after i)" } },
    "oibríonn": { "lemma": "oibrigh", "pos": "VERB", "gloss": { "en": "works (he, she, they, you)" } },
    "múinim": { "lemma": "múin", "pos": "VERB", "gloss": { "en": "I teach" } },
    "gach": { "lemma": "gach", "pos": "DET", "gloss": { "en": "every, each" } },
    "ó": { "lemma": "ó", "pos": "ADP", "gloss": { "en": "from: ó Luan go hAoine = Monday to Friday" } },
    "múineann": { "lemma": "múin", "pos": "VERB", "gloss": { "en": "teaches (he, she, they, you)" } },
    "phost": { "lemma": "post", "pos": "NOUN", "gloss": { "en": "job (post, lenited after mo or do)" } },
    "suimiúil": { "lemma": "suimiúil", "pos": "ADJ", "gloss": { "en": "interesting" } },
    "leadránach": { "lemma": "leadránach", "pos": "ADJ", "gloss": { "en": "boring" } },
    "saoiste": { "lemma": "saoiste", "pos": "NOUN", "gloss": { "en": "boss (masculine)" } },
    "shaoiste": { "lemma": "saoiste", "pos": "NOUN", "gloss": { "en": "boss (saoiste, lenited after mo)" } },
    "an-deas": { "lemma": "deas", "pos": "ADJ", "gloss": { "en": "very nice (an- lenites, but not d: an-deas)" } },
    "pá": { "lemma": "pá", "pos": "NOUN", "gloss": { "en": "pay, wages (masculine)" } },
    "chuid": { "lemma": "cuid", "pos": "NOUN", "gloss": { "en": "share, part (cuid, lenited after do): do chuid Gaeilge = your Irish" } }
  },
  "lessons": [
    {
      "id": "ga-a1-obair-1",
      "title": "Is múinteoir mé",
      "grammarFocus": { "en": ["say what someone is with is: is múinteoir mé = I'm a teacher","ní ... = isn't: ní altra í","answer an ...? with is ea (yes) or ní hea (no)"] },
      "units": [
        { "id": "ga-a1-obair-1-u01", "rev": 1, "stage": "word", "text": "múinteoir",
          "translation": { "en": "teacher" },
          "distractors": { "en": ["doctor","student"] } },
        { "id": "ga-a1-obair-1-u02", "rev": 1, "stage": "sentence", "text": "Is múinteoir mé.",
          "translation": { "en": "I'm a teacher." },
          "distractors": { "en": ["I'm a doctor.","You're a teacher."] } },
        { "id": "ga-a1-obair-1-u03", "rev": 1, "stage": "word", "text": "dochtúir",
          "translation": { "en": "doctor" },
          "distractors": { "en": ["nurse","teacher"] } },
        { "id": "ga-a1-obair-1-u04", "rev": 1, "stage": "sentence", "text": "Is dochtúir í Áine.",
          "translation": { "en": "Áine is a doctor." },
          "distractors": { "en": ["Áine is a nurse.","Áine isn't a doctor."] } },
        { "id": "ga-a1-obair-1-u05", "rev": 1, "stage": "word", "text": "altra",
          "translation": { "en": "nurse" },
          "distractors": { "en": ["doctor","cook"] } },
        { "id": "ga-a1-obair-1-u06", "rev": 1, "stage": "sentence", "text": "Is altra é Seán.",
          "translation": { "en": "Seán is a nurse." },
          "distractors": { "en": ["Seán is a doctor.","Seán isn't a nurse."] } },
        { "id": "ga-a1-obair-1-u07", "rev": 1, "stage": "word", "text": "innealtóir",
          "translation": { "en": "engineer" },
          "distractors": { "en": ["farmer","teacher"] } },
        { "id": "ga-a1-obair-1-u08", "rev": 1, "stage": "sentence", "text": "An innealtóir thú?", "senses": {"0":"q"},
          "translation": { "en": "Are you an engineer?" },
          "distractors": { "en": ["Is he an engineer?","Are you a farmer?"] } },
        { "id": "ga-a1-obair-1-u09", "rev": 1, "stage": "sentence", "text": "Ní hea, is múinteoir mé.",
          "translation": { "en": "No, I'm a teacher." },
          "distractors": { "en": ["Yes, I'm a teacher.","No, I'm a doctor."] } },
        { "id": "ga-a1-obair-1-u10", "rev": 1, "stage": "sentence", "text": "Is ea, is innealtóir mé.",
          "translation": { "en": "Yes, I'm an engineer." },
          "distractors": { "en": ["No, I'm an engineer.","Yes, I'm a farmer."] } },
        { "id": "ga-a1-obair-1-u11", "rev": 1, "stage": "phrase", "text": "mac léinn",
          "translation": { "en": "student" },
          "distractors": { "en": ["teacher","school"] } },
        { "id": "ga-a1-obair-1-u12", "rev": 1, "stage": "sentence", "text": "Is mac léinn mé.",
          "translation": { "en": "I'm a student." },
          "distractors": { "en": ["I'm a teacher.","She's a student."] } },
        { "id": "ga-a1-obair-1-u13", "rev": 1, "stage": "word", "text": "cócaire",
          "translation": { "en": "cook, chef" },
          "distractors": { "en": ["doctor","farmer"] } },
        { "id": "ga-a1-obair-1-u14", "rev": 1, "stage": "sentence", "text": "Is cócaire é m'athair.",
          "translation": { "en": "My father is a cook." },
          "distractors": { "en": ["My mother is a cook.","My father is a farmer."] } },
        { "id": "ga-a1-obair-1-u15", "rev": 1, "stage": "word", "text": "feirmeoir",
          "translation": { "en": "farmer" },
          "distractors": { "en": ["engineer","nurse"] } },
        { "id": "ga-a1-obair-1-u16", "rev": 1, "stage": "sentence", "text": "Is feirmeoir é a athair.", "senses": {"3":"his"},
          "translation": { "en": "His father is a farmer." },
          "distractors": { "en": ["Her father is a farmer.","His father is a cook."] } },
        { "id": "ga-a1-obair-1-u17", "rev": 1, "stage": "sentence", "text": "Ní altra í, is dochtúir í.",
          "translation": { "en": "She's not a nurse, she's a doctor." },
          "distractors": { "en": ["She's a nurse, not a doctor.","He's not a nurse, he's a doctor."] } },
        { "id": "ga-a1-obair-1-u18", "rev": 1, "stage": "word", "text": "post",
          "translation": { "en": "job" },
          "distractors": { "en": ["work","office"] } },
        { "id": "ga-a1-obair-1-u19", "rev": 1, "stage": "sentence", "text": "Cén post atá agat?",
          "translation": { "en": "What's your job?" },
          "distractors": { "en": ["Where's your job?","Do you have a job?"] } }
      ]
    },
    {
      "id": "ga-a1-obair-2",
      "title": "Tá mé ag obair",
      "grammarFocus": { "en": ["tá mé ag + verbal noun = I'm ...ing: tá mé ag obair = I'm working, I work","i eclipses: bialann, i mbialann; san before a vowel = in the: san ospidéal"] },
      "units": [
        { "id": "ga-a1-obair-2-u01", "rev": 1, "stage": "word", "text": "obair",
          "translation": { "en": "work" },
          "distractors": { "en": ["school","study"] } },
        { "id": "ga-a1-obair-2-u02", "rev": 1, "stage": "phrase", "text": "ag obair",
          "translation": { "en": "working" },
          "distractors": { "en": ["studying","eating"] } },
        { "id": "ga-a1-obair-2-u03", "rev": 1, "stage": "sentence", "text": "Tá mé ag obair anois.",
          "translation": { "en": "I'm working now." },
          "distractors": { "en": ["I'm studying now.","I'm not working now."] } },
        { "id": "ga-a1-obair-2-u04", "rev": 1, "stage": "sentence", "text": "Cá bhfuil tú ag obair?",
          "translation": { "en": "Where do you work?" },
          "distractors": { "en": ["Where do you live?","Where are you studying?"] } },
        { "id": "ga-a1-obair-2-u05", "rev": 1, "stage": "word", "text": "siopa",
          "translation": { "en": "shop" },
          "distractors": { "en": ["office","school"] } },
        { "id": "ga-a1-obair-2-u06", "rev": 1, "stage": "sentence", "text": "Tá mé ag obair i siopa.",
          "translation": { "en": "I work in a shop." },
          "distractors": { "en": ["I work in an office.","I live in a shop."] } },
        { "id": "ga-a1-obair-2-u07", "rev": 1, "stage": "word", "text": "oifig",
          "translation": { "en": "office" },
          "distractors": { "en": ["shop","hospital"] } },
        { "id": "ga-a1-obair-2-u08", "rev": 1, "stage": "sentence", "text": "Tá sí ag obair in oifig.",
          "translation": { "en": "She works in an office." },
          "distractors": { "en": ["He works in an office.","She works in a shop."] } },
        { "id": "ga-a1-obair-2-u09", "rev": 1, "stage": "word", "text": "ospidéal",
          "translation": { "en": "hospital" },
          "distractors": { "en": ["school","hotel"] } },
        { "id": "ga-a1-obair-2-u10", "rev": 1, "stage": "sentence", "text": "Tá m'athair ag obair san ospidéal.",
          "translation": { "en": "My father works in the hospital." },
          "distractors": { "en": ["My mother works in the hospital.","My father works in the school."] } },
        { "id": "ga-a1-obair-2-u11", "rev": 1, "stage": "word", "text": "bialann",
          "translation": { "en": "restaurant" },
          "distractors": { "en": ["café","shop"] } },
        { "id": "ga-a1-obair-2-u12", "rev": 1, "stage": "sentence", "text": "Tá Seán ag obair i mbialann.",
          "translation": { "en": "Seán works in a restaurant." },
          "distractors": { "en": ["Seán works in a café.","Seán eats in a restaurant."] } },
        { "id": "ga-a1-obair-2-u13", "rev": 1, "stage": "word", "text": "scoil",
          "translation": { "en": "school" },
          "distractors": { "en": ["office","university"] } },
        { "id": "ga-a1-obair-2-u14", "rev": 1, "stage": "sentence", "text": "Tá mo mháthair ag obair i scoil.",
          "translation": { "en": "My mother works in a school." },
          "distractors": { "en": ["My father works in a school.","My mother studies in a school."] } },
        { "id": "ga-a1-obair-2-u15", "rev": 1, "stage": "phrase", "text": "go crua",
          "translation": { "en": "hard" },
          "distractors": { "en": ["slowly","well"] } },
        { "id": "ga-a1-obair-2-u16", "rev": 1, "stage": "sentence", "text": "Tá tú ag obair go crua!",
          "translation": { "en": "You're working hard!" },
          "distractors": { "en": ["You're not working hard!","You're working slowly!"] } },
        { "id": "ga-a1-obair-2-u17", "rev": 1, "stage": "sentence", "text": "Tá mé ag obair sa bhaile inniu.",
          "translation": { "en": "I'm working from home today." },
          "distractors": { "en": ["I'm working in the office today.","I'm not working at home today."] } },
        { "id": "ga-a1-obair-2-u18", "rev": 1, "stage": "word", "text": "gnóthach",
          "translation": { "en": "busy" },
          "distractors": { "en": ["tired","free"] } },
        { "id": "ga-a1-obair-2-u19", "rev": 1, "stage": "sentence", "text": "Tá mé an-ghnóthach ag an obair.",
          "translation": { "en": "I'm very busy at work." },
          "distractors": { "en": ["I'm very tired at work.","I'm not busy at work."] } }
      ]
    },
    {
      "id": "ga-a1-obair-3",
      "title": "Ag foghlaim Gaeilge",
      "grammarFocus": { "en": ["the object follows the verbal noun: ag foghlaim Gaeilge = learning Irish","an Ghaeilge = Irish (as a subject); the article lenites it"] },
      "units": [
        { "id": "ga-a1-obair-3-u01", "rev": 1, "stage": "phrase", "text": "ag foghlaim",
          "translation": { "en": "learning" },
          "distractors": { "en": ["teaching","reading"] } },
        { "id": "ga-a1-obair-3-u02", "rev": 1, "stage": "sentence", "text": "Tá mé ag foghlaim Gaeilge.",
          "translation": { "en": "I'm learning Irish." },
          "distractors": { "en": ["I'm teaching Irish.","I'm learning English."] } },
        { "id": "ga-a1-obair-3-u03", "rev": 1, "stage": "phrase", "text": "ag staidéar",
          "translation": { "en": "studying" },
          "distractors": { "en": ["working","teaching"] } },
        { "id": "ga-a1-obair-3-u04", "rev": 1, "stage": "word", "text": "ollscoil",
          "translation": { "en": "university" },
          "distractors": { "en": ["school","library"] } },
        { "id": "ga-a1-obair-3-u05", "rev": 1, "stage": "sentence", "text": "Tá mé ag staidéar san ollscoil.",
          "translation": { "en": "I'm studying at the university." },
          "distractors": { "en": ["I'm working at the university.","I'm studying at the school."] } },
        { "id": "ga-a1-obair-3-u06", "rev": 1, "stage": "sentence", "text": "Tá Liam ag foghlaim Béarla.",
          "translation": { "en": "Liam is learning English." },
          "distractors": { "en": ["Liam is teaching English.","Liam is learning Irish."] } },
        { "id": "ga-a1-obair-3-u07", "rev": 1, "stage": "phrase", "text": "ag múineadh",
          "translation": { "en": "teaching" },
          "distractors": { "en": ["learning","studying"] } },
        { "id": "ga-a1-obair-3-u08", "rev": 1, "stage": "sentence", "text": "Tá mé ag múineadh Gaeilge i scoil.",
          "translation": { "en": "I teach Irish in a school." },
          "distractors": { "en": ["I'm learning Irish in a school.","I teach English in a school."] } },
        { "id": "ga-a1-obair-3-u09", "rev": 1, "stage": "word", "text": "rang",
          "translation": { "en": "class" },
          "distractors": { "en": ["school","teacher"] } },
        { "id": "ga-a1-obair-3-u10", "rev": 1, "stage": "sentence", "text": "Tá fiche duine sa rang.", "variants": ["Tá 20 duine sa rang."],
          "translation": { "en": "There are twenty people in the class." },
          "distractors": { "en": ["There are twelve people in the class.","There are twenty people in the school."] } },
        { "id": "ga-a1-obair-3-u11", "rev": 1, "stage": "word", "text": "leabhar",
          "translation": { "en": "book" },
          "distractors": { "en": ["dictionary","class"] } },
        { "id": "ga-a1-obair-3-u12", "rev": 1, "stage": "sentence", "text": "An bhfuil do leabhar agat?", "senses": {"0":"q"},
          "translation": { "en": "Do you have your book?" },
          "distractors": { "en": ["Do you have my book?","Do you have a dictionary?"] } },
        { "id": "ga-a1-obair-3-u13", "rev": 1, "stage": "word", "text": "foclóir",
          "translation": { "en": "dictionary" },
          "distractors": { "en": ["book","teacher"] } },
        { "id": "ga-a1-obair-3-u14", "rev": 1, "stage": "sentence", "text": "Tá foclóir Gaeilge agam.",
          "translation": { "en": "I have an Irish dictionary." },
          "distractors": { "en": ["I have an Irish book.","I don't have an Irish dictionary."] } },
        { "id": "ga-a1-obair-3-u15", "rev": 1, "stage": "word", "text": "deacair",
          "translation": { "en": "difficult" },
          "distractors": { "en": ["easy","interesting"] } },
        { "id": "ga-a1-obair-3-u16", "rev": 1, "stage": "sentence", "text": "Tá an Ghaeilge deacair!",
          "translation": { "en": "Irish is difficult!" },
          "distractors": { "en": ["Irish is easy!","English is difficult!"] } },
        { "id": "ga-a1-obair-3-u17", "rev": 1, "stage": "word", "text": "éasca",
          "translation": { "en": "easy" },
          "distractors": { "en": ["difficult","boring"] } },
        { "id": "ga-a1-obair-3-u18", "rev": 1, "stage": "sentence", "text": "Níl sé éasca, ach is breá liom é.",
          "translation": { "en": "It's not easy, but I love it." },
          "distractors": { "en": ["It's easy, and I love it.","It's not easy, and I don't like it."] } }
      ]
    },
    {
      "id": "ga-a1-obair-4",
      "title": "Cad a dhéanann tú?",
      "grammarFocus": { "en": ["the present tense is for habits: oibrím = I work, oibríonn sé = he works","a question verb after cad takes a and lenites: cad a dhéanann tú? = what do you do?"] },
      "units": [
        { "id": "ga-a1-obair-4-u01", "rev": 1, "stage": "sentence", "text": "Cad a dhéanann tú?", "senses": {"1":"rel"},
          "translation": { "en": "What do you do?" },
          "distractors": { "en": ["Where do you work?","What are you doing now?"] } },
        { "id": "ga-a1-obair-4-u02", "rev": 1, "stage": "phrase", "text": "oibrím",
          "translation": { "en": "I work" },
          "distractors": { "en": ["you work","I worked"] } },
        { "id": "ga-a1-obair-4-u03", "rev": 1, "stage": "word", "text": "banc",
          "translation": { "en": "bank" },
          "distractors": { "en": ["shop","office"] } },
        { "id": "ga-a1-obair-4-u04", "rev": 1, "stage": "sentence", "text": "Oibrím i mbanc.",
          "translation": { "en": "I work in a bank." },
          "distractors": { "en": ["I work in a shop.","He works in a bank."] } },
        { "id": "ga-a1-obair-4-u05", "rev": 1, "stage": "phrase", "text": "oibríonn sé",
          "translation": { "en": "he works" },
          "distractors": { "en": ["she works","I work"] } },
        { "id": "ga-a1-obair-4-u06", "rev": 1, "stage": "sentence", "text": "Oibríonn sé in oifig i mBaile Átha Cliath.",
          "translation": { "en": "He works in an office in Dublin." },
          "distractors": { "en": ["She works in an office in Dublin.","He works in a shop in Dublin."] } },
        { "id": "ga-a1-obair-4-u07", "rev": 1, "stage": "phrase", "text": "múinim",
          "translation": { "en": "I teach" },
          "distractors": { "en": ["I learn","I work"] } },
        { "id": "ga-a1-obair-4-u08", "rev": 1, "stage": "sentence", "text": "Múinim Gaeilge agus Béarla.",
          "translation": { "en": "I teach Irish and English." },
          "distractors": { "en": ["I learn Irish and English.","I teach Irish and French."] } },
        { "id": "ga-a1-obair-4-u09", "rev": 1, "stage": "sentence", "text": "An oibríonn tú anseo?", "senses": {"0":"q"},
          "translation": { "en": "Do you work here?" },
          "distractors": { "en": ["Do you live here?","Does she work here?"] } },
        { "id": "ga-a1-obair-4-u10", "rev": 1, "stage": "sentence", "text": "Oibrím.",
          "translation": { "en": "Yes, I do." },
          "distractors": { "en": ["No, I don't.","Yes, she does."] } },
        { "id": "ga-a1-obair-4-u11", "rev": 1, "stage": "sentence", "text": "Ní oibrím, tá mé ag staidéar.",
          "translation": { "en": "No, I'm studying." },
          "distractors": { "en": ["Yes, I'm studying.","No, I'm working."] } },
        { "id": "ga-a1-obair-4-u12", "rev": 1, "stage": "phrase", "text": "gach lá",
          "translation": { "en": "every day" },
          "distractors": { "en": ["every week","today"] } },
        { "id": "ga-a1-obair-4-u13", "rev": 1, "stage": "sentence", "text": "Oibrím gach lá ach Dé Domhnaigh.",
          "translation": { "en": "I work every day except Sunday." },
          "distractors": { "en": ["I work every day except Saturday.","I work every Sunday."] } },
        { "id": "ga-a1-obair-4-u14", "rev": 1, "stage": "phrase", "text": "ó Luan go hAoine",
          "translation": { "en": "Monday to Friday" },
          "distractors": { "en": ["Monday to Sunday","Friday to Monday"] } },
        { "id": "ga-a1-obair-4-u15", "rev": 1, "stage": "sentence", "text": "Oibríonn sí ó Luan go hAoine.",
          "translation": { "en": "She works Monday to Friday." },
          "distractors": { "en": ["He works Monday to Friday.","She works Monday to Saturday."] } },
        { "id": "ga-a1-obair-4-u16", "rev": 1, "stage": "sentence", "text": "Múineann sí i scoil i gCorcaigh.",
          "translation": { "en": "She teaches in a school in Cork." },
          "distractors": { "en": ["She studies in a school in Cork.","He teaches in a school in Cork."] } }
      ]
    },
    {
      "id": "ga-a1-obair-5",
      "title": "Is breá liom mo phost",
      "grammarFocus": { "en": ["mo lenites: post, mo phost","is for what something is (is múinteoir í); tá for how it is (tá sí tuirseach)"] },
      "units": [
        { "id": "ga-a1-obair-5-u01", "rev": 1, "stage": "phrase", "text": "mo phost",
          "translation": { "en": "my job" },
          "distractors": { "en": ["your job","my boss"] } },
        { "id": "ga-a1-obair-5-u02", "rev": 1, "stage": "sentence", "text": "Is breá liom mo phost.",
          "translation": { "en": "I love my job." },
          "distractors": { "en": ["I like my job.","I don't like my job."] } },
        { "id": "ga-a1-obair-5-u03", "rev": 1, "stage": "word", "text": "suimiúil",
          "translation": { "en": "interesting" },
          "distractors": { "en": ["boring","difficult"] } },
        { "id": "ga-a1-obair-5-u04", "rev": 1, "stage": "sentence", "text": "Tá an obair suimiúil.",
          "translation": { "en": "The work is interesting." },
          "distractors": { "en": ["The work is boring.","The work isn't interesting."] } },
        { "id": "ga-a1-obair-5-u05", "rev": 1, "stage": "word", "text": "leadránach",
          "translation": { "en": "boring" },
          "distractors": { "en": ["interesting","easy"] } },
        { "id": "ga-a1-obair-5-u06", "rev": 1, "stage": "sentence", "text": "Tá mo phost beagán leadránach.",
          "translation": { "en": "My job is a bit boring." },
          "distractors": { "en": ["My job is very boring.","My job is a bit interesting."] } },
        { "id": "ga-a1-obair-5-u07", "rev": 1, "stage": "word", "text": "saoiste",
          "translation": { "en": "boss" },
          "distractors": { "en": ["teacher","friend"] } },
        { "id": "ga-a1-obair-5-u08", "rev": 1, "stage": "phrase", "text": "mo shaoiste",
          "translation": { "en": "my boss" },
          "distractors": { "en": ["your boss","my job"] } },
        { "id": "ga-a1-obair-5-u09", "rev": 1, "stage": "sentence", "text": "Tá mo shaoiste an-deas.",
          "translation": { "en": "My boss is very nice." },
          "distractors": { "en": ["My boss isn't very nice.","My friend is very nice."] } },
        { "id": "ga-a1-obair-5-u10", "rev": 1, "stage": "word", "text": "pá",
          "translation": { "en": "pay" },
          "distractors": { "en": ["job","work"] } },
        { "id": "ga-a1-obair-5-u11", "rev": 1, "stage": "sentence", "text": "Níl an pá go maith.",
          "translation": { "en": "The pay isn't good." },
          "distractors": { "en": ["The pay is good.","The job isn't good."] } },
        { "id": "ga-a1-obair-5-u12", "rev": 1, "stage": "sentence", "text": "Is dochtúir í, agus tá sí an-ghnóthach.",
          "translation": { "en": "She's a doctor, and she's very busy." },
          "distractors": { "en": ["She's a nurse, and she's very busy.","She's a doctor, and she's very tired."] } },
        { "id": "ga-a1-obair-5-u13", "rev": 1, "stage": "sentence", "text": "Is feirmeoir é, agus tá sé tuirseach.",
          "translation": { "en": "He's a farmer, and he's tired." },
          "distractors": { "en": ["He's a cook, and he's tired.","She's a farmer, and she's tired."] } },
        { "id": "ga-a1-obair-5-u14", "rev": 1, "stage": "sentence", "text": "An maith leat do phost?", "senses": {"0":"q"},
          "translation": { "en": "Do you like your job?" },
          "distractors": { "en": ["Would you like a job?","Do you like my job?"] } },
        { "id": "ga-a1-obair-5-u15", "rev": 1, "stage": "sentence", "text": "Is maith, ach tá sé deacair.",
          "translation": { "en": "Yes, but it's difficult." },
          "distractors": { "en": ["No, it's difficult.","Yes, and it's easy."] } }
      ]
    },
    {
      "id": "ga-a1-obair-6",
      "title": "Ag cur aithne ar a chéile",
      "grammarFocus": { "en": ["review: is, tá and ag + verbal noun in one conversation","obair is feminine, so it is sí: tá sí deacair = it's difficult"] },
      "units": [
        { "id": "ga-a1-obair-6-u01", "rev": 1, "stage": "sentence", "text": "Cad is ainm duit, agus cad a dhéanann tú?", "senses": {"6":"rel"},
          "translation": { "en": "What's your name, and what do you do?" },
          "distractors": { "en": ["What's your name, and where do you work?","Where are you from, and what do you do?"] } },
        { "id": "ga-a1-obair-6-u02", "rev": 1, "stage": "sentence", "text": "Is mise Seán, agus is innealtóir mé.",
          "translation": { "en": "I'm Seán, and I'm an engineer." },
          "distractors": { "en": ["I'm Seán, and I'm a teacher.","This is Seán, and he's an engineer."] } },
        { "id": "ga-a1-obair-6-u03", "rev": 1, "stage": "sentence", "text": "Cá bhfuil tú ag obair, a Sheáin?", "senses": {"5":"voc"},
          "translation": { "en": "Where do you work, Seán?" },
          "distractors": { "en": ["Where do you live, Seán?","What do you do, Seán?"] } },
        { "id": "ga-a1-obair-6-u04", "rev": 1, "stage": "sentence", "text": "Tá mé ag obair i mBaile Átha Cliath anois.",
          "translation": { "en": "I work in Dublin now." },
          "distractors": { "en": ["I live in Dublin now.","I worked in Dublin."] } },
        { "id": "ga-a1-obair-6-u05", "rev": 1, "stage": "sentence", "text": "An maith leat an obair?", "senses": {"0":"q"},
          "translation": { "en": "Do you like the work?" },
          "distractors": { "en": ["Would you like the work?","Do you like the school?"] } },
        { "id": "ga-a1-obair-6-u06", "rev": 1, "stage": "sentence", "text": "Is maith, ach tá sí deacair.",
          "translation": { "en": "Yes, but it's difficult." },
          "distractors": { "en": ["Yes, and it's easy.","No, and it's difficult."] } },
        { "id": "ga-a1-obair-6-u07", "rev": 1, "stage": "sentence", "text": "Agus tusa, cad a dhéanann tú?", "senses": {"3":"rel"},
          "translation": { "en": "And you, what do you do?" },
          "distractors": { "en": ["And you, where do you work?","And you, what's your name?"] } },
        { "id": "ga-a1-obair-6-u08", "rev": 1, "stage": "sentence", "text": "Is mac léinn mé, tá mé ag foghlaim Gaeilge.",
          "translation": { "en": "I'm a student, I'm learning Irish." },
          "distractors": { "en": ["I'm a teacher, I teach Irish.","I'm a student, I'm learning English."] } },
        { "id": "ga-a1-obair-6-u09", "rev": 1, "stage": "phrase", "text": "do chuid Gaeilge",
          "translation": { "en": "your Irish" },
          "distractors": { "en": ["my Irish","your English"] } },
        { "id": "ga-a1-obair-6-u10", "rev": 1, "stage": "sentence", "text": "Tá do chuid Gaeilge go maith!",
          "translation": { "en": "Your Irish is good!" },
          "distractors": { "en": ["Your English is good!","Your Irish isn't good!"] } },
        { "id": "ga-a1-obair-6-u11", "rev": 1, "stage": "sentence", "text": "Go raibh maith agat, tá mé ag foghlaim go crua.",
          "translation": { "en": "Thank you, I'm learning hard." },
          "distractors": { "en": ["Thank you, I'm working hard.","Thank you, I'm learning slowly."] } }
      ]
    }
  ]
