{
  "id": "ga-a1-obair",
  "language": "ga",
  "level": "A1",
  "order": 5,
  "title": "Obair agus Staidéar",
  "description": { "en": "Say what you do for a living, where you work, what you're studying, and what you think of it" },
  "track": "main",
  "requires": ["ga-a1-clann"],
  "introduces": ["múinteoir","dochtúir","altra","innealtóir","ea","léann","cócaire","feirmeoir","post","obair","siopa","oifig","ospidéal","bialann","scoil","crua","gnóthach","foghlaim","staidéar","ollscoil","múin","rang","duine","leabhar","foclóir","deacair","éasca","déan","oibrigh","banc","gach","ó","suimiúil","leadránach","saoiste","pá","cuid"],
  "lexicon": {
    "múinteoir": { "lemma": "múinteoir", "pos": "NOUN", "gloss": { "en": "teacher (masculine)" } },
    "dochtúir": { "lemma": "dochtúir", "pos": "NOUN", "gloss": { "en": "doctor (masculine)" } },
    "altra": { "lemma": "altra", "pos": "NOUN", "gloss": { "en": "nurse (masculine)" } },
    "innealtóir": { "lemma": "innealtóir", "pos": "NOUN", "gloss": { "en": "engineer (masculine)" } },
