    "imríonn": { "lemma": "imir", "pos": "VERB", "gloss": { "en": "plays (he, she, they, you)" } },
    "leadóg": { "lemma": "leadóg", "pos": "NOUN", "gloss": { "en": "tennis (feminine)" } },
    "foireann": { "lemma": "foireann", "pos": "NOUN", "gloss": { "en": "team (feminine)" } },
    "bhfoireann": { "lemma": "foireann", "pos": "NOUN", "gloss": { "en": "team (foireann, eclipsed after ar an)" } },
    "cluiche": { "lemma": "cluiche", "pos": "NOUN", "gloss": { "en": "match, game (masculine)" } },
    "bpeil": { "lemma": "peil", "pos": "NOUN", "gloss": { "en": "football (peil, eclipsed after ar an)" } },
    "seinnim": { "lemma": "seinn", "pos": "VERB", "gloss": { "en": "I play (music, an instrument)" } },
    "giotár": { "lemma": "giotár", "pos": "NOUN", "gloss": { "en": "guitar (masculine)" } },
    "pianó": { "lemma": "pianó", "pos": "NOUN", "gloss": { "en": "piano (masculine)" } },
    "seinneann": { "lemma": "seinn", "pos": "VERB", "gloss": { "en": "plays (music; he, she, they, you)" } },
    "fidil": { "lemma": "fidil", "pos": "NOUN", "gloss": { "en": "fiddle (feminine)" } },
    "fhidil": { "lemma": "fidil", "pos": "NOUN", "gloss": { "en": "fiddle (fidil, lenited after an)" } },
    "canaim": { "lemma": "can", "pos": "VERB", "gloss": { "en": "I sing" } },
    "sheinnim": { "lemma": "seinn", "pos": "VERB", "gloss": { "en": "I play (seinnim, lenited after ní)" } },
    "amhrán": { "lemma": "amhrán", "pos": "NOUN", "gloss": { "en": "song (masculine)" } },
    "t-amhrán": { "lemma": "amhrán", "pos": "NOUN", "gloss": { "en": "song (amhrán, with t- after an)" } },
    "traidisiúnta": { "lemma": "traidisiúnta", "pos": "ADJ", "gloss": { "en": "traditional" } },
