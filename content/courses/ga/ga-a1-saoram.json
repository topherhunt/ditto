    "scannán": { "lemma": "scannán", "pos": "NOUN", "gloss": { "en": "film (masculine)" } },
    "chairde": { "lemma": "cara", "pos": "NOUN", "gloss": { "en": "friends (cairde, plural of cara, lenited after mo)" } },
    "tábhairne": { "lemma": "tábhairne", "pos": "NOUN", "gloss": { "en": "tavern: teach tábhairne = pub" } },
    "buailim": { "lemma": "buail", "pos": "VERB", "gloss": { "en": "I hit; buailim le = I meet" } },
    "téimid": { "lemma": "téigh", "pos": "VERB", "gloss": { "en": "we go" } },
    "fanaim": { "lemma": "fan", "pos": "VERB", "gloss": { "en": "I stay, I wait" } },
    "uaireanta": { "lemma": "uair", "pos": "NOUN", "gloss": { "en": "sometimes (plural of uair, used as an adverb)" } },
    "ligim": { "lemma": "lig", "pos": "VERB", "gloss": { "en": "I let: ligim mo scíth = I relax" } },
    "scíth": { "lemma": "scíth", "pos": "NOUN", "gloss": { "en": "rest: ligim mo scíth = I relax" } },
    "teacht": { "lemma": "tar", "pos": "VERB", "gloss": { "en": "coming, to come (verbal noun of tar)" } },
    "bhreá": { "lemma": "breá", "pos": "ADJ", "gloss": { "en": "fine (breá, lenited after ba): ba bhreá liom = I'd love to" } },
    "b'fhéidir": { "lemma": "féidir", "pos": "ADV", "gloss": { "en": "maybe (ba + féidir)" } },
    "cóisir": { "lemma": "cóisir", "pos": "NOUN", "gloss": { "en": "party (feminine)" } },
    "chóisir": { "lemma": "cóisir", "pos": "NOUN", "gloss": { "en": "party (cóisir, lenited after an)" } }
  },
  "lessons": [
    {
      "id": "ga-a1-saoram-1",
      "title": "Is breá liom snámh",
      "grammarFocus": { "en": ["a verbal noun works like a noun: is breá liom snámh = I love swimming","caitheamh aimsire = a hobby (lit. a spending of time)"] },
      "units": [
        { "id": "ga-a1-saoram-1-u01", "rev": 1, "stage": "word", "text": "snámh",
          "translation": { "en": "swimming" },
          "distractors": { "en": ["running","dancing"] } },
        { "id": "ga-a1-saoram-1-u02", "rev": 1, "stage": "sentence", "text": "Is breá liom snámh.",
          "translation": { "en": "I love swimming." },
          "distractors": { "en": ["I like swimming.","I love running."] } },
        { "id": "ga-a1-saoram-1-u03", "rev": 1, "stage": "word", "text": "rith",
          "translation": { "en": "running" },
          "distractors": { "en": ["swimming","walking"] } },
        { "id": "ga-a1-saoram-1-u04", "rev": 1, "stage": "sentence", "text": "Ní maith liom rith.",
          "translation": { "en": "I don't like running." },
          "distractors": { "en": ["I like running.","I don't like swimming."] } },
        { "id": "ga-a1-saoram-1-u05", "rev": 1, "stage": "word", "text": "damhsa",
          "translation": { "en": "dancing" },
          "distractors": { "en": ["singing","swimming"] } },
        { "id": "ga-a1-saoram-1-u06", "rev": 1, "stage": "sentence", "text": "Is maith le mo dheirfiúr damhsa.",
          "translation": { "en": "My sister likes dancing." },
          "distractors": { "en": ["My brother likes dancing.","My sister likes singing."] } },
        { "id": "ga-a1-saoram-1-u07", "rev": 1, "stage": "word", "text": "amhránaíocht",
          "translation": { "en": "singing" },
          "distractors": { "en": ["dancing","music"] } },
        { "id": "ga-a1-saoram-1-u08", "rev": 1, "stage": "sentence", "text": "An maith leat amhránaíocht?", "senses": {"0":"q"},
          "translation": { "en": "Do you like singing?" },
          "distractors": { "en": ["Would you like to sing?","Do you like dancing?"] } },
        { "id": "ga-a1-saoram-1-u09", "rev": 1, "stage": "word", "text": "léamh",
          "translation": { "en": "reading" },
          "distractors": { "en": ["writing","swimming"] } },
        { "id": "ga-a1-saoram-1-u10", "rev": 1, "stage": "sentence", "text": "Is breá le m'athair léamh.",
          "translation": { "en": "My father loves reading." },
          "distractors": { "en": ["My mother loves reading.","My father loves writing."] } },
        { "id": "ga-a1-saoram-1-u11", "rev": 1, "stage": "phrase", "text": "caitheamh aimsire",
          "translation": { "en": "hobby, pastime" },
          "distractors": { "en": ["holiday","weekend"] } },
        { "id": "ga-a1-saoram-1-u12", "rev": 1, "stage": "sentence", "text": "Cén caitheamh aimsire atá agat?",
          "translation": { "en": "What's your hobby?" },
          "distractors": { "en": ["What's your job?","When's your holiday?"] } },
        { "id": "ga-a1-saoram-1-u13", "rev": 1, "stage": "sentence", "text": "Is breá liom ceol agus léamh.",
          "translation": { "en": "I love music and reading." },
          "distractors": { "en": ["I love music and writing.","I like music and reading."] } },
        { "id": "ga-a1-saoram-1-u14", "rev": 1, "stage": "word", "text": "siúl",
          "translation": { "en": "walking" },
          "distractors": { "en": ["running","swimming"] } },
        { "id": "ga-a1-saoram-1-u15", "rev": 1, "stage": "sentence", "text": "Téim ag siúl gach Satharn.",
          "translation": { "en": "I go walking every Saturday." },
          "distractors": { "en": ["I go swimming every Saturday.","I go walking every Sunday."] } },
        { "id": "ga-a1-saoram-1-u16", "rev": 1, "stage": "sentence", "text": "Cad is maith leat a dhéanamh?", "senses": {"4":"to"},
          "translation": { "en": "What do you like to do?" },
          "distractors": { "en": ["What would you like to do?","What are you doing?"] } }
      ]
    },
    {
      "id": "ga-a1-saoram-2",
      "title": "Imrím peil",
      "grammarFocus": { "en": ["imrím = I play (a sport); an imríonn tú ...? = do you play ...?","ar an eclipses: peil, ar an bpeil; foireann, ar an bhfoireann"] },
      "units": [
        { "id": "ga-a1-saoram-2-u01", "rev": 1, "stage": "word", "text": "spórt",
          "translation": { "en": "sport" },
          "distractors": { "en": ["game","team"] } },
        { "id": "ga-a1-saoram-2-u02", "rev": 1, "stage": "sentence", "text": "An maith leat spórt?", "senses": {"0":"q"},
          "translation": { "en": "Do you like sport?" },
          "distractors": { "en": ["Do you play sport?","Do you like music?"] } },
        { "id": "ga-a1-saoram-2-u03", "rev": 1, "stage": "phrase", "text": "imrím",
          "translation": { "en": "I play (a sport)" },
          "distractors": { "en": ["I watch","I played"] } },
        { "id": "ga-a1-saoram-2-u04", "rev": 1, "stage": "word", "text": "peil",
          "translation": { "en": "football" },
          "distractors": { "en": ["hurling","tennis"] } },
        { "id": "ga-a1-saoram-2-u05", "rev": 1, "stage": "sentence", "text": "Imrím peil gach Céadaoin.",
          "translation": { "en": "I play football every Wednesday." },
          "distractors": { "en": ["I play football every Thursday.","I watch football every Wednesday."] } },
        { "id": "ga-a1-saoram-2-u06", "rev": 1, "stage": "word", "text": "iománaíocht",
          "translation": { "en": "hurling" },
          "distractors": { "en": ["football","rugby"] } },
        { "id": "ga-a1-saoram-2-u07", "rev": 1, "stage": "sentence", "text": "Imríonn mo dheartháir iománaíocht.",
          "translation": { "en": "My brother plays hurling." },
          "distractors": { "en": ["My sister plays hurling.","My brother plays football."] } },
        { "id": "ga-a1-saoram-2-u08", "rev": 1, "stage": "word", "text": "leadóg",
          "translation": { "en": "tennis" },
          "distractors": { "en": ["golf","football"] } },
        { "id": "ga-a1-saoram-2-u09", "rev": 1, "stage": "sentence", "text": "An imríonn tú leadóg?", "senses": {"0":"q"},
          "translation": { "en": "Do you play tennis?" },
          "distractors": { "en": ["Do you watch tennis?","Does she play tennis?"] } },
        { "id": "ga-a1-saoram-2-u10", "rev": 1, "stage": "sentence", "text": "Imrím, ach níl mé go maith!",
          "translation": { "en": "Yes, but I'm not good!" },
          "distractors": { "en": ["No, but I'm good!","Yes, and I'm good!"] } },
        { "id": "ga-a1-saoram-2-u11", "rev": 1, "stage": "word", "text": "foireann",
          "translation": { "en": "team" },
          "distractors": { "en": ["match","club"] } },
        { "id": "ga-a1-saoram-2-u12", "rev": 2, "stage": "sentence", "text": "Tá mo mhac ar an bhfoireann.",
          "translation": { "en": "My son is on the team." },
          "distractors": { "en": ["My daughter is on the team.","My son isn't on the team."] } },
        { "id": "ga-a1-saoram-2-u13", "rev": 1, "stage": "word", "text": "cluiche",
          "translation": { "en": "match, game" },
          "distractors": { "en": ["team","sport"] } },
        { "id": "ga-a1-saoram-2-u14", "rev": 1, "stage": "sentence", "text": "Tá cluiche ann Dé Sathairn.",
          "translation": { "en": "There's a match on Saturday." },
          "distractors": { "en": ["There's a match on Sunday.","There's no match on Saturday."] } },
        { "id": "ga-a1-saoram-2-u15", "rev": 1, "stage": "sentence", "text": "Féachaim ar an bpeil ar an teilifís.",
          "translation": { "en": "I watch football on TV." },
          "distractors": { "en": ["I play football on TV.","I watch hurling on TV."] } },
        { "id": "ga-a1-saoram-2-u16", "rev": 1, "stage": "phrase", "text": "ag snámh",
          "translation": { "en": "swimming" },
          "distractors": { "en": ["running","walking"] } },
        { "id": "ga-a1-saoram-2-u17", "rev": 1, "stage": "sentence", "text": "Téann sí ag snámh gach maidin.",
          "translation": { "en": "She goes swimming every morning." },
          "distractors": { "en": ["He goes swimming every morning.","She goes running every morning."] } }
      ]
    },
    {
      "id": "ga-a1-saoram-3",
      "title": "Seinnim an giotár",
      "grammarFocus": { "en": ["seinnim = I play (an instrument): seinnim an giotár","ní lenites: ní sheinnim","fidil is feminine: an fhidil"] },
      "units": [
        { "id": "ga-a1-saoram-3-u01", "rev": 1, "stage": "phrase", "text": "seinnim",
          "translation": { "en": "I play (music)" },
          "distractors": { "en": ["I sing","I listen"] } },
        { "id": "ga-a1-saoram-3-u02", "rev": 1, "stage": "word", "text": "giotár",
          "translation": { "en": "guitar" },
          "distractors": { "en": ["piano","violin"] } },
        { "id": "ga-a1-saoram-3-u03", "rev": 1, "stage": "sentence", "text": "Seinnim an giotár.",
          "translation": { "en": "I play the guitar." },
          "distractors": { "en": ["I play the piano.","I sing with the guitar."] } },
        { "id": "ga-a1-saoram-3-u04", "rev": 1, "stage": "word", "text": "pianó",
          "translation": { "en": "piano" },
          "distractors": { "en": ["guitar","fiddle"] } },
        { "id": "ga-a1-saoram-3-u05", "rev": 1, "stage": "sentence", "text": "Seinneann m'iníon an pianó.",
          "translation": { "en": "My daughter plays the piano." },
          "distractors": { "en": ["My son plays the piano.","My daughter plays the guitar."] } },
        { "id": "ga-a1-saoram-3-u06", "rev": 1, "stage": "word", "text": "fidil",
          "translation": { "en": "fiddle" },
          "distractors": { "en": ["guitar","flute"] } },
        { "id": "ga-a1-saoram-3-u07", "rev": 1, "stage": "sentence", "text": "An seinneann tú an fhidil?", "senses": {"0":"q"},
          "translation": { "en": "Do you play the fiddle?" },
          "distractors": { "en": ["Do you play the guitar?","Does he play the fiddle?"] } },
        { "id": "ga-a1-saoram-3-u08", "rev": 1, "stage": "phrase", "text": "canaim",
          "translation": { "en": "I sing" },
          "distractors": { "en": ["I play","I dance"] } },
        { "id": "ga-a1-saoram-3-u09", "rev": 1, "stage": "sentence", "text": "Ní sheinnim, ach canaim.",
          "translation": { "en": "No, but I sing." },
          "distractors": { "en": ["Yes, and I sing.","No, but I dance."] } },
        { "id": "ga-a1-saoram-3-u10", "rev": 1, "stage": "word", "text": "amhrán",
          "translation": { "en": "song" },
          "distractors": { "en": ["music","concert"] } },
        { "id": "ga-a1-saoram-3-u11", "rev": 1, "stage": "sentence", "text": "Is breá liom an t-amhrán seo.",
          "translation": { "en": "I love this song." },
          "distractors": { "en": ["I like this song.","I love this music."] } },
        { "id": "ga-a1-saoram-3-u12", "rev": 1, "stage": "phrase", "text": "ceol traidisiúnta",
          "translation": { "en": "traditional music" },
          "distractors": { "en": ["modern music","a traditional song"] } },
        { "id": "ga-a1-saoram-3-u13", "rev": 1, "stage": "sentence", "text": "Éistim le ceol traidisiúnta.",
          "translation": { "en": "I listen to traditional music." },
          "distractors": { "en": ["I play traditional music.","I listen to modern music."] } },
        { "id": "ga-a1-saoram-3-u14", "rev": 1, "stage": "word", "text": "ceolchoirm",
          "translation": { "en": "concert" },
          "distractors": { "en": ["match","party"] } },
        { "id": "ga-a1-saoram-3-u15", "rev": 1, "stage": "word", "text": "anocht",
          "translation": { "en": "tonight" },
          "distractors": { "en": ["tomorrow","today"] } },
        { "id": "ga-a1-saoram-3-u16", "rev": 1, "stage": "sentence", "text": "Tá mé ag dul go dtí an cheolchoirm anocht.",
          "translation": { "en": "I'm going to the concert tonight." },
          "distractors": { "en": ["I'm going to the match tonight.","I'm going to the concert tomorrow."] } },
        { "id": "ga-a1-saoram-3-u17", "rev": 1, "stage": "word", "text": "banna",
          "translation": { "en": "band" },
          "distractors": { "en": ["team","song"] } },
        { "id": "ga-a1-saoram-3-u18", "rev": 1, "stage": "sentence", "text": "Seinneann sé i mbanna.",
          "translation": { "en": "He plays in a band." },
          "distractors": { "en": ["She plays in a band.","He sings in a band."] } }
      ]
    },
    {
      "id": "ga-a1-saoram-4",
      "title": "An deireadh seachtaine",
      "grammarFocus": { "en": ["ag an deireadh seachtaine = at the weekend","go dtí an lenites a feminine noun: an phictiúrlann","mo lenites a plural too: mo chairde = my friends"] },
      "units": [
        { "id": "ga-a1-saoram-4-u01", "rev": 1, "stage": "phrase", "text": "an deireadh seachtaine",
          "translation": { "en": "the weekend" },
          "distractors": { "en": ["the week","Saturday"] } },
        { "id": "ga-a1-saoram-4-u02", "rev": 1, "stage": "sentence", "text": "Cad a dhéanann tú ag an deireadh seachtaine?", "senses": {"1":"rel"},
          "translation": { "en": "What do you do at the weekend?" },
          "distractors": { "en": ["What are you doing this weekend?","Where do you go at the weekend?"] } },
        { "id": "ga-a1-saoram-4-u03", "rev": 1, "stage": "sentence", "text": "Téim go dtí an phictiúrlann.",
          "translation": { "en": "I go to the cinema." },
          "distractors": { "en": ["I go to the theatre.","I went to the cinema."] } },
        { "id": "ga-a1-saoram-4-u04", "rev": 1, "stage": "word", "text": "scannán",
          "translation": { "en": "film" },
          "distractors": { "en": ["book","play"] } },
        { "id": "ga-a1-saoram-4-u05", "rev": 1, "stage": "sentence", "text": "Féachaim ar scannán Dé hAoine.",
          "translation": { "en": "I watch a film on Friday." },
          "distractors": { "en": ["I watch a film on Thursday.","I watch a match on Friday."] } },
        { "id": "ga-a1-saoram-4-u06", "rev": 1, "stage": "phrase", "text": "mo chairde",
          "translation": { "en": "my friends" },
          "distractors": { "en": ["my friend","your friends"] } },
        { "id": "ga-a1-saoram-4-u07", "rev": 1, "stage": "phrase", "text": "teach tábhairne",
          "translation": { "en": "pub" },
