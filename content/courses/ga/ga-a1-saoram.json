    "aimsire": { "lemma": "aimsir", "pos": "NOUN", "gloss": { "en": "of time, of weather (aimsir in the genitive): caitheamh aimsire = hobby" } },
    "siúl": { "lemma": "siúil", "pos": "VERB", "gloss": { "en": "walking (verbal noun of siúil): ag siúl = walking" } },
