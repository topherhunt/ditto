      "units": [
        { "id": "ga-a1-saoram-6-u01", "rev": 1, "stage": "sentence", "text": "Dia duit, a Áine! Cad a dhéanann tú ag an deireadh seachtaine?", "senses": {"2":"voc","5":"rel"},
