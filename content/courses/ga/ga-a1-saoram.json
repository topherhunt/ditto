    "anocht": { "lemma": "anocht", "pos": "ADV", "gloss": { "en": "tonight" } },
    "dul": { "lemma": "téigh", "pos": "VERB", "gloss": { "en": "going, to go (verbal noun of téigh): ag dul = going" } },
    "cheolchoirm": { "lemma": "ceolchoirm", "pos": "NOUN", "gloss": { "en": "concert (ceolchoirm, lenited after an)" } },
