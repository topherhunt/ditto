        { "id": "ga-a1-saoram-6-u02", "rev": 1, "stage": "sentence", "text": "Imrím peil Dé Sathairn, agus téim ag snámh Dé Domhnaigh.",
          "translation": { "en": "I play football on Saturday, and I go swimming on Sunday." },
          "distractors": { "en": ["I play football on Sunday, and I go swimming on Saturday.","I watch football on Saturday, and I go swimming on Sunday."] } },
        { "id": "ga-a1-saoram-6-u03", "rev": 1, "stage": "sentence", "text": "Agus tusa? An imríonn tú spórt?", "senses": {"2":"q"},
          "translation": { "en": "And you? Do you play sport?" },
          "distractors": { "en": ["And you? Do you like sport?","And him? Does he play sport?"] } },
        { "id": "ga-a1-saoram-6-u04", "rev": 1, "stage": "sentence", "text": "Ní imrím, ach seinnim an giotár i mbanna.",
          "translation": { "en": "No, but I play the guitar in a band." },
          "distractors": { "en": ["Yes, and I play the guitar in a band.","No, but I play the piano in a band."] } },
        { "id": "ga-a1-saoram-6-u05", "rev": 1, "stage": "sentence", "text": "Tá ceolchoirm againn anocht.",
          "translation": { "en": "We have a concert tonight." },
          "distractors": { "en": ["We have a match tonight.","We have a concert tomorrow."] } },
        { "id": "ga-a1-saoram-6-u06", "rev": 1, "stage": "sentence", "text": "Ar mhaith leat teacht?", "senses": {"0":"cop"},
          "translation": { "en": "Would you like to come?" },
          "distractors": { "en": ["Would you like to go?","Do you like to come?"] } },
        { "id": "ga-a1-saoram-6-u07", "rev": 1, "stage": "sentence", "text": "Ba bhreá liom, go raibh maith agat!",
