          "distractors": { "en": ["salt","butter"] } },
        { "id": "ga-a1-bia-5-u09", "rev": 1, "stage": "sentence", "text": "An bhfuil salann agus piobar ann?", "senses": {"0":"q"},
          "translation": { "en": "Are there salt and pepper in it?" },
