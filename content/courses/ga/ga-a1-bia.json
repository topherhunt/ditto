      "title": "Sa chistin",
      "grammarFocus": { "en": ["cad atá tú a dhéanamh? = what are you doing?","commands: cuir = put, gearr = cut, tar isteach = come in"] },
      "units": [
        { "id": "ga-a1-bia-5-u01", "rev": 1, "stage": "phrase", "text": "ag cócaráil",
