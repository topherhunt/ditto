          "distractors": { "en": ["put","wash"] } },
        { "id": "ga-a1-bia-5-u11", "rev": 1, "stage": "sentence", "text": "Gearr na prátaí, le do thoil.",
          "translation": { "en": "Cut the potatoes, please." },
