{
  "id": "ga-a1-bia",
  "language": "ga",
  "level": "A1",
  "order": 8,
  "title": "Bia agus Bialann",
  "description": { "en": "Name everyday food, order a meal in a restaurant, say what you eat and don't, and cook at home" },
  "track": "main",
  "requires": ["ga-a1-cathair"],
  "introduces": ["feoil","iasc","sicín","mairteoil","glasra","práta","rís","sailéad","réidh","céad","cúrsa","príomhchúrsa","sceallóg","brúigh","nó","milseog","uachtar","reoigh","fíon","dearg","beoir","feoilséantóir","bia","milis","saill","úr","spíosrach","cócaráil","salann","cuir","piobar","gearr","isteach","buidéal"],
  "lexicon": {
    "feoil": { "lemma": "feoil", "pos": "NOUN", "gloss": { "en": "meat (feminine)" } },
    "fheoil": { "lemma": "feoil", "pos": "NOUN", "gloss": { "en": "meat (feoil, lenited after an): an fheoil" } },
    "iasc": { "lemma": "iasc", "pos": "NOUN", "gloss": { "en": "fish (masculine)" } },
    "t-iasc": { "lemma": "iasc", "pos": "NOUN", "gloss": { "en": "fish (iasc, with t- after an): an t-iasc" } },
    "sicín": { "lemma": "sicín", "pos": "NOUN", "gloss": { "en": "chicken (masculine)" } },
    "mairteoil": { "lemma": "mairteoil", "pos": "NOUN", "gloss": { "en": "beef (feminine)" } },
    "mhairteoil": { "lemma": "mairteoil", "pos": "NOUN", "gloss": { "en": "beef (mairteoil, lenited after an): an mhairteoil" } },
    "glasraí": { "lemma": "glasra", "pos": "NOUN", "gloss": { "en": "vegetables (plural of glasra)" } },
    "prátaí": { "lemma": "práta", "pos": "NOUN", "gloss": { "en": "potatoes (plural of práta)" } },
    "rís": { "lemma": "rís", "pos": "NOUN", "gloss": { "en": "rice (feminine)" } },
    "sailéad": { "lemma": "sailéad", "pos": "NOUN", "gloss": { "en": "salad (masculine)" } },
    "réidh": { "lemma": "réidh", "pos": "ADJ", "gloss": { "en": "ready" } },
    "chéad": { "lemma": "céad", "pos": "ADJ", "gloss": { "en": "first (céad, lenited after an): an chéad chúrsa; it lenites the noun after it" } },
    "chúrsa": { "lemma": "cúrsa", "pos": "NOUN", "gloss": { "en": "course (cúrsa, lenited after chéad)" } },
    "don": { "lemma": "do", "pos": "ADP", "gloss": { "en": "to the, for the (do + an); lenites: don chéad chúrsa" } },
    "t-anraith": { "lemma": "anraith", "pos": "NOUN", "gloss": { "en": "soup (anraith, with t- after an): an t-anraith" } },
    "príomhchúrsa": { "lemma": "príomhchúrsa", "pos": "NOUN", "gloss": { "en": "main course (masculine)" } },
    "phríomhchúrsa": { "lemma": "príomhchúrsa", "pos": "NOUN", "gloss": { "en": "main course (príomhchúrsa, lenited after don)" } },
    "sceallóga": { "lemma": "sceallóg", "pos": "NOUN", "gloss": { "en": "chips (plural of sceallóg)" } },
    "brúite": { "lemma": "brúigh", "pos": "ADJ", "gloss": { "en": "mashed, crushed: prátaí brúite = mashed potatoes" } },
    "nó": { "lemma": "nó", "pos": "CCONJ", "gloss": { "en": "or" } },
    "milseog": { "lemma": "milseog", "pos": "NOUN", "gloss": { "en": "dessert (feminine)" } },
    "uachtar": { "lemma": "uachtar", "pos": "NOUN", "gloss": { "en": "cream (masculine): uachtar reoite = ice cream" } },
    "reoite": { "lemma": "reoigh", "pos": "ADJ", "gloss": { "en": "frozen: uachtar reoite = ice cream" } },
    "fíon": { "lemma": "fíon", "pos": "NOUN", "gloss": { "en": "wine (masculine)" } },
    "dearg": { "lemma": "dearg", "pos": "ADJ", "gloss": { "en": "red" } },
    "beoir": { "lemma": "beoir", "pos": "NOUN", "gloss": { "en": "beer (feminine)" } },
    "feoilséantóir": { "lemma": "feoilséantóir", "pos": "NOUN", "gloss": { "en": "vegetarian (masculine)" } },
    "an-bhlasta": { "lemma": "blasta", "pos": "ADJ", "gloss": { "en": "very tasty (an- lenites: an-bhlasta)" } },
    "bia": { "lemma": "bia", "pos": "NOUN", "gloss": { "en": "food (masculine)" } },
    "agaibh": { "lemma": "ag", "pos": "ADP", "gloss": { "en": "at you (ag + sibh, to several people): an bhfuil ... agaibh? = do you have ...?" } },
    "milis": { "lemma": "milis", "pos": "ADJ", "gloss": { "en": "sweet" } },
    "rómhilis": { "lemma": "milis", "pos": "ADJ", "gloss": { "en": "too sweet (ró- lenites: rómhilis)" } },
    "saillte": { "lemma": "saill", "pos": "ADJ", "gloss": { "en": "salty, salted" } },
    "róthe": { "lemma": "te", "pos": "ADJ", "gloss": { "en": "too hot (ró- lenites, but t doesn't change: róthe)" } },
    "úr": { "lemma": "úr", "pos": "ADJ", "gloss": { "en": "fresh, new" } },
    "an-úr": { "lemma": "úr", "pos": "ADJ", "gloss": { "en": "very fresh" } },
    "spíosrach": { "lemma": "spíosrach", "pos": "ADJ", "gloss": { "en": "spicy" } },
    "cócaráil": { "lemma": "cócaráil", "pos": "VERB", "gloss": { "en": "cooking (verbal noun): ag cócaráil = cooking" } },
    "dhéanamh": { "lemma": "déan", "pos": "VERB", "gloss": { "en": "doing, making (déanamh, lenited after a): cad atá tú a dhéanamh? = what are you doing?" } },
    "déanamh": { "lemma": "déan", "pos": "VERB", "gloss": { "en": "doing, making (verbal noun of déan): ag déanamh = making" } },
    "salann": { "lemma": "salann", "pos": "NOUN", "gloss": { "en": "salt (masculine)" } },
    "cuir": { "lemma": "cuir", "pos": "VERB", "gloss": { "en": "put (command)" } },
    "piobar": { "lemma": "piobar", "pos": "NOUN", "gloss": { "en": "pepper (masculine)" } },
    "gearr": { "lemma": "gearr", "pos": "VERB", "gloss": { "en": "cut (command)" } },
    "isteach": { "lemma": "isteach", "pos": "ADV", "gloss": { "en": "in (with motion): tar isteach = come in" } },
    "cheathrar": { "lemma": "ceathrar", "pos": "NOUN", "gloss": { "en": "four people (ceathrar, lenited after do): bord do cheathrar = a table for four" } },
    "daoibh": { "lemma": "do", "pos": "ADP", "gloss": { "en": "to you, for you (do + sibh, to several people)" } },
    "libh": { "lemma": "le", "pos": "ADP", "gloss": { "en": "with you (le + sibh, to several people): ba mhaith libh = you'd all like" } },
    "liomsa": { "lemma": "le", "pos": "ADP", "gloss": { "en": "with me (liom, stressed): ba mhaith liomsa = I'd like (as for me)" } },
    "hól": { "lemma": "ól", "pos": "VERB", "gloss": { "en": "drinking (ól, with h after le): rud éigin le hól = something to drink" } },
    "buidéal": { "lemma": "buidéal", "pos": "NOUN", "gloss": { "en": "bottle (masculine)" } },
    "bhí": { "lemma": "bí", "pos": "VERB", "gloss": { "en": "was, were (past of tá)" } }
  },
  "lessons": [
    {
      "id": "ga-a1-bia-1",
      "title": "Feoil agus iasc",
      "grammarFocus": { "en": ["every noun is masculine or feminine","an lenites a feminine noun: feoil, an fheoil (fh is silent)","a masculine noun starting with a vowel takes t-: iasc, an t-iasc"] },
      "units": [
        { "id": "ga-a1-bia-1-u01", "rev": 1, "stage": "word", "text": "feoil",
          "translation": { "en": "meat" },
          "distractors": { "en": ["fish","chicken"] } },
        { "id": "ga-a1-bia-1-u02", "rev": 1, "stage": "phrase", "text": "an fheoil",
          "translation": { "en": "the meat" },
          "distractors": { "en": ["the fish","a meat"] } },
        { "id": "ga-a1-bia-1-u03", "rev": 1, "stage": "word", "text": "iasc",
          "translation": { "en": "fish" },
          "distractors": { "en": ["meat","rice"] } },
        { "id": "ga-a1-bia-1-u04", "rev": 1, "stage": "phrase", "text": "an t-iasc",
          "translation": { "en": "the fish" },
          "distractors": { "en": ["the meat","a fish"] } },
        { "id": "ga-a1-bia-1-u05", "rev": 1, "stage": "word", "text": "sicín",
          "translation": { "en": "chicken" },
          "distractors": { "en": ["beef","fish"] } },
        { "id": "ga-a1-bia-1-u06", "rev": 1, "stage": "word", "text": "mairteoil",
          "translation": { "en": "beef" },
          "distractors": { "en": ["chicken","pork"] } },
        { "id": "ga-a1-bia-1-u07", "rev": 1, "stage": "phrase", "text": "an mhairteoil",
          "translation": { "en": "the beef" },
          "distractors": { "en": ["the chicken","the meat"] } },
        { "id": "ga-a1-bia-1-u08", "rev": 1, "stage": "word", "text": "glasraí",
          "translation": { "en": "vegetables" },
          "distractors": { "en": ["potatoes","fruit"] } },
        { "id": "ga-a1-bia-1-u09", "rev": 1, "stage": "word", "text": "prátaí",
          "translation": { "en": "potatoes" },
          "distractors": { "en": ["vegetables","chips"] } },
        { "id": "ga-a1-bia-1-u10", "rev": 1, "stage": "word", "text": "rís",
          "translation": { "en": "rice" },
          "distractors": { "en": ["bread","salad"] } },
        { "id": "ga-a1-bia-1-u11", "rev": 1, "stage": "word", "text": "sailéad",
          "translation": { "en": "salad" },
          "distractors": { "en": ["soup","rice"] } },
        { "id": "ga-a1-bia-1-u12", "rev": 1, "stage": "sentence", "text": "Is maith liom iasc agus rís.",
          "translation": { "en": "I like fish and rice." },
          "distractors": { "en": ["I like meat and rice.","I'd like fish and rice."] } },
        { "id": "ga-a1-bia-1-u13", "rev": 1, "stage": "sentence", "text": "Ní maith liom an fheoil anseo.",
          "translation": { "en": "I don't like the meat here." },
          "distractors": { "en": ["I like the meat here.","I don't like the fish here."] } },
        { "id": "ga-a1-bia-1-u14", "rev": 1, "stage": "sentence", "text": "Ba mhaith liom sicín agus prátaí.",
          "translation": { "en": "I'd like chicken and potatoes." },
          "distractors": { "en": ["I'd like chicken and rice.","I'd like beef and potatoes."] } },
        { "id": "ga-a1-bia-1-u15", "rev": 1, "stage": "sentence", "text": "Ithim glasraí gach lá.",
          "translation": { "en": "I eat vegetables every day." },
          "distractors": { "en": ["I eat potatoes every day.","I eat vegetables every week."] } },
        { "id": "ga-a1-bia-1-u16", "rev": 1, "stage": "sentence", "text": "An maith leat sailéad?", "senses": {"0":"q"},
          "translation": { "en": "Do you like salad?" },
          "distractors": { "en": ["Would you like salad?","Do you like soup?"] } },
        { "id": "ga-a1-bia-1-u17", "rev": 1, "stage": "sentence", "text": "Tá an mhairteoil go hálainn.",
          "translation": { "en": "The beef is lovely." },
          "distractors": { "en": ["The chicken is lovely.","The beef isn't lovely."] } }
      ]
    },
    {
      "id": "ga-a1-bia-2",
      "title": "Sa bhialann",
      "grammarFocus": { "en": ["don = to the, for the (do + an); it lenites: don chéad chúrsa = for the first course","nó = or"] },
      "units": [
        { "id": "ga-a1-bia-2-u01", "rev": 1, "stage": "word", "text": "réidh",
          "translation": { "en": "ready" },
          "distractors": { "en": ["busy","free"] } },
        { "id": "ga-a1-bia-2-u02", "rev": 1, "stage": "sentence", "text": "An bhfuil tú réidh?", "senses": {"0":"q"},
          "translation": { "en": "Are you ready?" },
          "distractors": { "en": ["Are you busy?","Is she ready?"] } },
        { "id": "ga-a1-bia-2-u03", "rev": 1, "stage": "phrase", "text": "an chéad chúrsa",
          "translation": { "en": "the first course" },
          "distractors": { "en": ["the main course","dessert"] } },
        { "id": "ga-a1-bia-2-u04", "rev": 1, "stage": "sentence", "text": "Don chéad chúrsa, ba mhaith liom an t-anraith.",
          "translation": { "en": "For the first course, I'd like the soup." },
          "distractors": { "en": ["For the main course, I'd like the soup.","For the first course, I'd like the salad."] } },
        { "id": "ga-a1-bia-2-u05", "rev": 1, "stage": "phrase", "text": "an príomhchúrsa",
          "translation": { "en": "the main course" },
          "distractors": { "en": ["the first course","the menu"] } },
        { "id": "ga-a1-bia-2-u06", "rev": 1, "stage": "sentence", "text": "Agus don phríomhchúrsa, an sicín.",
          "translation": { "en": "And for the main course, the chicken." },
          "distractors": { "en": ["And for the first course, the chicken.","And for the main course, the fish."] } },
        { "id": "ga-a1-bia-2-u07", "rev": 1, "stage": "word", "text": "sceallóga",
          "translation": { "en": "chips" },
          "distractors": { "en": ["potatoes","rice"] } },
        { "id": "ga-a1-bia-2-u08", "rev": 1, "stage": "sentence", "text": "An bhfuil sceallóga leis?", "senses": {"0":"q"},
          "translation": { "en": "Does it come with chips?" },
          "distractors": { "en": ["Does it come with rice?","Would you like chips?"] } },
        { "id": "ga-a1-bia-2-u09", "rev": 1, "stage": "phrase", "text": "prátaí brúite",
          "translation": { "en": "mashed potatoes" },
          "distractors": { "en": ["boiled potatoes","chips"] } },
        { "id": "ga-a1-bia-2-u10", "rev": 1, "stage": "sentence", "text": "Tá, nó prátaí brúite.",
          "translation": { "en": "Yes, or mashed potatoes." },
          "distractors": { "en": ["No, but mashed potatoes.","Yes, and mashed potatoes."] } },
        { "id": "ga-a1-bia-2-u11", "rev": 1, "stage": "word", "text": "milseog",
          "translation": { "en": "dessert" },
          "distractors": { "en": ["starter","cake"] } },
        { "id": "ga-a1-bia-2-u12", "rev": 1, "stage": "sentence", "text": "Ar mhaith leat milseog?", "senses": {"0":"cop"},
          "translation": { "en": "Would you like dessert?" },
          "distractors": { "en": ["Do you like dessert?","Would you like a starter?"] } },
        { "id": "ga-a1-bia-2-u13", "rev": 1, "stage": "phrase", "text": "uachtar reoite",
          "translation": { "en": "ice cream" },
          "distractors": { "en": ["cream","cake"] } },
        { "id": "ga-a1-bia-2-u14", "rev": 1, "stage": "sentence", "text": "Ba mhaith liom uachtar reoite, le do thoil.",
          "translation": { "en": "I'd like ice cream, please." },
          "distractors": { "en": ["I'd like cake, please.","I like ice cream, please."] } },
        { "id": "ga-a1-bia-2-u15", "rev": 1, "stage": "word", "text": "fíon",
          "translation": { "en": "wine" },
          "distractors": { "en": ["beer","water"] } },
        { "id": "ga-a1-bia-2-u16", "rev": 1, "stage": "phrase", "text": "fíon dearg",
          "translation": { "en": "red wine" },
          "distractors": { "en": ["white wine","red beer"] } },
        { "id": "ga-a1-bia-2-u17", "rev": 1, "stage": "sentence", "text": "Ba mhaith liom fíon dearg.",
          "translation": { "en": "I'd like red wine." },
          "distractors": { "en": ["I'd like white wine.","I like red wine."] } },
        { "id": "ga-a1-bia-2-u18", "rev": 1, "stage": "word", "text": "beoir",
          "translation": { "en": "beer" },
          "distractors": { "en": ["wine","juice"] } },
        { "id": "ga-a1-bia-2-u19", "rev": 1, "stage": "sentence", "text": "Ba mhaith leis beoir.",
          "translation": { "en": "He'd like a beer." },
          "distractors": { "en": ["She'd like a beer.","He'd like a wine."] } }
      ]
    },
    {
      "id": "ga-a1-bia-3",
      "title": "Is feoilséantóir mé",
      "grammarFocus": { "en": ["ní + verb = don't: ní ithim feoil = I don't eat meat","ná = nor, or (after a negative)","an ...? + verb asks: an itheann tú? = do you eat? Answer with the verb: ithim (yes), ní ithim (no)"] },
      "units": [
        { "id": "ga-a1-bia-3-u01", "rev": 1, "stage": "word", "text": "feoilséantóir",
          "translation": { "en": "vegetarian" },
          "distractors": { "en": ["vegan","cook"] } },
        { "id": "ga-a1-bia-3-u02", "rev": 1, "stage": "sentence", "text": "Is feoilséantóir mé.",
          "translation": { "en": "I'm a vegetarian." },
          "distractors": { "en": ["I'm a cook.","She's a vegetarian."] } },
        { "id": "ga-a1-bia-3-u03", "rev": 1, "stage": "sentence", "text": "Ní ithim feoil ná iasc.",
          "translation": { "en": "I don't eat meat or fish." },
          "distractors": { "en": ["I eat meat and fish.","I don't eat meat, but I eat fish."] } },
        { "id": "ga-a1-bia-3-u04", "rev": 1, "stage": "sentence", "text": "An itheann tú iasc?", "senses": {"0":"q"},
          "translation": { "en": "Do you eat fish?" },
          "distractors": { "en": ["Do you like fish?","Does he eat fish?"] } },
        { "id": "ga-a1-bia-3-u05", "rev": 1, "stage": "sentence", "text": "Ithim, is breá liom iasc.",
          "translation": { "en": "Yes, I love fish." },
          "distractors": { "en": ["No, I don't like fish.","Yes, I like fish."] } },
        { "id": "ga-a1-bia-3-u06", "rev": 1, "stage": "sentence", "text": "Ní ólaim beoir ná fíon.",
          "translation": { "en": "I don't drink beer or wine." },
          "distractors": { "en": ["I drink beer and wine.","I don't drink beer, but I drink wine."] } },
        { "id": "ga-a1-bia-3-u07", "rev": 1, "stage": "sentence", "text": "Is fearr liom glasraí ná feoil.",
          "translation": { "en": "I prefer vegetables to meat." },
          "distractors": { "en": ["I prefer meat to vegetables.","I like vegetables and meat."] } },
        { "id": "ga-a1-bia-3-u08", "rev": 1, "stage": "phrase", "text": "an-bhlasta",
          "translation": { "en": "very tasty" },
          "distractors": { "en": ["very sweet","not tasty"] } },
        { "id": "ga-a1-bia-3-u09", "rev": 1, "stage": "sentence", "text": "Tá na glasraí seo an-bhlasta.",
          "translation": { "en": "These vegetables are very tasty." },
          "distractors": { "en": ["These potatoes are very tasty.","These vegetables aren't tasty."] } },
        { "id": "ga-a1-bia-3-u10", "rev": 1, "stage": "word", "text": "bia",
          "translation": { "en": "food" },
          "distractors": { "en": ["meat","dinner"] } },
        { "id": "ga-a1-bia-3-u11", "rev": 1, "stage": "sentence", "text": "An bhfuil bia gan feoil agaibh?", "senses": {"0":"q"},
          "translation": { "en": "Do you have food without meat?" },
          "distractors": { "en": ["Do you have food with meat?","Do you have fish without meat?"] } },
        { "id": "ga-a1-bia-3-u12", "rev": 1, "stage": "sentence", "text": "Tá, tá sailéad agus anraith glasraí againn.",
          "translation": { "en": "Yes, we have salad and vegetable soup." },
          "distractors": { "en": ["No, we have salad and vegetable soup.","Yes, we have salad and chicken soup."] } }
      ]
    },
    {
      "id": "ga-a1-bia-4",
      "title": "Tá sé blasta",
      "grammarFocus": { "en": ["ró- = too; it lenites: milis, rómhilis = too sweet; te, róthe = too hot","go leor after an adjective = enough: te go leor = hot enough"] },
      "units": [
        { "id": "ga-a1-bia-4-u01", "rev": 1, "stage": "word", "text": "milis",
          "translation": { "en": "sweet" },
          "distractors": { "en": ["salty","bitter"] } },
        { "id": "ga-a1-bia-4-u02", "rev": 1, "stage": "sentence", "text": "Tá an cáca seo milis.",
          "translation": { "en": "This cake is sweet." },
          "distractors": { "en": ["This cake is salty.","This bread is sweet."] } },
        { "id": "ga-a1-bia-4-u03", "rev": 1, "stage": "phrase", "text": "rómhilis",
          "translation": { "en": "too sweet" },
          "distractors": { "en": ["too salty","very sweet"] } },
        { "id": "ga-a1-bia-4-u04", "rev": 1, "stage": "sentence", "text": "Tá an tae seo rómhilis.",
          "translation": { "en": "This tea is too sweet." },
          "distractors": { "en": ["This coffee is too sweet.","This tea isn't sweet enough."] } },
        { "id": "ga-a1-bia-4-u05", "rev": 1, "stage": "word", "text": "saillte",
          "translation": { "en": "salty" },
          "distractors": { "en": ["sweet","spicy"] } },
        { "id": "ga-a1-bia-4-u06", "rev": 1, "stage": "sentence", "text": "Tá na sceallóga saillte.",
          "translation": { "en": "The chips are salty." },
          "distractors": { "en": ["The chips are sweet.","The potatoes are salty."] } },
        { "id": "ga-a1-bia-4-u07", "rev": 1, "stage": "phrase", "text": "róthe",
          "translation": { "en": "too hot" },
          "distractors": { "en": ["too cold","very hot"] } },
        { "id": "ga-a1-bia-4-u08", "rev": 1, "stage": "sentence", "text": "Tá an t-anraith róthe.",
          "translation": { "en": "The soup is too hot." },
          "distractors": { "en": ["The soup is too cold.","The tea is too hot."] } },
        { "id": "ga-a1-bia-4-u09", "rev": 1, "stage": "word", "text": "úr",
          "translation": { "en": "fresh" },
          "distractors": { "en": ["old","cold"] } },
        { "id": "ga-a1-bia-4-u10", "rev": 1, "stage": "sentence", "text": "An bhfuil an t-iasc úr?", "senses": {"0":"q"},
          "translation": { "en": "Is the fish fresh?" },
          "distractors": { "en": ["Is the meat fresh?","Is the fish cold?"] } },
        { "id": "ga-a1-bia-4-u11", "rev": 1, "stage": "sentence", "text": "Tá, tá sé an-úr.",
          "translation": { "en": "Yes, it's very fresh." },
          "distractors": { "en": ["No, it's not fresh.","Yes, it's very cold."] } },
        { "id": "ga-a1-bia-4-u12", "rev": 1, "stage": "word", "text": "spíosrach",
          "translation": { "en": "spicy" },
          "distractors": { "en": ["sweet","salty"] } },
        { "id": "ga-a1-bia-4-u13", "rev": 1, "stage": "sentence", "text": "Is maith liom bia spíosrach.",
          "translation": { "en": "I like spicy food." },
          "distractors": { "en": ["I like sweet food.","I don't like spicy food."] } },
        { "id": "ga-a1-bia-4-u14", "rev": 1, "stage": "sentence", "text": "Tá an bia anseo go hiontach.",
          "translation": { "en": "The food here is great." },
          "distractors": { "en": ["The food here is awful.","The coffee here is great."] } },
        { "id": "ga-a1-bia-4-u15", "rev": 1, "stage": "sentence", "text": "Níl an fheoil te go leor.",
          "translation": { "en": "The meat isn't hot enough." },
          "distractors": { "en": ["The meat is too hot.","The fish isn't hot enough."] } }
      ]
    },
    {
