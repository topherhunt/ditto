      "units": [
        { "id": "ga-a1-bia-6-u01", "rev": 1, "stage": "sentence", "text": "Dia duit, bord do cheathrar, le do thoil.", "senses": {"3":"to"},
          "translation": { "en": "Hello, a table for four, please." },
          "distractors": { "en": ["Hello, a table for three, please.","Hello, a table for two, please."] } },
        { "id": "ga-a1-bia-6-u02", "rev": 1, "stage": "sentence", "text": "Seo daoibh an biachlár.",
          "translation": { "en": "Here's the menu for you." },
          "distractors": { "en": ["Here's the bill for you.","Here's a table for you."] } },
        { "id": "ga-a1-bia-6-u03", "rev": 1, "stage": "sentence", "text": "Cad ba mhaith libh?",
          "translation": { "en": "What would you all like?" },
          "distractors": { "en": ["What do you all like?","Where would you all like to sit?"] } },
        { "id": "ga-a1-bia-6-u04", "rev": 1, "stage": "sentence", "text": "Ba mhaith liomsa an t-iasc.",
          "translation": { "en": "I'd like the fish." },
          "distractors": { "en": ["I'd like the chicken.","I like the fish."] } },
        { "id": "ga-a1-bia-6-u05", "rev": 1, "stage": "sentence", "text": "Agus ba mhaith léi an sicín le sceallóga.",
          "translation": { "en": "And she'd like the chicken with chips." },
          "distractors": { "en": ["And he'd like the chicken with chips.","And she'd like the fish with chips."] } },
        { "id": "ga-a1-bia-6-u06", "rev": 1, "stage": "sentence", "text": "Ar mhaith libh rud éigin le hól?", "senses": {"0":"cop"},
          "translation": { "en": "Would you all like something to drink?" },
          "distractors": { "en": ["Would you all like something to eat?","Do you all like something to drink?"] } },
        { "id": "ga-a1-bia-6-u07", "rev": 1, "stage": "sentence", "text": "Buidéal uisce, le do thoil.",
          "translation": { "en": "A bottle of water, please." },
          "distractors": { "en": ["A glass of water, please.","A bottle of wine, please."] } },
        { "id": "ga-a1-bia-6-u08", "rev": 1, "stage": "sentence", "text": "An raibh gach rud ceart go leor?", "senses": {"0":"q"},
          "translation": { "en": "Was everything okay?" },
          "distractors": { "en": ["Is everything okay?","Was everything ready?"] } },
        { "id": "ga-a1-bia-6-u09", "rev": 1, "stage": "phrase", "text": "bhí sé",
          "translation": { "en": "it was" },
          "distractors": { "en": ["it is","it will be"] } },
        { "id": "ga-a1-bia-6-u10", "rev": 1, "stage": "sentence", "text": "Bhí sé go hálainn, go raibh maith agat.",
          "translation": { "en": "It was lovely, thank you." },
          "distractors": { "en": ["It is lovely, thank you.","It wasn't lovely, thank you."] } },
        { "id": "ga-a1-bia-6-u11", "rev": 1, "stage": "sentence", "text": "Bhí an t-iasc an-bhlasta.",
          "translation": { "en": "The fish was very tasty." },
          "distractors": { "en": ["The fish is very tasty.","The meat was very tasty."] } }
      ]
    }
