          "distractors": { "en": ["eating","cleaning"] } },
        { "id": "ga-a1-bia-5-u02", "rev": 1, "stage": "sentence", "text": "Tá mé ag cócaráil sa chistin.",
          "translation": { "en": "I'm cooking in the kitchen." },
          "distractors": { "en": ["I'm eating in the kitchen.","I'm cooking in the restaurant."] } },
        { "id": "ga-a1-bia-5-u03", "rev": 1, "stage": "sentence", "text": "Cad atá tú a dhéanamh?", "senses": {"3":"to"},
          "translation": { "en": "What are you doing?" },
          "distractors": { "en": ["What are you eating?","What do you do?"] } },
        { "id": "ga-a1-bia-5-u04", "rev": 1, "stage": "sentence", "text": "Tá mé ag déanamh anraith.",
          "translation": { "en": "I'm making soup." },
          "distractors": { "en": ["I'm eating soup.","I'm making salad."] } },
        { "id": "ga-a1-bia-5-u05", "rev": 1, "stage": "word", "text": "salann",
