{
  "id": "ga-a1-siopadoireacht",
  "language": "ga",
  "level": "A1",
  "order": 10,
  "title": "Siopadóireacht",
  "description": { "en": "Buy clothes and food: colours, sizes and prices, trying things on, paying, and the market" },
  "track": "main",
  "requires": ["ga-a1-saoram"],
  "introduces": ["éadach","léine","bróg","nua","cóta","gúna","geansaí","bríste","dath","bán","glas","buí","daor","ceann","seasca","méid","triail","feisteas","feil","foirfe","cárta","íoc","airgead","tirim","mála","admháil","margadh","úll","tabhair","tráta"],
  "lexicon": {
    "éadaí": { "lemma": "éadach", "pos": "NOUN", "gloss": { "en": "clothes (plural of éadach)" } },
    "léine": { "lemma": "léine", "pos": "NOUN", "gloss": { "en": "shirt (feminine)" } },
    "uaim": { "lemma": "ó", "pos": "ADP", "gloss": { "en": "from me (ó + mé): tá ... uaim = I need ..." } },
    "bróga": { "lemma": "bróg", "pos": "NOUN", "gloss": { "en": "shoes (plural of bróg); adjectives after it take a plural ending: bróga donna" } },
    "nua": { "lemma": "nua", "pos": "ADJ", "gloss": { "en": "new" } },
    "cóta": { "lemma": "cóta", "pos": "NOUN", "gloss": { "en": "coat (masculine)" } },
    "chóta": { "lemma": "cóta", "pos": "NOUN", "gloss": { "en": "coat (cóta, lenited after do)" } },
    "gúna": { "lemma": "gúna", "pos": "NOUN", "gloss": { "en": "dress (masculine)" } },
    "geansaí": { "lemma": "geansaí", "pos": "NOUN", "gloss": { "en": "jumper (masculine)" } },
    "bríste": { "lemma": "bríste", "pos": "NOUN", "gloss": { "en": "trousers (masculine, singular in Irish)" } },
    "dath": { "lemma": "dath", "pos": "NOUN", "gloss": { "en": "colour (masculine)" } },
    "ngeansaí": { "lemma": "geansaí", "pos": "NOUN", "gloss": { "en": "jumper (geansaí, eclipsed after ar an)" } },
    "gorm": { "lemma": "gorm", "pos": "ADJ", "gloss": { "en": "blue" } },
    "dhearg": { "lemma": "dearg", "pos": "ADJ", "gloss": { "en": "red (dearg, lenited after a feminine noun: léine dhearg)" } },
    "bhán": { "lemma": "bán", "pos": "ADJ", "gloss": { "en": "white (bán, lenited after a feminine noun: léine bhán)" } },
    "glas": { "lemma": "glas", "pos": "ADJ", "gloss": { "en": "green" } },
    "uaithi": { "lemma": "ó", "pos": "ADP", "gloss": { "en": "from her (ó + í): tá ... uaithi = she needs ..." } },
    "ghorm": { "lemma": "gorm", "pos": "ADJ", "gloss": { "en": "blue (gorm, lenited after a feminine noun: léine ghorm)" } },
    "buí": { "lemma": "buí", "pos": "ADJ", "gloss": { "en": "yellow" } },
    "daor": { "lemma": "daor", "pos": "ADJ", "gloss": { "en": "expensive" } },
    "an-daor": { "lemma": "daor", "pos": "ADJ", "gloss": { "en": "very expensive (an- doesn't lenite d)" } },
    "ródhaor": { "lemma": "daor", "pos": "ADJ", "gloss": { "en": "too expensive (ró- lenites: ródhaor)" } },
    "saoire": { "lemma": "saor", "pos": "ADJ", "gloss": { "en": "cheaper (comparative of saor): níos saoire" } },
    "ceann": { "lemma": "ceann", "pos": "NOUN", "gloss": { "en": "one (thing), head (masculine): an ceann seo = this one" } },
    "seasca": { "lemma": "seasca", "pos": "NUM", "gloss": { "en": "sixty" } },
    "méid": { "lemma": "méid", "pos": "NOUN", "gloss": { "en": "size, amount" } },
    "thriail": { "lemma": "triail", "pos": "VERB", "gloss": { "en": "trying (triail, lenited after a): é a thriail = to try it on" } },
    "feistis": { "lemma": "feisteas", "pos": "NOUN", "gloss": { "en": "of clothing (feisteas in the genitive): seomra feistis = fitting room" } },
    "róbheag": { "lemma": "beag", "pos": "ADJ", "gloss": { "en": "too small (ró- lenites: róbheag)" } },
    "rómhór": { "lemma": "mór", "pos": "ADJ", "gloss": { "en": "too big (ró- lenites: rómhór)" } },
    "mó": { "lemma": "mór", "pos": "ADJ", "gloss": { "en": "bigger (comparative of mór): níos mó" } },
    "feileann": { "lemma": "feil", "pos": "VERB", "gloss": { "en": "suits (he, she, it, they): feileann sé duit = it suits you" } },
    "foirfe": { "lemma": "foirfe", "pos": "ADJ", "gloss": { "en": "perfect" } },
    "tógfaidh": { "lemma": "tóg", "pos": "VERB", "gloss": { "en": "will take: tógfaidh mé é = I'll take it" } },
    "cárta": { "lemma": "cárta", "pos": "NOUN", "gloss": { "en": "card (masculine)" } },
    "íoc": { "lemma": "íoc", "pos": "VERB", "gloss": { "en": "paying, to pay (verbal noun of íoc)" } },
    "airgead": { "lemma": "airgead", "pos": "NOUN", "gloss": { "en": "money, silver (masculine): airgead tirim = cash" } },
    "tirim": { "lemma": "tirim", "pos": "ADJ", "gloss": { "en": "dry: airgead tirim = cash" } },
    "hairgead": { "lemma": "airgead", "pos": "NOUN", "gloss": { "en": "money (airgead, with h after le): le hairgead tirim = with cash" } },
    "mála": { "lemma": "mála", "pos": "NOUN", "gloss": { "en": "bag (masculine)" } },
    "admháil": { "lemma": "admháil", "pos": "NOUN", "gloss": { "en": "receipt (feminine)" } },
    "margadh": { "lemma": "margadh", "pos": "NOUN", "gloss": { "en": "market (masculine)" } },
    "úlla": { "lemma": "úll", "pos": "NOUN", "gloss": { "en": "apples (plural of úll)" } },
    "oráistí": { "lemma": "oráiste", "pos": "NOUN", "gloss": { "en": "oranges (plural of oráiste)" } },
    "húlla": { "lemma": "úll", "pos": "NOUN", "gloss": { "en": "apples (úlla, with h after na)" } },
    "tabhair": { "lemma": "tabhair", "pos": "VERB", "gloss": { "en": "give (command): tabhair dom = give me" } },
    "cinn": { "lemma": "ceann", "pos": "NOUN", "gloss": { "en": "ones (plural of ceann, used after numbers): sé cinn = six (of them)" } },
    "trátaí": { "lemma": "tráta", "pos": "NOUN", "gloss": { "en": "tomatoes (plural of tráta)" } },
    "cáis": { "lemma": "cáis", "pos": "NOUN", "gloss": { "en": "cheese (feminine)" } },
    "aon": { "lemma": "aon", "pos": "DET", "gloss": { "en": "any: aon rud eile? = anything else?" } },
    "t-ollmhargadh": { "lemma": "ollmhargadh", "pos": "NOUN", "gloss": { "en": "supermarket (ollmhargadh, with t- after an)" } }
  },
  "lessons": [
    {
      "id": "ga-a1-siopadoireacht-1",
      "title": "Éadaí",
      "grammarFocus": { "en": ["tá ... uaim = I need ... (lit. ... is from me)","tá ... orm = I'm wearing ... (lit. ... is on me): tá cóta uirthi = she's wearing a coat"] },
      "units": [
        { "id": "ga-a1-siopadoireacht-1-u01", "rev": 1, "stage": "word", "text": "éadaí",
          "translation": { "en": "clothes" },
          "distractors": { "en": ["shoes","shops"] } },
        { "id": "ga-a1-siopadoireacht-1-u02", "rev": 1, "stage": "word", "text": "léine",
          "translation": { "en": "shirt" },
          "distractors": { "en": ["jumper","dress"] } },
        { "id": "ga-a1-siopadoireacht-1-u03", "rev": 1, "stage": "sentence", "text": "Tá léine uaim.",
          "translation": { "en": "I need a shirt." },
          "distractors": { "en": ["I have a shirt.","I need a jumper."] } },
        { "id": "ga-a1-siopadoireacht-1-u04", "rev": 1, "stage": "word", "text": "bróga",
          "translation": { "en": "shoes" },
          "distractors": { "en": ["socks","boots"] } },
        { "id": "ga-a1-siopadoireacht-1-u05", "rev": 1, "stage": "word", "text": "nua",
          "translation": { "en": "new" },
          "distractors": { "en": ["old","cheap"] } },
        { "id": "ga-a1-siopadoireacht-1-u06", "rev": 1, "stage": "sentence", "text": "Tá bróga nua uaim.",
          "translation": { "en": "I need new shoes." },
          "distractors": { "en": ["I have new shoes.","I need new socks."] } },
        { "id": "ga-a1-siopadoireacht-1-u07", "rev": 1, "stage": "word", "text": "cóta",
          "translation": { "en": "coat" },
          "distractors": { "en": ["jumper","hat"] } },
        { "id": "ga-a1-siopadoireacht-1-u08", "rev": 1, "stage": "sentence", "text": "Is maith liom do chóta nua.",
          "translation": { "en": "I like your new coat." },
          "distractors": { "en": ["I like my new coat.","I like your new dress."] } },
        { "id": "ga-a1-siopadoireacht-1-u09", "rev": 1, "stage": "word", "text": "gúna",
          "translation": { "en": "dress" },
          "distractors": { "en": ["skirt","coat"] } },
        { "id": "ga-a1-siopadoireacht-1-u10", "rev": 1, "stage": "sentence", "text": "An bhfuil gúna nua agat?", "senses": {"0":"q"},
          "translation": { "en": "Do you have a new dress?" },
          "distractors": { "en": ["Do you need a new dress?","Does she have a new dress?"] } },
        { "id": "ga-a1-siopadoireacht-1-u11", "rev": 1, "stage": "word", "text": "geansaí",
          "translation": { "en": "jumper" },
          "distractors": { "en": ["shirt","coat"] } },
        { "id": "ga-a1-siopadoireacht-1-u12", "rev": 1, "stage": "sentence", "text": "Tá geansaí ar Liam.",
          "translation": { "en": "Liam is wearing a jumper." },
          "distractors": { "en": ["Liam is wearing a coat.","Liam wants a jumper."] } },
        { "id": "ga-a1-siopadoireacht-1-u13", "rev": 1, "stage": "word", "text": "bríste",
          "translation": { "en": "trousers" },
          "distractors": { "en": ["skirt","shoes"] } },
        { "id": "ga-a1-siopadoireacht-1-u14", "rev": 1, "stage": "sentence", "text": "Tá bríste agus léine air.",
          "translation": { "en": "He's wearing trousers and a shirt." },
          "distractors": { "en": ["She's wearing trousers and a shirt.","He's wearing a skirt and a shirt."] } },
        { "id": "ga-a1-siopadoireacht-1-u15", "rev": 1, "stage": "sentence", "text": "Tá cóta uirthi.",
          "translation": { "en": "She's wearing a coat." },
          "distractors": { "en": ["He's wearing a coat.","She needs a coat."] } },
        { "id": "ga-a1-siopadoireacht-1-u16", "rev": 1, "stage": "sentence", "text": "Níl éadaí nua uaim.",
          "translation": { "en": "I don't need new clothes." },
          "distractors": { "en": ["I need new clothes.","I don't have new clothes."] } }
      ]
    },
    {
      "id": "ga-a1-siopadoireacht-2",
      "title": "Léine dhearg",
      "grammarFocus": { "en": ["colours come after the noun","after a feminine noun they lenite: léine, léine dhearg","after a masculine noun they don't: geansaí dearg","after a plural they take a plural ending: bróga donna"] },
      "units": [
        { "id": "ga-a1-siopadoireacht-2-u01", "rev": 1, "stage": "word", "text": "dath",
          "translation": { "en": "colour" },
          "distractors": { "en": ["size","price"] } },
        { "id": "ga-a1-siopadoireacht-2-u02", "rev": 1, "stage": "sentence", "text": "Cén dath atá ar an ngeansaí?",
          "translation": { "en": "What colour is the jumper?" },
          "distractors": { "en": ["What size is the jumper?","How much is the jumper?"] } },
        { "id": "ga-a1-siopadoireacht-2-u03", "rev": 1, "stage": "word", "text": "gorm",
          "translation": { "en": "blue" },
          "distractors": { "en": ["green","black"] } },
        { "id": "ga-a1-siopadoireacht-2-u04", "rev": 1, "stage": "sentence", "text": "Tá sé gorm.",
          "translation": { "en": "It's blue." },
          "distractors": { "en": ["It's green.","It's black."] } },
        { "id": "ga-a1-siopadoireacht-2-u05", "rev": 1, "stage": "phrase", "text": "léine dhearg",
          "translation": { "en": "a red shirt" },
          "distractors": { "en": ["a red jumper","a blue shirt"] } },
        { "id": "ga-a1-siopadoireacht-2-u06", "rev": 1, "stage": "phrase", "text": "léine bhán",
          "translation": { "en": "a white shirt" },
          "distractors": { "en": ["a white jumper","a black shirt"] } },
        { "id": "ga-a1-siopadoireacht-2-u07", "rev": 1, "stage": "sentence", "text": "Ba mhaith liom léine bhán.",
          "translation": { "en": "I'd like a white shirt." },
          "distractors": { "en": ["I'd like a black shirt.","I'd like a white jumper."] } },
        { "id": "ga-a1-siopadoireacht-2-u08", "rev": 1, "stage": "word", "text": "glas",
          "translation": { "en": "green" },
          "distractors": { "en": ["blue","yellow"] } },
        { "id": "ga-a1-siopadoireacht-2-u09", "rev": 1, "stage": "sentence", "text": "Tá gúna glas uaithi.",
          "translation": { "en": "She needs a green dress." },
          "distractors": { "en": ["She has a green dress.","She needs a blue dress."] } },
        { "id": "ga-a1-siopadoireacht-2-u10", "rev": 1, "stage": "phrase", "text": "léine ghorm",
          "translation": { "en": "a blue shirt" },
          "distractors": { "en": ["a green shirt","a blue jumper"] } },
        { "id": "ga-a1-siopadoireacht-2-u11", "rev": 1, "stage": "sentence", "text": "Tá léine ghorm agus bríste dubh air.",
          "translation": { "en": "He's wearing a blue shirt and black trousers." },
          "distractors": { "en": ["He's wearing a black shirt and blue trousers.","She's wearing a blue shirt and black trousers."] } },
        { "id": "ga-a1-siopadoireacht-2-u12", "rev": 1, "stage": "word", "text": "buí",
          "translation": { "en": "yellow" },
          "distractors": { "en": ["white","green"] } },
        { "id": "ga-a1-siopadoireacht-2-u13", "rev": 1, "stage": "sentence", "text": "Is breá liom an cóta buí sin.",
          "translation": { "en": "I love that yellow coat." },
          "distractors": { "en": ["I love this yellow coat.","I love that green coat."] } },
        { "id": "ga-a1-siopadoireacht-2-u14", "rev": 1, "stage": "phrase", "text": "bróga donna",
          "translation": { "en": "brown shoes" },
          "distractors": { "en": ["black shoes","a brown shoe"] } },
        { "id": "ga-a1-siopadoireacht-2-u15", "rev": 1, "stage": "sentence", "text": "Tá cóta dubh agus bróga donna uirthi.",
          "translation": { "en": "She's wearing a black coat and brown shoes." },
          "distractors": { "en": ["She's wearing a brown coat and black shoes.","He's wearing a black coat and brown shoes."] } }
      ]
    },
    {
      "id": "ga-a1-siopadoireacht-3",
      "title": "Cé mhéad atá air?",
      "grammarFocus": { "en": ["cé mhéad atá ar ...? = how much is ...?","ró- lenites: daor, ródhaor = too expensive","an- doesn't lenite d, t or s: an-daor","níos + comparative = more ...: níos saoire = cheaper"] },
      "units": [
        { "id": "ga-a1-siopadoireacht-3-u01", "rev": 1, "stage": "sentence", "text": "Cé mhéad atá ar an ngeansaí seo?",
          "translation": { "en": "How much is this jumper?" },
          "distractors": { "en": ["How much is that jumper?","What colour is this jumper?"] } },
        { "id": "ga-a1-siopadoireacht-3-u02", "rev": 1, "stage": "sentence", "text": "Tá sé tríocha euro.", "variants": ["Tá sé 30 euro."],
          "translation": { "en": "It's thirty euro." },
          "distractors": { "en": ["It's thirteen euro.","It's forty euro."] } },
        { "id": "ga-a1-siopadoireacht-3-u03", "rev": 1, "stage": "word", "text": "daor",
          "translation": { "en": "expensive" },
          "distractors": { "en": ["cheap","new"] } },
        { "id": "ga-a1-siopadoireacht-3-u04", "rev": 1, "stage": "sentence", "text": "Tá sé an-daor!",
          "translation": { "en": "It's very expensive!" },
          "distractors": { "en": ["It's very cheap!","It isn't expensive!"] } },
        { "id": "ga-a1-siopadoireacht-3-u05", "rev": 1, "stage": "phrase", "text": "ródhaor",
          "translation": { "en": "too expensive" },
          "distractors": { "en": ["too cheap","very expensive"] } },
        { "id": "ga-a1-siopadoireacht-3-u06", "rev": 1, "stage": "sentence", "text": "Tá an cóta seo ródhaor.",
          "translation": { "en": "This coat is too expensive." },
          "distractors": { "en": ["This coat is too big.","That coat is too expensive."] } },
        { "id": "ga-a1-siopadoireacht-3-u07", "rev": 1, "stage": "sentence", "text": "Tá sé saor, níl sé ach deich n-euro.", "variants": ["Tá sé saor, níl sé ach 10 euro."],
          "translation": { "en": "It's cheap, it's only ten euro." },
          "distractors": { "en": ["It's expensive, it's ten euro.","It's cheap, it's only two euro."] } },
        { "id": "ga-a1-siopadoireacht-3-u08", "rev": 1, "stage": "phrase", "text": "níos saoire",
          "translation": { "en": "cheaper" },
          "distractors": { "en": ["more expensive","cheapest"] } },
        { "id": "ga-a1-siopadoireacht-3-u09", "rev": 1, "stage": "sentence", "text": "An bhfuil ceann níos saoire agat?", "senses": {"0":"q"},
          "translation": { "en": "Do you have a cheaper one?" },
          "distractors": { "en": ["Do you have a more expensive one?","Is there a cheaper shop?"] } },
        { "id": "ga-a1-siopadoireacht-3-u10", "rev": 1, "stage": "sentence", "text": "Tá an ceann seo níos saoire.",
          "translation": { "en": "This one is cheaper." },
          "distractors": { "en": ["That one is cheaper.","This one is more expensive."] } },
        { "id": "ga-a1-siopadoireacht-3-u11", "rev": 1, "stage": "sentence", "text": "Cé mhéad atá ar na bróga?",
          "translation": { "en": "How much are the shoes?" },
          "distractors": { "en": ["How much is the shoe?","What colour are the shoes?"] } },
        { "id": "ga-a1-siopadoireacht-3-u12", "rev": 1, "stage": "sentence", "text": "Seasca euro.", "variants": ["60 euro."],
          "translation": { "en": "Sixty euro." },
          "distractors": { "en": ["Sixteen euro.","Seventy euro."] } },
        { "id": "ga-a1-siopadoireacht-3-u13", "rev": 1, "stage": "sentence", "text": "Tá sé sin ceart go leor.",
          "translation": { "en": "That's okay." },
          "distractors": { "en": ["That's too much.","That's not okay."] } }
      ]
    },
    {
      "id": "ga-a1-siopadoireacht-4",
      "title": "An féidir liom é a thriail?",
      "grammarFocus": { "en": ["ró- makes too: róbheag = too small, rómhór = too big","níos mó = bigger (mór has an irregular comparative)","tógfaidh mé é = I'll take it (a future form, learn it as a phrase)"] },
      "units": [
        { "id": "ga-a1-siopadoireacht-4-u01", "rev": 1, "stage": "word", "text": "méid",
          "translation": { "en": "size" },
          "distractors": { "en": ["colour","price"] } },
        { "id": "ga-a1-siopadoireacht-4-u02", "rev": 1, "stage": "sentence", "text": "Cén méid atá uait?",
          "translation": { "en": "What size do you need?" },
          "distractors": { "en": ["What colour do you need?","What size are you wearing?"] } },
        { "id": "ga-a1-siopadoireacht-4-u03", "rev": 1, "stage": "sentence", "text": "An féidir liom é a thriail?", "senses": {"0":"q","4":"to"},
          "translation": { "en": "Can I try it on?" },
          "distractors": { "en": ["Can you try it on?","Can I take it?"] } },
        { "id": "ga-a1-siopadoireacht-4-u04", "rev": 1, "stage": "phrase", "text": "seomra feistis",
          "translation": { "en": "fitting room" },
          "distractors": { "en": ["bathroom","shop"] } },
        { "id": "ga-a1-siopadoireacht-4-u05", "rev": 1, "stage": "sentence", "text": "Cá bhfuil an seomra feistis?",
          "translation": { "en": "Where's the fitting room?" },
          "distractors": { "en": ["Where's the bathroom?","Is there a fitting room?"] } },
        { "id": "ga-a1-siopadoireacht-4-u06", "rev": 1, "stage": "word", "text": "róbheag",
          "translation": { "en": "too small" },
          "distractors": { "en": ["too big","very small"] } },
        { "id": "ga-a1-siopadoireacht-4-u07", "rev": 1, "stage": "sentence", "text": "Tá sé róbheag.",
          "translation": { "en": "It's too small." },
          "distractors": { "en": ["It's too big.","It's very small."] } },
        { "id": "ga-a1-siopadoireacht-4-u08", "rev": 1, "stage": "word", "text": "rómhór",
          "translation": { "en": "too big" },
          "distractors": { "en": ["too small","very big"] } },
        { "id": "ga-a1-siopadoireacht-4-u09", "rev": 1, "stage": "sentence", "text": "Tá na bróga seo rómhór.",
          "translation": { "en": "These shoes are too big." },
          "distractors": { "en": ["These shoes are too small.","Those shoes are too big."] } },
        { "id": "ga-a1-siopadoireacht-4-u10", "rev": 1, "stage": "phrase", "text": "níos mó",
          "translation": { "en": "bigger" },
          "distractors": { "en": ["smaller","cheaper"] } },
        { "id": "ga-a1-siopadoireacht-4-u11", "rev": 1, "stage": "sentence", "text": "An bhfuil ceann níos mó agat?", "senses": {"0":"q"},
          "translation": { "en": "Do you have a bigger one?" },
          "distractors": { "en": ["Do you have a smaller one?","Do you have a cheaper one?"] } },
        { "id": "ga-a1-siopadoireacht-4-u12", "rev": 1, "stage": "word", "text": "feileann",
          "translation": { "en": "suits" },
          "distractors": { "en": ["fits badly","costs"] } },
        { "id": "ga-a1-siopadoireacht-4-u13", "rev": 1, "stage": "sentence", "text": "Feileann an dath sin duit.",
          "translation": { "en": "That colour suits you." },
          "distractors": { "en": ["That colour doesn't suit you.","This colour suits you."] } },
        { "id": "ga-a1-siopadoireacht-4-u14", "rev": 1, "stage": "word", "text": "foirfe",
          "translation": { "en": "perfect" },
          "distractors": { "en": ["too big","new"] } },
        { "id": "ga-a1-siopadoireacht-4-u15", "rev": 1, "stage": "sentence", "text": "Tá sé foirfe!",
          "translation": { "en": "It's perfect!" },
          "distractors": { "en": ["It's awful!","It's too big!"] } },
        { "id": "ga-a1-siopadoireacht-4-u16", "rev": 1, "stage": "chunk", "text": "tógfaidh mé é",
          "translation": { "en": "I'll take it" },
          "distractors": { "en": ["I took it","I'll try it on"] } },
        { "id": "ga-a1-siopadoireacht-4-u17", "rev": 1, "stage": "sentence", "text": "Tógfaidh mé an ceann gorm.",
          "translation": { "en": "I'll take the blue one." },
          "distractors": { "en": ["I'll take the green one.","I'll try the blue one."] } }
      ]
    },
    {
      "id": "ga-a1-siopadoireacht-5",
      "title": "Ag íoc",
      "grammarFocus": { "en": ["le puts h before a vowel: le hairgead tirim = with cash","do lenites: sóinseáil, do shóinseáil = your change","ar fad = altogether"] },
      "units": [
        { "id": "ga-a1-siopadoireacht-5-u01", "rev": 1, "stage": "word", "text": "cárta",
          "translation": { "en": "card" },
          "distractors": { "en": ["cash","receipt"] } },
        { "id": "ga-a1-siopadoireacht-5-u02", "rev": 1, "stage": "word", "text": "íoc",
          "translation": { "en": "paying, to pay" },
          "distractors": { "en": ["buying","selling"] } },
        { "id": "ga-a1-siopadoireacht-5-u03", "rev": 1, "stage": "sentence", "text": "An féidir liom íoc le cárta?", "senses": {"0":"q"},
          "translation": { "en": "Can I pay by card?" },
          "distractors": { "en": ["Can I pay with cash?","Can you pay by card?"] } },
        { "id": "ga-a1-siopadoireacht-5-u04", "rev": 1, "stage": "phrase", "text": "airgead tirim",
          "translation": { "en": "cash" },
          "distractors": { "en": ["card","change"] } },
        { "id": "ga-a1-siopadoireacht-5-u05", "rev": 1, "stage": "sentence", "text": "Cinnte, nó le hairgead tirim.",
          "translation": { "en": "Of course, or with cash." },
          "distractors": { "en": ["Sorry, only with cash.","Of course, or by card."] } },
        { "id": "ga-a1-siopadoireacht-5-u06", "rev": 1, "stage": "sentence", "text": "Níl airgead tirim agam.",
          "translation": { "en": "I don't have cash." },
          "distractors": { "en": ["I have cash.","I don't have a card."] } },
        { "id": "ga-a1-siopadoireacht-5-u07", "rev": 1, "stage": "sentence", "text": "Sin fiche euro ar fad.", "variants": ["Sin 20 euro ar fad."],
          "translation": { "en": "That's twenty euro altogether." },
          "distractors": { "en": ["That's twelve euro altogether.","That's twenty euro each."] } },
        { "id": "ga-a1-siopadoireacht-5-u08", "rev": 1, "stage": "word", "text": "mála",
          "translation": { "en": "bag" },
          "distractors": { "en": ["box","receipt"] } },
        { "id": "ga-a1-siopadoireacht-5-u09", "rev": 1, "stage": "sentence", "text": "An bhfuil mála uait?", "senses": {"0":"q"},
          "translation": { "en": "Do you need a bag?" },
          "distractors": { "en": ["Do you have a bag?","Do you need a receipt?"] } },
        { "id": "ga-a1-siopadoireacht-5-u10", "rev": 1, "stage": "sentence", "text": "Níl, go raibh maith agat, tá mála agam.",
          "translation": { "en": "No, thanks, I have a bag." },
          "distractors": { "en": ["Yes, thanks, I need a bag.","No, thanks, I don't have a bag."] } },
        { "id": "ga-a1-siopadoireacht-5-u11", "rev": 1, "stage": "word", "text": "admháil",
          "translation": { "en": "receipt" },
          "distractors": { "en": ["bag","card"] } },
        { "id": "ga-a1-siopadoireacht-5-u12", "rev": 1, "stage": "sentence", "text": "Ar mhaith leat an admháil?", "senses": {"0":"cop"},
          "translation": { "en": "Would you like the receipt?" },
          "distractors": { "en": ["Do you have the receipt?","Would you like a bag?"] } },
        { "id": "ga-a1-siopadoireacht-5-u13", "rev": 1, "stage": "sentence", "text": "Seo duit do shóinseáil.",
          "translation": { "en": "Here's your change." },
          "distractors": { "en": ["Here's your receipt.","Here's your bag."] } }
      ]
    },
    {
      "id": "ga-a1-siopadoireacht-6",
      "title": "Ag an margadh",
      "grammarFocus": { "en": ["na puts h before a vowel: úlla, na húlla = the apples","ceann = one (thing), cinn = ones: sé cinn = six (of them)","ná after a comparative = than"] },
      "units": [
        { "id": "ga-a1-siopadoireacht-6-u01", "rev": 1, "stage": "word", "text": "margadh",
          "translation": { "en": "market" },
          "distractors": { "en": ["supermarket","shop"] } },
        { "id": "ga-a1-siopadoireacht-6-u02", "rev": 1, "stage": "sentence", "text": "Téim go dtí an margadh Dé Sathairn.",
          "translation": { "en": "I go to the market on Saturday." },
          "distractors": { "en": ["I go to the supermarket on Saturday.","I go to the market on Sunday."] } },
        { "id": "ga-a1-siopadoireacht-6-u03", "rev": 1, "stage": "word", "text": "úlla",
          "translation": { "en": "apples" },
          "distractors": { "en": ["oranges","tomatoes"] } },
        { "id": "ga-a1-siopadoireacht-6-u04", "rev": 1, "stage": "word", "text": "oráistí",
          "translation": { "en": "oranges" },
          "distractors": { "en": ["apples","lemons"] } },
        { "id": "ga-a1-siopadoireacht-6-u05", "rev": 1, "stage": "sentence", "text": "Tá úlla agus oráistí uaim.",
          "translation": { "en": "I need apples and oranges." },
          "distractors": { "en": ["I have apples and oranges.","I need apples and tomatoes."] } },
        { "id": "ga-a1-siopadoireacht-6-u06", "rev": 1, "stage": "sentence", "text": "Cé mhéad atá ar na húlla?",
          "translation": { "en": "How much are the apples?" },
          "distractors": { "en": ["How much are the oranges?","How many apples are there?"] } },
        { "id": "ga-a1-siopadoireacht-6-u07", "rev": 1, "stage": "sentence", "text": "Euro an ceann.",
          "translation": { "en": "A euro each." },
          "distractors": { "en": ["Two euro each.","A euro altogether."] } },
        { "id": "ga-a1-siopadoireacht-6-u08", "rev": 1, "stage": "sentence", "text": "Tabhair dom sé cinn, le do thoil.", "variants": ["Tabhair dom 6 cinn, le do thoil."], "senses": {"2":"six"},
          "translation": { "en": "Give me six, please." },
          "distractors": { "en": ["Give me seven, please.","Give me six apples, please."] } },
        { "id": "ga-a1-siopadoireacht-6-u09", "rev": 1, "stage": "word", "text": "trátaí",
          "translation": { "en": "tomatoes" },
          "distractors": { "en": ["potatoes","apples"] } },
        { "id": "ga-a1-siopadoireacht-6-u10", "rev": 1, "stage": "sentence", "text": "Tá na trátaí seo go hálainn.",
          "translation": { "en": "These tomatoes are lovely." },
          "distractors": { "en": ["These apples are lovely.","Those tomatoes are lovely."] } },
        { "id": "ga-a1-siopadoireacht-6-u11", "rev": 1, "stage": "word", "text": "cáis",
          "translation": { "en": "cheese" },
          "distractors": { "en": ["butter","bread"] } },
        { "id": "ga-a1-siopadoireacht-6-u12", "rev": 1, "stage": "sentence", "text": "Ba mhaith liom cáis, le do thoil.",
          "translation": { "en": "I'd like cheese, please." },
          "distractors": { "en": ["I'd like butter, please.","I like cheese, please."] } },
        { "id": "ga-a1-siopadoireacht-6-u13", "rev": 1, "stage": "sentence", "text": "Aon rud eile?",
          "translation": { "en": "Anything else?" },
          "distractors": { "en": ["Anything to drink?","Is that all?"] } },
        { "id": "ga-a1-siopadoireacht-6-u14", "rev": 1, "stage": "sentence", "text": "Sin é, go raibh maith agat.",
          "translation": { "en": "That's it, thanks." },
          "distractors": { "en": ["That's all, you're welcome.","That's not it, thanks."] } },
        { "id": "ga-a1-siopadoireacht-6-u15", "rev": 1, "stage": "sentence", "text": "Tá an margadh níos saoire ná an t-ollmhargadh.",
          "translation": { "en": "The market is cheaper than the supermarket." },
          "distractors": { "en": ["The supermarket is cheaper than the market.","The market is dearer than the supermarket."] } }
      ]
    }
  ]
}
