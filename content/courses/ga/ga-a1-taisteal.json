{
  "id": "ga-a1-taisteal",
  "language": "ga",
  "level": "A1",
  "order": 11,
  "title": "Taisteal agus Aimsir",
  "description": { "en": "Talk about the weather and the seasons, buy a train ticket, go on holiday, and say where you went" },
  "track": "main",
  "requires": ["ga-a1-siopadoireacht"],
  "introduces": ["grianmhar","fliuch","gaofar","báisteach","sneachta","scamallach","grian","taitin","samhradh","geimhreadh","earrach","bláth","fómhar","séasúr","minic","riamh","taistil","ticéad","fill","singil","eitleán","aerfort","pas","cathain","fág","sroich","ardán","ais","cois","farraige","trá","radharc","sliabh"],
  "lexicon": {
    "aimsir": { "lemma": "aimsir", "pos": "NOUN", "gloss": { "en": "weather, time (feminine)" } },
    "grianmhar": { "lemma": "grianmhar", "pos": "ADJ", "gloss": { "en": "sunny" } },
    "fliuch": { "lemma": "fliuch", "pos": "ADJ", "gloss": { "en": "wet" } },
    "gaofar": { "lemma": "gaofar", "pos": "ADJ", "gloss": { "en": "windy" } },
    "cur": { "lemma": "cuir", "pos": "VERB", "gloss": { "en": "putting (verbal noun of cuir): ag cur báistí = raining" } },
    "báistí": { "lemma": "báisteach", "pos": "NOUN", "gloss": { "en": "of rain (báisteach in the genitive): ag cur báistí = raining" } },
    "sneachta": { "lemma": "sneachta", "pos": "NOUN", "gloss": { "en": "snow (masculine): ag cur sneachta = snowing" } },
    "scamallach": { "lemma": "scamallach", "pos": "ADJ", "gloss": { "en": "cloudy" } },
    "ghrian": { "lemma": "grian", "pos": "NOUN", "gloss": { "en": "sun (grian, feminine, lenited after an)" } },
    "taitneamh": { "lemma": "taitin", "pos": "VERB", "gloss": { "en": "shining (verbal noun of taitin): ag taitneamh = shining" } },
    "samhradh": { "lemma": "samhradh", "pos": "NOUN", "gloss": { "en": "summer (masculine): sa samhradh = in summer" } },
    "geimhreadh": { "lemma": "geimhreadh", "pos": "NOUN", "gloss": { "en": "winter (masculine)" } },
    "gheimhreadh": { "lemma": "geimhreadh", "pos": "NOUN", "gloss": { "en": "winter (geimhreadh, lenited after sa)" } },
    "earrach": { "lemma": "earrach", "pos": "NOUN", "gloss": { "en": "spring (masculine): san earrach = in spring" } },
    "bláthanna": { "lemma": "bláth", "pos": "NOUN", "gloss": { "en": "flowers (plural of bláth)" } },
    "fómhar": { "lemma": "fómhar", "pos": "NOUN", "gloss": { "en": "autumn, harvest (masculine)" } },
    "fhómhar": { "lemma": "fómhar", "pos": "NOUN", "gloss": { "en": "autumn (fómhar, lenited after san)" } },
    "séasúr": { "lemma": "séasúr", "pos": "NOUN", "gloss": { "en": "season (masculine)" } },
    "minic": { "lemma": "minic", "pos": "ADJ", "gloss": { "en": "frequent: go minic = often" } },
    "riamh": { "lemma": "riamh", "pos": "ADV", "gloss": { "en": "ever; with a negative, never" } },
    "bhíonn": { "lemma": "bí", "pos": "VERB", "gloss": { "en": "is usually (bíonn, lenited after ní)" } },
    "an-te": { "lemma": "te", "pos": "ADJ", "gloss": { "en": "very hot (an- doesn't lenite t)" } },
    "taisteal": { "lemma": "taistil", "pos": "VERB", "gloss": { "en": "travelling (verbal noun of taistil)" } },
    "gaillimh": { "lemma": "Gaillimh", "pos": "PROPN", "gloss": { "en": "Galway" } },
    "tógaim": { "lemma": "tóg", "pos": "VERB", "gloss": { "en": "I take" } },
    "ticéad": { "lemma": "ticéad", "pos": "NOUN", "gloss": { "en": "ticket (masculine)" } },
    "fillte": { "lemma": "fill", "pos": "ADJ", "gloss": { "en": "returning: ticéad fillte = return ticket" } },
    "singil": { "lemma": "singil", "pos": "ADJ", "gloss": { "en": "single: ticéad singil = single ticket" } },
    "thicéad": { "lemma": "ticéad", "pos": "NOUN", "gloss": { "en": "ticket (ticéad, lenited after ar)" } },
    "eitleán": { "lemma": "eitleán", "pos": "NOUN", "gloss": { "en": "plane (masculine)" } },
    "aerfort": { "lemma": "aerfort", "pos": "NOUN", "gloss": { "en": "airport (masculine)" } },
    "t-aerfort": { "lemma": "aerfort", "pos": "NOUN", "gloss": { "en": "airport (aerfort, with t- after an)" } },
    "pas": { "lemma": "pas", "pos": "NOUN", "gloss": { "en": "passport (masculine)" } },
    "phas": { "lemma": "pas", "pos": "NOUN", "gloss": { "en": "passport (pas, lenited after do)" } },
    "cathain": { "lemma": "cathain", "pos": "ADV", "gloss": { "en": "when (in questions): cathain a ...?" } },
    "fhágann": { "lemma": "fág", "pos": "VERB", "gloss": { "en": "leaves (fágann, lenited after a): cathain a fhágann sí?" } },
    "fágann": { "lemma": "fág", "pos": "VERB", "gloss": { "en": "leaves (he, she, it, they)" } },
    "shroicheann": { "lemma": "sroich", "pos": "VERB", "gloss": { "en": "arrives (sroicheann, lenited after a)" } },
    "sroicheann": { "lemma": "sroich", "pos": "VERB", "gloss": { "en": "reaches, arrives at (he, she, it, they)" } },
    "ardán": { "lemma": "ardán", "pos": "NOUN", "gloss": { "en": "platform (masculine)" } },
    "t-ardán": { "lemma": "ardán", "pos": "NOUN", "gloss": { "en": "platform (ardán, with t- after cén)" } },
    "ais": { "lemma": "ais", "pos": "NOUN", "gloss": { "en": "back: ar ais = back" } },
    "beidh": { "lemma": "bí", "pos": "VERB", "gloss": { "en": "will be (future of tá): beidh mé = I'll be" } },
    "fanacht": { "lemma": "fan", "pos": "VERB", "gloss": { "en": "staying, waiting (verbal noun of fan): ag fanacht = staying" } },
    "cois": { "lemma": "cois", "pos": "ADP", "gloss": { "en": "beside: cois farraige = by the sea" } },
    "farraige": { "lemma": "farraige", "pos": "NOUN", "gloss": { "en": "sea (feminine)" } },
    "trá": { "lemma": "trá", "pos": "NOUN", "gloss": { "en": "beach, strand (feminine)" } },
    "an-fhuar": { "lemma": "fuar", "pos": "ADJ", "gloss": { "en": "very cold (an- lenites: an-fhuar; fh is silent)" } },
    "radharc": { "lemma": "radharc", "pos": "NOUN", "gloss": { "en": "view, sight (masculine)" } },
    "sléibhte": { "lemma": "sliabh", "pos": "NOUN", "gloss": { "en": "mountains (plural of sliabh)" } },
    "sna": { "lemma": "i", "pos": "ADP", "gloss": { "en": "in the (i + na, plural): sna sléibhte = in the mountains" } },
    "chuaigh": { "lemma": "téigh", "pos": "VERB", "gloss": { "en": "went (past of téigh): chuaigh mé = I went" } },
    "caite": { "lemma": "caith", "pos": "ADJ", "gloss": { "en": "spent, last: an tseachtain seo caite = last week" } },
    "chuamar": { "lemma": "téigh", "pos": "VERB", "gloss": { "en": "we went (past of téigh)" } }
  },
  "lessons": [
    {
      "id": "ga-a1-taisteal-1",
      "title": "Conas atá an aimsir?",
      "grammarFocus": { "en": ["weather uses tá sé: tá sé fuar = it's cold","ag cur báistí = raining (lit. putting rain)","grian is feminine: an ghrian = the sun"] },
      "units": [
        { "id": "ga-a1-taisteal-1-u01", "rev": 1, "stage": "word", "text": "aimsir",
          "translation": { "en": "weather" },
          "distractors": { "en": ["time","season"] } },
        { "id": "ga-a1-taisteal-1-u02", "rev": 1, "stage": "sentence", "text": "Conas atá an aimsir inniu?",
          "translation": { "en": "How's the weather today?" },
          "distractors": { "en": ["How's the weather tomorrow?","How are you today?"] } },
        { "id": "ga-a1-taisteal-1-u03", "rev": 1, "stage": "word", "text": "fuar",
          "translation": { "en": "cold" },
          "distractors": { "en": ["warm","wet"] } },
        { "id": "ga-a1-taisteal-1-u04", "rev": 1, "stage": "sentence", "text": "Tá sé fuar inniu.",
          "translation": { "en": "It's cold today." },
          "distractors": { "en": ["It's warm today.","It's cold tomorrow."] } },
        { "id": "ga-a1-taisteal-1-u05", "rev": 1, "stage": "word", "text": "grianmhar",
          "translation": { "en": "sunny" },
          "distractors": { "en": ["cloudy","windy"] } },
        { "id": "ga-a1-taisteal-1-u06", "rev": 1, "stage": "sentence", "text": "Tá sé te agus grianmhar.",
          "translation": { "en": "It's warm and sunny." },
          "distractors": { "en": ["It's cold and sunny.","It's warm and cloudy."] } },
        { "id": "ga-a1-taisteal-1-u07", "rev": 1, "stage": "word", "text": "fliuch",
          "translation": { "en": "wet" },
          "distractors": { "en": ["dry","cold"] } },
        { "id": "ga-a1-taisteal-1-u08", "rev": 1, "stage": "word", "text": "gaofar",
          "translation": { "en": "windy" },
          "distractors": { "en": ["wet","sunny"] } },
        { "id": "ga-a1-taisteal-1-u09", "rev": 1, "stage": "sentence", "text": "Tá sé fliuch agus gaofar.",
          "translation": { "en": "It's wet and windy." },
          "distractors": { "en": ["It's dry and windy.","It's wet and cold."] } },
        { "id": "ga-a1-taisteal-1-u10", "rev": 1, "stage": "phrase", "text": "ag cur báistí",
          "translation": { "en": "raining" },
          "distractors": { "en": ["snowing","sunny"] } },
        { "id": "ga-a1-taisteal-1-u11", "rev": 1, "stage": "sentence", "text": "Tá sé ag cur báistí arís!",
          "translation": { "en": "It's raining again!" },
          "distractors": { "en": ["It's snowing again!","It's not raining again!"] } },
        { "id": "ga-a1-taisteal-1-u12", "rev": 1, "stage": "phrase", "text": "ag cur sneachta",
          "translation": { "en": "snowing" },
          "distractors": { "en": ["raining","freezing"] } },
        { "id": "ga-a1-taisteal-1-u13", "rev": 1, "stage": "sentence", "text": "An bhfuil sé ag cur sneachta?", "senses": {"0":"q"},
          "translation": { "en": "Is it snowing?" },
          "distractors": { "en": ["Is it raining?","Will it snow?"] } },
        { "id": "ga-a1-taisteal-1-u14", "rev": 1, "stage": "word", "text": "scamallach",
          "translation": { "en": "cloudy" },
          "distractors": { "en": ["sunny","foggy"] } },
        { "id": "ga-a1-taisteal-1-u15", "rev": 1, "stage": "sentence", "text": "Tá sé scamallach, ach níl sé fuar.",
          "translation": { "en": "It's cloudy, but it's not cold." },
          "distractors": { "en": ["It's sunny, but it's not cold.","It's cloudy, and it's cold."] } },
        { "id": "ga-a1-taisteal-1-u16", "rev": 1, "stage": "phrase", "text": "an ghrian",
          "translation": { "en": "the sun" },
          "distractors": { "en": ["the rain","the wind"] } },
        { "id": "ga-a1-taisteal-1-u17", "rev": 1, "stage": "sentence", "text": "Tá an ghrian ag taitneamh.",
          "translation": { "en": "The sun is shining." },
          "distractors": { "en": ["The rain is falling.","The sun isn't shining."] } },
        { "id": "ga-a1-taisteal-1-u18", "rev": 1, "stage": "sentence", "text": "Is lá breá é!",
          "translation": { "en": "It's a fine day!" },
          "distractors": { "en": ["It's an awful day!","It's a fine night!"] } }
      ]
    },
    {
      "id": "ga-a1-taisteal-2",
      "title": "Sa samhradh",
      "grammarFocus": { "en": ["sa and san before the season: sa samhradh, sa gheimhreadh, san earrach, san fhómhar","san lenites f: fómhar, san fhómhar (fh is silent)","bíonn sé = it's usually"] },
      "units": [
        { "id": "ga-a1-taisteal-2-u01", "rev": 1, "stage": "word", "text": "samhradh",
          "translation": { "en": "summer" },
          "distractors": { "en": ["winter","spring"] } },
        { "id": "ga-a1-taisteal-2-u02", "rev": 1, "stage": "sentence", "text": "Bíonn sé te sa samhradh.",
          "translation": { "en": "It's usually warm in summer." },
          "distractors": { "en": ["It's usually cold in summer.","It's usually warm in spring."] } },
        { "id": "ga-a1-taisteal-2-u03", "rev": 1, "stage": "word", "text": "geimhreadh",
          "translation": { "en": "winter" },
          "distractors": { "en": ["summer","autumn"] } },
        { "id": "ga-a1-taisteal-2-u04", "rev": 1, "stage": "phrase", "text": "sa gheimhreadh",
          "translation": { "en": "in winter" },
          "distractors": { "en": ["in summer","in autumn"] } },
        { "id": "ga-a1-taisteal-2-u05", "rev": 1, "stage": "sentence", "text": "Bíonn sé fuar agus fliuch sa gheimhreadh.",
          "translation": { "en": "It's usually cold and wet in winter." },
          "distractors": { "en": ["It's usually cold and dry in winter.","It's usually warm and wet in winter."] } },
        { "id": "ga-a1-taisteal-2-u06", "rev": 1, "stage": "word", "text": "earrach",
          "translation": { "en": "spring" },
          "distractors": { "en": ["autumn","summer"] } },
        { "id": "ga-a1-taisteal-2-u07", "rev": 1, "stage": "word", "text": "bláthanna",
          "translation": { "en": "flowers" },
          "distractors": { "en": ["trees","leaves"] } },
        { "id": "ga-a1-taisteal-2-u08", "rev": 1, "stage": "sentence", "text": "Bíonn na bláthanna go hálainn san earrach.",
          "translation": { "en": "The flowers are lovely in spring." },
          "distractors": { "en": ["The flowers are lovely in summer.","The trees are lovely in spring."] } },
        { "id": "ga-a1-taisteal-2-u09", "rev": 1, "stage": "word", "text": "fómhar",
          "translation": { "en": "autumn" },
          "distractors": { "en": ["spring","winter"] } },
        { "id": "ga-a1-taisteal-2-u10", "rev": 1, "stage": "phrase", "text": "san fhómhar",
          "translation": { "en": "in autumn" },
          "distractors": { "en": ["in spring","in winter"] } },
        { "id": "ga-a1-taisteal-2-u11", "rev": 1, "stage": "sentence", "text": "Is breá liom an fómhar.",
          "translation": { "en": "I love autumn." },
          "distractors": { "en": ["I love spring.","I like autumn."] } },
        { "id": "ga-a1-taisteal-2-u12", "rev": 1, "stage": "word", "text": "séasúr",
          "translation": { "en": "season" },
          "distractors": { "en": ["weather","month"] } },
        { "id": "ga-a1-taisteal-2-u13", "rev": 1, "stage": "sentence", "text": "Cén séasúr is fearr leat?",
          "translation": { "en": "Which season do you like best?" },
          "distractors": { "en": ["Which season don't you like?","Which month do you like best?"] } },
        { "id": "ga-a1-taisteal-2-u14", "rev": 1, "stage": "sentence", "text": "Is fearr liom an samhradh.",
          "translation": { "en": "I prefer summer." },
          "distractors": { "en": ["I prefer winter.","I love summer."] } },
        { "id": "ga-a1-taisteal-2-u15", "rev": 1, "stage": "word", "text": "minic",
          "translation": { "en": "often" },
          "distractors": { "en": ["never","sometimes"] } },
        { "id": "ga-a1-taisteal-2-u16", "rev": 1, "stage": "sentence", "text": "Bíonn sé ag cur báistí go minic in Éirinn.",
          "translation": { "en": "It often rains in Ireland." },
          "distractors": { "en": ["It never rains in Ireland.","It often snows in Ireland."] } },
        { "id": "ga-a1-taisteal-2-u17", "rev": 1, "stage": "word", "text": "riamh",
          "translation": { "en": "never, ever" },
          "distractors": { "en": ["often","always"] } },
        { "id": "ga-a1-taisteal-2-u18", "rev": 1, "stage": "sentence", "text": "Ní bhíonn sé an-te riamh.",
          "translation": { "en": "It's never very hot." },
          "distractors": { "en": ["It's always very hot.","It's never very cold."] } }
      ]
    },
    {
      "id": "ga-a1-taisteal-3",
      "title": "Ag taisteal",
      "grammarFocus": { "en": ["go = to (a place without the article): go Gaillimh","ar lenites a noun without the article: ticéad, ar thicéad"] },
      "units": [
        { "id": "ga-a1-taisteal-3-u01", "rev": 1, "stage": "phrase", "text": "ag taisteal",
          "translation": { "en": "travelling" },
          "distractors": { "en": ["working","walking"] } },
        { "id": "ga-a1-taisteal-3-u02", "rev": 1, "stage": "sentence", "text": "Is breá liom taisteal.",
          "translation": { "en": "I love travelling." },
          "distractors": { "en": ["I like travelling.","I love walking."] } },
        { "id": "ga-a1-taisteal-3-u03", "rev": 1, "stage": "sentence", "text": "Tá mé ag dul go Gaillimh amárach.",
          "translation": { "en": "I'm going to Galway tomorrow." },
          "distractors": { "en": ["I'm going to Cork tomorrow.","I'm going to Galway today."] } },
        { "id": "ga-a1-taisteal-3-u04", "rev": 1, "stage": "phrase", "text": "tógaim an traein",
          "translation": { "en": "I take the train" },
          "distractors": { "en": ["I take the bus","I took the train"] } },
        { "id": "ga-a1-taisteal-3-u05", "rev": 1, "stage": "sentence", "text": "Tógaim an traein go Gaillimh.",
          "translation": { "en": "I take the train to Galway." },
          "distractors": { "en": ["I take the bus to Galway.","I take the train to Cork."] } },
        { "id": "ga-a1-taisteal-3-u06", "rev": 1, "stage": "word", "text": "ticéad",
          "translation": { "en": "ticket" },
          "distractors": { "en": ["passport","map"] } },
        { "id": "ga-a1-taisteal-3-u07", "rev": 1, "stage": "phrase", "text": "ticéad fillte",
          "translation": { "en": "return ticket" },
          "distractors": { "en": ["single ticket","train ticket"] } },
        { "id": "ga-a1-taisteal-3-u08", "rev": 1, "stage": "sentence", "text": "Ticéad fillte go Gaillimh, le do thoil.",
          "translation": { "en": "A return ticket to Galway, please." },
          "distractors": { "en": ["A single ticket to Galway, please.","A return ticket to Cork, please."] } },
        { "id": "ga-a1-taisteal-3-u09", "rev": 1, "stage": "phrase", "text": "ticéad singil",
          "translation": { "en": "single ticket" },
          "distractors": { "en": ["return ticket","cheap ticket"] } },
        { "id": "ga-a1-taisteal-3-u10", "rev": 1, "stage": "sentence", "text": "Cé mhéad atá ar thicéad singil?",
          "translation": { "en": "How much is a single ticket?" },
          "distractors": { "en": ["How much is a return ticket?","Where's the single ticket?"] } },
        { "id": "ga-a1-taisteal-3-u11", "rev": 1, "stage": "sentence", "text": "Tá sé daichead euro.", "variants": ["Tá sé 40 euro."],
          "translation": { "en": "It's forty euro." },
          "distractors": { "en": ["It's fourteen euro.","It's thirty euro."] } },
        { "id": "ga-a1-taisteal-3-u12", "rev": 1, "stage": "word", "text": "eitleán",
          "translation": { "en": "plane" },
          "distractors": { "en": ["train","boat"] } },
        { "id": "ga-a1-taisteal-3-u13", "rev": 1, "stage": "sentence", "text": "Téim go Meiriceá ar an eitleán.",
          "translation": { "en": "I go to America by plane." },
          "distractors": { "en": ["I go to America by boat.","I go to England by plane."] } },
        { "id": "ga-a1-taisteal-3-u14", "rev": 1, "stage": "word", "text": "aerfort",
          "translation": { "en": "airport" },
          "distractors": { "en": ["station","port"] } },
        { "id": "ga-a1-taisteal-3-u15", "rev": 1, "stage": "sentence", "text": "Cá bhfuil an t-aerfort?",
          "translation": { "en": "Where's the airport?" },
          "distractors": { "en": ["Where's the station?","Is there an airport?"] } },
        { "id": "ga-a1-taisteal-3-u16", "rev": 1, "stage": "word", "text": "pas",
          "translation": { "en": "passport" },
          "distractors": { "en": ["ticket","bag"] } },
        { "id": "ga-a1-taisteal-3-u17", "rev": 1, "stage": "sentence", "text": "An bhfuil do phas agat?", "senses": {"0":"q"},
          "translation": { "en": "Do you have your passport?" },
          "distractors": { "en": ["Do you have your ticket?","Do you have my passport?"] } }
      ]
    },
    {
      "id": "ga-a1-taisteal-4",
      "title": "Ag an stáisiún",
      "grammarFocus": { "en": ["traein is feminine, so it's sí: fágann sí = it leaves","cathain a ...? = when ...?; a lenites the verb: cathain a fhágann sí?"] },
      "units": [
        { "id": "ga-a1-taisteal-4-u01", "rev": 1, "stage": "word", "text": "cathain",
          "translation": { "en": "when" },
          "distractors": { "en": ["where","how"] } },
        { "id": "ga-a1-taisteal-4-u02", "rev": 1, "stage": "sentence", "text": "Cathain a fhágann an traein?", "senses": {"1":"rel"},
          "translation": { "en": "When does the train leave?" },
          "distractors": { "en": ["When does the train arrive?","Where does the train leave from?"] } },
        { "id": "ga-a1-taisteal-4-u03", "rev": 1, "stage": "sentence", "text": "Fágann sí ar a deich.", "senses": {"3":"num"},
          "translation": { "en": "It leaves at ten." },
          "distractors": { "en": ["It arrives at ten.","It leaves at two."] } },
        { "id": "ga-a1-taisteal-4-u04", "rev": 1, "stage": "sentence", "text": "Cathain a shroicheann sí Gaillimh?", "senses": {"1":"rel"},
