  "lessons": [
    {
      "id": "ga-a1-failte-1",
      "title": "Dia duit",
      "grammarFocus": { "en": ["Irish greets with a blessing: Dia duit (God to you), and the reply adds Mary: Dia is Muire duit","a before a name you call lenites it: Seán, a Sheáin"] },
      "units": [
        { "id": "ga-a1-failte-1-u01", "rev": 1, "stage": "phrase", "text": "Dia duit",
          "translation": { "en": "hello" },
          "distractors": { "en": ["goodbye","thank you"] } },
        { "id": "ga-a1-failte-1-u02", "rev": 1, "stage": "sentence", "text": "Dia duit, a Áine.", "senses": {"2":"voc"},
          "translation": { "en": "Hello, Áine." },
          "distractors": { "en": ["Goodbye, Áine.","Thank you, Áine."] } },
        { "id": "ga-a1-failte-1-u03", "rev": 2, "stage": "phrase", "text": "Dia is Muire duit", "senses": {"1":"and"},
          "translation": { "en": "hello (the reply to Dia duit)" },
          "distractors": { "en": ["goodbye (the reply to slán)","thanks (the reply to go raibh maith agat)"] } },
        { "id": "ga-a1-failte-1-u04", "rev": 2, "stage": "sentence", "text": "Dia is Muire duit, a Sheáin.", "senses": {"1":"and","4":"voc"},
          "translation": { "en": "Hello to you too, Seán." },
          "distractors": { "en": ["Goodbye to you too, Seán.","Thank you too, Seán."] } },
        { "id": "ga-a1-failte-1-u05", "rev": 2, "stage": "word", "text": "maidin",
          "translation": { "en": "morning" },
          "distractors": { "en": ["night","evening"] } },
        { "id": "ga-a1-failte-1-u06", "rev": 2, "stage": "phrase", "text": "ar maidin",
          "translation": { "en": "in the morning" },
          "distractors": { "en": ["at night","in the evening"] } },
        { "id": "ga-a1-failte-1-u07", "rev": 2, "stage": "sentence", "text": "Dia duit ar maidin!",
          "translation": { "en": "Good morning!" },
          "distractors": { "en": ["Good night!","Good evening!"] } },
        { "id": "ga-a1-failte-1-u08", "rev": 1, "stage": "word", "text": "oíche",
          "translation": { "en": "night" },
          "distractors": { "en": ["morning","day"] } },
        { "id": "ga-a1-failte-1-u09", "rev": 1, "stage": "phrase", "text": "oíche mhaith",
          "translation": { "en": "good night" },
          "distractors": { "en": ["good morning","good luck"] } },
        { "id": "ga-a1-failte-1-u10", "rev": 1, "stage": "sentence", "text": "Oíche mhaith, a Liam!", "senses": {"2":"voc"},
          "translation": { "en": "Good night, Liam!" },
          "distractors": { "en": ["Good morning, Liam!","Thank you, Liam!"] } },
        { "id": "ga-a1-failte-1-u11", "rev": 1, "stage": "word", "text": "slán",
          "translation": { "en": "goodbye" },
          "distractors": { "en": ["hello","please"] } },
        { "id": "ga-a1-failte-1-u12", "rev": 1, "stage": "phrase", "text": "go fóill",
          "translation": { "en": "for now" },
          "distractors": { "en": ["again","tomorrow"] } },
        { "id": "ga-a1-failte-1-u13", "rev": 1, "stage": "sentence", "text": "Slán go fóill!",
          "translation": { "en": "Bye for now!" },
          "distractors": { "en": ["Hello again!","See you tomorrow!"] } },
        { "id": "ga-a1-failte-1-u14", "rev": 1, "stage": "word", "text": "cara",
          "translation": { "en": "friend" },
          "distractors": { "en": ["sister","brother"] } },
        { "id": "ga-a1-failte-1-u15", "rev": 1, "stage": "phrase", "text": "a chara", "senses": {"0":"voc"},
          "translation": { "en": "friend (calling someone)" },
          "distractors": { "en": ["my sister (calling her)","my brother (calling him)"] } },
        { "id": "ga-a1-failte-1-u16", "rev": 1, "stage": "sentence", "text": "Slán abhaile, a chara!", "senses": {"2":"voc"},
          "translation": { "en": "Safe home, friend!" },
          "distractors": { "en": ["Welcome home, friend!","Good night, friend!"] } }
      ]
    },
    {
      "id": "ga-a1-failte-2",
      "title": "Conas atá tú?",
      "grammarFocus": { "en": ["tá = am, is, are; níl = am not, is not, are not","go before an adjective makes an adverb: maith = good, go maith = well"] },
      "units": [
        { "id": "ga-a1-failte-2-u01", "rev": 2, "stage": "word", "text": "conas",
          "translation": { "en": "how" },
          "distractors": { "en": ["what","where"] } },
        { "id": "ga-a1-failte-2-u02", "rev": 2, "stage": "sentence", "text": "Conas atá tú?",
          "translation": { "en": "How are you?" },
          "distractors": { "en": ["Where are you?","Who are you?"] } },
        { "id": "ga-a1-failte-2-u03", "rev": 2, "stage": "word", "text": "maith",
          "translation": { "en": "good" },
          "distractors": { "en": ["bad","tired"] } },
        { "id": "ga-a1-failte-2-u04", "rev": 2, "stage": "phrase", "text": "go maith",
          "translation": { "en": "well" },
          "distractors": { "en": ["badly","not well"] } },
        { "id": "ga-a1-failte-2-u05", "rev": 2, "stage": "sentence", "text": "Tá mé go maith.",
          "translation": { "en": "I'm well." },
          "distractors": { "en": ["I'm tired.","You're well."] } },
        { "id": "ga-a1-failte-2-u06", "rev": 2, "stage": "chunk", "text": "go raibh maith agat",
          "translation": { "en": "thank you" },
          "distractors": { "en": ["you're welcome","excuse me"] } },
        { "id": "ga-a1-failte-2-u07", "rev": 2, "stage": "sentence", "text": "Tá mé go maith, go raibh maith agat.",
          "translation": { "en": "I'm well, thank you." },
          "distractors": { "en": ["I'm not well, thank you.","You're well, thank you."] } },
        { "id": "ga-a1-failte-2-u08", "rev": 2, "stage": "phrase", "text": "go breá",
          "translation": { "en": "fine, great" },
          "distractors": { "en": ["badly","so-so"] } },
        { "id": "ga-a1-failte-2-u09", "rev": 1, "stage": "sentence", "text": "Tá mé go breá, a Sheáin.", "senses": {"4":"voc"},
          "translation": { "en": "I'm fine, Seán." },
          "distractors": { "en": ["I'm tired, Seán.","You're fine, Seán."] } },
        { "id": "ga-a1-failte-2-u10", "rev": 1, "stage": "word", "text": "tuirseach",
          "translation": { "en": "tired" },
          "distractors": { "en": ["happy","hungry"] } },
        { "id": "ga-a1-failte-2-u11", "rev": 1, "stage": "sentence", "text": "Tá mé tuirseach inniu.",
          "translation": { "en": "I'm tired today." },
          "distractors": { "en": ["I'm happy today.","You're tired today."] } },
        { "id": "ga-a1-failte-2-u12", "rev": 1, "stage": "phrase", "text": "go dona",
          "translation": { "en": "badly, bad" },
          "distractors": { "en": ["well","great"] } },
        { "id": "ga-a1-failte-2-u13", "rev": 1, "stage": "sentence", "text": "Níl mé go dona.",
          "translation": { "en": "I'm not bad." },
          "distractors": { "en": ["I'm not tired.","You're not bad."] } },
        { "id": "ga-a1-failte-2-u14", "rev": 1, "stage": "phrase", "text": "tú féin",
          "translation": { "en": "you yourself" },
          "distractors": { "en": ["me myself","your friend"] } },
        { "id": "ga-a1-failte-2-u15", "rev": 1, "stage": "sentence", "text": "Conas atá tú féin?",
          "translation": { "en": "And how are you?" },
          "distractors": { "en": ["And where are you?","And who are you?"] } },
        { "id": "ga-a1-failte-2-u16", "rev": 1, "stage": "phrase", "text": "ceart go leor",
