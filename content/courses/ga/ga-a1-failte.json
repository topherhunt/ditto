{
  "id": "ga-a1-failte",
  "language": "ga",
  "level": "A1",
  "order": 1,
  "title": "Fáilte",
  "description": { "en": "Greetings, introducing yourself and your family, and a cup of tea" },
  "track": "main",
  "requires": [],
  "introduces": ["dia", "do", "a", "conas", "bí", "tú", "mé", "go", "maith", "ag", "slán", "fóill", "ainm", "cad", "is", "as", "seo", "sí", "sé", "mo", "deirfiúr", "deartháir", "tae", "caife", "cupán", "le", "toil"],
  "lexicon": {
    "dia": { "lemma": "dia", "pos": "NOUN", "gloss": { "en": "God; Dia duit = hello (lit. God to you)" } },
    "duit": { "lemma": "do", "pos": "ADP", "gloss": { "en": "to you (do + tú)" } },
    "dom": { "lemma": "do", "pos": "ADP", "gloss": { "en": "to me (do + mé)" } },
    "do": { "lemma": "do", "pos": "DET", "gloss": { "en": "your (one person); lenites: do thoil" } },
    "a": { "lemma": "a", "pos": "PART", "gloss": { "en": "particle before a name you address; lenites consonants (a Sheáin)" } },
    "áine": { "lemma": "Áine", "pos": "PROPN", "gloss": { "en": "Áine (a woman's name)" } },
    "seán": { "lemma": "Seán", "pos": "PROPN", "gloss": { "en": "Seán (a man's name)" } },
    "éirinn": { "lemma": "Éire", "pos": "PROPN", "gloss": { "en": "Ireland (Éire); as Éirinn = from Ireland" } },
    "conas": { "lemma": "conas", "pos": "ADV", "gloss": { "en": "how" } },
    "atá": { "lemma": "bí", "pos": "VERB", "gloss": { "en": "is, are (form of tá after conas)" } },
    "tá": { "lemma": "bí", "pos": "VERB", "gloss": { "en": "am, is, are (the verb bí, to be)" } },
    "raibh": { "lemma": "bí", "pos": "VERB", "gloss": { "en": "be (form of bí after go, ní, an)" } },
    "tú": { "lemma": "tú", "pos": "PRON", "gloss": { "en": "you (one person)" } },
    "mé": { "lemma": "mé", "pos": "PRON", "gloss": { "en": "I, me" } },
    "mise": { "lemma": "mé", "pos": "PRON", "gloss": { "en": "I, me (emphatic form of mé)" } },
    "go": { "lemma": "go", "pos": "PART", "gloss": { "en": "particle: go maith = well; go raibh = may (it) be; go fóill = for now" } },
    "maith": { "lemma": "maith", "pos": "ADJ", "gloss": { "en": "good; go maith = well" } },
    "mhaith": { "lemma": "maith", "pos": "ADJ", "gloss": { "en": "good (lenited maith, after ba, ar, níor)" } },
    "agat": { "lemma": "ag", "pos": "ADP", "gloss": { "en": "at you (ag + tú); go raibh maith agat = thank you" } },
    "slán": { "lemma": "slán", "pos": "ADJ", "gloss": { "en": "safe; slán = goodbye" } },
    "fóill": { "lemma": "fóill", "pos": "NOUN", "gloss": { "en": "go fóill = for now, yet" } },
    "ainm": { "lemma": "ainm", "pos": "NOUN", "gloss": { "en": "name" } },
    "cad": { "lemma": "cad", "pos": "PRON", "gloss": { "en": "what" } },
    "is": { "lemma": "is", "pos": "AUX", "gloss": { "en": "is, am, are (the copula, for identity: who or what something is)" } },
    "ba": { "lemma": "is", "pos": "AUX", "gloss": { "en": "would be (copula); ba mhaith liom = I would like" } },
    "ar": { "lemma": "is", "pos": "AUX", "gloss": { "en": "would ...? (copula question); ar mhaith leat? = would you like?" } },
    "níor": { "lemma": "is", "pos": "AUX", "gloss": { "en": "would not be (copula); níor mhaith = no (I wouldn't like)" } },
    "as": { "lemma": "as", "pos": "ADP", "gloss": { "en": "from, out of" } },
    "seo": { "lemma": "seo", "pos": "PRON", "gloss": { "en": "this, here" } },
    "í": { "lemma": "sí", "pos": "PRON", "gloss": { "en": "she, her (form of sí after seo and the copula)" } },
    "é": { "lemma": "sé", "pos": "PRON", "gloss": { "en": "he, him, it (form of sé after seo and the copula)" } },
    "mo": { "lemma": "mo", "pos": "DET", "gloss": { "en": "my; lenites: mo dheirfiúr" } },
    "dheirfiúr": { "lemma": "deirfiúr", "pos": "NOUN", "gloss": { "en": "sister (deirfiúr, lenited after mo)" } },
    "dheartháir": { "lemma": "deartháir", "pos": "NOUN", "gloss": { "en": "brother (deartháir, lenited after mo)" } },
    "tae": { "lemma": "tae", "pos": "NOUN", "gloss": { "en": "tea" } },
    "caife": { "lemma": "caife", "pos": "NOUN", "gloss": { "en": "coffee" } },
    "cupán": { "lemma": "cupán", "pos": "NOUN", "gloss": { "en": "cup; cupán tae = a cup of tea" } },
    "liom": { "lemma": "le", "pos": "ADP", "gloss": { "en": "with me (le + mé)" } },
    "leat": { "lemma": "le", "pos": "ADP", "gloss": { "en": "with you (le + tú)" } },
    "le": { "lemma": "le", "pos": "ADP", "gloss": { "en": "with; le do thoil = please" } },
    "thoil": { "lemma": "toil", "pos": "NOUN", "gloss": { "en": "will, wish (toil, lenited after do)" } }
  },
  "lessons": [
    {
      "id": "ga-a1-failte-1",
      "title": "Dia duit",
      "grammarFocus": { "en": ["Irish greets with a blessing: Dia duit", "prepositions merge with pronouns: do + tú = duit, ag + tú = agat"] },
      "units": [
        { "id": "ga-a1-failte-1-u01", "rev": 1, "stage": "phrase", "text": "Dia duit",
          "translation": { "en": "hello" },
          "distractors": { "en": ["goodbye", "thank you"] } },
        { "id": "ga-a1-failte-1-u02", "rev": 1, "stage": "sentence", "text": "Dia duit, a Áine.",
          "translation": { "en": "Hello, Áine." },
          "distractors": { "en": ["Goodbye, Áine.", "Thank you, Áine."] } },
        { "id": "ga-a1-failte-1-u03", "rev": 1, "stage": "sentence", "text": "Conas atá tú?",
          "translation": { "en": "How are you?" },
          "distractors": { "en": ["Where are you?", "Who are you?"] } },
        { "id": "ga-a1-failte-1-u04", "rev": 1, "stage": "sentence", "text": "Tá mé go maith.", "variants": ["Táim go maith."],
          "translation": { "en": "I'm well." },
          "distractors": { "en": ["I'm tired.", "You're well."] } },
        { "id": "ga-a1-failte-1-u05", "rev": 1, "stage": "chunk", "text": "go raibh maith agat",
          "translation": { "en": "thank you" },
          "distractors": { "en": ["you're welcome", "good morning"] } },
        { "id": "ga-a1-failte-1-u06", "rev": 1, "stage": "sentence", "text": "Tá mé go maith, go raibh maith agat.", "variants": ["Táim go maith, go raibh maith agat."],
          "translation": { "en": "I'm well, thank you." },
          "distractors": { "en": ["I'm not well, thank you.", "You're well, thank you."] } },
        { "id": "ga-a1-failte-1-u07", "rev": 1, "stage": "sentence", "text": "Slán go fóill!",
          "translation": { "en": "Bye for now!" },
          "distractors": { "en": ["Hello again!", "See you tomorrow!"] } }
      ]
    },
    {
      "id": "ga-a1-failte-2",
      "title": "Is mise Seán",
      "grammarFocus": { "en": ["the copula is says who or what something is", "mo lenites: deirfiúr becomes mo dheirfiúr"] },
      "units": [
        { "id": "ga-a1-failte-2-u01", "rev": 1, "stage": "word", "text": "ainm",
          "translation": { "en": "name" },
          "distractors": { "en": ["sister", "tea"] } },
        { "id": "ga-a1-failte-2-u02", "rev": 1, "stage": "sentence", "text": "Cad is ainm duit?",
          "translation": { "en": "What's your name?" },
          "distractors": { "en": ["Where are you from?", "How are you?"] } },
        { "id": "ga-a1-failte-2-u03", "rev": 1, "stage": "sentence", "text": "Is mise Seán.",
          "translation": { "en": "I'm Seán." },
          "distractors": { "en": ["This is Seán.", "You're Seán."] } },
        { "id": "ga-a1-failte-2-u04", "rev": 1, "stage": "sentence", "text": "Seán is ainm dom.",
          "translation": { "en": "My name is Seán." },
          "distractors": { "en": ["Seán is my brother.", "Your name is Seán."] } },
        { "id": "ga-a1-failte-2-u05", "rev": 1, "stage": "sentence", "text": "Is as Éirinn mé.",
          "translation": { "en": "I'm from Ireland." },
          "distractors": { "en": ["I'm in Ireland.", "I'm going to Ireland."] } },
        { "id": "ga-a1-failte-2-u06", "rev": 1, "stage": "phrase", "text": "mo dheirfiúr",
          "translation": { "en": "my sister" },
          "distractors": { "en": ["my brother", "your sister"] } },
        { "id": "ga-a1-failte-2-u07", "rev": 1, "stage": "sentence", "text": "Seo í mo dheirfiúr.",
          "translation": { "en": "This is my sister." },
          "distractors": { "en": ["This is my brother.", "Is this your sister?"] } },
        { "id": "ga-a1-failte-2-u08", "rev": 1, "stage": "sentence", "text": "Seo é mo dheartháir.",
          "translation": { "en": "This is my brother." },
          "distractors": { "en": ["This is my sister.", "Here is my father."] } }
      ]
    },
    {
      "id": "ga-a1-failte-3",
      "title": "Cupán tae",
      "grammarFocus": { "en": ["ba mhaith liom = I would like (lit. it would be good with me)", "no word for yes or no: answer with the verb (ba mhaith / níor mhaith)"] },
      "units": [
        { "id": "ga-a1-failte-3-u01", "rev": 1, "stage": "word", "text": "tae",
          "translation": { "en": "tea" },
          "distractors": { "en": ["coffee", "milk"] } },
        { "id": "ga-a1-failte-3-u02", "rev": 1, "stage": "phrase", "text": "cupán tae",
          "translation": { "en": "a cup of tea" },
          "distractors": { "en": ["a cup of coffee", "a pot of tea"] } },
        { "id": "ga-a1-failte-3-u03", "rev": 1, "stage": "sentence", "text": "Ba mhaith liom cupán tae.",
          "translation": { "en": "I'd like a cup of tea." },
          "distractors": { "en": ["I have a cup of tea.", "I'd like a cup of coffee."] } },
        { "id": "ga-a1-failte-3-u04", "rev": 1, "stage": "sentence", "text": "Ba mhaith liom caife, le do thoil.",
          "translation": { "en": "I'd like coffee, please." },
          "distractors": { "en": ["I'd like tea, please.", "I don't like coffee."] } },
        { "id": "ga-a1-failte-3-u05", "rev": 1, "stage": "sentence", "text": "Ar mhaith leat cupán tae?",
          "translation": { "en": "Would you like a cup of tea?" },
          "distractors": { "en": ["Do you have a cup of tea?", "Would you like a coffee?"] } },
        { "id": "ga-a1-failte-3-u06", "rev": 1, "stage": "sentence", "text": "Ba mhaith, go raibh maith agat.",
          "translation": { "en": "Yes please, thank you." },
          "distractors": { "en": ["No, thank you.", "I'm well, thank you."] } },
        { "id": "ga-a1-failte-3-u07", "rev": 1, "stage": "sentence", "text": "Níor mhaith, go raibh maith agat.",
          "translation": { "en": "No, thank you." },
          "distractors": { "en": ["Yes please, thank you.", "Not now, thanks."] } }
      ]
    }
  ]
}
