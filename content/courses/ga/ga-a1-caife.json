{
  "id": "ga-a1-caife",
  "language": "ga",
  "level": "A1",
  "order": 2,
  "title": "Sa Chaife",
  "description": { "en": "Order drinks and snacks, say you're hungry or thirsty, and say what you like and prefer" },
  "track": "main",
  "requires": ["ga-a1-failte"],
  "introduces": ["tae","caife","cupán","uisce","gloine","bainne","siúcra","gan","dubh","ocras","tart","ceapaire","anraith","babhla","arán","donn","cáca","píosa","biachlár","bille","folamh","lán","fuar","te","bord","saor","cathaoir","seacláid","ná","ól","ith","cáis","sú","oráiste","rud","éigin","eile","sin","méad","beirt","suigh","síos","anseo","deas","álainn"],
  "lexicon": {
    "tae": { "lemma": "tae", "pos": "NOUN", "gloss": { "en": "tea (masculine)" } },
    "caife": { "lemma": "caife", "pos": "NOUN", "gloss": { "en": "coffee; café (masculine)" } },
    "cupán": { "lemma": "cupán", "pos": "NOUN", "gloss": { "en": "cup (masculine)" } },
    "ba": { "lemma": "is", "pos": "AUX", "gloss": { "en": "would be (past and conditional of the copula; lenites: ba mhaith)" } },
    "liom": { "lemma": "le", "pos": "ADP", "gloss": { "en": "with me (le + mé); ba mhaith liom = I'd like" } },
    "uisce": { "lemma": "uisce", "pos": "NOUN", "gloss": { "en": "water (masculine)" } },
    "gloine": { "lemma": "gloine", "pos": "NOUN", "gloss": { "en": "glass (feminine)" } },
    "ar#cop": { "lemma": "is", "pos": "AUX", "gloss": { "en": "would...? (question form of ba; lenites): ar mhaith leat? = would you like?" } },
    "níor": { "lemma": "is", "pos": "AUX", "gloss": { "en": "would not (negative form of ba; lenites): níor mhaith = no, I wouldn't" } },
    "bainne": { "lemma": "bainne", "pos": "NOUN", "gloss": { "en": "milk (masculine)" } },
    "siúcra": { "lemma": "siúcra", "pos": "NOUN", "gloss": { "en": "sugar (masculine)" } },
    "gan": { "lemma": "gan", "pos": "ADP", "gloss": { "en": "without" } },
    "dubh": { "lemma": "dubh", "pos": "ADJ", "gloss": { "en": "black" } },
