    "tart": { "lemma": "tart", "pos": "NOUN", "gloss": { "en": "thirst; tá tart orm = I'm thirsty" } },
    "ort": { "lemma": "ar", "pos": "ADP", "gloss": { "en": "on you (ar + tú)" } },
    "air": { "lemma": "ar", "pos": "ADP", "gloss": { "en": "on him, on it (ar + é); cé mhéad atá air? = how much is it?" } },
    "uirthi": { "lemma": "ar", "pos": "ADP", "gloss": { "en": "on her (ar + í)" } },
    "ceapaire": { "lemma": "ceapaire", "pos": "NOUN", "gloss": { "en": "sandwich (masculine)" } },
    "anraith": { "lemma": "anraith", "pos": "NOUN", "gloss": { "en": "soup (masculine)" } },
    "babhla": { "lemma": "babhla", "pos": "NOUN", "gloss": { "en": "bowl (masculine)" } },
    "arán": { "lemma": "arán", "pos": "NOUN", "gloss": { "en": "bread (masculine)" } },
    "donn": { "lemma": "donn", "pos": "ADJ", "gloss": { "en": "brown" } },
    "cáca": { "lemma": "cáca", "pos": "NOUN", "gloss": { "en": "cake (masculine)" } },
    "píosa": { "lemma": "píosa", "pos": "NOUN", "gloss": { "en": "piece (masculine)" } },
    "biachlár": { "lemma": "biachlár", "pos": "NOUN", "gloss": { "en": "menu (masculine)" } },
    "an": { "lemma": "an", "pos": "DET", "gloss": { "en": "the; lenites a feminine noun (an ghloine) and puts t- before a masculine one starting with a vowel (an t-uisce)" } },
    "bille": { "lemma": "bille", "pos": "NOUN", "gloss": { "en": "bill (masculine)" } },
    "ghloine": { "lemma": "gloine", "pos": "NOUN", "gloss": { "en": "glass (gloine, lenited after an)" } },
