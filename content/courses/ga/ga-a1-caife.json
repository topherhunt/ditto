    "lán": { "lemma": "lán", "pos": "ADJ", "gloss": { "en": "full" } },
    "t-uisce": { "lemma": "uisce", "pos": "NOUN", "gloss": { "en": "water (uisce, with t- after an: an t-uisce)" } },
    "fuar": { "lemma": "fuar", "pos": "ADJ", "gloss": { "en": "cold" } },
    "te": { "lemma": "te", "pos": "ADJ", "gloss": { "en": "hot, warm" } },
    "bord": { "lemma": "bord", "pos": "NOUN", "gloss": { "en": "table (masculine)" } },
    "saor": { "lemma": "saor", "pos": "ADJ", "gloss": { "en": "free (not taken); cheap" } },
    "chathaoir": { "lemma": "cathaoir", "pos": "NOUN", "gloss": { "en": "chair (cathaoir, feminine, lenited after an)" } },
    "seacláid": { "lemma": "seacláid", "pos": "NOUN", "gloss": { "en": "chocolate (feminine)" } },
    "the": { "lemma": "te", "pos": "ADJ", "gloss": { "en": "hot (te, lenited after a feminine noun: seacláid the)" } },
    "fearr": { "lemma": "maith", "pos": "ADJ", "gloss": { "en": "better (comparative of maith); is fearr liom = I prefer" } },
    "ná": { "lemma": "ná", "pos": "CCONJ", "gloss": { "en": "than (after a comparative); nor (after a negative)" } },
    "léi": { "lemma": "le", "pos": "ADP", "gloss": { "en": "with her (le + í)" } },
    "leis": { "lemma": "le", "pos": "ADP", "gloss": { "en": "with him (le + é); leis an = with the" } },
    "chaife": { "lemma": "caife", "pos": "NOUN", "gloss": { "en": "coffee, café (caife, lenited after sa = in the, or ina = in his)" } },
    "a#to": { "lemma": "a", "pos": "PART", "gloss": { "en": "to (before a verbal noun; lenites): a ól = to drink, a chodladh = to sleep" } },
    "ól": { "lemma": "ól", "pos": "VERB", "gloss": { "en": "drinking, to drink (verbal noun of ól)" } },
    "ithe": { "lemma": "ith", "pos": "VERB", "gloss": { "en": "eating, to eat (verbal noun of ith)" } },
    "cáise": { "lemma": "cáis", "pos": "NOUN", "gloss": { "en": "of cheese (cáis in the genitive): ceapaire cáise = a cheese sandwich" } },
    "sú": { "lemma": "sú", "pos": "NOUN", "gloss": { "en": "juice (masculine)" } },
    "oráiste": { "lemma": "oráiste", "pos": "NOUN", "gloss": { "en": "orange" } },
    "rud": { "lemma": "rud", "pos": "NOUN", "gloss": { "en": "thing (masculine)" } },
    "éigin": { "lemma": "éigin", "pos": "ADJ", "gloss": { "en": "some; rud éigin = something" } },
    "eile": { "lemma": "eile", "pos": "ADJ", "gloss": { "en": "other, else" } },
    "sin": { "lemma": "sin", "pos": "PRON", "gloss": { "en": "that; sin é = that's it" } },
    "mhéad": { "lemma": "méad", "pos": "NOUN", "gloss": { "en": "amount (méad, lenited after cé): cé mhéad? = how much? how many?" } },
    "sa": { "lemma": "i", "pos": "ADP", "gloss": { "en": "in the (i + an); lenites: sa chaife" } },
    "do#to": { "lemma": "do", "pos": "ADP", "gloss": { "en": "to, for; lenites: bord do bheirt = a table for two" } },
    "bheirt": { "lemma": "beirt", "pos": "NOUN", "gloss": { "en": "two people (beirt, lenited after do)" } },
    "suigh": { "lemma": "suigh", "pos": "VERB", "gloss": { "en": "sit (command)" } },
    "síos": { "lemma": "síos", "pos": "ADV", "gloss": { "en": "down (movement downward)" } },
    "anseo": { "lemma": "anseo", "pos": "ADV", "gloss": { "en": "here" } },
    "deas": { "lemma": "deas", "pos": "ADJ", "gloss": { "en": "nice" } },
    "hálainn": { "lemma": "álainn", "pos": "ADJ", "gloss": { "en": "lovely (álainn, with h- after go: go hálainn)" } },
    "sheán": { "lemma": "Seán", "pos": "PROPN", "gloss": { "en": "Seán (lenited after ar: tart ar Sheán)" } }
  },
  "lessons": [
    {
      "id": "ga-a1-caife-1",
      "title": "Ba mhaith liom tae",
      "grammarFocus": { "en": ["ba mhaith liom = I'd like (lit. it would be good with me)","ar mhaith leat? = would you like? Answer ba mhaith (yes) or níor mhaith (no)"] },
      "units": [
        { "id": "ga-a1-caife-1-u01", "rev": 1, "stage": "word", "text": "tae",
          "translation": { "en": "tea" },
          "distractors": { "en": ["coffee","water"] } },
        { "id": "ga-a1-caife-1-u02", "rev": 1, "stage": "word", "text": "caife",
          "translation": { "en": "coffee" },
          "distractors": { "en": ["tea","milk"] } },
        { "id": "ga-a1-caife-1-u03", "rev": 1, "stage": "word", "text": "cupán",
          "translation": { "en": "cup" },
          "distractors": { "en": ["glass","pot"] } },
        { "id": "ga-a1-caife-1-u04", "rev": 1, "stage": "phrase", "text": "cupán tae",
          "translation": { "en": "a cup of tea" },
          "distractors": { "en": ["a cup of coffee","a glass of tea"] } },
        { "id": "ga-a1-caife-1-u05", "rev": 1, "stage": "chunk", "text": "ba mhaith liom",
          "translation": { "en": "I'd like" },
          "distractors": { "en": ["I like","you'd like"] } },
        { "id": "ga-a1-caife-1-u06", "rev": 1, "stage": "sentence", "text": "Ba mhaith liom cupán tae.",
          "translation": { "en": "I'd like a cup of tea." },
          "distractors": { "en": ["I'd like a cup of coffee.","You'd like a cup of tea."] } },
        { "id": "ga-a1-caife-1-u07", "rev": 1, "stage": "sentence", "text": "Ba mhaith liom cupán caife, le do thoil.",
          "translation": { "en": "I'd like a cup of coffee, please." },
          "distractors": { "en": ["I'd like a cup of tea, please.","I like a cup of coffee, please."] } },
        { "id": "ga-a1-caife-1-u08", "rev": 1, "stage": "word", "text": "uisce",
          "translation": { "en": "water" },
          "distractors": { "en": ["milk","juice"] } },
        { "id": "ga-a1-caife-1-u09", "rev": 1, "stage": "phrase", "text": "gloine uisce",
          "translation": { "en": "a glass of water" },
          "distractors": { "en": ["a glass of milk","a cup of water"] } },
        { "id": "ga-a1-caife-1-u10", "rev": 1, "stage": "sentence", "text": "Ba mhaith liom gloine uisce freisin.",
          "translation": { "en": "I'd also like a glass of water." },
          "distractors": { "en": ["I'd also like a glass of milk.","I'd also like a cup of water."] } },
        { "id": "ga-a1-caife-1-u11", "rev": 1, "stage": "chunk", "text": "ar mhaith leat", "senses": {"0":"cop"},
          "translation": { "en": "would you like" },
          "distractors": { "en": ["do you like","would she like"] } },
        { "id": "ga-a1-caife-1-u12", "rev": 1, "stage": "sentence", "text": "Ar mhaith leat cupán tae?", "senses": {"0":"cop"},
          "translation": { "en": "Would you like a cup of tea?" },
          "distractors": { "en": ["Do you like a cup of tea?","Would you like a cup of coffee?"] } },
        { "id": "ga-a1-caife-1-u13", "rev": 1, "stage": "sentence", "text": "Ba mhaith, go raibh maith agat.",
          "translation": { "en": "Yes, thank you." },
          "distractors": { "en": ["No, thank you.","Yes, please."] } },
        { "id": "ga-a1-caife-1-u14", "rev": 1, "stage": "sentence", "text": "Níor mhaith, go raibh maith agat.",
          "translation": { "en": "No, thank you." },
          "distractors": { "en": ["Yes, thank you.","No, please."] } },
        { "id": "ga-a1-caife-1-u15", "rev": 1, "stage": "word", "text": "bainne",
          "translation": { "en": "milk" },
          "distractors": { "en": ["sugar","water"] } },
        { "id": "ga-a1-caife-1-u16", "rev": 1, "stage": "sentence", "text": "Ba mhaith liom tae le bainne.",
          "translation": { "en": "I'd like tea with milk." },
          "distractors": { "en": ["I'd like tea without milk.","I'd like coffee with milk."] } },
        { "id": "ga-a1-caife-1-u17", "rev": 1, "stage": "word", "text": "siúcra",
          "translation": { "en": "sugar" },
          "distractors": { "en": ["milk","salt"] } },
        { "id": "ga-a1-caife-1-u18", "rev": 1, "stage": "phrase", "text": "gan siúcra",
          "translation": { "en": "without sugar" },
          "distractors": { "en": ["with sugar","without milk"] } },
        { "id": "ga-a1-caife-1-u19", "rev": 1, "stage": "sentence", "text": "Caife dubh gan siúcra, le do thoil.",
          "translation": { "en": "A black coffee without sugar, please." },
          "distractors": { "en": ["A black coffee with sugar, please.","A black tea without sugar, please."] } }
      ]
    },
    {
      "id": "ga-a1-caife-2",
      "title": "Tá ocras orm",
      "grammarFocus": { "en": ["feelings sit on you: tá ocras orm = I'm hungry (lit. hunger is on me)","ar + person: orm, ort, air, uirthi = on me, on you, on him, on her"] },
      "units": [
        { "id": "ga-a1-caife-2-u01", "rev": 1, "stage": "word", "text": "ocras",
          "translation": { "en": "hunger" },
          "distractors": { "en": ["thirst","cold"] } },
        { "id": "ga-a1-caife-2-u02", "rev": 1, "stage": "chunk", "text": "tá ocras orm",
          "translation": { "en": "I'm hungry" },
          "distractors": { "en": ["I'm thirsty","you're hungry"] } },
        { "id": "ga-a1-caife-2-u03", "rev": 1, "stage": "sentence", "text": "Tá ocras orm anois.",
          "translation": { "en": "I'm hungry now." },
          "distractors": { "en": ["I'm thirsty now.","I'm not hungry now."] } },
        { "id": "ga-a1-caife-2-u04", "rev": 1, "stage": "word", "text": "tart",
          "translation": { "en": "thirst" },
          "distractors": { "en": ["hunger","joy"] } },
        { "id": "ga-a1-caife-2-u05", "rev": 1, "stage": "sentence", "text": "Tá tart orm.",
          "translation": { "en": "I'm thirsty." },
          "distractors": { "en": ["I'm hungry.","She's thirsty."] } },
        { "id": "ga-a1-caife-2-u06", "rev": 1, "stage": "sentence", "text": "An bhfuil ocras ort?", "senses": {"0":"q"},
          "translation": { "en": "Are you hungry?" },
          "distractors": { "en": ["Are you thirsty?","Is he hungry?"] } },
        { "id": "ga-a1-caife-2-u07", "rev": 1, "stage": "sentence", "text": "Níl ocras orm, ach tá tart orm.",
          "translation": { "en": "I'm not hungry, but I'm thirsty." },
          "distractors": { "en": ["I'm hungry, but I'm not thirsty.","I'm not thirsty, but I'm hungry."] } },
        { "id": "ga-a1-caife-2-u08", "rev": 1, "stage": "sentence", "text": "Tá ocras air.",
          "translation": { "en": "He's hungry." },
          "distractors": { "en": ["She's hungry.","I'm hungry."] } },
        { "id": "ga-a1-caife-2-u09", "rev": 1, "stage": "sentence", "text": "An bhfuil tart uirthi?", "senses": {"0":"q"},
          "translation": { "en": "Is she thirsty?" },
          "distractors": { "en": ["Is he thirsty?","Is she hungry?"] } },
        { "id": "ga-a1-caife-2-u10", "rev": 1, "stage": "word", "text": "ceapaire",
          "translation": { "en": "sandwich" },
          "distractors": { "en": ["cake","soup"] } },
        { "id": "ga-a1-caife-2-u11", "rev": 1, "stage": "sentence", "text": "Tá ocras orm, ba mhaith liom ceapaire.",
          "translation": { "en": "I'm hungry, I'd like a sandwich." },
          "distractors": { "en": ["I'm thirsty, I'd like a sandwich.","I'm hungry, I like sandwiches."] } },
        { "id": "ga-a1-caife-2-u12", "rev": 1, "stage": "word", "text": "anraith",
          "translation": { "en": "soup" },
          "distractors": { "en": ["sandwich","bread"] } },
        { "id": "ga-a1-caife-2-u13", "rev": 1, "stage": "phrase", "text": "babhla anraith",
          "translation": { "en": "a bowl of soup" },
          "distractors": { "en": ["a cup of soup","a plate of soup"] } },
        { "id": "ga-a1-caife-2-u14", "rev": 1, "stage": "sentence", "text": "Ar mhaith leat babhla anraith?", "senses": {"0":"cop"},
          "translation": { "en": "Would you like a bowl of soup?" },
          "distractors": { "en": ["Would you like a cup of soup?","Do you like a bowl of soup?"] } },
        { "id": "ga-a1-caife-2-u15", "rev": 1, "stage": "word", "text": "arán",
          "translation": { "en": "bread" },
          "distractors": { "en": ["cake","butter"] } },
        { "id": "ga-a1-caife-2-u16", "rev": 1, "stage": "phrase", "text": "arán donn",
          "translation": { "en": "brown bread" },
          "distractors": { "en": ["white bread","brown cake"] } },
        { "id": "ga-a1-caife-2-u17", "rev": 1, "stage": "sentence", "text": "Ba mhaith, agus arán donn, le do thoil.",
          "translation": { "en": "Yes, and brown bread, please." },
          "distractors": { "en": ["No, but brown bread, please.","Yes, and white bread, please."] } },
        { "id": "ga-a1-caife-2-u18", "rev": 1, "stage": "word", "text": "cáca",
          "translation": { "en": "cake" },
          "distractors": { "en": ["bread","biscuit"] } },
        { "id": "ga-a1-caife-2-u19", "rev": 1, "stage": "phrase", "text": "píosa cáca",
          "translation": { "en": "a piece of cake" },
          "distractors": { "en": ["a cup of cake","a piece of bread"] } },
        { "id": "ga-a1-caife-2-u20", "rev": 1, "stage": "sentence", "text": "Ba mhaith liom píosa cáca agus cupán tae.",
          "translation": { "en": "I'd like a piece of cake and a cup of tea." },
          "distractors": { "en": ["I'd like a piece of bread and a cup of tea.","I'd like a piece of cake and a cup of coffee."] } }
      ]
    },
    {
      "id": "ga-a1-caife-3",
      "title": "Seo duit",
      "grammarFocus": { "en": ["an = the. It lenites a feminine noun: gloine, an ghloine","a masculine noun starting with a vowel takes t-: uisce, an t-uisce"] },
      "units": [
        { "id": "ga-a1-caife-3-u01", "rev": 1, "stage": "phrase", "text": "seo duit",
          "translation": { "en": "here you are" },
          "distractors": { "en": ["thank you","excuse me"] } },
        { "id": "ga-a1-caife-3-u02", "rev": 1, "stage": "sentence", "text": "Seo duit, cupán tae.",
          "translation": { "en": "Here you are, a cup of tea." },
          "distractors": { "en": ["Thank you, a cup of tea.","Here you are, a cup of coffee."] } },
        { "id": "ga-a1-caife-3-u03", "rev": 1, "stage": "word", "text": "biachlár",
          "translation": { "en": "menu" },
          "distractors": { "en": ["bill","table"] } },
        { "id": "ga-a1-caife-3-u04", "rev": 1, "stage": "sentence", "text": "An bhfuil an biachlár agat?", "senses": {"0":"q"},
          "translation": { "en": "Do you have the menu?" },
          "distractors": { "en": ["Do you have the bill?","Do you have a table?"] } },
        { "id": "ga-a1-caife-3-u05", "rev": 1, "stage": "sentence", "text": "Tá, seo duit an biachlár.",
          "translation": { "en": "Yes, here's the menu." },
          "distractors": { "en": ["Yes, here's the bill.","No, I don't have the menu."] } },
        { "id": "ga-a1-caife-3-u06", "rev": 1, "stage": "word", "text": "bille",
          "translation": { "en": "bill" },
          "distractors": { "en": ["menu","cup"] } },
        { "id": "ga-a1-caife-3-u07", "rev": 1, "stage": "sentence", "text": "An bille, le do thoil.",
          "translation": { "en": "The bill, please." },
          "distractors": { "en": ["The menu, please.","A bill, please."] } },
        { "id": "ga-a1-caife-3-u08", "rev": 1, "stage": "phrase", "text": "an ghloine",
          "translation": { "en": "the glass" },
          "distractors": { "en": ["the cup","a glass"] } },
        { "id": "ga-a1-caife-3-u09", "rev": 1, "stage": "word", "text": "folamh",
          "translation": { "en": "empty" },
          "distractors": { "en": ["full","cold"] } },
        { "id": "ga-a1-caife-3-u10", "rev": 1, "stage": "sentence", "text": "Tá an ghloine folamh.",
          "translation": { "en": "The glass is empty." },
          "distractors": { "en": ["The glass is full.","The cup is empty."] } },
        { "id": "ga-a1-caife-3-u11", "rev": 1, "stage": "word", "text": "lán",
          "translation": { "en": "full" },
          "distractors": { "en": ["empty","hot"] } },
        { "id": "ga-a1-caife-3-u12", "rev": 1, "stage": "sentence", "text": "Tá an cupán lán.",
          "translation": { "en": "The cup is full." },
          "distractors": { "en": ["The cup is empty.","The glass is full."] } },
        { "id": "ga-a1-caife-3-u13", "rev": 1, "stage": "phrase", "text": "an t-uisce",
          "translation": { "en": "the water" },
          "distractors": { "en": ["the tea","some water"] } },
        { "id": "ga-a1-caife-3-u14", "rev": 1, "stage": "word", "text": "fuar",
          "translation": { "en": "cold" },
          "distractors": { "en": ["hot","fresh"] } },
        { "id": "ga-a1-caife-3-u15", "rev": 1, "stage": "sentence", "text": "Tá an t-uisce fuar.",
          "translation": { "en": "The water is cold." },
          "distractors": { "en": ["The water is hot.","The tea is cold."] } },
        { "id": "ga-a1-caife-3-u16", "rev": 1, "stage": "word", "text": "te",
          "translation": { "en": "hot" },
          "distractors": { "en": ["cold","sweet"] } },
        { "id": "ga-a1-caife-3-u17", "rev": 1, "stage": "sentence", "text": "Níl an tae te!",
          "translation": { "en": "The tea isn't hot!" },
          "distractors": { "en": ["The tea is hot!","The coffee isn't hot!"] } },
        { "id": "ga-a1-caife-3-u18", "rev": 1, "stage": "word", "text": "bord",
          "translation": { "en": "table" },
          "distractors": { "en": ["chair","menu"] } },
        { "id": "ga-a1-caife-3-u19", "rev": 1, "stage": "word", "text": "saor",
          "translation": { "en": "free (not taken)" },
          "distractors": { "en": ["busy","broken"] } },
        { "id": "ga-a1-caife-3-u20", "rev": 1, "stage": "sentence", "text": "Tá an bord seo saor.",
          "translation": { "en": "This table is free." },
          "distractors": { "en": ["This table isn't free.","This chair is free."] } },
        { "id": "ga-a1-caife-3-u21", "rev": 1, "stage": "phrase", "text": "an chathaoir",
          "translation": { "en": "the chair" },
          "distractors": { "en": ["the table","a chair"] } },
        { "id": "ga-a1-caife-3-u22", "rev": 1, "stage": "sentence", "text": "An bhfuil an chathaoir seo saor?", "senses": {"0":"q"},
          "translation": { "en": "Is this chair free?" },
          "distractors": { "en": ["Is this table free?","Is this chair broken?"] } }
      ]
    },
    {
      "id": "ga-a1-caife-4",
      "title": "Is maith liom caife",
      "grammarFocus": { "en": ["is maith liom = I like; ní maith liom = I don't like; is breá liom = I love","is fearr liom X ná Y = I prefer X to Y"] },
      "units": [
        { "id": "ga-a1-caife-4-u01", "rev": 1, "stage": "chunk", "text": "is maith liom",
          "translation": { "en": "I like" },
          "distractors": { "en": ["I'd like","I don't like"] } },
        { "id": "ga-a1-caife-4-u02", "rev": 1, "stage": "sentence", "text": "Is maith liom caife.",
          "translation": { "en": "I like coffee." },
          "distractors": { "en": ["I'd like coffee.","I don't like coffee."] } },
        { "id": "ga-a1-caife-4-u03", "rev": 1, "stage": "chunk", "text": "ní maith liom",
          "translation": { "en": "I don't like" },
          "distractors": { "en": ["I like","I wouldn't like"] } },
        { "id": "ga-a1-caife-4-u04", "rev": 1, "stage": "sentence", "text": "Ní maith liom tae.",
          "translation": { "en": "I don't like tea." },
          "distractors": { "en": ["I like tea.","I wouldn't like tea."] } },
        { "id": "ga-a1-caife-4-u05", "rev": 1, "stage": "sentence", "text": "An maith leat bainne?", "senses": {"0":"q"},
          "translation": { "en": "Do you like milk?" },
          "distractors": { "en": ["Would you like milk?","Does he like milk?"] } },
        { "id": "ga-a1-caife-4-u06", "rev": 1, "stage": "sentence", "text": "Is maith.",
          "translation": { "en": "Yes, I do." },
          "distractors": { "en": ["No, I don't.","Yes, I would."] } },
        { "id": "ga-a1-caife-4-u07", "rev": 1, "stage": "sentence", "text": "Ní maith.",
          "translation": { "en": "No, I don't." },
          "distractors": { "en": ["Yes, I do.","No, I wouldn't."] } },
        { "id": "ga-a1-caife-4-u08", "rev": 1, "stage": "chunk", "text": "is breá liom",
          "translation": { "en": "I love" },
          "distractors": { "en": ["I like","I'd love"] } },
        { "id": "ga-a1-caife-4-u09", "rev": 1, "stage": "word", "text": "seacláid",
          "translation": { "en": "chocolate" },
          "distractors": { "en": ["cake","coffee"] } },
        { "id": "ga-a1-caife-4-u10", "rev": 1, "stage": "phrase", "text": "seacláid the",
          "translation": { "en": "hot chocolate" },
          "distractors": { "en": ["cold chocolate","hot coffee"] } },
        { "id": "ga-a1-caife-4-u11", "rev": 1, "stage": "sentence", "text": "Is breá liom seacláid the.",
          "translation": { "en": "I love hot chocolate." },
          "distractors": { "en": ["I like hot chocolate.","I love hot coffee."] } },
        { "id": "ga-a1-caife-4-u12", "rev": 1, "stage": "chunk", "text": "is fearr liom",
          "translation": { "en": "I prefer" },
          "distractors": { "en": ["I like","I'd like"] } },
        { "id": "ga-a1-caife-4-u13", "rev": 1, "stage": "sentence", "text": "Is fearr liom caife ná tae.",
          "translation": { "en": "I prefer coffee to tea." },
          "distractors": { "en": ["I prefer tea to coffee.","I like coffee and tea."] } },
        { "id": "ga-a1-caife-4-u14", "rev": 1, "stage": "sentence", "text": "Is fearr léi tae ná caife.",
          "translation": { "en": "She prefers tea to coffee." },
          "distractors": { "en": ["He prefers tea to coffee.","She prefers coffee to tea."] } },
        { "id": "ga-a1-caife-4-u15", "rev": 1, "stage": "sentence", "text": "Is maith leis bainne ina chaife.",
          "translation": { "en": "He likes milk in his coffee." },
          "distractors": { "en": ["She likes milk in her coffee.","He likes sugar in his coffee."] } },
        { "id": "ga-a1-caife-4-u16", "rev": 1, "stage": "sentence", "text": "Ní maith le Liam siúcra.",
          "translation": { "en": "Liam doesn't like sugar." },
          "distractors": { "en": ["Liam likes sugar.","Liam doesn't like milk."] } },
        { "id": "ga-a1-caife-4-u17", "rev": 1, "stage": "sentence", "text": "Is breá le Máire cáca.",
          "translation": { "en": "Máire loves cake." },
          "distractors": { "en": ["Máire likes cake.","Máire loves bread."] } }
      ]
    },
    {
      "id": "ga-a1-caife-5",
      "title": "Cad ba mhaith leat?",
      "grammarFocus": { "en": ["cad ba mhaith leat? = what would you like?","a + verbal noun = to ...: a ól = to drink, a ithe = to eat"] },
      "units": [
        { "id": "ga-a1-caife-5-u01", "rev": 1, "stage": "sentence", "text": "Cad ba mhaith leat?",
          "translation": { "en": "What would you like?" },
          "distractors": { "en": ["What do you like?","Where would you like to go?"] } },
        { "id": "ga-a1-caife-5-u02", "rev": 1, "stage": "phrase", "text": "a ól", "senses": {"0":"to"},
          "translation": { "en": "to drink" },
          "distractors": { "en": ["to eat","to order"] } },
        { "id": "ga-a1-caife-5-u03", "rev": 1, "stage": "sentence", "text": "Cad ba mhaith leat a ól?", "senses": {"4":"to"},
          "translation": { "en": "What would you like to drink?" },
          "distractors": { "en": ["What would you like to eat?","What do you like to drink?"] } },
        { "id": "ga-a1-caife-5-u04", "rev": 2, "stage": "sentence", "text": "Ba mhaith liom cupán caife dubh.",
          "translation": { "en": "I'd like a cup of black coffee." },
          "distractors": { "en": ["I'd like a cup of white coffee.","I'd like a cup of black tea."] } },
        { "id": "ga-a1-caife-5-u05", "rev": 1, "stage": "phrase", "text": "a ithe", "senses": {"0":"to"},
          "translation": { "en": "to eat" },
          "distractors": { "en": ["to drink","to cook"] } },
        { "id": "ga-a1-caife-5-u06", "rev": 1, "stage": "sentence", "text": "Cad ba mhaith leat a ithe?", "senses": {"4":"to"},
          "translation": { "en": "What would you like to eat?" },
          "distractors": { "en": ["What would you like to drink?","What do you like to eat?"] } },
        { "id": "ga-a1-caife-5-u07", "rev": 1, "stage": "phrase", "text": "ceapaire cáise",
          "translation": { "en": "a cheese sandwich" },
          "distractors": { "en": ["a ham sandwich","cheese cake"] } },
        { "id": "ga-a1-caife-5-u08", "rev": 1, "stage": "sentence", "text": "Ba mhaith liom ceapaire cáise.",
          "translation": { "en": "I'd like a cheese sandwich." },
          "distractors": { "en": ["I'd like a cheese cake.","I like cheese sandwiches."] } },
        { "id": "ga-a1-caife-5-u09", "rev": 1, "stage": "word", "text": "sú",
          "translation": { "en": "juice" },
          "distractors": { "en": ["milk","soup"] } },
        { "id": "ga-a1-caife-5-u10", "rev": 1, "stage": "phrase", "text": "sú oráiste",
          "translation": { "en": "orange juice" },
          "distractors": { "en": ["apple juice","orange soup"] } },
        { "id": "ga-a1-caife-5-u11", "rev": 1, "stage": "sentence", "text": "Ba mhaith le Seán sú oráiste.",
          "translation": { "en": "Seán would like orange juice." },
          "distractors": { "en": ["Seán likes orange juice.","Seán would like apple juice."] } },
        { "id": "ga-a1-caife-5-u12", "rev": 1, "stage": "phrase", "text": "rud éigin eile",
          "translation": { "en": "something else" },
          "distractors": { "en": ["anything at all","the same thing"] } },
        { "id": "ga-a1-caife-5-u13", "rev": 1, "stage": "sentence", "text": "Ar mhaith leat rud éigin eile?", "senses": {"0":"cop"},
          "translation": { "en": "Would you like anything else?" },
          "distractors": { "en": ["Would you like something to eat?","Do you like anything else?"] } },
        { "id": "ga-a1-caife-5-u14", "rev": 1, "stage": "sentence", "text": "Níor mhaith, sin é, go raibh maith agat.",
          "translation": { "en": "No, that's it, thank you." },
          "distractors": { "en": ["Yes, that's it, thank you.","No, that's not it, thank you."] } },
        { "id": "ga-a1-caife-5-u15", "rev": 1, "stage": "sentence", "text": "Cé mhéad atá air?",
          "translation": { "en": "How much is it?" },
          "distractors": { "en": ["How many are there?","Where is it?"] } }
      ]
    },
    {
      "id": "ga-a1-caife-6",
      "title": "Sa chaife",
      "grammarFocus": { "en": ["sa = in the; it lenites: caife, sa chaife","review: ordering, likes, hunger and thirst"] },
      "units": [
        { "id": "ga-a1-caife-6-u01", "rev": 1, "stage": "phrase", "text": "sa chaife",
          "translation": { "en": "in the café" },
          "distractors": { "en": ["in the kitchen","at home"] } },
        { "id": "ga-a1-caife-6-u02", "rev": 1, "stage": "sentence", "text": "Tá mé sa chaife le Máire.",
          "translation": { "en": "I'm in the café with Máire." },
          "distractors": { "en": ["I'm in the café without Máire.","Máire is in the café with me."] } },
        { "id": "ga-a1-caife-6-u03", "rev": 1, "stage": "phrase", "text": "bord do bheirt", "senses": {"1":"to"},
          "translation": { "en": "a table for two" },
          "distractors": { "en": ["a table for three","a chair for two"] } },
        { "id": "ga-a1-caife-6-u04", "rev": 1, "stage": "sentence", "text": "Dia duit! Bord do bheirt, le do thoil.", "senses": {"3":"to"},
          "translation": { "en": "Hello! A table for two, please." },
          "distractors": { "en": ["Hello! A table for three, please.","Goodbye! A table for two, please."] } },
        { "id": "ga-a1-caife-6-u05", "rev": 1, "stage": "sentence", "text": "Suigh síos anseo, le do thoil.",
          "translation": { "en": "Sit down here, please." },
          "distractors": { "en": ["Stand up here, please.","Sit down there, please."] } },
        { "id": "ga-a1-caife-6-u06", "rev": 1, "stage": "sentence", "text": "Ar mhaith leat bainne sa tae?", "senses": {"0":"cop"},
          "translation": { "en": "Would you like milk in the tea?" },
          "distractors": { "en": ["Would you like sugar in the tea?","Do you like milk in the tea?"] } },
        { "id": "ga-a1-caife-6-u07", "rev": 1, "stage": "sentence", "text": "Ba mhaith, ach gan siúcra.",
          "translation": { "en": "Yes, but no sugar." },
          "distractors": { "en": ["No, but with sugar.","Yes, and sugar too."] } },
        { "id": "ga-a1-caife-6-u08", "rev": 1, "stage": "word", "text": "deas",
          "translation": { "en": "nice" },
          "distractors": { "en": ["bad","cold"] } },
        { "id": "ga-a1-caife-6-u09", "rev": 1, "stage": "sentence", "text": "Tá an caife seo go deas.",
          "translation": { "en": "This coffee is nice." },
          "distractors": { "en": ["This tea is nice.","This coffee isn't nice."] } },
        { "id": "ga-a1-caife-6-u10", "rev": 1, "stage": "phrase", "text": "go hálainn",
          "translation": { "en": "lovely" },
          "distractors": { "en": ["awful","fine"] } },
        { "id": "ga-a1-caife-6-u11", "rev": 1, "stage": "sentence", "text": "Tá an cáca seo go hálainn!",
          "translation": { "en": "This cake is lovely!" },
          "distractors": { "en": ["This bread is lovely!","This cake is awful!"] } },
        { "id": "ga-a1-caife-6-u12", "rev": 1, "stage": "sentence", "text": "Is breá liom an caife anseo.",
          "translation": { "en": "I love the coffee here." },
          "distractors": { "en": ["I like the coffee here.","I love the tea here."] } },
        { "id": "ga-a1-caife-6-u13", "rev": 1, "stage": "sentence", "text": "Tá tart ar Sheán.",
          "translation": { "en": "Seán is thirsty." },
          "distractors": { "en": ["Seán is hungry.","Seán is tired."] } },
        { "id": "ga-a1-caife-6-u14", "rev": 1, "stage": "sentence", "text": "Tá ocras ar Mháire freisin.",
          "translation": { "en": "Máire is hungry too." },
          "distractors": { "en": ["Máire is thirsty too.","Máire isn't hungry either."] } },
        { "id": "ga-a1-caife-6-u15", "rev": 1, "stage": "sentence", "text": "Gabh mo leithscéal, an bille, le do thoil.",
          "translation": { "en": "Excuse me, the bill, please." },
          "distractors": { "en": ["Excuse me, the menu, please.","Thank you, the bill, please."] } }
      ]
    }
  ]
