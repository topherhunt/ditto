{
  "id": "ga-a1-cathair",
  "language": "ga",
  "level": "A1",
  "order": 7,
  "title": "Sa Chathair",
  "description": { "en": "Find your way around town: ask where things are, follow directions, and ask for help" },
  "track": "main",
  "requires": ["ga-a1-gnathla"],
  "introduces": ["stáisiún","thall","óstán","aice","leithreas","séipéal","lár","páirc","cas","deis","clé","díreach","aghaidh","lean","bóthar","suas","sráid","trasnaigh","solas","cóngarach","nóiméad","tóg","stad","tacsaí","pictiúrlann","amharclann","cathair","músaem","ollmhargadh","leabharlann","oscail","dún","féidir","cabhraigh","caill","fios","brón","léarscáil","taispeáin","míle","buíochas","cinnte","lorg","céanna","iontach"],
  "lexicon": {
    "stáisiún": { "lemma": "stáisiún", "pos": "NOUN", "gloss": { "en": "station (masculine)" } },
    "thall": { "lemma": "thall", "pos": "ADV", "gloss": { "en": "over there, yonder: thall ansin = over there" } },
    "óstán": { "lemma": "óstán", "pos": "NOUN", "gloss": { "en": "hotel (masculine)" } },
    "aice": { "lemma": "aice", "pos": "NOUN", "gloss": { "en": "nearness; in aice le = next to, near" } },
    "leithreas": { "lemma": "leithreas", "pos": "NOUN", "gloss": { "en": "toilet (masculine)" } },
    "séipéal": { "lemma": "séipéal", "pos": "NOUN", "gloss": { "en": "church, chapel (masculine)" } },
    "lár": { "lemma": "lár", "pos": "NOUN", "gloss": { "en": "middle, centre: i lár an bhaile = in the town centre" } },
    "páirc": { "lemma": "páirc", "pos": "NOUN", "gloss": { "en": "park, field (feminine)" } },
    "phoist": { "lemma": "post", "pos": "NOUN", "gloss": { "en": "of post (post in the genitive, lenited after an): oifig an phoist = the post office" } },
    "cas": { "lemma": "cas", "pos": "VERB", "gloss": { "en": "turn (command)" } },
    "dheis": { "lemma": "deis", "pos": "NOUN", "gloss": { "en": "right (side) (deis, lenited after ar): ar dheis = on the right" } },
    "chlé": { "lemma": "clé", "pos": "NOUN", "gloss": { "en": "left (side) (clé, lenited after ar): ar chlé = on the left" } },
    "díreach": { "lemma": "díreach", "pos": "ADV", "gloss": { "en": "straight, directly: díreach ar aghaidh = straight ahead" } },
    "aghaidh": { "lemma": "aghaidh", "pos": "NOUN", "gloss": { "en": "face; ar aghaidh = forward, ahead" } },
    "téigh": { "lemma": "téigh", "pos": "VERB", "gloss": { "en": "go (command)" } },
    "lean": { "lemma": "lean", "pos": "VERB", "gloss": { "en": "follow, continue (command): lean ar aghaidh = keep going" } },
    "bóthar": { "lemma": "bóthar", "pos": "NOUN", "gloss": { "en": "road (masculine)" } },
    "suas": { "lemma": "suas", "pos": "ADV", "gloss": { "en": "up (movement upward)" } },
    "sráid": { "lemma": "sráid", "pos": "NOUN", "gloss": { "en": "street (feminine)" } },
    "tsráid": { "lemma": "sráid", "pos": "NOUN", "gloss": { "en": "street (sráid, with t- after an: an tsráid)" } },
    "trasnaigh": { "lemma": "trasnaigh", "pos": "VERB", "gloss": { "en": "cross (command)" } },
    "soilse": { "lemma": "solas", "pos": "NOUN", "gloss": { "en": "lights (plural of solas): na soilse = the traffic lights" } },
    "bhfad": { "lemma": "fad", "pos": "NOUN", "gloss": { "en": "length (fad, eclipsed after i): i bhfad = far, for a long time" } },
    "cóngarach": { "lemma": "cóngarach", "pos": "ADJ", "gloss": { "en": "near, close" } },
    "nóiméad": { "lemma": "nóiméad", "pos": "NOUN", "gloss": { "en": "minute (masculine)" } },
    "ón": { "lemma": "ó", "pos": "ADP", "gloss": { "en": "from the (ó + an)" } },
    "tóg": { "lemma": "tóg", "pos": "VERB", "gloss": { "en": "take (command)" } },
    "bus": { "lemma": "bus", "pos": "NOUN", "gloss": { "en": "bus (masculine)" } },
    "stad": { "lemma": "stad", "pos": "NOUN", "gloss": { "en": "stop: stad an bhus = the bus stop" } },
    "bhus": { "lemma": "bus", "pos": "NOUN", "gloss": { "en": "of the bus (bus in the genitive, lenited after an): stad an bhus" } },
    "tacsaí": { "lemma": "tacsaí", "pos": "NOUN", "gloss": { "en": "taxi (masculine)" } },
    "baile": { "lemma": "baile", "pos": "NOUN", "gloss": { "en": "town, home (masculine); baile mór = town" } },
    "mór": { "lemma": "mór", "pos": "ADJ", "gloss": { "en": "big, great" } },
    "pictiúrlann": { "lemma": "pictiúrlann", "pos": "NOUN", "gloss": { "en": "cinema (feminine)" } },
    "amharclann": { "lemma": "amharclann", "pos": "NOUN", "gloss": { "en": "theatre (feminine)" } },
    "cathair": { "lemma": "cathair", "pos": "NOUN", "gloss": { "en": "city (feminine)" } },
    "músaem": { "lemma": "músaem", "pos": "NOUN", "gloss": { "en": "museum (masculine)" } },
    "chathair": { "lemma": "cathair", "pos": "NOUN", "gloss": { "en": "city (cathair, lenited after sa)" } },
    "ollmhargadh": { "lemma": "ollmhargadh", "pos": "NOUN", "gloss": { "en": "supermarket (masculine)" } },
    "leabharlann": { "lemma": "leabharlann", "pos": "NOUN", "gloss": { "en": "library (feminine)" } },
    "oscailt": { "lemma": "oscail", "pos": "VERB", "gloss": { "en": "opening (verbal noun of oscail): ar oscailt = open" } },
    "dúnta": { "lemma": "dún", "pos": "ADJ", "gloss": { "en": "closed, shut" } },
    "féidir": { "lemma": "féidir", "pos": "NOUN", "gloss": { "en": "possibility: an féidir leat? = can you?; is féidir liom = I can" } },
    "cabhrú": { "lemma": "cabhraigh", "pos": "VERB", "gloss": { "en": "helping, to help (verbal noun of cabhraigh): cabhrú le = to help" } },
    "caillte": { "lemma": "caill", "pos": "ADJ", "gloss": { "en": "lost" } },
    "fhios": { "lemma": "fios", "pos": "NOUN", "gloss": { "en": "knowledge (fios, lenited after a): tá a fhios agam = I know" } },
    "brón": { "lemma": "brón", "pos": "NOUN", "gloss": { "en": "sorrow; tá brón orm = I'm sorry" } },
    "léarscáil": { "lemma": "léarscáil", "pos": "NOUN", "gloss": { "en": "map (feminine)" } },
    "thaispeáint": { "lemma": "taispeáin", "pos": "VERB", "gloss": { "en": "showing, to show (taispeáint, lenited after a)" } },
    "míle": { "lemma": "míle", "pos": "NUM", "gloss": { "en": "a thousand; go raibh míle maith agat = thanks a million" } },
    "bhuíochas": { "lemma": "buíochas", "pos": "NOUN", "gloss": { "en": "thanks (buíochas, lenited after a): níl a bhuíochas ort = you're welcome" } },
    "cinnte": { "lemma": "cinnte", "pos": "ADV", "gloss": { "en": "certainly, of course" } },
    "uait": { "lemma": "ó", "pos": "ADP", "gloss": { "en": "from you (ó + tú): cad atá uait? = what do you need?" } },
    "lorg": { "lemma": "lorg", "pos": "VERB", "gloss": { "en": "looking for, searching (verbal noun): ag lorg = looking for" } },
    "stáisiúin": { "lemma": "stáisiún", "pos": "NOUN", "gloss": { "en": "of the station (stáisiún in the genitive): ag lorg an stáisiúin" } },
    "chéanna": { "lemma": "céanna", "pos": "ADJ", "gloss": { "en": "same (céanna, lenited after a feminine noun: an tsráid chéanna)" } },
    "hiontach": { "lemma": "iontach", "pos": "ADJ", "gloss": { "en": "wonderful (iontach, with h after go): go hiontach = great" } }
  },
  "lessons": [
    {
      "id": "ga-a1-cathair-1",
      "title": "Cá bhfuil an stáisiún?",
      "grammarFocus": { "en": ["cá bhfuil ...? = where is ...?","anseo = here, ansin = there, thall ansin = over there","in aice le = next to; le + an = leis an"] },
      "units": [
        { "id": "ga-a1-cathair-1-u01", "rev": 1, "stage": "word", "text": "stáisiún",
          "translation": { "en": "station" },
          "distractors": { "en": ["bank","hotel"] } },
        { "id": "ga-a1-cathair-1-u02", "rev": 1, "stage": "sentence", "text": "Gabh mo leithscéal, cá bhfuil an stáisiún?",
          "translation": { "en": "Excuse me, where's the station?" },
          "distractors": { "en": ["Excuse me, where's the bank?","Excuse me, is this the station?"] } },
        { "id": "ga-a1-cathair-1-u03", "rev": 1, "stage": "phrase", "text": "thall ansin",
          "translation": { "en": "over there" },
          "distractors": { "en": ["right here","straight ahead"] } },
        { "id": "ga-a1-cathair-1-u04", "rev": 1, "stage": "sentence", "text": "Tá sé thall ansin.",
          "translation": { "en": "It's over there." },
          "distractors": { "en": ["It's right here.","It isn't over there."] } },
        { "id": "ga-a1-cathair-1-u05", "rev": 1, "stage": "sentence", "text": "Cá bhfuil an banc?",
          "translation": { "en": "Where's the bank?" },
          "distractors": { "en": ["Where's the station?","Is there a bank?"] } },
        { "id": "ga-a1-cathair-1-u06", "rev": 1, "stage": "word", "text": "óstán",
          "translation": { "en": "hotel" },
          "distractors": { "en": ["hospital","station"] } },
        { "id": "ga-a1-cathair-1-u07", "rev": 1, "stage": "sentence", "text": "An bhfuil óstán anseo?", "senses": {"0":"q"},
          "translation": { "en": "Is there a hotel here?" },
          "distractors": { "en": ["Is there a hospital here?","Is the hotel here?"] } },
        { "id": "ga-a1-cathair-1-u08", "rev": 1, "stage": "phrase", "text": "in aice le",
          "translation": { "en": "next to" },
          "distractors": { "en": ["far from","in front of"] } },
        { "id": "ga-a1-cathair-1-u09", "rev": 1, "stage": "sentence", "text": "Tá óstán in aice leis an stáisiún.",
          "translation": { "en": "There's a hotel next to the station." },
          "distractors": { "en": ["There's a hotel far from the station.","There's a bank next to the station."] } },
        { "id": "ga-a1-cathair-1-u10", "rev": 1, "stage": "word", "text": "leithreas",
          "translation": { "en": "toilet" },
          "distractors": { "en": ["kitchen","bathroom"] } },
        { "id": "ga-a1-cathair-1-u11", "rev": 1, "stage": "sentence", "text": "Cá bhfuil an leithreas, le do thoil?",
          "translation": { "en": "Where's the toilet, please?" },
          "distractors": { "en": ["Where's the kitchen, please?","Is there a toilet, please?"] } },
        { "id": "ga-a1-cathair-1-u12", "rev": 1, "stage": "word", "text": "séipéal",
          "translation": { "en": "church" },
          "distractors": { "en": ["school","park"] } },
        { "id": "ga-a1-cathair-1-u13", "rev": 1, "stage": "phrase", "text": "i lár an bhaile",
          "translation": { "en": "in the town centre" },
          "distractors": { "en": ["in the city","near the town"] } },
        { "id": "ga-a1-cathair-1-u14", "rev": 1, "stage": "sentence", "text": "Tá an séipéal i lár an bhaile.",
          "translation": { "en": "The church is in the town centre." },
          "distractors": { "en": ["The school is in the town centre.","The church is near the town."] } },
        { "id": "ga-a1-cathair-1-u15", "rev": 1, "stage": "word", "text": "páirc",
          "translation": { "en": "park" },
          "distractors": { "en": ["church","street"] } },
        { "id": "ga-a1-cathair-1-u16", "rev": 1, "stage": "sentence", "text": "Tá páirc mhór in aice leis an scoil.",
          "translation": { "en": "There's a big park next to the school." },
          "distractors": { "en": ["There's a small park next to the school.","There's a big park next to the church."] } },
        { "id": "ga-a1-cathair-1-u17", "rev": 1, "stage": "phrase", "text": "oifig an phoist",
          "translation": { "en": "the post office" },
          "distractors": { "en": ["the office","the bank"] } },
        { "id": "ga-a1-cathair-1-u18", "rev": 1, "stage": "sentence", "text": "Cá bhfuil oifig an phoist?",
          "translation": { "en": "Where's the post office?" },
          "distractors": { "en": ["Where's the office?","Is there a post office?"] } }
      ]
    },
    {
      "id": "ga-a1-cathair-2",
      "title": "Cas ar dheis",
      "grammarFocus": { "en": ["a command is the bare verb: cas = turn, téigh = go, lean = follow","ar dheis = right, ar chlé = left, díreach ar aghaidh = straight ahead","ag an eclipses: banc, ag an mbanc"] },
      "units": [
        { "id": "ga-a1-cathair-2-u01", "rev": 1, "stage": "phrase", "text": "cas ar dheis",
          "translation": { "en": "turn right" },
          "distractors": { "en": ["turn left","go straight on"] } },
        { "id": "ga-a1-cathair-2-u02", "rev": 1, "stage": "sentence", "text": "Cas ar dheis ag an mbanc.",
          "translation": { "en": "Turn right at the bank." },
          "distractors": { "en": ["Turn left at the bank.","Turn right at the church."] } },
        { "id": "ga-a1-cathair-2-u03", "rev": 1, "stage": "phrase", "text": "cas ar chlé",
          "translation": { "en": "turn left" },
          "distractors": { "en": ["turn right","go back"] } },
        { "id": "ga-a1-cathair-2-u04", "rev": 1, "stage": "sentence", "text": "Cas ar chlé ag an ospidéal.",
          "translation": { "en": "Turn left at the hospital." },
          "distractors": { "en": ["Turn right at the hospital.","Turn left at the hotel."] } },
        { "id": "ga-a1-cathair-2-u05", "rev": 1, "stage": "phrase", "text": "díreach ar aghaidh",
          "translation": { "en": "straight ahead" },
          "distractors": { "en": ["over there","turn left"] } },
        { "id": "ga-a1-cathair-2-u06", "rev": 1, "stage": "sentence", "text": "Téigh díreach ar aghaidh.",
          "translation": { "en": "Go straight ahead." },
          "distractors": { "en": ["Turn right.","Go back."] } },
        { "id": "ga-a1-cathair-2-u07", "rev": 1, "stage": "phrase", "text": "lean ar aghaidh",
          "translation": { "en": "keep going" },
          "distractors": { "en": ["go back","stop here"] } },
        { "id": "ga-a1-cathair-2-u08", "rev": 1, "stage": "sentence", "text": "Lean ar aghaidh go dtí an stáisiún.",
          "translation": { "en": "Keep going to the station." },
          "distractors": { "en": ["Go back to the station.","Keep going to the church."] } },
        { "id": "ga-a1-cathair-2-u09", "rev": 1, "stage": "word", "text": "bóthar",
          "translation": { "en": "road" },
          "distractors": { "en": ["street","park"] } },
        { "id": "ga-a1-cathair-2-u10", "rev": 1, "stage": "sentence", "text": "Téigh suas an bóthar.",
          "translation": { "en": "Go up the road." },
          "distractors": { "en": ["Go down the road.","Cross the road."] } },
        { "id": "ga-a1-cathair-2-u11", "rev": 1, "stage": "word", "text": "sráid",
          "translation": { "en": "street" },
          "distractors": { "en": ["road","town"] } },
        { "id": "ga-a1-cathair-2-u12", "rev": 1, "stage": "sentence", "text": "Téigh síos an tsráid.",
          "translation": { "en": "Go down the street." },
          "distractors": { "en": ["Go up the street.","Cross the street."] } },
        { "id": "ga-a1-cathair-2-u13", "rev": 1, "stage": "word", "text": "trasnaigh",
          "translation": { "en": "cross" },
          "distractors": { "en": ["turn","follow"] } },
        { "id": "ga-a1-cathair-2-u14", "rev": 1, "stage": "sentence", "text": "Trasnaigh an bóthar ag na soilse.",
          "translation": { "en": "Cross the road at the lights." },
          "distractors": { "en": ["Cross the road at the church.","Turn right at the lights."] } },
        { "id": "ga-a1-cathair-2-u15", "rev": 1, "stage": "sentence", "text": "Ansin, cas ar dheis.",
          "translation": { "en": "Then turn right." },
          "distractors": { "en": ["Then turn left.","Now turn right."] } },
        { "id": "ga-a1-cathair-2-u16", "rev": 1, "stage": "sentence", "text": "Tá an banc ar chlé.",
          "translation": { "en": "The bank is on the left." },
          "distractors": { "en": ["The bank is on the right.","The bank is straight ahead."] } }
      ]
    },
    {
      "id": "ga-a1-cathair-3",
      "title": "An bhfuil sé i bhfad?",
      "grammarFocus": { "en": ["i bhfad = far (lit. in length); cóngarach = near","ó + an = ón: ón stáisiún = from the station"] },
      "units": [
        { "id": "ga-a1-cathair-3-u01", "rev": 1, "stage": "sentence", "text": "An bhfuil sé i bhfad ó seo?", "senses": {"0":"q"},
          "translation": { "en": "Is it far from here?" },
          "distractors": { "en": ["Is it near here?","Is he far from here?"] } },
        { "id": "ga-a1-cathair-3-u02", "rev": 1, "stage": "word", "text": "cóngarach",
          "translation": { "en": "near" },
          "distractors": { "en": ["far","big"] } },
        { "id": "ga-a1-cathair-3-u03", "rev": 1, "stage": "sentence", "text": "Níl, tá sé cóngarach.",
          "translation": { "en": "No, it's near." },
          "distractors": { "en": ["Yes, it's near.","No, it's far."] } },
        { "id": "ga-a1-cathair-3-u04", "rev": 1, "stage": "word", "text": "nóiméad",
          "translation": { "en": "minute" },
          "distractors": { "en": ["hour","day"] } },
        { "id": "ga-a1-cathair-3-u05", "rev": 1, "stage": "phrase", "text": "cúig nóiméad", "variants": ["5 nóiméad"],
          "translation": { "en": "five minutes" },
          "distractors": { "en": ["six minutes","five hours"] } },
        { "id": "ga-a1-cathair-3-u06", "rev": 1, "stage": "sentence", "text": "Tá sé cúig nóiméad ón stáisiún.", "variants": ["Tá sé 5 nóiméad ón stáisiún."],
          "translation": { "en": "It's five minutes from the station." },
          "distractors": { "en": ["It's five minutes from the bank.","It's six minutes from the station."] } },
        { "id": "ga-a1-cathair-3-u07", "rev": 1, "stage": "phrase", "text": "deich nóiméad", "variants": ["10 nóiméad"],
          "translation": { "en": "ten minutes" },
          "distractors": { "en": ["nine minutes","ten hours"] } },
        { "id": "ga-a1-cathair-3-u08", "rev": 1, "stage": "sentence", "text": "Tá sé deich nóiméad de shiúl na gcos.", "variants": ["Tá sé 10 nóiméad de shiúl na gcos."],
          "translation": { "en": "It's a ten-minute walk." },
          "distractors": { "en": ["It's ten minutes by bus.","It's a nine-minute walk."] } },
        { "id": "ga-a1-cathair-3-u09", "rev": 1, "stage": "word", "text": "tóg",
          "translation": { "en": "take" },
          "distractors": { "en": ["turn","follow"] } },
        { "id": "ga-a1-cathair-3-u10", "rev": 1, "stage": "sentence", "text": "Tóg an bus, tá sé i bhfad.",
          "translation": { "en": "Take the bus, it's far." },
          "distractors": { "en": ["Take the train, it's far.","Take the bus, it's near."] } },
        { "id": "ga-a1-cathair-3-u11", "rev": 1, "stage": "phrase", "text": "stad an bhus",
          "translation": { "en": "the bus stop" },
          "distractors": { "en": ["the train station","the bus"] } },
        { "id": "ga-a1-cathair-3-u12", "rev": 1, "stage": "sentence", "text": "Cá bhfuil stad an bhus?",
          "translation": { "en": "Where's the bus stop?" },
          "distractors": { "en": ["Where's the train station?","Is there a bus stop?"] } },
        { "id": "ga-a1-cathair-3-u13", "rev": 1, "stage": "word", "text": "tacsaí",
          "translation": { "en": "taxi" },
          "distractors": { "en": ["bus","train"] } },
        { "id": "ga-a1-cathair-3-u14", "rev": 1, "stage": "sentence", "text": "An bhfuil tacsaí ann?", "senses": {"0":"q"},
          "translation": { "en": "Is there a taxi?" },
          "distractors": { "en": ["Is there a bus?","Is the taxi here?"] } },
        { "id": "ga-a1-cathair-3-u15", "rev": 1, "stage": "sentence", "text": "Tá an stáisiún i bhfad ó lár an bhaile.",
          "translation": { "en": "The station is far from the town centre." },
          "distractors": { "en": ["The station is near the town centre.","The church is far from the town centre."] } }
      ]
    },
    {
      "id": "ga-a1-cathair-4",
      "title": "Sa bhaile mór",
      "grammarFocus": { "en": ["tá ... ann = there is ...: tá caife ann = there's a café","níl ... ann = there isn't","cathair is feminine: cathair mhór"] },
      "units": [
        { "id": "ga-a1-cathair-4-u01", "rev": 1, "stage": "phrase", "text": "baile mór",
          "translation": { "en": "town" },
          "distractors": { "en": ["city","village"] } },
        { "id": "ga-a1-cathair-4-u02", "rev": 1, "stage": "sentence", "text": "Is baile beag é.",
          "translation": { "en": "It's a small town." },
          "distractors": { "en": ["It's a big town.","It's a small city."] } },
        { "id": "ga-a1-cathair-4-u03", "rev": 1, "stage": "word", "text": "pictiúrlann",
          "translation": { "en": "cinema" },
          "distractors": { "en": ["theatre","museum"] } },
        { "id": "ga-a1-cathair-4-u04", "rev": 1, "stage": "sentence", "text": "An bhfuil pictiúrlann ann?", "senses": {"0":"q"},
          "translation": { "en": "Is there a cinema?" },
          "distractors": { "en": ["Is there a theatre?","Is the cinema there?"] } },
        { "id": "ga-a1-cathair-4-u05", "rev": 1, "stage": "word", "text": "amharclann",
