          "distractors": { "en": ["town","street"] } },
        { "id": "ga-a1-cathair-4-u08", "rev": 1, "stage": "sentence", "text": "Is cathair mhór í Corcaigh.",
          "translation": { "en": "Cork is a big city." },
          "distractors": { "en": ["Cork is a small city.","Cork is a big town."] } },
        { "id": "ga-a1-cathair-4-u09", "rev": 1, "stage": "word", "text": "músaem",
          "translation": { "en": "museum" },
          "distractors": { "en": ["theatre","library"] } },
        { "id": "ga-a1-cathair-4-u10", "rev": 1, "stage": "sentence", "text": "Tá músaem maith sa chathair.",
          "translation": { "en": "There's a good museum in the city." },
          "distractors": { "en": ["There's a good theatre in the city.","There's a good museum in the town."] } },
        { "id": "ga-a1-cathair-4-u11", "rev": 1, "stage": "word", "text": "ollmhargadh",
