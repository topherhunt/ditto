        { "id": "ga-a1-cathair-4-u13", "rev": 1, "stage": "word", "text": "leabharlann",
          "translation": { "en": "library" },
          "distractors": { "en": ["bookshop","school"] } },
        { "id": "ga-a1-cathair-4-u14", "rev": 1, "stage": "phrase", "text": "ar oscailt",
