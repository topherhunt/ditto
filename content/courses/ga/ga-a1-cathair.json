    {
      "id": "ga-a1-cathair-5",
      "title": "An féidir leat cabhrú liom?",
      "grammarFocus": { "en": ["an féidir leat ...? = can you ...?; is féidir liom = I can","níl a fhios agam = I don't know (lit. his knowledge isn't at me)"] },
      "units": [
        { "id": "ga-a1-cathair-5-u01", "rev": 1, "stage": "chunk", "text": "an féidir leat", "senses": {"0":"q"},
          "translation": { "en": "can you" },
          "distractors": { "en": ["would you like","do you like"] } },
        { "id": "ga-a1-cathair-5-u02", "rev": 1, "stage": "sentence", "text": "An féidir leat cabhrú liom?", "senses": {"0":"q"},
          "translation": { "en": "Can you help me?" },
          "distractors": { "en": ["Can I help you?","Would you like to help me?"] } },
        { "id": "ga-a1-cathair-5-u03", "rev": 1, "stage": "word", "text": "caillte",
          "translation": { "en": "lost" },
          "distractors": { "en": ["tired","late"] } },
        { "id": "ga-a1-cathair-5-u04", "rev": 1, "stage": "sentence", "text": "Tá mé caillte.",
          "translation": { "en": "I'm lost." },
          "distractors": { "en": ["I'm late.","I'm tired."] } },
        { "id": "ga-a1-cathair-5-u05", "rev": 1, "stage": "chunk", "text": "níl a fhios agam", "senses": {"1":"his"},
          "translation": { "en": "I don't know" },
          "distractors": { "en": ["I don't understand","I know"] } },
        { "id": "ga-a1-cathair-5-u06", "rev": 1, "stage": "sentence", "text": "Tá brón orm, níl a fhios agam.", "senses": {"4":"his"},
          "translation": { "en": "I'm sorry, I don't know." },
          "distractors": { "en": ["I'm sorry, I don't understand.","Thank you, I know."] } },
        { "id": "ga-a1-cathair-5-u07", "rev": 1, "stage": "sentence", "text": "Níl mé ó seo.",
          "translation": { "en": "I'm not from here." },
          "distractors": { "en": ["I'm from here.","I don't live here."] } },
        { "id": "ga-a1-cathair-5-u08", "rev": 1, "stage": "sentence", "text": "An bhfuil a fhios agat cá bhfuil an stáisiún?", "senses": {"0":"q","2":"his"},
          "translation": { "en": "Do you know where the station is?" },
          "distractors": { "en": ["Do you know where the bank is?","Do you know when the train is?"] } },
        { "id": "ga-a1-cathair-5-u09", "rev": 1, "stage": "word", "text": "léarscáil",
          "translation": { "en": "map" },
          "distractors": { "en": ["ticket","book"] } },
        { "id": "ga-a1-cathair-5-u10", "rev": 1, "stage": "sentence", "text": "An bhfuil léarscáil agat?", "senses": {"0":"q"},
          "translation": { "en": "Do you have a map?" },
          "distractors": { "en": ["Do you have a ticket?","Is there a map?"] } },
        { "id": "ga-a1-cathair-5-u11", "rev": 1, "stage": "sentence", "text": "Is féidir liom é a thaispeáint duit.", "senses": {"4":"to"},
          "translation": { "en": "I can show it to you." },
          "distractors": { "en": ["You can show it to me.","I can't show it to you."] } },
        { "id": "ga-a1-cathair-5-u12", "rev": 1, "stage": "chunk", "text": "go raibh míle maith agat",
          "translation": { "en": "thanks a million" },
          "distractors": { "en": ["you're welcome","excuse me"] } },
        { "id": "ga-a1-cathair-5-u13", "rev": 1, "stage": "sentence", "text": "Go raibh míle maith agat!",
          "translation": { "en": "Thanks a million!" },
          "distractors": { "en": ["You're welcome!","Excuse me!"] } },
        { "id": "ga-a1-cathair-5-u14", "rev": 1, "stage": "chunk", "text": "níl a bhuíochas ort", "senses": {"1":"his"},
          "translation": { "en": "you're welcome" },
          "distractors": { "en": ["thank you","I'm sorry"] } },
        { "id": "ga-a1-cathair-5-u15", "rev": 1, "stage": "sentence", "text": "Níl a bhuíochas ort, slán!", "senses": {"1":"his"},
          "translation": { "en": "You're welcome, bye!" },
          "distractors": { "en": ["Thank you, bye!","You're welcome, hello!"] } }
      ]
    },
    {
      "id": "ga-a1-cathair-6",
      "title": "Ag siúl sa chathair",
      "grammarFocus": { "en": ["review: asking the way, directions, and places in town"] },
      "units": [
        { "id": "ga-a1-cathair-6-u01", "rev": 1, "stage": "sentence", "text": "Dia duit, an féidir leat cabhrú liom?", "senses": {"2":"q"},
          "translation": { "en": "Hello, can you help me?" },
          "distractors": { "en": ["Hello, can I help you?","Goodbye, can you help me?"] } },
        { "id": "ga-a1-cathair-6-u02", "rev": 1, "stage": "sentence", "text": "Cinnte, cad atá uait?",
          "translation": { "en": "Of course, what do you need?" },
          "distractors": { "en": ["Of course, where do you live?","Sorry, what do you need?"] } },
        { "id": "ga-a1-cathair-6-u03", "rev": 1, "stage": "sentence", "text": "Tá mé ag lorg an stáisiúin.",
          "translation": { "en": "I'm looking for the station." },
          "distractors": { "en": ["I'm looking for the bank.","I'm going to the station."] } },
        { "id": "ga-a1-cathair-6-u04", "rev": 1, "stage": "sentence", "text": "Téigh díreach ar aghaidh, agus cas ar chlé ag an séipéal.",
          "translation": { "en": "Go straight ahead, and turn left at the church." },
          "distractors": { "en": ["Go straight ahead, and turn right at the church.","Turn left, and go straight ahead to the church."] } },
        { "id": "ga-a1-cathair-6-u05", "rev": 1, "stage": "sentence", "text": "An bhfuil sé i bhfad?", "senses": {"0":"q"},
          "translation": { "en": "Is it far?" },
          "distractors": { "en": ["Is it near?","Is it open?"] } },
        { "id": "ga-a1-cathair-6-u06", "rev": 1, "stage": "sentence", "text": "Níl, tá sé cúig nóiméad de shiúl na gcos.", "variants": ["Níl, tá sé 5 nóiméad de shiúl na gcos."],
          "translation": { "en": "No, it's a five-minute walk." },
          "distractors": { "en": ["Yes, it's a five-minute walk.","No, it's five minutes by bus."] } },
        { "id": "ga-a1-cathair-6-u07", "rev": 1, "stage": "sentence", "text": "An bhfuil caife maith in aice leis?", "senses": {"0":"q"},
          "translation": { "en": "Is there a good café near it?" },
          "distractors": { "en": ["Is there a good restaurant near it?","Is there a good café in it?"] } },
        { "id": "ga-a1-cathair-6-u08", "rev": 1, "stage": "sentence", "text": "Tá, tá caife beag ar an tsráid chéanna.",
          "translation": { "en": "Yes, there's a little café on the same street." },
          "distractors": { "en": ["Yes, there's a big café on the same street.","No, there's a little café on another street."] } },
        { "id": "ga-a1-cathair-6-u09", "rev": 1, "stage": "sentence", "text": "Go hiontach, go raibh maith agat!",
          "translation": { "en": "Great, thank you!" },
          "distractors": { "en": ["Great, you're welcome!","Awful, thank you!"] } }
      ]
    }
  ]
