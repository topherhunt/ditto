      "title": "Where's the station?",
      "grammarFocus": { "es-419": ["where's = where is", "do you know where the museum is? (el verbo va al final)", "near = cerca de, far from = lejos de"], "it": ["where's = where is", "do you know where the museum is? (il verbo va alla fine)", "near = vicino a, far from = lontano da"] },
