          "distractors": { "es-419": ["Disculpe, ¿dónde está la parada?", "Disculpe, ¿a qué hora abre la estación?"], "it": ["Mi scusi, dov'è la fermata?", "Mi scusi, a che ora apre la stazione?"] } },
        { "id": "en-a1-city-1-u04", "rev": 1, "stage": "word", "text": "know",
