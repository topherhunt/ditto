  "lessons": [
    {
      "id": "en-a2-polite-1",
      "title": "Could you help me?",
      "grammarFocus": { "es-419": ["Could you + verbo? = ¿Podrías...?", "Would you mind + -ing? = ¿Te molestaría...?", "Do you mind if I...? = ¿Te molesta si...?", "¡ojo! No, not at all = no me molesta (o sea, sí)"], "it": ["Could you + verbo? = Potresti...?", "Would you mind + -ing? = Ti dispiacerebbe...?", "Do you mind if I...? = Ti dispiace se...?", "attenzione: No, not at all = non mi dispiace (cioè sì)"] },
      "units": [
        { "id": "en-a2-polite-1-u01", "rev": 1, "stage": "chunk", "text": "could you help me",
          "translation": { "es-419": "me podrías ayudar", "it": "potresti aiutarmi" },
          "distractors": { "es-419": ["me puedes esperar", "te podría ayudar"], "it": ["potresti aspettarmi", "potrei aiutarti"] } },
        { "id": "en-a2-polite-1-u02", "rev": 1, "stage": "sentence", "text": "Could you help me, please?",
          "translation": { "es-419": "¿Me podrías ayudar, por favor?", "it": "Potresti aiutarmi, per favore?" },
          "distractors": { "es-419": ["¿Te podría ayudar, por favor?", "¿Me podrías esperar, por favor?"], "it": ["Potrei aiutarti, per favore?", "Potresti aspettarmi, per favore?"] } },
        { "id": "en-a2-polite-1-u03", "rev": 1, "stage": "sentence", "text": "Could you open the window?",
          "translation": { "es-419": "¿Podrías abrir la ventana?", "it": "Potresti aprire la finestra?" },
          "distractors": { "es-419": ["¿Podrías cerrar la ventana?", "¿Podrías abrir la puerta?"], "it": ["Potresti chiudere la finestra?", "Potresti aprire la porta?"] } },
        { "id": "en-a2-polite-1-u04", "rev": 1, "stage": "word", "text": "mind",
          "translation": { "es-419": "importar", "it": "dispiacere" },
          "distractors": { "es-419": ["recordar", "pensar"], "it": ["ricordare", "pensare"] } },
        { "id": "en-a2-polite-1-u05", "rev": 1, "stage": "chunk", "text": "would you mind",
          "translation": { "es-419": "te molestaría", "it": "ti dispiacerebbe" },
          "distractors": { "es-419": ["te gustaría", "te molestó"], "it": ["ti piacerebbe", "ti è dispiaciuto"] } },
        { "id": "en-a2-polite-1-u06", "rev": 1, "stage": "sentence", "text": "Would you mind closing the door?",
          "translation": { "es-419": "¿Te molestaría cerrar la puerta?", "it": "Ti dispiacerebbe chiudere la porta?" },
          "distractors": { "es-419": ["¿Te molestaría abrir la puerta?", "¿Te gustaría cerrar la puerta?"], "it": ["Ti dispiacerebbe aprire la porta?", "Ti piacerebbe chiudere la porta?"] } },
        { "id": "en-a2-polite-1-u07", "rev": 1, "stage": "chunk", "text": "not at all",
          "translation": { "es-419": "para nada", "it": "per niente" },
          "distractors": { "es-419": ["claro que sí", "un poco"], "it": ["certo che sì", "un po'"] } },
        { "id": "en-a2-polite-1-u08", "rev": 1, "stage": "sentence", "text": "No, not at all.",
          "translation": { "es-419": "No, para nada.", "it": "No, per niente." },
          "distractors": { "es-419": ["Sí, un poco.", "Sí, mucho."], "it": ["Sì, un po'.", "Sì, molto."] } },
        { "id": "en-a2-polite-1-u09", "rev": 1, "stage": "sentence", "text": "Would you mind speaking more slowly?",
          "translation": { "es-419": "¿Te molestaría hablar más despacio?", "it": "Ti dispiacerebbe parlare più lentamente?" },
          "distractors": { "es-419": ["¿Te molestaría hablar más fuerte?", "¿Te molestaría hablar más rápido?"], "it": ["Ti dispiacerebbe parlare più forte?", "Ti dispiacerebbe parlare più velocemente?"] } },
        { "id": "en-a2-polite-1-u10", "rev": 1, "stage": "chunk", "text": "do you mind if I",
          "translation": { "es-419": "te molesta si", "it": "ti dispiace se" },
          "distractors": { "es-419": ["le molesta si", "te molestó si"], "it": ["le dispiace se", "ti è dispiaciuto se"] } },
        { "id": "en-a2-polite-1-u11", "rev": 1, "stage": "sentence", "text": "Do you mind if I open the window?",
          "translation": { "es-419": "¿Te molesta si abro la ventana?", "it": "Ti dispiace se apro la finestra?" },
          "distractors": { "es-419": ["¿Te molesta si cierro la ventana?", "¿Te molesta si abro la puerta?"], "it": ["Ti dispiace se chiudo la finestra?", "Ti dispiace se apro la porta?"] } },
        { "id": "en-a2-polite-1-u12", "rev": 1, "stage": "sentence", "text": "Do you mind if I borrow your pen?",
          "translation": { "es-419": "¿Te molesta si tomo prestado tu bolígrafo?", "it": "Ti dispiace se prendo in prestito la tua penna?" },
          "distractors": { "es-419": ["¿Te molesta si tomo prestado tu teléfono?", "¿Te molesta si tomo prestada tu bicicleta?"], "it": ["Ti dispiace se prendo in prestito il tuo telefono?", "Ti dispiace se prendo in prestito la tua bici?"] } },
        { "id": "en-a2-polite-1-u13", "rev": 1, "stage": "word", "text": "problem",
          "translation": { "es-419": "problema", "it": "problema" },
          "distractors": { "es-419": ["pregunta", "error"], "it": ["domanda", "errore"] } },
        { "id": "en-a2-polite-1-u14", "rev": 1, "stage": "sentence", "text": "Sure, no problem.",
          "translation": { "es-419": "Claro, no hay problema.", "it": "Certo, nessun problema." },
          "distractors": { "es-419": ["Lo siento, es un problema.", "Claro, pero más tarde."], "it": ["Mi dispiace, è un problema.", "Certo, ma più tardi."] } },
        { "id": "en-a2-polite-1-u15", "rev": 1, "stage": "sentence", "text": "Could you wait for me here?",
          "translation": { "es-419": "¿Me podrías esperar aquí?", "it": "Potresti aspettarmi qui?" },
          "distractors": { "es-419": ["¿Me podrías esperar afuera?", "¿Te podría esperar aquí?"], "it": ["Potresti aspettarmi fuori?", "Potrei aspettarti qui?"] } },
        { "id": "en-a2-polite-1-u16", "rev": 1, "stage": "sentence", "text": "Excuse me, could you tell me where the station is?",
          "translation": { "es-419": "Disculpe, ¿me podría decir dónde está la estación?", "it": "Scusi, potrebbe dirmi dov'è la stazione?" },
          "distractors": { "es-419": ["Disculpe, ¿me podría decir dónde está el hotel?", "Disculpe, ¿me podría decir dónde está la parada?"], "it": ["Scusi, potrebbe dirmi dov'è l'albergo?", "Scusi, potrebbe dirmi dov'è la fermata?"] } }
      ]
    },
    {
      "id": "en-a2-polite-2",
      "title": "I'd love to",
      "grammarFocus": { "es-419": ["I'd love to = me encantaría", "I'd rather + verbo = prefiero", "Would you like to...? = ¿Te gustaría...?"], "it": ["I'd love to = mi piacerebbe molto", "I'd rather + verbo = preferisco", "Would you like to...? = Ti piacerebbe...?"] },
      "units": [
        { "id": "en-a2-polite-2-u01", "rev": 1, "stage": "chunk", "text": "I'd love to", "variants": ["I would love to"],
          "translation": { "es-419": "me encantaría", "it": "mi piacerebbe molto" },
          "distractors": { "es-419": ["me encantó", "no puedo"], "it": ["mi è piaciuto molto", "non posso"] } },
        { "id": "en-a2-polite-2-u02", "rev": 1, "stage": "sentence", "text": "Would you like to have dinner with us on Friday?",
          "translation": { "es-419": "¿Te gustaría cenar con nosotros el viernes?", "it": "Ti piacerebbe cenare con noi venerdì?" },
          "distractors": { "es-419": ["¿Te gustaría almorzar con nosotros el viernes?", "¿Te gustaría cenar con nosotros el sábado?"], "it": ["Ti piacerebbe pranzare con noi venerdì?", "Ti piacerebbe cenare con noi sabato?"] } },
        { "id": "en-a2-polite-2-u03", "rev": 1, "stage": "sentence", "text": "I'd love to! What time?", "variants": ["I would love to! What time?"],
          "translation": { "es-419": "¡Me encantaría! ¿A qué hora?", "it": "Mi piacerebbe molto! A che ora?" },
          "distractors": { "es-419": ["¡Me encantaría! ¿Dónde?", "¡Lo siento, no puedo! ¿Otro día?"], "it": ["Mi piacerebbe molto! Dove?", "Mi dispiace, non posso! Un altro giorno?"] } },
        { "id": "en-a2-polite-2-u04", "rev": 1, "stage": "word", "text": "rather",
          "translation": { "es-419": "más bien", "it": "piuttosto" },
          "distractors": { "es-419": ["también", "todavía"], "it": ["anche", "ancora"] } },
        { "id": "en-a2-polite-2-u05", "rev": 1, "stage": "chunk", "text": "I'd rather", "variants": ["I would rather"],
          "translation": { "es-419": "prefiero", "it": "preferisco" },
          "distractors": { "es-419": ["prefieres", "preferí"], "it": ["preferisci", "ho preferito"] } },
        { "id": "en-a2-polite-2-u06", "rev": 1, "stage": "sentence", "text": "I'd rather stay home tonight.", "variants": ["I would rather stay home tonight."],
          "translation": { "es-419": "Prefiero quedarme en casa esta noche.", "it": "Stasera preferisco restare a casa." },
          "distractors": { "es-419": ["Prefiero salir esta noche.", "Prefiero quedarme en casa mañana."], "it": ["Stasera preferisco uscire.", "Domani preferisco restare a casa."] } },
        { "id": "en-a2-polite-2-u07", "rev": 1, "stage": "sentence", "text": "Would you rather go to the beach or the mountains?",
          "translation": { "es-419": "¿Prefieres ir a la playa o a las montañas?", "it": "Preferisci andare al mare o in montagna?" },
          "distractors": { "es-419": ["¿Prefieres ir a la playa o al lago?", "¿Fuiste a la playa o a las montañas?"], "it": ["Preferisci andare al mare o al lago?", "Sei andato al mare o in montagna?"] } },
        { "id": "en-a2-polite-2-u08", "rev": 1, "stage": "sentence", "text": "I'd like to make a reservation for Saturday.", "variants": ["I would like to make a reservation for Saturday."],
          "translation": { "es-419": "Quisiera hacer una reservación para el sábado.", "it": "Vorrei fare una prenotazione per sabato." },
          "distractors": { "es-419": ["Quisiera cancelar una reservación para el sábado.", "Quisiera hacer una reservación para el domingo."], "it": ["Vorrei cancellare una prenotazione per sabato.", "Vorrei fare una prenotazione per domenica."] } },
        { "id": "en-a2-polite-2-u09", "rev": 1, "stage": "word", "text": "cancel",
          "translation": { "es-419": "cancelar", "it": "annullare" },
          "distractors": { "es-419": ["cambiar", "confirmar"], "it": ["cambiare", "confermare"] } },
        { "id": "en-a2-polite-2-u10", "rev": 1, "stage": "sentence", "text": "I'm sorry, but I have to cancel.", "variants": ["I am sorry, but I have to cancel."],
          "translation": { "es-419": "Lo siento, pero tengo que cancelar.", "it": "Mi dispiace, ma devo annullare." },
          "distractors": { "es-419": ["Lo siento, pero tengo que cambiar la hora.", "Lo siento, pero no puedo cancelar."], "it": ["Mi dispiace, ma devo cambiare l'ora.", "Mi dispiace, ma non posso annullare."] } },
        { "id": "en-a2-polite-2-u11", "rev": 1, "stage": "chunk", "text": "maybe next time",
          "translation": { "es-419": "quizás la próxima vez", "it": "magari la prossima volta" },
          "distractors": { "es-419": ["quizás mañana", "nunca más"], "it": ["magari domani", "mai più, grazie"] } },
        { "id": "en-a2-polite-2-u12", "rev": 1, "stage": "sentence", "text": "That's okay, maybe next time.", "variants": ["That is okay, maybe next time."],
          "translation": { "es-419": "No pasa nada, quizás la próxima vez.", "it": "Non fa niente, magari la prossima volta." },
          "distractors": { "es-419": ["No pasa nada, quizás mañana.", "Qué pena, nunca más."], "it": ["Non fa niente, magari domani.", "Che peccato, mai più."] } },
        { "id": "en-a2-polite-2-u13", "rev": 1, "stage": "sentence", "text": "Would you like me to drive you home?",
          "translation": { "es-419": "¿Quieres que te lleve a casa?", "it": "Vuoi che ti accompagni a casa?" },
          "distractors": { "es-419": ["¿Quieres llevarme a casa?", "¿Quieres que te lleve al trabajo?"], "it": ["Vuoi accompagnarmi a casa?", "Vuoi che ti accompagni al lavoro?"] } },
        { "id": "en-a2-polite-2-u14", "rev": 1, "stage": "sentence", "text": "Thanks, but I'd rather walk.", "variants": ["Thanks, but I would rather walk."],
          "translation": { "es-419": "Gracias, pero prefiero caminar.", "it": "Grazie, ma preferisco camminare." },
          "distractors": { "es-419": ["Gracias, prefiero que me lleves.", "Gracias, pero prefiero tomar el autobús."], "it": ["Grazie, preferisco che mi accompagni.", "Grazie, ma preferisco prendere l'autobus."] } },
        { "id": "en-a2-polite-2-u15", "rev": 1, "stage": "sentence", "text": "We'd love to come, but we're busy that weekend.", "variants": ["We would love to come, but we are busy that weekend.", "We would love to come, but we're busy that weekend.", "We'd love to come, but we are busy that weekend."],
          "translation": { "es-419": "Nos encantaría ir, pero estamos ocupados ese fin de semana.", "it": "Ci piacerebbe molto venire, ma quel fine settimana siamo impegnati." },
          "distractors": { "es-419": ["Nos encantaría ir, y estamos libres ese fin de semana.", "Nos encantaría ir, pero estamos ocupados esa noche."], "it": ["Ci piacerebbe molto venire, e quel fine settimana siamo liberi.", "Ci piacerebbe molto venire, ma quella sera siamo impegnati."] } }
      ]
    },
    {
      "id": "en-a2-polite-3",
      "title": "On the phone",
      "grammarFocus": { "es-419": ["al teléfono: This is Sarah = habla Sarah", "Hold on = espera un momento", "call me back = devuélveme la llamada"], "it": ["al telefono: This is Sarah = sono Sarah", "Hold on = aspetta un attimo", "call me back = richiamami"] },
      "units": [
        { "id": "en-a2-polite-3-u01", "rev": 1, "stage": "chunk", "text": "this is Sarah",
          "translation": { "es-419": "habla Sarah", "it": "sono Sarah" },
          "distractors": { "es-419": ["busco a Sarah", "llamo a Sarah"], "it": ["cerco Sarah", "chiamo Sarah"] } },
        { "id": "en-a2-polite-3-u02", "rev": 1, "stage": "sentence", "text": "Hi, this is Sarah. Is Mike there?",
          "translation": { "es-419": "Hola, habla Sarah. ¿Está Mike?", "it": "Ciao, sono Sarah. C'è Mike?" },
          "distractors": { "es-419": ["Hola, habla Sarah. ¿Eres Mike?", "Hola, habla Mike. ¿Está Sarah?"], "it": ["Ciao, sono Sarah. Sei Mike?", "Ciao, sono Mike. C'è Sarah?"] } },
        { "id": "en-a2-polite-3-u03", "rev": 1, "stage": "word", "text": "hold",
          "translation": { "es-419": "sostener", "it": "tenere" },
          "distractors": { "es-419": ["soltar", "llamar"], "it": ["lasciare", "chiamare"] } },
        { "id": "en-a2-polite-3-u04", "rev": 1, "stage": "chunk", "text": "hold on",
          "translation": { "es-419": "espera un momento", "it": "aspetta un attimo" },
          "distractors": { "es-419": ["cuelga ya", "llámame luego"], "it": ["riattacca", "richiamami dopo"] } },
        { "id": "en-a2-polite-3-u05", "rev": 1, "stage": "sentence", "text": "Hold on, I'll get him.", "variants": ["Hold on, I will get him."],
          "translation": { "es-419": "Espera un momento, ya lo llamo.", "it": "Aspetta un attimo, te lo chiamo." },
          "distractors": { "es-419": ["Espera un momento, ya la llamo.", "Espera un momento, no está."], "it": ["Aspetta un attimo, te la chiamo.", "Aspetta un attimo, non c'è."] } },
        { "id": "en-a2-polite-3-u06", "rev": 1, "stage": "sentence", "text": "Sorry, he's not here right now.", "variants": ["Sorry, he is not here right now."],
