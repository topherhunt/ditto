          "distractors": { "en": ["A coffee for me, thanks.", "I'd like the bill, please."], "es-419": ["Un café para mí, gracias.", "Quisiera la cuenta, por favor."], "nl": ["Een koffie voor mij, bedankt.", "Ik wil graag de rekening, alsjeblieft."] } },
        { "id": "it-a1-bar-1-u07", "rev": 1, "stage": "phrase", "text": "un cornetto",
