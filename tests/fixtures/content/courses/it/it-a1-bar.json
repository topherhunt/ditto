          "distractors": { "en": ["a sandwich", "a coffee"], "es-419": ["un sándwich", "un café"], "nl": ["een broodje", "een koffie"] } },
        { "id": "it-a1-bar-1-u08", "rev": 1, "stage": "sentence", "text": "Vorrei un caffè e un cornetto.",
