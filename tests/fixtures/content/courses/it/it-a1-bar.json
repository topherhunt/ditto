      "units": [
        { "id": "it-a1-bar-2-u01", "rev": 1, "stage": "word", "text": "quanto",
          "translation": { "en": "how much", "es-419": "cuánto", "nl": "hoeveel" },
          "distractors": { "en": ["how many", "how"], "es-419": ["cuántos", "cómo"], "nl": ["hoe vaak", "hoe"] } },
        { "id": "it-a1-bar-2-u02", "rev": 1, "stage": "sentence", "text": "Quanto costa?",
          "translation": { "en": "How much is it?", "es-419": "¿Cuánto cuesta?", "nl": "Hoeveel kost het?" },
          "distractors": { "en": ["What is it?", "Can I pay?"], "es-419": ["¿Qué es?", "¿Puedo pagar?"], "nl": ["Wat is het?", "Kan ik betalen?"] } },
        { "id": "it-a1-bar-2-u03", "rev": 1, "stage": "phrase", "text": "due euro", "variants": ["2 euro"],
          "translation": { "en": "two euros", "es-419": "dos euros", "nl": "twee euro" },
          "distractors": { "en": ["ten euros", "twelve euros"], "es-419": ["diez euros", "doce euros"], "nl": ["tien euro", "twaalf euro"] } },
        { "id": "it-a1-bar-2-u04", "rev": 1, "stage": "sentence", "text": "Costa due euro.", "variants": ["Costa 2 euro."],
          "translation": { "en": "It costs two euros.", "es-419": "Cuesta dos euros.", "nl": "Het kost twee euro." },
          "distractors": { "en": ["It costs ten euros.", "It costs two dollars."], "es-419": ["Cuesta diez euros.", "Cuesta dos dólares."], "nl": ["Het kost tien euro.", "Het kost twee dollar."] } },
        { "id": "it-a1-bar-2-u05", "rev": 1, "stage": "phrase", "text": "il conto",
          "translation": { "en": "the bill", "es-419": "la cuenta", "nl": "de rekening" },
          "distractors": { "en": ["the card", "the menu"], "es-419": ["la tarjeta", "el menú"], "nl": ["de kaart", "het menu"] } },
        { "id": "it-a1-bar-2-u06", "rev": 1, "stage": "sentence", "text": "Il conto, per favore.",
          "translation": { "en": "The bill, please.", "es-419": "La cuenta, por favor.", "nl": "De rekening, alsjeblieft." },
          "distractors": { "en": ["The menu, please.", "The card, thanks."], "es-419": ["El menú, por favor.", "La tarjeta, gracias."], "nl": ["Het menu, alsjeblieft.", "De kaart, bedankt."] } },
        { "id": "it-a1-bar-2-u07", "rev": 1, "stage": "chunk", "text": "posso pagare",
          "translation": { "en": "can I pay", "es-419": "puedo pagar", "nl": "kan ik betalen" },
          "distractors": { "en": ["I want to pay", "can you pay"], "es-419": ["quiero pagar", "puedes pagar"], "nl": ["ik wil betalen", "kun jij betalen"] } },
        { "id": "it-a1-bar-2-u08", "rev": 1, "stage": "sentence", "text": "Posso pagare con la carta?",
          "translation": { "en": "Can I pay by card?", "es-419": "¿Puedo pagar con tarjeta?", "nl": "Kan ik met de kaart betalen?" },
          "distractors": { "en": ["Can I pay in cash?", "Can you pay by card?"], "es-419": ["¿Puedo pagar en efectivo?", "¿Puedes pagar con tarjeta?"], "nl": ["Kan ik contant betalen?", "Kun jij met de kaart betalen?"] } },
        { "id": "it-a1-bar-2-u09", "rev": 1, "stage": "sentence", "text": "Lo prendo, grazie.", "senses": {"0": "pron"},
          "translation": { "en": "I'll take it, thanks.", "es-419": "Me lo llevo, gracias.", "nl": "Ik neem het, bedankt." },
          "distractors": { "en": ["I'll pay for it, thanks.", "I'll leave it, thanks."], "es-419": ["Lo pago yo, gracias.", "Lo dejo, gracias."], "nl": ["Ik betaal het, bedankt.", "Ik laat het staan, bedankt."] } }
      ]
    }
