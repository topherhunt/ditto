          "distractors": { "en": ["I'd like a coffee without a croissant.", "I'd like two coffees and a croissant."], "es-419": ["Quisiera un café sin croissant.", "Quisiera dos cafés y un croissant."], "nl": ["Ik wil graag een koffie zonder croissant.", "Ik wil graag twee koffie en een croissant."] } },
        { "id": "it-a1-bar-1-u09", "rev": 1, "stage": "phrase", "text": "un'acqua frizzante",
          "translation": { "en": "a sparkling water", "es-419": "un agua con gas", "nl": "een bruisend water" },
          "distractors": { "en": ["a still water", "a sparkling wine"], "es-419": ["un agua sin gas", "un vino espumoso"], "nl": ["een plat water", "een mousserende wijn"] } },
        { "id": "it-a1-bar-1-u10", "rev": 1, "stage": "sentence", "text": "Per me, un'acqua frizzante, grazie.",
          "translation": { "en": "For me, a sparkling water, thanks.", "es-419": "Para mí, un agua con gas, gracias.", "nl": "Voor mij een bruisend water, bedankt." },
          "distractors": { "en": ["For me, a coffee, thanks.", "A sparkling water for you, thanks."], "es-419": ["Para mí, un café, gracias.", "Un agua con gas para ti, gracias."], "nl": ["Voor mij een koffie, bedankt.", "Een bruisend water voor jou, bedankt."] } }
      ]
    },
    {
      "id": "it-a1-bar-2",
      "title": "Quanto costa?",
