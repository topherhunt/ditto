          "distractors": { "en": ["tea", "milk"], "es-419": ["té", "leche"], "nl": ["thee", "melk"] } },
        { "id": "it-a1-bar-1-u02", "rev": 1, "stage": "word", "text": "vorrei",
          "translation": { "en": "I would like", "es-419": "quisiera", "nl": "ik zou graag willen" },
          "distractors": { "en": ["I would pay", "I would take"], "es-419": ["pagaría", "tomaría"], "nl": ["ik zou betalen", "ik zou nemen"] } },
